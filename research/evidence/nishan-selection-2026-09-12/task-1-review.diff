+        wrong_output = root / "wrong-pin.pdf"
+        wrong = _rejection(lambda: core.decrypt_and_attribute(package, identities, "alice", secret,
+            ledger_root, wrong_output, **{**strict, "witness_public_key_sha3_256": "0" * 64}))
