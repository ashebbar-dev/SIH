+    actual = set(names)
+    if len(names) != len(EXPECTED_SAFEGUARD_CASES) or actual != expected:
+        raise ValueError(
+            "safeguard scenario coverage must be the exact 12 reviewed cases; "
+            f"missing={sorted(expected - actual)}, unexpected={sorted(actual - expected)}"
+        )
