+def _package_core_source(source_id: str, destination: Path) -> dict[str, Any]:
+    spec = SOURCE_SPECS[source_id]
+    original = ROOT / spec["input"]
+    if sha256_file(original) != spec["original_sha256"]:
+        raise ValueError(f"frozen source hash changed: {spec['input']}")
+    _require_a4(original)
+
+    header_rect = fitz.Rect(spec["header_rect_points"])
+    footer_rect = fitz.Rect(spec["footer_rect_points"])
+    with fitz.open(original) as source_document:
+        original_nonlabel_words = _words_outside(
+            source_document[0], (header_rect, footer_rect)
+        )
+        document = fitz.open(original)
+
+    try:
+        page = document[0]
+        page.add_redact_annot(header_rect, fill=(1, 1, 1), cross_out=False)
+        page.add_redact_annot(footer_rect, fill=(1, 1, 1), cross_out=False)
+        page.apply_redactions(images=0, graphics=0, text=0)
+        _insert_packaging_font(page)
+        page.insert_text(
+            fitz.Point(*spec["header_origin_points"]),
+            spec["replacement_header"],
+            fontsize=8.25,
+            fontname=PDF_FONT_NAME,
+            color=(0.04, 0.17, 0.35),
+            overlay=True,
+        )
+        page.insert_text(
+            fitz.Point(*spec["footer_origin_points"]),
+            spec["replacement_footer"],
+            fontsize=7.5,
+            fontname=PDF_FONT_NAME,
+            color=(0.12, 0.18, 0.25),
+            overlay=True,
+        )
+        document.set_metadata(
+            {
+                "title": f"N1 calibration source {source_id}",
+                "author": "NISHAN robustness campaign",
+                "subject": "Shared calibration source; paired sheet may carry public synthetic test modulation",
+                "keywords": "N1, calibration, public synthetic fixture",
+                "creator": "research.n1_v2.build_pack",
+                "producer": "PyMuPDF 1.28.2 reproducible research build",
+                "creationDate": "D:20260916000000+05'30'",
+                "modDate": "D:20260916000000+05'30'",
+            }
+        )
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        document.save(
+            destination,
+            garbage=4,
+            clean=True,
+            deflate=True,
+            no_new_id=False,
+            preserve_metadata=True,
+            reproducible=True,
+        )
+    finally:
+        document.close()
+
+    _canonicalize_pdf_id(destination, f"sources/{source_id}.pdf")
+    _require_a4(destination)
+    with fitz.open(destination) as packaged:
+        text = packaged[0].get_text()
+        packaged_nonlabel_words = _words_outside(packaged[0], (header_rect, footer_rect))
+        metadata = packaged.metadata
+    if spec["removed_header"] in text or spec["removed_footer"] in text:
+        raise AssertionError(f"stale source label survived in {source_id}")
+    if spec["replacement_header"] not in text or spec["replacement_footer"] not in text:
+        raise AssertionError(f"shared source label missing in {source_id}")
+    if original_nonlabel_words != packaged_nonlabel_words:
+        raise AssertionError(f"non-label source glyphs changed in {source_id}")
+    if "unmarked" in (metadata.get("subject") or "").lower():
+        raise AssertionError(f"packaged metadata falsely asserts unmarked: {source_id}")
+    return {
+        "source_id": source_id,
+        "calibration_status": "development_source_reused_for_calibration_not_held_out",
+        "original_repo_path": spec["input"],
+        "original_sha256": spec["original_sha256"],
+        "changed_source_pdf": f"sources/{source_id}.pdf",
+        "changed_source_sha256": sha256_file(destination),
+        "named_source_label_packaging_change": {
+            "removed_header": spec["removed_header"],
+            "removed_footer": spec["removed_footer"],
+            "replacement_header": spec["replacement_header"],
+            "replacement_footer": spec["replacement_footer"],
+            "header_rect_points": spec["header_rect_points"],
+            "footer_rect_points": spec["footer_rect_points"],
+            "metadata_subject": metadata.get("subject"),
+            "embedded_font": {
+                "name": "Noto Sans Regular",
+                "sha256": FONT_SHA256,
+                "scope": "replacement header/footer only",
+            },
+        },
+        "preserved_nonlabel_word_count": len(packaged_nonlabel_words),
+        "page_points": list(PAGE_POINTS),
+    }
