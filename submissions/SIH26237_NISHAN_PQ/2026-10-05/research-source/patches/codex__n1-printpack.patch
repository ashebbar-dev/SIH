+            with self.assertRaises(FileExistsError):
+                build_pack.build_pack(existing)
+            self.assertEqual(sentinel.read_text(), "retain")
+
+            regenerated = root / "regenerated"
+            build_pack.build_pack(regenerated)
+            expected_inventory = inventory(PACK_ROOT)
+            regenerated_inventory = inventory(regenerated)
+            differing = {
