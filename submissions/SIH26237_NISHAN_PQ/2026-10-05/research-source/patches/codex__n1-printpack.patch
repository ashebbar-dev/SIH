+def _decode_clean_render(
+    source: Path,
+    marked: Path,
+    expected_word: np.ndarray,
+    scratch: Path,
+) -> dict[str, Any]:
+    direct_word, direct_correlations = tardos_carrier.decode_word(
+        source,
+        marked,
+        int(CARRIER["m"]),
+        FIXTURE_SECRET,
+        CARRIER_CONTEXT,
+        dpi=int(CARRIER["dpi"]),
+        block_size=int(CARRIER["block"]),
+    )
+    rendered = _render_rgb(marked)
+    rendered_path = scratch / f"{marked.stem}-clean-render-144.png"
+    _save_png(rendered_path, rendered)
+    render_word, render_correlations = tardos_carrier.decode_word(
+        source,
+        rendered_path,
+        int(CARRIER["m"]),
+        FIXTURE_SECRET,
+        CARRIER_CONTEXT,
+        dpi=int(CARRIER["dpi"]),
+        block_size=int(CARRIER["block"]),
+    )
+    direct_mismatches = int(np.count_nonzero(direct_word != expected_word))
+    render_mismatches = int(np.count_nonzero(render_word != expected_word))
+    if direct_mismatches or render_mismatches:
+        raise AssertionError(
+            f"original carrier decoder did not recover clean full codeword: "
+            f"direct={direct_mismatches}, render={render_mismatches}"
+        )
+    return {
+        "decoder": "nishan.tardos_carrier.decode_word",
+        "symbol_count": int(expected_word.size),
+        "direct_pdf_codeword_mismatches": direct_mismatches,
+        "clean_144dpi_render_codeword_mismatches": render_mismatches,
+        "direct_nonzero_correlations": int(np.count_nonzero(direct_correlations)),
+        "render_nonzero_correlations": int(np.count_nonzero(render_correlations)),
+        "clean_render_geometry": list(rendered.shape),
+        "clean_render_retained_in_pack": False,
+        "status": "full_codeword_recovered",
+    }
+
