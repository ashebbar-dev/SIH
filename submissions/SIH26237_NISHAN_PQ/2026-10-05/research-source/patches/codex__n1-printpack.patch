+CORE_CONTRIBUTORS = {"A1": 7, "B1": 29}
+
+COUPON_BLOCKS = (6, 12, 24)
+COUPON_TONES: tuple[tuple[str, int], ...] = (
+    ("black", 0),
+    ("gray", 128),
+    ("white", 255),
+)
+COUPON_X_PIXELS = (72, 408, 744)
+COUPON_Y_PIXELS = {6: 300, 12: 690, 24: 1080}
+COUPON_REGION_WIDTH = 312
+COUPON_REGION_HEIGHT = 288
+
+_PDF_ID = re.compile(
+    br"(/ID\s*\[\s*<)([0-9A-Fa-f]{32})(>\s*<)([0-9A-Fa-f]{32})(>\s*\])"
+)
+_FINAL_TRAILER = re.compile(
+    br"(trailer\s*<<)(.*?)(>>\s*startxref\s*\d+\s*%%EOF\s*)\Z", re.DOTALL
+)
+_SHA256 = re.compile(r"[0-9a-f]{64}")
+
+
+def _json_bytes(value: object) -> bytes:
+    return (
+        json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False, allow_nan=False)
+        + "\n"
+    ).encode("utf-8")
+
+
+def _canonical_json_bytes(value: object) -> bytes:
+    return json.dumps(
+        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+    ).encode("ascii")
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _write_json(path: Path, value: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("xb") as stream:
+        stream.write(_json_bytes(value))
+
+
+def _write_npy(path: Path, values: np.ndarray) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("xb") as stream:
+        np.save(stream, np.ascontiguousarray(values), allow_pickle=False)
+
+
+def _canonicalize_pdf_id(path: Path, identity: str) -> None:
+    """Replace only PyMuPDF's volatile trailer ID with a stable 16-byte ID."""
+
+    payload = Path(path).read_bytes()
+    stable = hashlib.sha256(
+        b"nishan.n1-pack/v2 deterministic PDF ID\x00" + identity.encode("utf-8")
+    ).hexdigest()[:32].upper().encode("ascii")
+
+    def replacement(match: re.Match[bytes]) -> bytes:
+        return match.group(1) + stable + match.group(3) + stable + match.group(5)
+
+    normalized, count = _PDF_ID.subn(replacement, payload)
+    # A repaired/incremental input can retain more than one trailer. Normalize
+    # every fixed-width ID; requiring exactly one would make a same-process
+    # regeneration depend on MuPDF's global repair/cache history.
+    if count == 0:
+        trailer = _FINAL_TRAILER.search(payload)
+        if trailer is None:
+            raise ValueError(f"cannot locate final PDF trailer in {path}")
+        fixed_id = b"/ID[<" + stable + b"><" + stable + b">]"
+        normalized = (
+            payload[: trailer.start(3)] + fixed_id + payload[trailer.start(3) :]
+        )
+    elif len(normalized) != len(payload):
+        raise ValueError(f"fixed-width PDF trailer normalization changed length in {path}")
+    Path(path).write_bytes(normalized)
+    with fitz.open(path) as document:
+        if not document.is_pdf or document.page_count != 1:
+            raise ValueError(f"canonicalized artifact is not a one-page PDF: {path}")
+
+
+def _pdf_page_points(path: Path) -> tuple[float, float]:
+    with fitz.open(path) as document:
+        if document.page_count != 1:
+            raise ValueError(f"expected one page: {path}")
+        rectangle = document[0].rect
+        return float(rectangle.width), float(rectangle.height)
+
+
+def _require_a4(path: Path) -> None:
+    width, height = _pdf_page_points(path)
+    if not (math.isclose(width, PAGE_POINTS[0], abs_tol=0.01) and math.isclose(height, PAGE_POINTS[1], abs_tol=0.01)):
+        raise ValueError(f"not the fixed 595 x 842 point A4 geometry: {path} ({width}, {height})")
+
+
+def _insert_packaging_font(page: fitz.Page) -> None:
+    if not FONT_FILE.is_file() or sha256_file(FONT_FILE) != FONT_SHA256:
+        raise FileNotFoundError(
+            "the deterministic Noto Sans font asset is missing or changed: "
+            f"expected {FONT_FILE} with SHA-256 {FONT_SHA256}"
+        )
+    page.insert_font(fontname=PDF_FONT_NAME, fontfile=str(FONT_FILE))
+
+
+def _words_outside(page: fitz.Page, rectangles: Iterable[fitz.Rect]) -> list[tuple[Any, ...]]:
+    regions = list(rectangles)
+    kept: list[tuple[Any, ...]] = []
+    for word in page.get_text("words"):
+        word_rect = fitz.Rect(word[:4])
+        if any(word_rect.intersects(region) for region in regions):
+            continue
+        kept.append(tuple(word[:5]))
+    return kept
+
