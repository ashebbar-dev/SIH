+def build_pack(output_directory: str | Path) -> dict[str, Any]:
+    """Exclusively create a complete pack and atomically publish the directory."""
+
+    output = Path(output_directory)
+    if output.exists():
+        raise FileExistsError(output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    temporary = Path(
+        tempfile.mkdtemp(prefix=f".{output.name}.building-", dir=output.parent)
+    )
+    try:
+        manifest = _build_into(temporary)
+        if output.exists():
+            raise FileExistsError(output)
+        temporary.rename(output)
+        return manifest
+    except BaseException:
+        shutil.rmtree(temporary, ignore_errors=True)
+        raise
+
+
+def _safe_relative(root: Path, value: object, label: str) -> Path:
+    if not isinstance(value, str) or not value or "\\" in value:
+        raise ValueError(f"{label} must be a nonempty portable relative path")
+    relative = Path(value)
+    if relative.is_absolute() or ".." in relative.parts or relative.as_posix() != value:
+        raise ValueError(f"{label} must be a normalized non-escaping relative path")
+    candidate = (root / relative).resolve()
+    try:
+        candidate.relative_to(root.resolve())
+    except ValueError as error:
+        raise ValueError(f"{label} escapes pack root") from error
+    return candidate
+
+
+def _require_hash(path: Path, expected: object, label: str) -> None:
+    if not isinstance(expected, str) or not _SHA256.fullmatch(expected):
+        raise ValueError(f"{label} has malformed SHA-256")
+    if not path.is_file():
+        raise FileNotFoundError(f"missing {label}: {path}")
+    actual = sha256_file(path)
+    if actual != expected:
+        raise ValueError(f"{label} SHA-256 mismatch: {actual} != {expected}")
+
+
+def _validate_carrier(carrier: object) -> dict[str, Any]:
+    if not isinstance(carrier, dict):
+        raise ValueError("carrier must be an object")
+    required = set(CARRIER)
+    missing = required - set(carrier)
+    if missing:
+        raise ValueError(f"carrier missing fields: {sorted(missing)}")
+    unsupported = set(carrier) - required
+    if unsupported:
+        raise ValueError(f"carrier has unsupported fields: {sorted(unsupported)}")
+    for key in ("n", "c", "m", "block", "dpi"):
+        if not isinstance(carrier[key], int) or isinstance(carrier[key], bool) or carrier[key] <= 0:
+            raise ValueError(f"carrier {key} must be a positive integer")
+    for key in ("strength", "epsilon"):
+        if not isinstance(carrier[key], (int, float)) or isinstance(carrier[key], bool):
+            raise ValueError(f"carrier {key} must be numeric")
+        if not math.isfinite(float(carrier[key])) or float(carrier[key]) <= 0:
+            raise ValueError(f"carrier {key} must be finite and positive")
+    for key, expected in CARRIER.items():
+        if carrier[key] != expected:
+            raise ValueError(
+                f"carrier {key} must equal fixed N1 invariant {expected!r}"
+            )
+    return carrier
+
+
+def _validate_public_fixture(
+    fixture_path: Path,
+    expected_hash: object,
+    carrier: dict[str, Any],
+    context: dict[str, Any],
+    manifest: dict[str, Any],
+) -> None:
+    _require_hash(fixture_path, expected_hash, "public fixture")
+    fixture = json.loads(fixture_path.read_text(encoding="utf-8"))
+    if not isinstance(fixture, dict) or fixture.get("schema") != "nishan.public-fixture/v1":
+        raise ValueError("wrong public fixture schema")
+    fixture_carrier = _validate_carrier(fixture.get("carrier"))
+    if fixture_carrier != carrier:
+        raise ValueError("public fixture carrier does not match manifest carrier")
+    resolved_context = dict(context)
+    resolved_secret_hex = resolved_context.get("fixture_secret_hex")
+    if resolved_secret_hex is None:
+        resolved_secret_hex = FIXTURE_SECRET.hex()
+        resolved_context["fixture_secret_hex"] = resolved_secret_hex
+    if fixture.get("context") != resolved_context:
+        raise ValueError("public fixture context does not match manifest context")
+    context_hash = hashlib.sha256(_canonical_json_bytes(resolved_context)).hexdigest()
+    if fixture.get("context_sha256") != context_hash:
+        raise ValueError("public fixture context SHA-256 does not match context")
+    declared_context_hash = manifest.get("context_sha256")
+    if declared_context_hash is not None and declared_context_hash != context_hash:
+        raise ValueError("manifest context SHA-256 does not match context")
+    if fixture.get("fixture_secret_hex") != resolved_secret_hex:
+        raise ValueError("public fixture secret does not match manifest context")
+    declared_seed_hash = manifest.get("fixture_seed_sha256")
+    if declared_seed_hash is not None:
+        actual_seed_hash = hashlib.sha256(bytes.fromhex(resolved_secret_hex)).hexdigest()
+        if declared_seed_hash != actual_seed_hash:
+            raise ValueError("manifest fixture seed SHA-256 does not match fixture secret")
+        if fixture.get("fixture_secret_sha256") != actual_seed_hash:
+            raise ValueError("public fixture seed SHA-256 does not match fixture secret")
+    commitment = fixture.get("tardos_commitment")
+    parameters = commitment.get("parameters") if isinstance(commitment, dict) else None
+    if not isinstance(parameters, dict):
+        raise ValueError("public fixture Tardos commitment is missing parameters")
+    expected_parameters = {
+        "roster_size": carrier["n"],
+        "coalition_limit": carrier["c"],
+        "code_length": carrier["m"],
+        "familywise_epsilon": carrier["epsilon"],
+    }
+    for key, expected in expected_parameters.items():
+        if parameters.get(key) != expected:
+            raise ValueError(f"public fixture Tardos {key} does not match carrier")
+    if commitment.get("codebook_shape") != [carrier["n"], carrier["m"]]:
+        raise ValueError("public fixture codebook shape does not match carrier")
+
+
+def _validate_visual_qa(
+    qa_path: Path,
+    expected_hash: object,
+    sheet_hashes: dict[str, str],
+) -> None:
+    _require_hash(qa_path, expected_hash, "visual QA")
+    qa = json.loads(qa_path.read_text(encoding="utf-8"))
+    if not isinstance(qa, dict) or qa.get("schema") != "nishan.n1-pack-visual-qa/v1":
+        raise ValueError("wrong visual QA schema")
+    if qa.get("status") != "passed":
+        raise ValueError("visual QA status must be passed")
+    for key in ("reviewed_pdf_sha256", "actual_pdf_sha256"):
+        value = qa.get(key)
+        if value != sheet_hashes:
+            raise ValueError(f"visual QA {key} does not match current sheet hashes")
+    records = qa.get("sheets")
+    if not isinstance(records, dict) or set(records) != set(sheet_hashes):
+        raise ValueError("visual QA must map every current sheet exactly once")
+    for sheet_id, expected_sheet_hash in sheet_hashes.items():
+        record = records.get(sheet_id)
+        if not isinstance(record, dict):
+            raise ValueError(f"visual QA record is invalid for {sheet_id}")
+        if record.get("status") != "passed":
+            raise ValueError(f"visual QA sheet status must be passed for {sheet_id}")
+        if record.get("reviewed_hash_matches") is not True:
+            raise ValueError(f"visual QA reviewed hash must match for {sheet_id}")
+        if record.get("reviewed_pdf_sha256") != expected_sheet_hash:
+            raise ValueError(f"visual QA reviewed PDF hash is stale for {sheet_id}")
+        if record.get("actual_pdf_sha256") != expected_sheet_hash:
+            raise ValueError(f"visual QA actual PDF hash is stale for {sheet_id}")
+        if record.get("labels_truthful") != "passed":
+            raise ValueError(f"visual QA label review must be passed for {sheet_id}")
+        if record.get("legibility") != "passed":
+            raise ValueError(f"visual QA legibility review must be passed for {sheet_id}")
+        if set(sheet_hashes) == {"A0", "A1", "B0", "B1", "C0", "C1"}:
+            inherited_fixture = sheet_id[0] in {"A", "B"}
+            expected_clipping = (
+                "no_new_clipping_observed_relative_to_frozen_source"
+                if inherited_fixture
+                else "none_observed_in_pdf_render"
+            )
+            expected_overlap = (
+                "no_new_overlap_observed_relative_to_frozen_source"
+                if inherited_fixture
+                else "none_observed"
+            )
+            if record.get("clipping") != expected_clipping:
+                raise ValueError(
+                    f"visual QA clipping observation is not approved for {sheet_id}"
+                )
+            if record.get("overlap") != expected_overlap:
+                raise ValueError(
+                    f"visual QA overlap observation is not approved for {sheet_id}"
+                )
+        else:
+            if record.get("clipping") not in {
+                "no_new_clipping_observed_relative_to_frozen_source",
+                "none_observed_in_pdf_render",
+            }:
+                raise ValueError(
+                    f"visual QA clipping observation is not approved for {sheet_id}"
+                )
+            if record.get("overlap") not in {
+                "no_new_overlap_observed_relative_to_frozen_source",
+                "none_observed",
+            }:
+                raise ValueError(
+                    f"visual QA overlap observation is not approved for {sheet_id}"
+                )
+
+
+def _validate_coupon_descriptor(descriptor_path: Path, expected_hash: str) -> None:
+    _require_hash(descriptor_path, expected_hash, "coupon descriptor")
+    descriptor = json.loads(descriptor_path.read_text(encoding="utf-8"))
+    if descriptor.get("schema") != COUPON_SCHEMA:
+        raise ValueError("wrong coupon descriptor schema")
+    if descriptor.get("sheet_id") != "C1" or descriptor.get("control_sheet_id") != "C0":
+        raise ValueError("coupon sheet/control IDs changed")
+    base = descriptor_path.parent
+    reference = descriptor.get("reference_image")
+    if not isinstance(reference, dict) or reference.get("dpi") != 144:
+        raise ValueError("coupon reference image is missing fixed 144-dpi metadata")
+    reference_path = _safe_relative(base, reference.get("path"), "coupon reference image")
+    _require_hash(reference_path, reference.get("sha256"), "coupon reference image")
+    if [reference.get("width"), reference.get("height")] != list(PAGE_PIXELS_144):
+        raise ValueError("coupon reference image geometry changed")
+    regions = descriptor.get("regions")
+    if not isinstance(regions, list) or len(regions) != 9:
+        raise ValueError("coupon descriptor must contain nine regions")
+    combinations: set[tuple[int, str]] = set()
+    for region in regions:
+        if not isinstance(region, dict):
+            raise ValueError("coupon region must be an object")
+        bbox = region.get("reference_bbox_px_144")
+        if (
+            not isinstance(bbox, list)
+            or len(bbox) != 4
+            or not all(isinstance(value, int) for value in bbox)
+        ):
+            raise ValueError("coupon region bbox must be four integers")
+        x0, y0, x1, y1 = bbox
+        if not (0 <= x0 < x1 <= PAGE_PIXELS_144[0] and 0 <= y0 < y1 <= PAGE_PIXELS_144[1]):
+            raise ValueError("coupon region bbox is outside reference image")
+        block = region.get("block_px")
+        tone = region.get("source_tone")
+        if block not in COUPON_BLOCKS or not isinstance(tone, dict):
+            raise ValueError("coupon block/tone is invalid")
+        tone_name = tone.get("name")
+        combinations.add((block, tone_name))
+        if float(region.get("strength", -1)) != 4.0:
+            raise ValueError("coupon strength changed")
+        if region.get("delta_template_dtype") != "int16":
+            raise ValueError("coupon delta template dtype changed")
+        expected_shape = [y1 - y0, x1 - x0, 3]
+        if region.get("delta_template_shape") != expected_shape:
+            raise ValueError("coupon delta template shape does not match bbox")
+        template_path = _safe_relative(
+            base, region.get("delta_template_path"), f"coupon {region.get('region_id')} template"
+        )
+        _require_hash(
+            template_path,
+            region.get("delta_template_sha256"),
+            f"coupon {region.get('region_id')} template",
+        )
+        template = np.load(template_path, allow_pickle=False)
+        if template.dtype != np.int16 or list(template.shape) != expected_shape:
+            raise ValueError("coupon delta template array metadata mismatch")
+        if not np.any(template):
+            raise ValueError("coupon delta template is degenerate/zero")
+    expected_combinations = {
+        (block, tone) for block in COUPON_BLOCKS for tone, _ in COUPON_TONES
+    }
+    if combinations != expected_combinations:
+        raise ValueError("coupon block/tone cross-product changed")
+    anchor_ids = {
+        anchor.get("anchor_id") for anchor in descriptor.get("geometry_anchors", [])
+        if isinstance(anchor, dict)
+    }
+    required_anchors = {
+        "canon-normal-printable-area",
+        "scale-bar-100mm",
+        "square-20mm",
+        "lower-crosshair",
+        "page-crosshairs",
+    }
+    if not required_anchors <= anchor_ids:
+        raise ValueError("coupon geometry anchors incomplete")
+
+
+def validate_manifest(pack_root: str | Path, manifest: dict[str, Any]) -> dict[str, Any]:
+    """Validate one pack without assuming calibration IDs for other splits."""
+
+    root = Path(pack_root)
+    if manifest.get("schema") != PACK_SCHEMA:
+        raise ValueError("wrong pack manifest schema")
+    split = manifest.get("split")
+    if split not in {"calibration", "validation", "heldout"}:
+        raise ValueError("unsupported pack split")
+    carrier = _validate_carrier(manifest.get("carrier"))
+    context = manifest.get("context")
+    if not isinstance(context, dict):
+        raise ValueError("context must be an object")
+    secret_hex = context.get("fixture_secret_hex")
+    if secret_hex is not None and not re.fullmatch(r"[0-9a-fA-F]{64}", secret_hex):
+        raise ValueError("fixture_secret_hex must contain exactly 64 hexadecimal characters")
+
+    public_fixture_declared = (
+        "public_fixture_file" in manifest or "public_fixture_sha256" in manifest
+    )
+    if split == "calibration" and not public_fixture_declared:
+        raise ValueError("calibration pack requires a hash-bound public fixture")
+    if public_fixture_declared:
+        fixture_path = _safe_relative(
+            root, manifest.get("public_fixture_file"), "public fixture"
+        )
+        _validate_public_fixture(
+            fixture_path,
+            manifest.get("public_fixture_sha256"),
+            carrier,
+            context,
+            manifest,
+        )
+
+    sheets = manifest.get("sheets")
+    if not isinstance(sheets, list) or not sheets:
+        raise ValueError("manifest sheets must be a nonempty list")
+    ids: set[str] = set()
+    pdf_paths: set[str] = set()
+    sheet_hashes: dict[str, str] = {}
+    allowed_kinds = {"unmarked", "marked", "coupon_unmarked", "coupon_marked"}
+    for sheet in sheets:
+        if not isinstance(sheet, dict):
+            raise ValueError("sheet records must be objects")
+        sheet_id = sheet.get("sheet_id")
+        if not isinstance(sheet_id, str) or not sheet_id or sheet_id in ids:
+            raise ValueError("sheet IDs must be unique nonempty strings")
+        ids.add(sheet_id)
+        if sheet.get("kind") not in allowed_kinds:
+            raise ValueError(f"unsupported sheet kind: {sheet.get('kind')}")
+        pdf_value = sheet.get("pdf")
+        if pdf_value in pdf_paths:
+            raise ValueError("sheet PDF paths must be unique")
+        pdf_paths.add(pdf_value)
+        pdf_path = _safe_relative(root, pdf_value, f"sheet {sheet_id} PDF")
+        source_path = _safe_relative(
+            root, sheet.get("source_pdf"), f"sheet {sheet_id} source"
+        )
+        _require_hash(pdf_path, sheet.get("sha256"), f"sheet {sheet_id} PDF")
+        _require_hash(source_path, sheet.get("source_sha256"), f"sheet {sheet_id} source")
+        sheet_hashes[sheet_id] = sheet["sha256"]
+        _require_a4(pdf_path)
+        _require_a4(source_path)
+        if sheet.get("kind") == "marked":
+            capacity = tardos_carrier.capacity(
+                source_path, dpi=int(carrier["dpi"]), block_size=int(carrier["block"])
+            )
+            if capacity < carrier["m"]:
+                raise ValueError(
+                    f"sheet {sheet_id} source capacity {capacity} is below m={carrier['m']}"
+                )
+        if {"contributors", "expected_rows", "attack"} & set(sheet):
+            raise ValueError("evaluation labels leaked into sheet manifest")
+
+    if split == "calibration" and ids != {"A0", "A1", "B0", "B1", "C0", "C1"}:
+        raise ValueError("calibration split requires the fixed six sheet IDs")
+
+    labels_path = _safe_relative(root, manifest.get("labels_file"), "labels file")
+    _require_hash(labels_path, manifest.get("labels_sha256"), "labels file")
+    label_sheets = json.loads(labels_path.read_text(encoding="utf-8"))
+    if not isinstance(label_sheets, dict) or set(label_sheets) != ids:
+        raise ValueError("evaluation labels must map every sheet ID exactly once")
+    allowed_attacks = {
+        "single", "average_2", "average_5", "interleave_5", "unmarked", "diagnostic"
+    }
+    for sheet_id, label in label_sheets.items():
+        if not isinstance(label, dict) or label.get("attack") not in allowed_attacks:
+            raise ValueError(f"invalid evaluator label for {sheet_id}")
+        contributors = label.get("contributors")
+        if (
+            not isinstance(contributors, list)
+            or contributors != sorted(set(contributors))
+            or any(
+                not isinstance(row, int) or isinstance(row, bool) or not 0 <= row < carrier["n"]
+                for row in contributors
+            )
+        ):
+            raise ValueError(f"invalid contributors for {sheet_id}")
+
+    for file_key, hash_key in (
+        ("guide_file", "guide_sha256"),
+        ("clean_qa_file", "clean_qa_sha256"),
+    ):
+        if file_key in manifest or hash_key in manifest:
+            path = _safe_relative(root, manifest.get(file_key), file_key)
+            _require_hash(path, manifest.get(hash_key), file_key)
+
+    visual_qa_declared = "visual_qa_file" in manifest or "visual_qa_sha256" in manifest
+    if split == "calibration" and not visual_qa_declared:
+        raise ValueError("calibration pack requires hash-bound visual QA")
+    if visual_qa_declared:
+        visual_qa_path = _safe_relative(
+            root, manifest.get("visual_qa_file"), "visual QA file"
+        )
+        _validate_visual_qa(
+            visual_qa_path,
+            manifest.get("visual_qa_sha256"),
+            sheet_hashes,
+        )
+
+    if split == "calibration":
+        descriptor_path = _safe_relative(
+            root, manifest.get("coupon_regions_file"), "coupon descriptor"
+        )
+        _validate_coupon_descriptor(
+            descriptor_path, manifest.get("coupon_regions_sha256")
+        )
+
+    artifacts = manifest.get("artifacts")
+    if not isinstance(artifacts, list) or not artifacts:
+        raise ValueError("manifest artifact inventory is missing")
+    inventory_paths: set[str] = set()
+    for artifact in artifacts:
+        if not isinstance(artifact, dict):
+            raise ValueError("artifact inventory records must be objects")
+        value = artifact.get("path")
+        if value in inventory_paths:
+            raise ValueError("duplicate artifact inventory path")
+        inventory_paths.add(value)
+        path = _safe_relative(root, value, "artifact inventory path")
+        _require_hash(path, artifact.get("sha256"), f"artifact {value}")
+        if path.stat().st_size != artifact.get("bytes"):
+            raise ValueError(f"artifact byte size mismatch: {value}")
+    actual_paths = {
+        path.relative_to(root).as_posix()
+        for path in root.rglob("*")
+        if path.is_file() and path.name != "manifest.json"
+    }
+    if inventory_paths != actual_paths:
+        raise ValueError("artifact inventory does not exactly cover pack files")
+    return manifest
+
+
+def validate_pack(pack_root: str | Path) -> dict[str, Any]:
+    root = Path(pack_root)
+    manifest_path = root / "manifest.json"
+    if not manifest_path.is_file():
+        raise FileNotFoundError(manifest_path)
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    return validate_manifest(root, manifest)
+
+
+def _parse_args(argv: list[str] | None = None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    action = parser.add_mutually_exclusive_group(required=True)
+    action.add_argument("--output", type=Path, help="new exclusive output directory")
+    action.add_argument("--verify", type=Path, help="existing pack directory to verify")
+    return parser.parse_args(argv)
+
+
+def main(argv: list[str] | None = None) -> int:
+    arguments = _parse_args(argv)
+    if arguments.output is not None:
+        manifest = build_pack(arguments.output)
+        print(
+            json.dumps(
+                {
+                    "status": "created",
+                    "pack": str(arguments.output),
+                    "manifest_sha256": sha256_file(arguments.output / "manifest.json"),
+                    "sheet_count": len(manifest["sheets"]),
+                    "peak_rss_kib": int(
+                        resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+                    ),
+                },
+                sort_keys=True,
+            )
+        )
+    else:
+        manifest = validate_pack(arguments.verify)
+        print(
+            json.dumps(
+                {
+                    "status": "verified",
+                    "pack": str(arguments.verify),
+                    "manifest_sha256": sha256_file(arguments.verify / "manifest.json"),
+                    "sheet_count": len(manifest["sheets"]),
+                },
+                sort_keys=True,
+            )
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
