+
+    shutil.copyfile(pack_root / "sources" / "cal-c.pdf", pack_root / "sheets" / "C0.pdf")
+    coupon_pattern_hashes = _create_coupon_signal(
+        pack_root / "sources" / "cal-c.pdf", pack_root / "sheets" / "C1.pdf"
