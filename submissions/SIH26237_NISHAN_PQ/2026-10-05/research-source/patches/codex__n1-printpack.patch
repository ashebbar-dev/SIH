+                visual[key] = {
+                    rename[sheet_id]: value
+                    for sheet_id, value in visual[key].items()
+                }
+            visual["sheets"] = {
+                rename[sheet_id]: value
+                for sheet_id, value in visual["sheets"].items()
+            }
+            visual_path.write_bytes(build_pack._json_bytes(visual))
