+                with self.subTest(field=field, value=value, remove=remove):
+                    manifest = copy.deepcopy(self.pack)
+                    qa = copy.deepcopy(source_qa)
+                    if remove:
+                        qa["sheets"]["A0"].pop(field)
+                    else:
+                        qa["sheets"]["A0"][field] = value
+                    qa_path = copied / manifest["visual_qa_file"]
+                    qa_path.write_bytes(build_pack._json_bytes(qa))
+                    refresh_artifact_hash(
+                        copied,
+                        manifest,
+                        manifest["visual_qa_file"],
+                        "visual_qa_sha256",
+                    )
+                    (copied / "manifest.json").write_bytes(
+                        build_pack._json_bytes(manifest)
+                    )
+                    with self.assertRaisesRegex(
+                        ValueError,
+                        rf"visual QA {field} observation is not approved for A0",
+                    ):
+                        build_pack.validate_pack(copied)
+
+    def test_validator_does_not_impose_calibration_ids_on_other_splits(self):
+        with tempfile.TemporaryDirectory() as directory:
+            copied = Path(directory) / "validation-pack"
+            shutil.copytree(PACK_ROOT, copied)
+            manifest = json.loads((copied / "manifest.json").read_text())
+            manifest["split"] = "validation"
+            rename = {old: f"V{index:02d}" for index, old in enumerate(sorted(self.sheets))}
+            for sheet in manifest["sheets"]:
+                sheet["sheet_id"] = rename[sheet["sheet_id"]]
+            labels_path = copied / manifest["labels_file"]
+            labels = json.loads(labels_path.read_text())
+            labels = {rename[sheet_id]: value for sheet_id, value in labels.items()}
+            labels_path.write_bytes(build_pack._json_bytes(labels))
