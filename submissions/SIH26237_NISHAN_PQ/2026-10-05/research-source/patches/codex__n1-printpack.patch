+    coupon_source = _create_coupon_source(pack_root / "sources" / "cal-c.pdf")
+    source_provenance.append(coupon_source)
+
+    config = tardos.parameters(
+        int(CARRIER["n"]), int(CARRIER["c"]), float(CARRIER["epsilon"])
+    )
+    if (
+        config.roster_size != CARRIER["n"]
+        or config.coalition_limit != CARRIER["c"]
+        or config.code_length != CARRIER["m"]
+        or config.familywise_epsilon != CARRIER["epsilon"]
+    ):
+        raise AssertionError("existing Tardos parameter implementation changed the N1 profile")
+    biases, codebook = tardos.generate_keyed(
+        config, FIXTURE_SECRET, CODEBOOK_CONTEXT, row_chunk=32
+    )
+    if codebook.shape != (CARRIER["n"], CARRIER["m"]):
+        raise AssertionError(f"wrong public fixture roster shape: {codebook.shape}")
+
+    fixture = _public_fixture(config, biases, codebook)
+    _write_json(pack_root / "public_fixture.json", fixture)
