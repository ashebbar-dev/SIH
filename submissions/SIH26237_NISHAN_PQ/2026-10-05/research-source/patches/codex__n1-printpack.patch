+def _fixed_coupon_pattern(block_px: int) -> np.ndarray:
+    if COUPON_REGION_WIDTH % block_px or COUPON_REGION_HEIGHT % block_px:
+        raise ValueError("coupon region must be an integer number of blocks")
+    rows = COUPON_REGION_HEIGHT // block_px
+    columns = COUPON_REGION_WIDTH // block_px
+    templates = tardos_carrier._templates(block_px)
+    pattern = np.empty((COUPON_REGION_HEIGHT, COUPON_REGION_WIDTH), dtype=np.float32)
+    for row in range(rows):
+        for column in range(columns):
+            orientation = (row + 2 * column + block_px // 6) % 2
+            sign = 1 if ((3 * row + 5 * column + block_px // 6) % 7) < 4 else -1
+            y0 = row * block_px
+            x0 = column * block_px
+            pattern[y0 : y0 + block_px, x0 : x0 + block_px] = (
+                sign * templates[orientation]
+            )
+    return pattern
+
+
+def _create_coupon_signal(source: Path, destination: Path) -> dict[int, str]:
+    document = fitz.open(source)
+    pattern_hashes: dict[int, str] = {}
+    try:
+        page = document[0]
+        for block_px in COUPON_BLOCKS:
+            pattern = _fixed_coupon_pattern(block_px)
+            pattern_hashes[block_px] = hashlib.sha256(
+                np.ascontiguousarray(pattern, dtype=np.int8).tobytes()
+            ).hexdigest()
+            overlay = tardos_carrier._transparent_overlay(
+                pattern, float(CARRIER["strength"])
+            )
+            y0_px = COUPON_Y_PIXELS[block_px]
+            for x0_px in COUPON_X_PIXELS:
+                rectangle = fitz.Rect(
+                    x0_px / 2.0,
+                    y0_px / 2.0,
+                    (x0_px + COUPON_REGION_WIDTH) / 2.0,
+                    (y0_px + COUPON_REGION_HEIGHT) / 2.0,
+                )
+                page.insert_image(
+                    rectangle,
+                    stream=overlay,
+                    overlay=True,
+                    keep_proportion=False,
+                )
+        document.save(destination, garbage=0, clean=False, deflate=True)
+    finally:
+        document.close()
+    _canonicalize_pdf_id(destination, "sheets/C1.pdf")
+    _require_a4(destination)
+    pair = tardos_carrier.measure_pdf_pair(source, destination, dpi=144)
+    if not pair.text_preserved:
+        raise AssertionError("coupon signal overlay changed PDF text")
+    return pattern_hashes
