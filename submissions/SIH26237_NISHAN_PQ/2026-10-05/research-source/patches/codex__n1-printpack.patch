+def _visual_qa_payload(
+    pack_root: Path,
+    reviewed_hashes: dict[str, str] | None = None,
+) -> dict[str, Any]:
+    reviewed = REVIEWED_SHEET_SHA256 if reviewed_hashes is None else reviewed_hashes
+    sheet_ids = {sheet["sheet_id"] for sheet in SHEET_SPECS}
+    if set(reviewed) != sheet_ids:
+        raise ValueError("reviewed visual-QA hashes must cover every sheet exactly once")
+    actual = {
+        sheet_id: sha256_file(pack_root / "sheets" / f"{sheet_id}.pdf")
+        for sheet_id in sorted(sheet_ids)
+    }
+    payload = copy.deepcopy(VISUAL_QA_TEMPLATE)
+    payload["review_policy"] = (
+        "passed only when every generated sheet SHA-256 equals the manually inspected PDF SHA-256"
+    )
+    payload["reviewed_pdf_sha256"] = dict(sorted(reviewed.items()))
+    payload["actual_pdf_sha256"] = actual
+    payload["status"] = "passed" if actual == reviewed else "needs_visual_review"
+    for sheet_id, record in payload["sheets"].items():
+        matched = actual[sheet_id] == reviewed[sheet_id]
+        record["reviewed_pdf_sha256"] = reviewed[sheet_id]
+        record["actual_pdf_sha256"] = actual[sheet_id]
+        record["reviewed_hash_matches"] = matched
+        record["status"] = "passed" if matched else "needs_visual_review"
+        record["labels_truthful"] = "passed" if matched else "needs_visual_review"
+        record["legibility"] = "passed" if matched else "needs_visual_review"
+        if not matched:
+            record["clipping"] = "needs_visual_review"
+            record["overlap"] = "needs_visual_review"
+            record["observation"] = (
+                "Generated PDF bytes differ from the inspected artifact; prior manual "
+                "observations do not carry forward."
+            )
+    return payload
+
