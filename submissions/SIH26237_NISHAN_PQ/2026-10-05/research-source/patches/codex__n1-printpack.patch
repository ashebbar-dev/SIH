+def _write_coupon_descriptor(
+    pack_root: Path,
+    source_record: dict[str, Any],
+    pattern_hashes: dict[int, str],
+) -> tuple[dict[str, Any], dict[str, Any]]:
+    diagnostics = pack_root / "diagnostics"
+    reference = _render_rgb(pack_root / "sheets" / "C0.pdf")
+    signal = _render_rgb(pack_root / "sheets" / "C1.pdf")
+    reference_path = diagnostics / "coupon_reference_144.png"
+    _save_png(reference_path, reference)
+
+    regions: list[dict[str, Any]] = []
+    for region in source_record["regions"]:
+        x0, y0, x1, y1 = region["reference_bbox_px_144"]
+        delta = signal[y0:y1, x0:x1].astype(np.int16) - reference[
+            y0:y1, x0:x1
+        ].astype(np.int16)
+        relative_template = Path("templates") / f"{region['region_id']}.npy"
+        template_path = diagnostics / relative_template
+        _write_npy(template_path, delta)
+        regions.append(
