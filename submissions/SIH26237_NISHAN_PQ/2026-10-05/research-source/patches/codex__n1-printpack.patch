+    for control_id, source_id in (("A0", "cal-a"), ("B0", "cal-b")):
+        shutil.copyfile(
+            pack_root / "sources" / f"{source_id}.pdf",
+            pack_root / "sheets" / f"{control_id}.pdf",
+        )
+
+    embedding_metrics: dict[str, Any] = {}
+    for sheet_id, source_id in (("A1", "cal-a"), ("B1", "cal-b")):
+        embedding_metrics[sheet_id] = _embed_core_sheet(
+            pack_root / "sources" / f"{source_id}.pdf",
+            pack_root / "sheets" / f"{sheet_id}.pdf",
+            codebook[CORE_CONTRIBUTORS[sheet_id]],
+            f"sheets/{sheet_id}.pdf",
