+def _render_rgb(path: Path) -> np.ndarray:
+    pages, _ = watermark.load_pages(path, dpi=144)
+    if len(pages) != 1 or pages[0].shape != (1684, 1190, 3):
+        raise ValueError(f"unexpected 144-dpi A4 render geometry for {path}: {[p.shape for p in pages]}")
+    return np.asarray(pages[0], dtype=np.uint8)
