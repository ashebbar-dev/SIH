+def digest(path: Path) -> str:
+    value = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            value.update(chunk)
+    return value.hexdigest()
+
+
+def inventory(root: Path) -> dict[str, str]:
+    return {
+        path.relative_to(root).as_posix(): digest(path)
+        for path in sorted(root.rglob("*"))
+        if path.is_file()
+    }
+
+
+def refresh_artifact_hash(
+    root: Path,
+    manifest: dict,
+    relative: str,
+    manifest_hash_key: str | None = None,
+) -> str:
+    path = root / relative
+    updated_hash = digest(path)
+    if manifest_hash_key is not None:
+        manifest[manifest_hash_key] = updated_hash
+    matching = [item for item in manifest["artifacts"] if item["path"] == relative]
+    if len(matching) != 1:
+        raise AssertionError(f"expected one artifact record for {relative}")
+    matching[0]["sha256"] = updated_hash
+    matching[0]["bytes"] = path.stat().st_size
+    return updated_hash
