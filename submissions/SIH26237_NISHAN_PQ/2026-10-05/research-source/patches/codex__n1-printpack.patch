+                for path in sorted(expected_inventory.keys() | regenerated_inventory.keys())
+                if expected_inventory.get(path) != regenerated_inventory.get(path)
+            }
+            self.assertEqual(differing, {})
+
+    def test_visual_qa_is_complete_for_every_final_sheet(self):
