+def _carrier_margin_analysis() -> dict[str, Any]:
+    width, height = PAGE_PIXELS_144
+    block = int(CARRIER["block"])
+    rows = height // block
+    columns = width // block
+    capacity = rows * columns
+    order, _, _ = tardos_carrier._plan(
+        FIXTURE_SECRET, CARRIER_CONTEXT, capacity, int(CARRIER["m"])
+    )
+    margin_left = CANON_PRINTABLE_AREA["margin_left_mm"] * CARRIER["dpi"] / 25.4
+    margin_right = CANON_PRINTABLE_AREA["margin_right_mm"] * CARRIER["dpi"] / 25.4
+    margin_top = CANON_PRINTABLE_AREA["margin_top_mm"] * CARRIER["dpi"] / 25.4
+    margin_bottom = CANON_PRINTABLE_AREA["margin_bottom_mm"] * CARRIER["dpi"] / 25.4
+    printable_right = width - margin_right
+    printable_bottom = height - margin_bottom
+
+    by_edge = {"left": 0, "right": 0, "top": 0, "bottom": 0}
+    at_risk = 0
+    for position in order:
+        row = int(position) // columns
+        column = int(position) % columns
+        x0 = column * block
+        y0 = row * block
+        x1 = x0 + block
+        y1 = y0 + block
+        edges = {
+            "left": x0 < margin_left,
+            "right": x1 > printable_right,
+            "top": y0 < margin_top,
+            "bottom": y1 > printable_bottom,
+        }
+        if any(edges.values()):
+            at_risk += 1
+        for name, affected in edges.items():
+            by_edge[name] += int(affected)
+
+    return {
+        "status": "normal_printer_margin_loss_expected_and_not_compensated",
+        "source": CANON_PRINTABLE_AREA["source"],
+        "page_pixels_144": [width, height],
+        "carrier_pattern_extent_px_144": [0, 0, columns * block, rows * block],
+        "rendered_capacity_blocks": capacity,
+        "embedded_symbols": int(CARRIER["m"]),
+        "printable_bounds_px_144": [
+            margin_left,
+            margin_top,
+            printable_right,
+            printable_bottom,
+        ],
+        "selected_symbols_intersecting_nominal_unprintable_margin": at_risk,
+        "selected_symbols_fully_inside_nominal_printable_area": int(CARRIER["m"]) - at_risk,
+        "edge_intersections_nonexclusive": by_edge,
+        "geometry_transform": "none",
+        "scale_percent": 100,
+        "fit_to_page": False,
+        "borderless": False,
+        "carrier_shrunk_or_reflowed": False,
+        "interpretation": (
+            "The unchanged full-page carrier reaches Canon's normal margins. Physical clipping is measured; "
+            "the pack does not shrink geometry or change strength to avoid it."
+        ),
+    }
+
+
+def _public_fixture(
+    config: tardos.Parameters,
+    biases: np.ndarray,
+    codebook: np.ndarray,
+) -> dict[str, Any]:
+    implementation = tardos.manifest(config, biases, codebook)
+    context_hash = hashlib.sha256(_canonical_json_bytes(CONTEXT)).hexdigest()
+    seed_hash = hashlib.sha256(FIXTURE_SECRET).hexdigest()
+    return {
+        "schema": "nishan.public-fixture/v1",
+        "kind": "public_synthetic_test_material_not_production_security_credentials",
+        "fixture_secret_description": "sha3_256(b'NISHAN Tardos carrier public fixture v1')",
+        "fixture_secret_hex": FIXTURE_SECRET.hex(),
+        "fixture_secret_sha256": seed_hash,
+        "context": CONTEXT,
+        "context_sha256": context_hash,
+        "carrier": CARRIER,
+        "tardos_commitment": implementation,
+        "same_seed_usage": [
+            "bias-only generation",
+            "full roster generation",
+            "carrier block geometry and templates",
+        ],
+        "warning": (
+            "Public deterministic calibration identifiers do not provide production secrecy and do not "
+            "certify a real-world 1e-6 false-attribution rate."
+        ),
+    }
+
