+def _build_into(pack_root: Path) -> dict[str, Any]:
+    cv2.setNumThreads(2)
+    (pack_root / "sheets").mkdir(parents=True, exist_ok=False)
+    (pack_root / "sources").mkdir(exist_ok=False)
+    (pack_root / "diagnostics" / "templates").mkdir(parents=True, exist_ok=False)
+    (pack_root / "qa").mkdir(exist_ok=False)
+    shutil.copyfile(
+        ROOT / "research" / "n1_v2" / "PRINTING.md", pack_root / "PRINTING.md"
+    )
+
+    source_provenance = [
+        _package_core_source(source_id, pack_root / "sources" / f"{source_id}.pdf")
+        for source_id in ("cal-a", "cal-b")
