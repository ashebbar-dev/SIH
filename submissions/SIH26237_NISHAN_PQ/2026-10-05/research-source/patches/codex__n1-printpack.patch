+        "a4_geometry": {
+            sheet["sheet_id"]: list(
+                _pdf_page_points(pack_root / "sheets" / f"{sheet['sheet_id']}.pdf")
+            )
+            for sheet in SHEET_SPECS
+        },
+        "truthful_packaging": {
+            "marked_sheets_have_no_unmarked_text_or_metadata_claim": True,
+            "source_label_changes_precede_embedding": True,
+            "no_post_embedding_identity_marks": True,
+        },
+        "physical_status": "pending_12_original_poco_photos",
+    }
+    _write_json(pack_root / "qa" / "clean_checks.json", machine_qa)
+
+    provenance_by_id = {item["source_id"]: item for item in source_provenance}
+    sheets: list[dict[str, Any]] = []
+    for sheet in SHEET_SPECS:
+        sheet_id = sheet["sheet_id"]
+        source_id = sheet["source_id"]
+        pdf_relative = f"sheets/{sheet_id}.pdf"
+        source_relative = f"sources/{source_id}.pdf"
+        source_path = pack_root / source_relative
+        record: dict[str, Any] = {
+            "sheet_id": sheet_id,
+            "kind": sheet["kind"],
+            "source_id": source_id,
+            "pdf": pdf_relative,
+            "sha256": sha256_file(pack_root / pdf_relative),
+            "source_pdf": source_relative,
+            "source_sha256": sha256_file(source_path),
+            "pair_id": sheet["pair_id"],
+            "page_points": list(PAGE_POINTS),
+        }
+        if source_id in SOURCE_SPECS:
+            record["original_source_sha256"] = provenance_by_id[source_id][
+                "original_sha256"
+            ]
+            record["carrier_scope"] = (
+                "unchanged_full_profile" if sheet["kind"] == "marked" else "source_control"
+            )
+        else:
+            record["carrier_scope"] = "diagnostic_coupon_not_full_profile"
+        sheets.append(record)
+
+    context_hash = hashlib.sha256(_canonical_json_bytes(CONTEXT)).hexdigest()
+    manifest = {
+        "schema": PACK_SCHEMA,
+        "pack_id": PACK_ID,
+        "split": "calibration",
+        "carrier": CARRIER,
+        "context": CONTEXT,
+        "context_sha256": context_hash,
+        "fixture_seed_sha256": hashlib.sha256(FIXTURE_SECRET).hexdigest(),
+        "sheets": sheets,
+        "labels_file": "evaluation_labels.json",
+        "labels_sha256": sha256_file(pack_root / "evaluation_labels.json"),
+        "labels_format": "plain_sheet_id_mapping_evaluator_only",
+        "public_fixture_file": "public_fixture.json",
+        "public_fixture_sha256": sha256_file(pack_root / "public_fixture.json"),
+        "coupon_regions_file": coupon_summary["coupon_regions_file"],
+        "coupon_regions_sha256": coupon_summary["coupon_regions_sha256"],
+        "guide_file": "PRINTING.md",
+        "guide_sha256": sha256_file(pack_root / "PRINTING.md"),
+        "clean_qa_file": "qa/clean_checks.json",
+        "clean_qa_sha256": sha256_file(pack_root / "qa" / "clean_checks.json"),
+        "visual_qa_file": "qa/visual_inspection.json",
+        "visual_qa_sha256": sha256_file(pack_root / "qa" / "visual_inspection.json"),
+        "source_provenance": source_provenance,
+        "canon_references": CANON_REFERENCES,
+        "printing_invariant": {
+            "paper": "A4 plain",
+            "scale": "actual size / 100%",
+            "borderless": False,
+            "fit_to_page": False,
+            "economy_or_toner_save": False,
+            "normal_margin_loss_recorded_not_compensated": True,
+        },
+        "security_notice": (
+            "All identifiers and fixture material are public synthetic test data, never production credentials."
+        ),
+        "physical_status": "pending_user_prints_and_12_original_poco_photos",
+    }
+    manifest["artifacts"] = _artifact_inventory(pack_root)
+    _write_json(pack_root / "manifest.json", manifest)
+    validate_manifest(pack_root, manifest)
+    return manifest
