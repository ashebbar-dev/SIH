+def _artifact_inventory(pack_root: Path) -> list[dict[str, Any]]:
+    artifacts: list[dict[str, Any]] = []
+    for path in sorted(pack_root.rglob("*")):
+        if not path.is_file() or path.name == "manifest.json":
+            continue
+        relative = path.relative_to(pack_root).as_posix()
+        if relative.startswith("sheets/"):
+            role = "print_sheet"
+        elif relative.startswith("sources/"):
+            role = "exact_source_reference"
+        elif relative.startswith("diagnostics/"):
+            role = "coupon_measurement_input"
+        elif relative.startswith("qa/"):
+            role = "quality_assurance"
+        elif relative == "evaluation_labels.json":
+            role = "evaluator_only_labels"
+        elif relative == "public_fixture.json":
+            role = "public_synthetic_fixture_config"
+        elif relative == "PRINTING.md":
+            role = "print_capture_guide"
+        else:
+            role = "supporting_artifact"
+        artifacts.append(
+            {
+                "path": relative,
+                "sha256": sha256_file(path),
+                "bytes": path.stat().st_size,
+                "role": role,
+            }
+        )
+    return artifacts
