+    labels = _labels_payload()
+    _write_json(pack_root / "evaluation_labels.json", labels)
+    _write_json(
+        pack_root / "qa" / "visual_inspection.json",
+        _visual_qa_payload(pack_root),
+    )
+
+    clean_decode: dict[str, Any] = {}
+    with tempfile.TemporaryDirectory(prefix="n1-pack-clean-render-") as directory:
+        scratch = Path(directory)
+        for sheet_id, source_id in (("A1", "cal-a"), ("B1", "cal-b")):
+            clean_decode[sheet_id] = _decode_clean_render(
+                pack_root / "sources" / f"{source_id}.pdf",
