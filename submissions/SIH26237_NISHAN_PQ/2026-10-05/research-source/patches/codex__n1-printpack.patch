+def _embed_core_sheet(
+    source: Path,
+    destination: Path,
+    codeword: np.ndarray,
+    identity: str,
+) -> dict[str, Any]:
+    metrics = tardos_carrier.embed_pdf(
+        source,
+        destination,
+        codeword,
+        FIXTURE_SECRET,
+        CARRIER_CONTEXT,
+        strength=float(CARRIER["strength"]),
+        dpi=int(CARRIER["dpi"]),
+        block_size=int(CARRIER["block"]),
+    )
+    _canonicalize_pdf_id(destination, identity)
+    _require_a4(destination)
+    measured = tardos_carrier.measure_pdf_pair(source, destination, dpi=144)
+    if not measured.text_preserved:
+        raise AssertionError(f"core carrier changed source text: {identity}")
+    if metrics.capacity_symbols < CARRIER["m"] or metrics.embedded_symbols != CARRIER["m"]:
+        raise AssertionError(f"core carrier capacity/profile changed: {identity}")
+    return asdict(metrics) | {
+        "post_canonicalization_pair": asdict(measured),
+        "output_sha256": sha256_file(destination),
+    }
+
