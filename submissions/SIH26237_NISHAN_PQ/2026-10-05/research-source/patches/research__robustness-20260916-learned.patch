@@ -0,0 +1,54 @@
+"""Registry-only receiver decisions for the bounded pilot."""
+
+from __future__ import annotations
+
+import re
+
+BITSTRING = re.compile(r"^[01]{61}$")
+DECODED = re.compile(r"Found watermark: ([01]{61})")
+
+
+def parse_decode_output(stdout: str) -> str | None:
+    """Parse the official CLI's valid-message or abstention output."""
+    if "Corrupt or missing watermark" in stdout:
+        return None
+    match = DECODED.search(stdout)
+    if not match:
+        raise ValueError(f"unrecognized TrustMark decode output: {stdout!r}")
+    return match.group(1)
+
+
+def classify(
+    decoded: str | None,
+    expected: str,
+    registry: dict[str, str],
+) -> dict[str, bool | str]:
+    """Classify without deriving or guessing messages.
+
+    A valid but unregistered BCH output is never accepted by this receiver.
+    """
+    if not BITSTRING.fullmatch(expected):
+        raise ValueError("expected must be a 61-bit string")
+    if set(registry) != {"A", "B"} or any(
+        not BITSTRING.fullmatch(value) for value in registry.values()
+    ):
+        raise ValueError("registry must contain valid A and B messages")
+
+    if decoded is None:
+        outcome = "abstain"
+    elif not BITSTRING.fullmatch(decoded):
+        raise ValueError("decoded must be None or a 61-bit string")
+    elif decoded == expected:
+        outcome = "exact_target"
+    elif decoded in registry.values():
+        outcome = "other_issued"
+    else:
+        outcome = "unissued_valid"
+
+    return {
+        "outcome": outcome,
+        "decoder_valid": decoded is not None,
+        "target_accepted": outcome == "exact_target",
+        "any_issued_recognized": decoded in registry.values() if decoded else False,
+        "unissued_accepted": False,
+    }
