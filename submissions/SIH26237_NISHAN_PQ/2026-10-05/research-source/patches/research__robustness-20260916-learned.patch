+    def test_resize_and_bilevel_are_deterministic(self) -> None:
+        array = np.full((120, 80, 3), 250, dtype=np.uint8)
+        array[20:100, 30:50] = 30
+        image = Image.fromarray(array, "RGB")
+        with tempfile.TemporaryDirectory() as tmp:
+            resized_path = Path(tmp) / "resize.png"
+            pilot.apply_transform(image, "screenshot_resize", resized_path)
+            with Image.open(resized_path) as resized:
+                self.assertEqual(resized.size, (768, 1152))
+            bilevel_path = Path(tmp) / "bilevel.png"
+            pilot.apply_transform(image, "scanner_bilevel", bilevel_path)
+            with Image.open(bilevel_path) as bilevel:
+                values = set(np.asarray(bilevel).reshape(-1).tolist())
+            self.assertEqual(values, {0, 255})
+
+    def test_perspective_path_retains_dimensions(self) -> None:
