@@ -0,0 +1,125 @@
+from __future__ import annotations
+
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+LEAD_DIR = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(LEAD_DIR / "src"))
+
+import messages  # noqa: E402
+import pilot  # noqa: E402
+import receiver  # noqa: E402
+
+
+class MessageTests(unittest.TestCase):
+    def test_frozen_message_and_independence(self) -> None:
+        self.assertEqual(
+            messages.issue("dev_memo", "A"),
+            "0111100111110001100011010101000000011001000101001110011100011",
+        )
+        self.assertEqual(len(messages.issue("dev_memo", "B")), 61)
+        self.assertNotEqual(
+            messages.issue("dev_memo", "A"), messages.issue("dev_memo", "B")
+        )
+        self.assertNotEqual(
+            messages.issue("dev_memo", "A"), messages.issue("dev_table", "A")
+        )
+
+    def test_invalid_message_inputs_fail(self) -> None:
+        with self.assertRaises(ValueError):
+            messages.issue("dev|memo", "A")
+        with self.assertRaises(ValueError):
+            messages.issue("dev_memo", "C")
+
+
+class ReceiverTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.registry = {
+            "A": messages.issue("dev_memo", "A"),
+            "B": messages.issue("dev_memo", "B"),
+        }
+
+    def test_all_receiver_outcomes(self) -> None:
+        expected = self.registry["A"]
+        self.assertEqual(
+            receiver.classify(expected, expected, self.registry)["outcome"],
+            "exact_target",
+        )
+        self.assertEqual(
+            receiver.classify(self.registry["B"], expected, self.registry)["outcome"],
+            "other_issued",
+        )
+        unissued = "0" * 61
+        self.assertNotIn(unissued, self.registry.values())
+        decision = receiver.classify(unissued, expected, self.registry)
+        self.assertEqual(decision["outcome"], "unissued_valid")
+        self.assertFalse(decision["unissued_accepted"])
+        self.assertEqual(
+            receiver.classify(None, expected, self.registry)["outcome"], "abstain"
+        )
+
