+class MetricAndSelectionTests(unittest.TestCase):
+    def test_quality_metrics(self) -> None:
+        source = Image.new("RGB", (20, 20), "white")
+        same = pilot.quality_metrics(source, source)
+        self.assertEqual(same["global_psnr_db"], "inf")
+        changed = source.copy()
+        changed.putpixel((0, 0), (0, 0, 0))
+        metrics = pilot.quality_metrics(source, changed)
+        self.assertGreater(metrics["global_mae"], 0)
+        self.assertLess(metrics["global_psnr_db"], 60)
