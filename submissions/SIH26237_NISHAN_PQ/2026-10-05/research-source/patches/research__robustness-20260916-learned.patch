+def make_readability_panel() -> None:
+    source = Image.open(render_path("validation_dense")).convert("RGB")
+    images = [
+        ("unmarked source", source),
+        ("strength 1.0", Image.open(marked_path("validation", "validation_dense", 1.0, "A")).convert("RGB")),
+        ("strength 1.5", Image.open(marked_path("validation", "validation_dense", 1.5, "A")).convert("RGB")),
+    ]
+    x, y, width, height = (96, 96, 640, 384)
+    label_height = 24
+    panel = Image.new("RGB", (width * len(images), height + label_height), "white")
+    draw = ImageDraw.Draw(panel)
+    for index, (label, image) in enumerate(images):
+        crop = image.crop((x, y, x + width, y + height))
+        panel.paste(crop, (index * width, label_height))
+        draw.text((index * width + 4, 4), label, fill="black")
+    panel.save(RESULTS_DIR / "readability_1to1.png", format="PNG")
+
+
+def selected_validation_controls(
+    strength: float,
+    registry: dict[str, dict[str, str]],
+) -> list[dict[str, Any]]:
+    rows: list[dict[str, Any]] = []
+    dense_b = marked_path("validation", "validation_dense", strength, "B")
+    decoded, timing = decode_image(dense_b)
+    rows.append(
+        make_result_row(
+            stage="validation",
+            case_type="control_other_issued",
+            source_id="validation_dense",
+            receiver_source_id="validation_dense",
+            strength=strength,
+            message_label="A",
+            transform_id="clean_png",
+            expected=registry["validation_dense"]["A"],
+            decoded=decoded,
+            registry=registry["validation_dense"],
+            decode_timing=timing,
+            input_size=Image.open(dense_b).size,
+            notes="Image carries issued message B while target query is A.",
+        )
+    )
+
+    dense_a = marked_path("validation", "validation_dense", strength, "A")
+    decoded, timing = decode_image(dense_a)
+    rows.append(
+        make_result_row(
+            stage="validation",
+            case_type="control_wrong_source_context",
+            source_id="validation_dense",
+            receiver_source_id="validation_diagram",
+            strength=strength,
+            message_label="A",
+            transform_id="clean_png",
+            expected=registry["validation_diagram"]["A"],
+            decoded=decoded,
+            registry=registry["validation_diagram"],
+            decode_timing=timing,
+            input_size=Image.open(dense_a).size,
+            notes="Public TrustMark has no key; this is a frozen wrong-source registry control.",
+        )
+    )
+
+    dense_source = np.asarray(Image.open(render_path("validation_dense")).convert("RGB"), dtype=np.int16)
+    dense_marked = np.asarray(Image.open(dense_a).convert("RGB"), dtype=np.int16)
+    diagram_source_image = Image.open(render_path("validation_diagram")).convert("RGB")
+    diagram_source = np.asarray(diagram_source_image, dtype=np.int16)
+    if dense_source.shape != diagram_source.shape:
+        raise RuntimeError("transplant sources have different raster dimensions")
+    transplant = np.clip(diagram_source + (dense_marked - dense_source), 0, 255).astype(np.uint8)
+    transplant_path = WORK_DIR / "validation" / "controls" / "donor_residual_transplant.png"
+    transplant_path.parent.mkdir(parents=True, exist_ok=True)
+    Image.fromarray(transplant, "RGB").save(transplant_path, format="PNG")
+    decoded, timing = decode_image(transplant_path)
+    row = make_result_row(
+        stage="validation",
+        case_type="control_donor_residual_transplant",
+        source_id="validation_diagram",
+        receiver_source_id="validation_diagram",
+        strength=strength,
+        message_label="A",
+        transform_id="donor_residual_transplant",
+        expected=registry["validation_diagram"]["A"],
+        decoded=decoded,
+        registry=registry["validation_diagram"],
+        decode_timing=timing,
+        quality=quality_metrics(diagram_source_image, Image.fromarray(transplant, "RGB")),
+        input_size=diagram_source_image.size,
+        notes="Residual copied from validation_dense/A. Donor recovery would demonstrate transplantability, not content authenticity or culpability.",
+    )
+    row["decoded_matches_donor_message"] = decoded == registry["validation_dense"]["A"]
+    rows.append(row)
+    return rows
+
+
+def validation() -> dict[str, Any]:
+    config = prepare()
+    smoke_result = read_json(RESULTS_DIR / "smoke.json")
+    if not smoke_result.get("passed"):
+        raise RuntimeError("a passing development smoke is required before validation")
+    if smoke_result["configuration_sha256"] != config["configuration_sha256"]:
+        raise RuntimeError("configuration changed after development smoke")
+    cases = [case for case in verify_sources() if case["split"] == "validation"]
+    registry = read_json(RESULTS_DIR / "receiver_registry.json")
+    matrix_rows = evaluate_matrix("validation", cases, [1.0, 1.5], registry)
+    unmarked_rows = evaluate_unmarked_controls("validation", cases, registry)
+    unmarked_valid = sum(bool(row["decoder_valid"]) for row in unmarked_rows)
+    selection = select_strength(matrix_rows, unmarked_valid)
+    selected_for_controls = selection["chosen_strength"]
+    if selected_for_controls is None:
+        selected_for_controls = selection["diagnostic_strength_if_no_gate"]
+    control_rows = selected_validation_controls(float(selected_for_controls), registry)
+    rows = matrix_rows + unmarked_rows + control_rows
+    selection.update(
+        {
+            "configuration_sha256": config["configuration_sha256"],
+            "controls_run_at_strength": selected_for_controls,
+            "selection_uses_controls": "unmarked only; other controls are diagnostic and do not tune strength",
+        }
+    )
+    write_rows("validation_cases", rows)
+    write_json(RESULTS_DIR / "selection.json", selection)
+    make_readability_panel()
+    return selection
+
+
+def require_committed_selection() -> dict[str, Any]:
+    relative = RESULTS_DIR.joinpath("selection.json").relative_to(REPO_ROOT)
+    subprocess.run(
+        ["git", "ls-files", "--error-unmatch", str(relative)],
+        cwd=REPO_ROOT,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=True,
+    )
+    status = run_plain(["git", "status", "--porcelain", "--", str(relative)], cwd=REPO_ROOT)
+    if status:
+        raise RuntimeError("selection.json must be committed and unchanged before confirmation")
+    return read_json(RESULTS_DIR / "selection.json")
+
+
+def create_print_candidate_if_allowed(
+    selection: dict[str, Any], rows: list[dict[str, Any]], strength: float
+) -> dict[str, Any]:
+    clean = [
+        row
+        for row in rows
+        if row["case_type"] == "matrix" and row["transform"] == "clean_png"
+    ]
+    confirmation_clean_pass = len(clean) == 4 and all(row["exact_recovery"] for row in clean)
+    allowed = bool(selection["gate_passed"] and confirmation_clean_pass)
+    metadata: dict[str, Any] = {
+        "allowed": allowed,
+        "validation_gate_passed": selection["gate_passed"],
+        "confirmation_clean_exact": sum(bool(row["exact_recovery"]) for row in clean),
+        "confirmation_clean_total": len(clean),
+        "candidate_pages": [],
+        "warning": "Any candidate requires a NEW matching print. Do not test this carrier on old captures.",
+    }
+    if allowed:
+        image_path = marked_path("confirmation", "test_mixed", strength, "A")
+        output = RESULTS_DIR / f"print_candidate_test_mixed_A_strength_{strength_name(strength)}.pdf"
+        image = Image.open(image_path).convert("RGB")
+        image.save(output, format="PDF", resolution=144.0)
+        metadata["candidate_pages"].append(
+            {
+                "file": output.name,
+                "sha256": sha256_file(output),
+                "source_id": "test_mixed",
+                "message_label": "A",
+                "message_bits": read_json(RESULTS_DIR / "receiver_registry.json")["test_mixed"]["A"],
+                "strength": strength,
+                "raster_only": True,
+            }
+        )
+    write_json(RESULTS_DIR / "print_gate.json", metadata)
+    return metadata
+
+
+def confirmation() -> dict[str, Any]:
+    config = prepare()
+    selection = require_committed_selection()
+    if selection["configuration_sha256"] != config["configuration_sha256"]:
+        raise RuntimeError("configuration changed after validation selection")
+    strength = selection["chosen_strength"]
+    negative_only = False
+    if strength is None:
+        strength = selection["diagnostic_strength_if_no_gate"]
+        negative_only = True
+    cases = [case for case in verify_sources() if case["split"] == "confirmation"]
+    registry = read_json(RESULTS_DIR / "receiver_registry.json")
+    matrix_rows = evaluate_matrix("confirmation", cases, [float(strength)], registry)
+    unmarked_rows = evaluate_unmarked_controls("confirmation", cases, registry)
+    rows = matrix_rows + unmarked_rows
+    write_rows("confirmation_cases", rows)
+    print_gate = create_print_candidate_if_allowed(selection, matrix_rows, float(strength))
+    summary = {
+        "schema": "nishan-trustmark-confirmation/v1",
+        "created_at_utc": utc_now(),
+        "configuration_sha256": config["configuration_sha256"],
+        "selection_sha256": sha256_file(RESULTS_DIR / "selection.json"),
+        "strength": strength,
+        "negative_only_because_validation_gate_failed": negative_only,
+        "matrix_exact": sum(bool(row["exact_recovery"]) for row in matrix_rows),
+        "matrix_total": len(matrix_rows),
+        "clean_exact": sum(
+            bool(row["exact_recovery"])
+            for row in matrix_rows
+            if row["transform"] == "clean_png"
+        ),
+        "clean_total": sum(row["transform"] == "clean_png" for row in matrix_rows),
+        "unmarked_valid": sum(bool(row["decoder_valid"]) for row in unmarked_rows),
+        "print_gate": print_gate,
+    }
+    write_json(RESULTS_DIR / "confirmation_summary.json", summary)
+    return summary
+
+
+def aggregate_rows(rows: list[dict[str, Any]]) -> dict[str, Any]:
+    matrix = [row for row in rows if row["case_type"] == "matrix"]
+    by_transform: dict[str, dict[str, int]] = {}
+    for transform_id in TRANSFORM_IDS:
+        selected = [row for row in matrix if row["transform"] == transform_id]
+        by_transform[transform_id] = {
+            "exact": sum(bool(row["exact_recovery"]) for row in selected),
+            "total": len(selected),
+            "wrong_valid": sum(
+                bool(row["decoder_valid"] and not row["exact_recovery"]) for row in selected
+            ),
+            "abstain": sum(row["outcome"] == "abstain" for row in selected),
+        }
+    valid_rss = [
+        value
+        for row in rows
+        for value in (row.get("encode_peak_rss_kib"), row.get("decode_peak_rss_kib"))
+        if isinstance(value, int)
+    ]
+    return {
+        "matrix_exact": sum(bool(row["exact_recovery"]) for row in matrix),
+        "matrix_total": len(matrix),
+        "wrong_valid": sum(
+            bool(row["decoder_valid"] and not row["exact_recovery"]) for row in matrix
+        ),
+        "abstain": sum(row["outcome"] == "abstain" for row in matrix),
+        "unissued_valid_rows": sum(row["outcome"] == "unissued_valid" for row in rows),
+        "unissued_accepted_rows": sum(bool(row["unissued_accepted"]) for row in rows),
+        "peak_child_rss_kib": max(valid_rss, default=None),
+        "by_transform": by_transform,
+    }
+
+
+def report() -> dict[str, Any]:
+    validation_payload = read_json(RESULTS_DIR / "validation_cases.json")
+    confirmation_payload = read_json(RESULTS_DIR / "confirmation_cases.json")
+    selection = read_json(RESULTS_DIR / "selection.json")
+    config = read_json(RESULTS_DIR / "configuration.json")
+    validation_summary = aggregate_rows(validation_payload["rows"])
+    confirmation_summary = aggregate_rows(confirmation_payload["rows"])
+    summary = {
+        "schema": "nishan-trustmark-pilot-summary/v1",
+        "created_at_utc": utc_now(),
+        "configuration_sha256": config["configuration_sha256"],
+        "selection": selection,
+        "validation": validation_summary,
+        "confirmation": confirmation_summary,
+        "raw_pre_ecc_bit_errors": "unavailable through official public Rust API",
+    }
+    write_json(RESULTS_DIR / "summary.json", summary)
+
+    chosen = selection["chosen_strength"]
+    print_gate = read_json(RESULTS_DIR / "print_gate.json")
+    lines = [
+        "# TrustMark-Q learned-carrier pilot",
+        "",
+        "## Outcome",
+        "",
+        f"The frozen validation gate {'passed' if selection['gate_passed'] else 'did not pass'}. "
+        f"Selected global strength: `{chosen}`. This is a bounded reproduction of Adobe TrustMark, not a NISHAN invention.",
+        "",
+        "All evaluated transforms were digital simulations on synthetic one-page PDFs. No old or new physical capture was opened, and these results do not establish print/scan/camera or messaging-app recovery.",
+        "",
+        "## Decisive counts",
+        "",
+        f"- Validation matrix: {validation_summary['matrix_exact']}/{validation_summary['matrix_total']} exact, "
+        f"{validation_summary['wrong_valid']} wrong-valid, {validation_summary['abstain']} abstentions across both preregistered strengths.",
+        f"- Confirmation matrix: {confirmation_summary['matrix_exact']}/{confirmation_summary['matrix_total']} exact, "
+        f"{confirmation_summary['wrong_valid']} wrong-valid, {confirmation_summary['abstain']} abstentions at the frozen strength.",
+        f"- Valid-but-unregistered outputs accepted by the registry receiver: {validation_summary['unissued_accepted_rows'] + confirmation_summary['unissued_accepted_rows']}. The receiver only accepts exact frozen registry entries.",
+        f"- Peak measured child RSS: {max(validation_summary['peak_child_rss_kib'] or 0, confirmation_summary['peak_child_rss_kib'] or 0)} KiB.",
+        "",
+        "## Confirmation by transform",
+        "",
+        "| Transform | Exact | Wrong valid | Abstain |",
+        "|---|---:|---:|---:|",
+    ]
+    for transform_id, counts in confirmation_summary["by_transform"].items():
+        lines.append(
+            f"| `{transform_id}` | {counts['exact']}/{counts['total']} | {counts['wrong_valid']} | {counts['abstain']} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Payload, receiver, and quality limits",
+            "",
+            "TrustMark-Q consumes 100 model bits. BCH_5 provides 61 data bits, 35 ECC bits, and 4 version bits (two reserved plus two schema bits), with the implementation configured to correct up to five flips. The public Rust API returns only a corrected 61-bit message or a corrupt/missing result, so raw pre-ECC BER is unavailable; the case files retain post-ECC message Hamming distance whenever a valid message exists.",
+            "",
+            "The carrier is public and unkeyed. Exact registry lookup is a bounded pilot decision, not cryptographic authentication or content binding. The wrong-context and donor-residual controls therefore cannot establish authorship, integrity, or human culpability. Output pages are raster-only and lose selectable text/accessibility semantics.",
+            "",
+            "Global, ink-region, and background PSNR/MAE are recorded per clean marked case in `results/*.json` and `results/*.csv`; `results/readability_1to1.png` preserves one source pixel per displayed crop pixel. No claim of invisibility follows from PSNR alone.",
+            "",
+            "## Print decision",
+            "",
+            f"Print gate allowed: `{print_gate['allowed']}`. Candidate pages produced: {len(print_gate['candidate_pages'])}. Any candidate requires a NEW matching print and must not be tested on `LEGACY_TRIAL_CAPTURE.jpeg` or historical captures.",
+            "",
+            "## Provenance and reproduction",
+            "",
+            f"Configuration hash: `{config['configuration_sha256']}`. Runtime, model hashes, exact commands, source hashes, and Adobe MIT attribution are in `results/runtime_manifest.json`, `results/model_manifest.json`, `results/command_log.jsonl`, the copied `source_pack/manifest.json`, and `SOURCE_LICENSE_AUDIT.md`.",
+            "",
+            "Adobe's FAQ describes process-dependent printing and gives strength 1.5 as an example; that is an upstream claim, not a result of this document pilot.",
+        ]
+    )
+    report_path = LEAD_DIR / "REPORT.md"
+    report_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+    checkpoint = {
+        "schema": "nishan-learned-checkpoint/v1",
+        "updated_at_utc": utc_now(),
+        "stage": "bounded_digital_pilot_complete",
+        "blocking_inputs": [
+            "New matched prints and captures are required for any physical claim."
+        ],
+        "required_user_or_gpt6_pro_question": "Should the coordinator include the gated raster candidate in a matched print pack with an unmarked reference and original-profile control?",
+        "next_runnable_action": "If authorized, print only the coordinator-selected matched pack and preregister capture conditions before decoding.",
+        "configuration_sha256": config["configuration_sha256"],
+        "selected_strength": chosen,
+        "print_gate_allowed": print_gate["allowed"],
+    }
+    write_json(LEAD_DIR / "checkpoint.json", checkpoint)
+    return summary
+
+
+def parse_args(argv: list[str]) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "stage", choices=("prepare", "smoke", "validation", "confirm", "report")
+    )
+    return parser.parse_args(argv)
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = parse_args(sys.argv[1:] if argv is None else argv)
+    action = {
+        "prepare": prepare,
+        "smoke": smoke,
+        "validation": validation,
+        "confirm": confirmation,
+        "report": report,
+    }[args.stage]
+    result = action()
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
