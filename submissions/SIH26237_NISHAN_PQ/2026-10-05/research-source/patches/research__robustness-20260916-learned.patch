+#!/usr/bin/env python3
+"""Package the frozen marked raster as a clearly labelled print candidate.
+
+This post-evaluation packaging step overwrites the synthetic source footer that
+incorrectly says no watermark is present. The overlay changes pixels locally,
+but does not re-embed, retune, or change the frozen payload. Both the labelled
+PNG and a 144-DPI PDF round-trip must still decode to the frozen message before
+the final PDF is retained.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+import time
+from pathlib import Path
+
+import pymupdf
+from PIL import Image, ImageDraw, ImageFont
+
+SRC_DIR = Path(__file__).resolve().parent
+sys.path.insert(0, str(SRC_DIR))
+
+import pilot  # noqa: E402
+
+LEAD_DIR = SRC_DIR.parent
+RESULTS_DIR = LEAD_DIR / "results"
+WORK_DIR = LEAD_DIR / "work" / "print_candidate"
+FONT_PATH = Path("/usr/share/fonts/noto/NotoSans-Bold.ttf")
+
+
+def load_json(path: Path) -> dict:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def main() -> int:
+    selection = pilot.require_committed_selection()
+    if not selection.get("gate_passed") or selection.get("chosen_strength") != 1.0:
+        raise RuntimeError("frozen selection does not authorize the strength-1.0 candidate")
+    confirmation = load_json(RESULTS_DIR / "confirmation_summary.json")
+    if confirmation.get("configuration_sha256") != selection["configuration_sha256"]:
+        raise RuntimeError("confirmation/configuration mismatch")
+    print_gate = load_json(RESULTS_DIR / "print_gate.json")
+    if not print_gate.get("allowed") or not print_gate.get("validation_gate_passed"):
+        raise RuntimeError("frozen validation and confirmation gates do not allow printing")
+    if (
+        print_gate.get("confirmation_clean_exact"),
+        print_gate.get("confirmation_clean_total"),
+    ) != (4, 4):
+        raise RuntimeError("confirmation clean-recovery gate is incomplete")
+    registry = load_json(RESULTS_DIR / "receiver_registry.json")
+    expected = registry["test_mixed"]["A"]
+    source = pilot.marked_path("confirmation", "test_mixed", 1.0, "A")
+    if not source.is_file():
+        raise RuntimeError("missing frozen confirmation marked raster")
+
+    WORK_DIR.mkdir(parents=True, exist_ok=True)
+    labelled_png = WORK_DIR / "test_mixed_A_strength_1p0_labelled.png"
+    image = Image.open(source).convert("RGB")
+    if image.size != (1190, 1684):
+        raise RuntimeError(f"unexpected candidate raster size {image.size}")
+    draw = ImageDraw.Draw(image)
+    draw.rectangle((48, 1528, 1142, 1652), fill="white", outline="black", width=2)
+    title_font = ImageFont.truetype(str(FONT_PATH), 20)
+    detail_font = ImageFont.truetype(str(FONT_PATH), 14)
+    draw.text(
+        (66, 1552),
+        "TRUSTMARK-Q RESEARCH CANDIDATE - SYNTHETIC ID A - STRENGTH 1.0",
+        fill="black",
+        font=title_font,
+    )
+    draw.text(
+        (66, 1594),
+        "NEW MATCHING PRINT ONLY | digital pilot; not content/authorship proof",
+        fill="black",
+        font=detail_font,
+    )
+    image.save(labelled_png, format="PNG")
+    labelled_decoded, labelled_timing = pilot.decode_image(labelled_png)
+    if labelled_decoded != expected:
+        raise RuntimeError("visible-label candidate no longer decodes exactly")
+
+    temporary_pdf = WORK_DIR / "candidate.pdf"
+    frozen_pdf_time = time.strptime(
+        confirmation["created_at_utc"], "%Y-%m-%dT%H:%M:%SZ"
+    )
+    image.save(
+        temporary_pdf,
+        format="PDF",
+        resolution=144.0,
+        title="TrustMark-Q synthetic research candidate",
+        creationDate=frozen_pdf_time,
+        modDate=frozen_pdf_time,
+    )
+    roundtrip_png = WORK_DIR / "candidate_pdf_roundtrip_144dpi.png"
+    with pymupdf.open(temporary_pdf) as document:
+        if document.page_count != 1:
+            raise RuntimeError("candidate PDF is not one page")
+        page = document[0]
+        if tuple(round(value, 3) for value in (page.rect.width, page.rect.height)) != (595.0, 842.0):
+            raise RuntimeError(f"candidate page size changed: {page.rect}")
+        pixmap = page.get_pixmap(matrix=pymupdf.Matrix(2, 2), alpha=False)
+        roundtrip = Image.frombytes("RGB", (pixmap.width, pixmap.height), pixmap.samples)
+        roundtrip.save(roundtrip_png, format="PNG")
+    roundtrip_decoded, roundtrip_timing = pilot.decode_image(roundtrip_png)
+    if roundtrip_decoded != expected:
+        raise RuntimeError("144-DPI PDF round-trip no longer decodes exactly")
+
+    output = RESULTS_DIR / "print_candidate_test_mixed_A_strength_1p0.pdf"
+    temporary_pdf.replace(output)
+    verification = {
+        "schema": "nishan-trustmark-print-candidate-verification/v1",
+        "created_at_utc": pilot.utc_now(),
+        "packaging_variant": "visible-label-v1-post-confirmation",
+        "packaging_script_sha256": pilot.sha256_file(Path(__file__)),
+        "source_marked_png_sha256": pilot.sha256_file(source),
+        "labelled_png_sha256": pilot.sha256_file(labelled_png),
+        "pdf_sha256": pilot.sha256_file(output),
+        "pdf_bytes": output.stat().st_size,
+        "page_points": [595.0, 842.0],
+        "raster_dimensions": [1190, 1684],
+        "raster_only": True,
+        "expected_bits": expected,
+        "labelled_png_exact_decode": labelled_decoded == expected,
+        "pdf_roundtrip_144dpi_exact_decode": roundtrip_decoded == expected,
+        "labelled_png_decode_wall_seconds": labelled_timing["wall_seconds"],
+        "labelled_png_decode_peak_rss_kib": labelled_timing["peak_rss_kib"],
+        "pdf_roundtrip_decode_wall_seconds": roundtrip_timing["wall_seconds"],
+        "pdf_roundtrip_decode_peak_rss_kib": roundtrip_timing["peak_rss_kib"],
+        "visible_label": "TRUSTMARK-Q research candidate; synthetic ID A; strength 1.0; new matching print only; not content/authorship proof",
+        "warning": "The visible label is a local post-embedding pixel edit, not a re-embed or retune. Exact recovery was reverified; no physical result is claimed.",
+    }
+    pilot.write_json(RESULTS_DIR / "print_candidate_verification.json", verification)
+
+    print_gate["candidate_pages"] = [
+        {
+            "file": output.name,
+            "sha256": verification["pdf_sha256"],
+            "source_id": "test_mixed",
+            "message_label": "A",
+            "message_bits": expected,
+            "strength": 1.0,
+            "raster_only": True,
+            "packaging_variant": verification["packaging_variant"],
+            "pdf_roundtrip_144dpi_exact_decode": True,
+        }
+    ]
+    print_gate["packaging_note"] = verification["warning"]
+    pilot.write_json(RESULTS_DIR / "print_gate.json", print_gate)
+
+    confirmation["print_gate"] = print_gate
+    pilot.write_json(RESULTS_DIR / "confirmation_summary.json", confirmation)
+    print(json.dumps(verification, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
