@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Complete two-message coverage of the development split after confirmation.
+
+This descriptive run is intentionally post-confirmation. It uses only the
+already committed strength 1.0 and cannot affect selection or the print gate.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+SRC_DIR = Path(__file__).resolve().parent
+sys.path.insert(0, str(SRC_DIR))
+
+import pilot  # noqa: E402
+
+LEAD_DIR = SRC_DIR.parent
+RESULTS_DIR = LEAD_DIR / "results"
+
+
+def main() -> int:
+    selection = pilot.require_committed_selection()
+    if not selection.get("gate_passed") or selection.get("chosen_strength") != 1.0:
+        raise RuntimeError("unexpected frozen selection")
+    confirmation = pilot.read_json(RESULTS_DIR / "confirmation_summary.json")
+    if confirmation.get("configuration_sha256") != selection["configuration_sha256"]:
+        raise RuntimeError("confirmation/configuration mismatch")
+    cases = [case for case in pilot.verify_sources() if case["split"] == "development"]
+    registry = pilot.read_json(RESULTS_DIR / "receiver_registry.json")
+    matrix = pilot.evaluate_matrix("development_post_confirmation", cases, [1.0], registry)
+    unmarked = pilot.evaluate_unmarked_controls("development_post_confirmation", cases, registry)
+    rows = matrix + unmarked
+    pilot.write_rows("development_cases", rows)
+    summary = {
+        "schema": "nishan-trustmark-development-completeness/v1",
+        "created_at_utc": pilot.utc_now(),
+        "configuration_sha256": selection["configuration_sha256"],
+        "selection_sha256": pilot.sha256_file(RESULTS_DIR / "selection.json"),
+        "strength": 1.0,
+        "post_confirmation_descriptive_only": True,
+        "cannot_change_selection_or_print_gate": True,
+        "matrix_exact": sum(bool(row["exact_recovery"]) for row in matrix),
+        "matrix_total": len(matrix),
+        "wrong_valid": sum(
+            bool(row["decoder_valid"] and not row["exact_recovery"]) for row in matrix
+        ),
+        "abstain": sum(row["outcome"] == "abstain" for row in matrix),
+        "unmarked_valid": sum(bool(row["decoder_valid"]) for row in unmarked),
+        "sources": [case["id"] for case in cases],
+        "messages_per_source": 2,
+    }
+    pilot.write_json(RESULTS_DIR / "development_summary.json", summary)
+    print(json.dumps(summary, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
