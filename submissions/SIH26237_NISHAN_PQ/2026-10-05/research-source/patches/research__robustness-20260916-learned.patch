+def render_source(case: dict[str, Any]) -> Image.Image:
+    render_dir = WORK_DIR / "renders"
+    render_dir.mkdir(parents=True, exist_ok=True)
+    output = render_dir / f"{case['id']}.png"
+    with pymupdf.open(SOURCE_DIR / case["file"]) as document:
+        if document.page_count != 1:
+            raise RuntimeError(f"unexpected page count for {case['id']}")
+        pixmap = document[0].get_pixmap(matrix=pymupdf.Matrix(2, 2), alpha=False)
+        image = Image.frombytes("RGB", (pixmap.width, pixmap.height), pixmap.samples)
+    image.save(output, format="PNG")
+    return image
+
+
+def apply_transform(image: Image.Image, transform_id: str, output: Path) -> None:
+    """Apply one preregistered transform and save its exact decoder input."""
+    output.parent.mkdir(parents=True, exist_ok=True)
+    rgb = image.convert("RGB")
+    if transform_id == "clean_png":
+        rgb.save(output, format="PNG")
+        return
+    if transform_id in {"screenshot_resize", "resize_jpeg_q55"}:
+        width, height = rgb.size
+        scale = 768 / min(width, height)
+        resized = rgb.resize(
+            (round(width * scale), round(height * scale)), Image.Resampling.LANCZOS
+        )
+        if transform_id == "screenshot_resize":
+            resized.save(output, format="PNG")
+        else:
+            resized.save(output, format="JPEG", quality=55, subsampling=2)
+        return
+    if transform_id == "jpeg_q55":
+        rgb.save(output, format="JPEG", quality=55, subsampling=2)
+        return
+    if transform_id == "grayscale":
+        rgb.convert("L").convert("RGB").save(output, format="PNG")
+        return
+    if transform_id == "scanner_bilevel":
+        grayscale = ImageOps.autocontrast(rgb.convert("L"))
+        binary = grayscale.point(lambda value: 255 if value >= 200 else 0)
+        binary.convert("RGB").save(output, format="PNG")
+        return
+    if transform_id == "perspective_blur_rectified":
+        array = np.asarray(rgb)
+        height, width = array.shape[:2]
+        source = np.float32(
+            [[0, 0], [width - 1, 0], [width - 1, height - 1], [0, height - 1]]
+        )
+        fractions = np.float32([[0.03, 0.02], [0.98, 0.04], [0.96, 0.97], [0.04, 0.95]])
+        destination = fractions * np.float32([width - 1, height - 1])
+        homography = cv2.getPerspectiveTransform(source, destination)
+        warped = cv2.warpPerspective(
+            array,
+            homography,
+            (width, height),
+            flags=cv2.INTER_LINEAR,
+            borderMode=cv2.BORDER_CONSTANT,
+            borderValue=(255, 255, 255),
+        )
+        blurred = cv2.GaussianBlur(warped, (0, 0), sigmaX=1.2, sigmaY=1.2)
+        rectified = cv2.warpPerspective(
+            blurred,
+            np.linalg.inv(homography),
+            (width, height),
+            flags=cv2.INTER_LINEAR,
+            borderMode=cv2.BORDER_CONSTANT,
+            borderValue=(255, 255, 255),
+        )
+        Image.fromarray(rectified.astype(np.uint8), "RGB").save(output, format="PNG")
+        return
+    raise ValueError(f"unknown transform {transform_id}")
+
+
+def _psnr(diff: np.ndarray) -> float | str:
+    mse = float(np.mean(np.square(diff, dtype=np.float64)))
+    if mse == 0:
+        return "inf"
+    return 10 * math.log10((255.0 * 255.0) / mse)
+
+
+def quality_metrics(source: Image.Image, marked: Image.Image) -> dict[str, float | str | int | None]:
+    original = np.asarray(source.convert("RGB"), dtype=np.float64)
+    changed = np.asarray(marked.convert("RGB"), dtype=np.float64)
+    if original.shape != changed.shape:
+        raise ValueError("quality inputs must have identical dimensions")
+    diff = changed - original
+    absolute = np.abs(diff)
+    luminance = 0.299 * original[:, :, 0] + 0.587 * original[:, :, 1] + 0.114 * original[:, :, 2]
+    ink_mask = luminance <= 220
+    background_mask = luminance >= 245
+
+    def region(mask: np.ndarray) -> tuple[float | str | None, float | None, int]:
+        count = int(np.count_nonzero(mask))
+        if count == 0:
+            return None, None, 0
+        selected = diff[mask]
+        return _psnr(selected), float(np.mean(np.abs(selected))), count
+
+    ink_psnr, ink_mae, ink_pixels = region(ink_mask)
+    background_psnr, background_mae, background_pixels = region(background_mask)
+    return {
+        "global_psnr_db": _psnr(diff),
+        "ink_psnr_db": ink_psnr,
+        "background_psnr_db": background_psnr,
+        "global_mae": float(np.mean(absolute)),
+        "ink_mae": ink_mae,
+        "background_mae": background_mae,
+        "p99_absolute_channel_error": float(np.percentile(absolute, 99)),
+        "ink_pixels": ink_pixels,
+        "background_pixels": background_pixels,
+    }
+
+
+def encode_image(input_path: Path, output_path: Path, message: str, strength: float) -> dict[str, Any]:
+    command = [
+        str(TRUSTMARK_CLI),
+        "--models",
+        str(MODELS_DIR),
+        "encode",
+        "-i",
+        str(input_path),
+        "-o",
+        str(output_path),
+        "--watermark",
+        message,
+        "--version",
+        "BCH_5",
+        "--variant",
+        "Q",
+        "--strength",
+        str(strength),
+    ]
+    return run_timed(command)
+
+
+def decode_image(input_path: Path) -> tuple[str | None, dict[str, Any]]:
+    command = [
+        str(TRUSTMARK_CLI),
+        "--models",
+        str(MODELS_DIR),
+        "decode",
+        "-i",
+        str(input_path),
+        "--variant",
+        "Q",
+    ]
+    timing = run_timed(command)
+    return receiver.parse_decode_output(timing["stdout"]), timing
+
+
+def strength_name(strength: float) -> str:
+    return f"{strength:.1f}".replace(".", "p")
+
+
+def render_path(source_id: str) -> Path:
+    return WORK_DIR / "renders" / f"{source_id}.png"
+
+
+def marked_path(stage: str, source_id: str, strength: float, label: str) -> Path:
+    return WORK_DIR / stage / source_id / strength_name(strength) / label / "marked.png"
+
+
+def hamming_distance(left: str, right: str) -> int:
+    if len(left) != len(right):
+        raise ValueError("bitstrings must have equal length")
+    return sum(a != b for a, b in zip(left, right))
+
+
+def make_result_row(
+    *,
+    stage: str,
+    case_type: str,
+    source_id: str,
+    receiver_source_id: str,
+    strength: float | None,
+    message_label: str,
+    transform_id: str,
+    expected: str,
+    decoded: str | None,
+    registry: dict[str, str],
+    decode_timing: dict[str, Any],
+    encode_timing: dict[str, Any] | None = None,
+    quality: dict[str, Any] | None = None,
+    input_size: tuple[int, int] | None = None,
+    notes: str = "",
+) -> dict[str, Any]:
+    decision = receiver.classify(decoded, expected, registry)
+    row: dict[str, Any] = {
+        "stage": stage,
+        "case_type": case_type,
+        "source_id": source_id,
+        "receiver_source_id": receiver_source_id,
+        "strength": strength,
+        "message_label": message_label,
+        "transform": transform_id,
+        "expected_bits": expected,
+        "decoded_bits": decoded,
+        **decision,
+        "exact_recovery": decoded == expected,
+        "post_ecc_message_bit_errors": hamming_distance(expected, decoded) if decoded else None,
+        "raw_pre_ecc_bit_errors": None,
+        "decode_wall_seconds": decode_timing["wall_seconds"],
+        "decode_peak_rss_kib": decode_timing["peak_rss_kib"],
+        "encode_wall_seconds": encode_timing["wall_seconds"] if encode_timing else None,
+        "encode_peak_rss_kib": encode_timing["peak_rss_kib"] if encode_timing else None,
+        "decoder_input_width": input_size[0] if input_size else None,
+        "decoder_input_height": input_size[1] if input_size else None,
+        "notes": notes,
+    }
+    if quality:
+        row.update(quality)
+    return row
+
+
+def evaluate_matrix(
+    stage: str,
+    cases: list[dict[str, Any]],
+    strengths: Iterable[float],
+    registry: dict[str, dict[str, str]],
+) -> list[dict[str, Any]]:
+    rows: list[dict[str, Any]] = []
+    for case in cases:
+        source = render_source(case)
+        source_path = render_path(case["id"])
+        for strength in strengths:
+            for label in messages.LABELS:
+                expected = registry[case["id"]][label]
+                output = marked_path(stage, case["id"], strength, label)
+                output.parent.mkdir(parents=True, exist_ok=True)
+                encode_timing = encode_image(source_path, output, expected, strength)
+                marked = Image.open(output).convert("RGB")
+                quality = quality_metrics(source, marked)
+                for transform_id in TRANSFORM_IDS:
+                    if transform_id == "clean_png":
+                        decoder_input = output
+                    else:
+                        suffix = ".jpg" if "jpeg" in transform_id else ".png"
+                        decoder_input = output.parent / f"{transform_id}{suffix}"
+                        apply_transform(marked, transform_id, decoder_input)
+                    with Image.open(decoder_input) as transformed:
+                        input_size = transformed.size
+                    decoded, decode_timing = decode_image(decoder_input)
+                    rows.append(
+                        make_result_row(
+                            stage=stage,
+                            case_type="matrix",
+                            source_id=case["id"],
+                            receiver_source_id=case["id"],
+                            strength=strength,
+                            message_label=label,
+                            transform_id=transform_id,
+                            expected=expected,
+                            decoded=decoded,
+                            registry=registry[case["id"]],
+                            decode_timing=decode_timing,
+                            encode_timing=encode_timing,
+                            quality=quality,
+                            input_size=input_size,
+                        )
+                    )
+    return rows
+
+
+def evaluate_unmarked_controls(
+    stage: str,
+    cases: list[dict[str, Any]],
+    registry: dict[str, dict[str, str]],
+) -> list[dict[str, Any]]:
+    rows = []
+    for case in cases:
+        image = render_source(case)
+        path = render_path(case["id"])
+        decoded, timing = decode_image(path)
+        rows.append(
+            make_result_row(
+                stage=stage,
+                case_type="control_unmarked",
+                source_id=case["id"],
+                receiver_source_id=case["id"],
+                strength=None,
+                message_label="A",
+                transform_id="unmarked_clean",
+                expected=registry[case["id"]]["A"],
+                decoded=decoded,
+                registry=registry[case["id"]],
+                decode_timing=timing,
+                input_size=image.size,
+                notes="Expected abstention; any valid 61-bit output is retained.",
+            )
+        )
+    return rows
+
+
+def _metric_at_least(value: Any, minimum: float) -> bool:
+    return value == "inf" or (isinstance(value, (int, float)) and value >= minimum)
+
+
+def select_strength(rows: list[dict[str, Any]], unmarked_valid: int) -> dict[str, Any]:
+    details: dict[str, Any] = {}
+    passing: list[float] = []
+    for strength in (1.0, 1.5):
+        candidate = [
+            row
+            for row in rows
+            if row["case_type"] == "matrix" and float(row["strength"]) == strength
+        ]
+        clean = [row for row in candidate if row["transform"] == "clean_png"]
+        nonclean = [row for row in candidate if row["transform"] != "clean_png"]
+        clean_exact = sum(bool(row["exact_recovery"]) for row in clean)
+        nonclean_exact = sum(bool(row["exact_recovery"]) for row in nonclean)
+        quality_pass = all(
+            _metric_at_least(row["global_psnr_db"], 35)
+            and _metric_at_least(row["ink_psnr_db"], 30)
+            and _metric_at_least(row["background_psnr_db"], 35)
+            for row in clean
+        )
+        gate = (
+            len(clean) == 4
+            and clean_exact == 4
+            and len(nonclean) == 24
+            and nonclean_exact >= 18
+            and quality_pass
+            and unmarked_valid == 0
+        )
+        details[str(strength)] = {
+            "clean_exact": clean_exact,
+            "clean_total": len(clean),
+            "nonclean_exact": nonclean_exact,
+            "nonclean_total": len(nonclean),
+            "quality_pass": quality_pass,
+            "unmarked_valid": unmarked_valid,
+            "gate_pass": gate,
+        }
+        if gate:
+            passing.append(strength)
+
+    ranking = sorted(
+        (1.0, 1.5),
+        key=lambda strength: (-details[str(strength)]["nonclean_exact"], strength),
+    )
+    chosen = min(
+        passing,
+        key=lambda strength: (-details[str(strength)]["nonclean_exact"], strength),
+        default=None,
+    )
+    return {
+        "schema": "nishan-trustmark-selection/v1",
+        "created_at_utc": utc_now(),
+        "gate_passed": chosen is not None,
+        "chosen_strength": chosen,
+        "diagnostic_strength_if_no_gate": ranking[0],
+        "tie_break": "highest non-clean exact count, then lowest strength",
+        "strength_details": details,
+    }
+
+
