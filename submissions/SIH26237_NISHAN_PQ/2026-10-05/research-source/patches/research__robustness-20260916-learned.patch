+        "python": sys.version,
+        "pymupdf": pymupdf.__version__,
+        "pillow": Image.__version__,
+        "numpy": np.__version__,
+        "opencv": cv2.__version__,
+        "rustc": run_plain(["rustup", "run", "1.85.0", "rustc", "--version"], env=rust_env),
+        "cargo": run_plain(["rustup", "run", "1.85.0", "cargo", "--version"], env=rust_env),
+        "trustmark_upstream_revision": revision,
+        "cpu_allowed_for_inference": allowed_cpu_spec(),
+        "thread_environment": {
+            "OMP_NUM_THREADS": 2,
+            "OPENBLAS_NUM_THREADS": 2,
+            "MKL_NUM_THREADS": 2,
+            "RAYON_NUM_THREADS": 2,
