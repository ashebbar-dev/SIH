+#!/usr/bin/env python3
+"""Frozen, staged TrustMark-Q document pilot.
+
+All image/channel transforms in this file are digital simulations.  The Rust
+binary is the pinned official Adobe implementation with the two small changes
+documented in patches/trustmark-cli-strength-threads.patch.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+import math
+import os
+import platform
+import re
+import shutil
+import subprocess
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Iterable
+
+import cv2
+import numpy as np
+import pymupdf
+from PIL import Image, ImageDraw, ImageOps
+
+import messages
+import receiver
+
+LEAD_DIR = Path(__file__).resolve().parents[1]
+REPO_ROOT = Path(__file__).resolve().parents[4]
+SOURCE_DIR = LEAD_DIR / "source_pack"
+RESULTS_DIR = LEAD_DIR / "results"
+WORK_DIR = LEAD_DIR / "work"
+RUNTIME_DIR = REPO_ROOT / ".runtime"
+TRUSTMARK_SOURCE = RUNTIME_DIR / "trustmark-src"
+MODELS_DIR = RUNTIME_DIR / "models"
+TRUSTMARK_CLI = RUNTIME_DIR / "target" / "release" / "trustmark"
+PREREG_PATH = LEAD_DIR / "preregistration.json"
+PATCH_PATH = LEAD_DIR / "patches" / "trustmark-cli-strength-threads.patch"
+COMMAND_LOG = RESULTS_DIR / "command_log.jsonl"
+
+MODEL_FILES = {
+    "encoder_Q.onnx": {
+        "url": "https://cai-watermark.adobe.net/watermarking/trustmark-models/encoder_Q.onnx",
+        "bytes": 17_312_208,
+        "sha256": "19b3d1b25836130ffd78775a8f61539f993375d1823ef0e59ba5b8dffb4f892d",
+    },
+    "decoder_Q.onnx": {
+        "url": "https://cai-watermark.adobe.net/watermarking/trustmark-models/decoder_Q.onnx",
+        "bytes": 47_401_222,
+        "sha256": "ee3268f057c9dabef680e169302f5973d0589feea86189ed229a896cc3aa88df",
+    },
+}
+TRUSTMARK_COMMIT = "2ecb73ad28d1a3f66ac9dc19e1b667711f14314f"
+TRANSFORM_IDS = (
+    "clean_png",
+    "screenshot_resize",
+    "jpeg_q55",
+    "resize_jpeg_q55",
+    "grayscale",
+    "scanner_bilevel",
+    "perspective_blur_rectified",
+)
+
+
+def utc_now() -> str:
+    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def canonical_hash(value: Any) -> str:
+    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def read_json(path: Path) -> Any:
+    with path.open("r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def write_json(path: Path, value: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    with temporary.open("w", encoding="utf-8") as handle:
+        json.dump(value, handle, indent=2, sort_keys=True)
+        handle.write("\n")
+    temporary.replace(path)
+
+
+def load_preregistration() -> dict[str, Any]:
+    return read_json(PREREG_PATH)
+
+
+def verify_sources() -> list[dict[str, Any]]:
+    """Verify copied source files, their splits, and the frozen preregistration."""
+    manifest = read_json(SOURCE_DIR / "manifest.json")
+    prereg = load_preregistration()
+    frozen = {case["id"]: case for case in prereg["sources"]["cases"]}
+    cases = manifest.get("cases", [])
+    if len(cases) != 6 or set(frozen) != {case.get("id") for case in cases}:
+        raise RuntimeError("source manifest does not contain the frozen six cases")
+    for case in cases:
+        expected = frozen[case["id"]]
+        if case["split"] != expected["split"] or case["sha256"] != expected["sha256"]:
+            raise RuntimeError(f"frozen metadata mismatch for {case['id']}")
+        pdf_path = SOURCE_DIR / case["file"]
+        if sha256_file(pdf_path) != expected["sha256"]:
+            raise RuntimeError(f"source hash mismatch for {case['id']}")
+        if case["page_count"] != 1:
+            raise RuntimeError(f"source {case['id']} is no longer one page")
+    return cases
+
+
+def verify_models() -> dict[str, dict[str, Any]]:
+    observed: dict[str, dict[str, Any]] = {}
+    for filename, expected in MODEL_FILES.items():
+        path = MODELS_DIR / filename
+        if not path.is_file():
+            raise RuntimeError(f"missing official model: {path}")
+        size = path.stat().st_size
+        digest = sha256_file(path)
+        if size != expected["bytes"] or digest != expected["sha256"]:
+            raise RuntimeError(
+                f"model mismatch for {filename}: observed bytes={size} sha256={digest}"
+            )
+        observed[filename] = {**expected, "observed_bytes": size, "observed_sha256": digest}
+    return observed
+
+
+def run_plain(command: list[str], cwd: Path | None = None, env: dict[str, str] | None = None) -> str:
+    completed = subprocess.run(
+        command,
+        cwd=cwd,
+        env=env,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        check=True,
+    )
+    return completed.stdout.strip()
+
+
+def runtime_environment() -> dict[str, str]:
+    env = os.environ.copy()
+    env.update(
+        {
+            "OMP_NUM_THREADS": "2",
+            "OPENBLAS_NUM_THREADS": "2",
+            "MKL_NUM_THREADS": "2",
+            "RAYON_NUM_THREADS": "2",
+            "PYTHONDONTWRITEBYTECODE": "1",
+        }
+    )
+    return env
+
+
+def allowed_cpu_spec() -> str:
+    status = Path("/proc/self/status").read_text(encoding="utf-8")
+    match = re.search(r"^Cpus_allowed_list:\s*(.+)$", status, re.MULTILINE)
+    if not match:
+        raise RuntimeError("cannot determine allowed CPUs")
+    cpus: list[int] = []
+    for part in match.group(1).strip().split(","):
+        if "-" in part:
+            first, last = (int(value) for value in part.split("-", 1))
+            cpus.extend(range(first, last + 1))
+        else:
+            cpus.append(int(part))
+        if len(cpus) >= 2:
+            break
+    if not cpus:
+        raise RuntimeError("no allowed CPUs reported")
+    return ",".join(str(cpu) for cpu in cpus[:2])
+
+
+def append_command_log(record: dict[str, Any]) -> None:
+    RESULTS_DIR.mkdir(parents=True, exist_ok=True)
+    with COMMAND_LOG.open("a", encoding="utf-8") as handle:
+        handle.write(json.dumps(record, sort_keys=True) + "\n")
+
+
+def run_timed(command: list[str]) -> dict[str, Any]:
+    """Run one CLI invocation on at most two CPUs and sample Linux RSS."""
+    cpu_spec = allowed_cpu_spec()
+    wrapped = ["taskset", "-c", cpu_spec, *command]
+    started = utc_now()
+    monotonic_start = time.monotonic()
+    process = subprocess.Popen(
+        wrapped,
+        cwd=REPO_ROOT,
+        env=runtime_environment(),
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    peak_rss_kib = 0
+    status_path = Path(f"/proc/{process.pid}/status")
+    while process.poll() is None:
+        try:
+            status = status_path.read_text(encoding="utf-8")
+            for field in ("VmHWM", "VmRSS"):
+                match = re.search(rf"^{field}:\s*([0-9]+) kB$", status, re.MULTILINE)
+                if match:
+                    peak_rss_kib = max(peak_rss_kib, int(match.group(1)))
+        except FileNotFoundError:
+            pass
+        time.sleep(0.02)
+    stdout, stderr = process.communicate()
+    timing = {
+        "wall_seconds": round(time.monotonic() - monotonic_start, 6),
+        "peak_rss_kib": peak_rss_kib,
+    }
+    record = {
+        "at_utc": started,
+        "argv": [str(item) for item in command],
+        "cpu_spec": cpu_spec,
+        "returncode": process.returncode,
+        "stdout": stdout,
+        "stderr": stderr,
+        "measurement": "Python monotonic wall time; /proc/<pid>/status VmHWM/VmRSS sampled every 20 ms",
+        **timing,
+    }
+    append_command_log(record)
+    if process.returncode != 0:
+        raise RuntimeError(
+            f"TrustMark command failed ({process.returncode}): {command}\n"
+            f"stdout={stdout}\nstderr={stderr}"
+        )
+    return {**record, **timing}
+
+
+def prepare() -> dict[str, Any]:
+    cases = verify_sources()
+    models = verify_models()
+    if not TRUSTMARK_CLI.is_file():
+        raise RuntimeError(f"missing built CLI: {TRUSTMARK_CLI}")
+    revision = run_plain(["git", "rev-parse", "HEAD"], cwd=TRUSTMARK_SOURCE)
+    if revision != TRUSTMARK_COMMIT:
+        raise RuntimeError(f"unexpected TrustMark revision {revision}")
+    registry = messages.build_registry([case["id"] for case in cases])
+    write_json(RESULTS_DIR / "issuer_registry.json", registry)
+    write_json(RESULTS_DIR / "receiver_registry.json", registry)
+
+    model_manifest = {
+        "schema": "nishan-trustmark-model-manifest/v1",
+        "recorded_at_utc": utc_now(),
+        "upstream_revision": TRUSTMARK_COMMIT,
+        "license": "MIT (official README states code and downloaded model files are covered)",
+        "models": models,
+        "note": "SHA-256 values are observed local pins; the audited upstream Rust downloader did not publish ONNX checksums.",
+    }
+    write_json(RESULTS_DIR / "model_manifest.json", model_manifest)
+
+    configuration = {
+        "preregistration_sha256": sha256_file(PREREG_PATH),
+        "source_manifest_sha256": sha256_file(SOURCE_DIR / "manifest.json"),
+        "source_sha256": {case["id"]: case["sha256"] for case in cases},
+        "registry_sha256": canonical_hash(registry),
+        "trustmark_commit": TRUSTMARK_COMMIT,
+        "trustmark_patch_sha256": sha256_file(PATCH_PATH),
+        "trustmark_cli_sha256": sha256_file(TRUSTMARK_CLI),
+        "runner_sha256": {
+            "messages.py": sha256_file(LEAD_DIR / "src" / "messages.py"),
+            "receiver.py": sha256_file(LEAD_DIR / "src" / "receiver.py"),
+            "pilot.py": sha256_file(LEAD_DIR / "src" / "pilot.py"),
+        },
+        "models": {name: value["sha256"] for name, value in MODEL_FILES.items()},
+        "variant": "Q",
+        "ecc_schema": "BCH_5",
+        "strengths": [1.0, 1.5],
+        "transforms": list(TRANSFORM_IDS),
+        "render_dpi": 144,
+        "effective_cpu_limit": 2,
+    }
+    config_manifest = {
+        "schema": "nishan-trustmark-configuration/v1",
