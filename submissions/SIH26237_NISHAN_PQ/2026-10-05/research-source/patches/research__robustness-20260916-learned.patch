+"""Deterministic public synthetic issuance for the bounded pilot.
+
+This module is intentionally separate from receiver.py.  It is not a secret
+key generator and must never be used for real identities.
+"""
+
+from __future__ import annotations
+
+import hashlib
+
+SEED = "nishan-trustmark-pilot-2026-09-16-v1"
+LABELS = ("A", "B")
+DATA_BITS = 61
+
+
+def issue(source_id: str, label: str) -> str:
+    """Return the frozen 61-bit synthetic message for one source/label."""
+    if not source_id or "|" in source_id:
+        raise ValueError("source_id must be non-empty and cannot contain '|'")
+    if label not in LABELS:
+        raise ValueError(f"label must be one of {LABELS}")
+    material = f"{SEED}|{source_id}|{label}".encode("utf-8")
+    bits = "".join(f"{byte:08b}" for byte in hashlib.sha256(material).digest())
+    return bits[:DATA_BITS]
+
+
+def build_registry(source_ids: list[str]) -> dict[str, dict[str, str]]:
+    """Build the public synthetic issuance registry used by the pilot."""
+    return {
+        source_id: {label: issue(source_id, label) for label in LABELS}
+        for source_id in source_ids
+    }
