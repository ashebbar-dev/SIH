+def smoke() -> dict[str, Any]:
+    config = prepare()
+    case = [case for case in verify_sources() if case["id"] == "dev_memo"][0]
+    registry = read_json(RESULTS_DIR / "receiver_registry.json")
+    source = render_source(case)
+    source_path = render_path(case["id"])
+    expected = registry[case["id"]]["A"]
+    output = marked_path("smoke", case["id"], 1.0, "A")
+    output.parent.mkdir(parents=True, exist_ok=True)
+    encode_timing = encode_image(source_path, output, expected, 1.0)
+    with Image.open(output) as opened:
+        marked = opened.convert("RGB")
+    decoded, decode_timing = decode_image(output)
+    clean_a = make_result_row(
+        stage="smoke",
+        case_type="matrix",
+        source_id=case["id"],
+        receiver_source_id=case["id"],
+        strength=1.0,
+        message_label="A",
+        transform_id="clean_png",
+        expected=expected,
+        decoded=decoded,
+        registry=registry[case["id"]],
+        decode_timing=decode_timing,
+        encode_timing=encode_timing,
+        quality=quality_metrics(source, marked),
+        input_size=marked.size,
+    )
+    passed = bool(clean_a["exact_recovery"])
+    result = {
+        "schema": "nishan-trustmark-smoke/v1",
+        "created_at_utc": utc_now(),
+        "passed": passed,
+        "configuration_sha256": config["configuration_sha256"],
+        "case": clean_a,
+        "note": "Only the preregistered development source informed implementation debugging.",
+    }
+    write_json(RESULTS_DIR / "smoke.json", result)
+    if not passed:
+        raise RuntimeError("official TrustMark development smoke did not recover the exact message")
+    return result
+
