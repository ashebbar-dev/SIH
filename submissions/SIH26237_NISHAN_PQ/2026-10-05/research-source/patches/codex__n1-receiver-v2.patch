+                + memo_marked_images[0].astype(np.int16)
+                - memo_source.astype(np.int16),
+                0,
+                255,
+            ).astype(np.uint8)
+            _save_png(transplant, transplanted)
+
+            cases = [
+                ("original_clean", original, original_marked, [0], "positive", None),
+                ("dev_memo_clean", memo, memo_marked_paths[0], [0], "positive", None),
+                ("dev_table_clean", table, table_marked, [0], "positive", None),
+                ("blur_resize_jpeg_geometry", memo, combined, [0], "positive", None),
+                ("unmarked", memo, memo, [], "negative", None),
+                ("wrong_source", table, memo_marked_paths[0], [], "negative", None),
+                ("wrong_key", memo, memo_marked_paths[0], [], "negative", "key"),
+                ("wrong_context", memo, memo_marked_paths[0], [], "negative", "context"),
+                ("other_issued_row", memo, memo_marked_paths[1], [1], "positive", None),
+                ("transplant", table, transplant, [0], "transplant", None),
+                ("average_2", memo, average_two, [0, 1], "positive", None),
+                ("average_5", memo, average_five, [0, 1, 2, 3, 4], "positive", None),
+                ("interleave_5", memo, interleave_five, [0, 1, 2, 3, 4], "positive", None),
+            ]
+            family_hypotheses = len(cases) * 9000
+            summary: dict[str, object] = {
