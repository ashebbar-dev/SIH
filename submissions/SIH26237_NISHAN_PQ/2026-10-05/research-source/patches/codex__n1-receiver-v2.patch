+def _blank_pdf(path: Path) -> None:
+    document = fitz.open()
+    document.new_page(width=595, height=842)
+    document.save(path)
+    document.close()
+
+
+def _save_png(path: Path, image: np.ndarray) -> None:
+    Image.fromarray(np.asarray(image, dtype=np.uint8)).save(path, format="PNG")
+
+
+def _render(path: Path) -> np.ndarray:
+    pages, _ = watermark.load_pages(path, dpi=144)
+    if len(pages) != 1:
+        raise AssertionError("development fixture must have one page")
+    return pages[0]
+
+
+def _combined_development_transform(image: np.ndarray) -> np.ndarray:
+    source = np.asarray(image, dtype=np.float32)
+    height, width = source.shape[:2]
+    source_points = np.float32(
+        [[0, 0], [width - 1, 0], [width - 1, height - 1], [0, height - 1]]
+    )
+    destination_points = np.float32(
+        [[7, 11], [width - 10, 4], [width - 5, height - 13], [9, height - 4]]
+    )
+    homography = cv2.getPerspectiveTransform(source_points, destination_points)
+    warped = cv2.warpPerspective(
+        source,
+        homography,
+        (width, height),
+        flags=cv2.INTER_LANCZOS4,
+        borderMode=cv2.BORDER_CONSTANT,
+        borderValue=(255, 255, 255),
+    )
+    blurred = cv2.GaussianBlur(warped, (0, 0), 0.9)
+    reduced = cv2.resize(
+        blurred,
+        (round(width * 0.82), round(height * 0.82)),
+        interpolation=cv2.INTER_AREA,
+    )
+    restored = cv2.resize(reduced, (width, height), interpolation=cv2.INTER_LANCZOS4)
+    stream = io.BytesIO()
+    Image.fromarray(np.clip(restored, 0, 255).astype(np.uint8)).save(
+        stream, format="JPEG", quality=70
+    )
+    stream.seek(0)
+    with Image.open(stream) as decoded:
+        return np.asarray(decoded.convert("RGB"), dtype=np.uint8)
