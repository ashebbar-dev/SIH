@@ -0,0 +1,146 @@
+from __future__ import annotations
+
+import itertools
+import math
+import unittest
+
+import numpy as np
+
+from research.n1_v2 import compound_score
+
+
+def _normal(y: float, mean: float, variance: float) -> float:
+    return -0.5 * ((y - mean) ** 2 / variance + math.log(2 * math.pi * variance))
+
+
+def _logsum(values: list[float]) -> float:
+    return float(np.logaddexp.reduce(np.asarray(values, dtype=np.float64)))
+
+
+class CompoundScoreTests(unittest.TestCase):
+    def test_average_two_matches_exact_latent_count_formula(self) -> None:
+        p = np.array([0.3])
+        y = np.array([[0.2]])
+        variance = np.array([[0.08]])
+        log_weights = np.zeros((1, 1))
+        erased = np.array([False])
+        q0, q1, diagnostics = compound_score.compound_log_evidence(
+            p,
+            y,
+            variance,
+            log_weights,
+            erased,
+            kind="average",
+            coalition_size=2,
+        )
+        f = [_normal(0.2, fraction, 0.08) for fraction in (0.0, 0.5, 1.0)]
+        null = _logsum(
+            [
+                2 * math.log(0.7) + f[0],
+                math.log(2 * 0.3 * 0.7) + f[1],
+                2 * math.log(0.3) + f[2],
+            ]
+        )
+        conditioned_zero = _logsum(
+            [math.log(0.7) + f[0], math.log(0.3) + f[1]]
+        )
+        conditioned_one = _logsum(
+            [math.log(0.7) + f[1], math.log(0.3) + f[2]]
+        )
+        expected = np.array([conditioned_zero - null, conditioned_one - null])
+        expected -= expected.max()
+        np.testing.assert_allclose([q0[0], q1[0]], expected, atol=1e-12)
+        self.assertEqual(diagnostics["coalition_size"], 2)
+
+    def test_interleave_five_matches_declared_mixture(self) -> None:
+        p = np.array([0.65])
+        y = np.array([[0.8]])
+        variance = np.array([[0.12]])
+        q0, q1, _ = compound_score.compound_log_evidence(
+            p,
+            y,
+            variance,
+            np.zeros((1, 1)),
+            np.array([False]),
+            kind="interleaving",
+            coalition_size=5,
+        )
+        f0, f1 = _normal(0.8, 0.0, 0.12), _normal(0.8, 1.0, 0.12)
+        null = np.logaddexp(math.log(0.35) + f0, math.log(0.65) + f1)
+        expected = []
+        for own in (f0, f1):
+            conditioned = np.logaddexp(
+                math.log(1 / 5) + own,
+                math.log(4 / 5) + null,
+            )
+            expected.append(conditioned - null)
+        expected = np.asarray(expected)
+        expected -= expected.max()
+        np.testing.assert_allclose([q0[0], q1[0]], expected, atol=1e-12)
+
+    def test_erased_symbols_are_exactly_zero(self) -> None:
+        q0, q1, diagnostics = compound_score.compound_log_evidence(
+            np.array([0.2, 0.8]),
+            np.array([[0.1, 0.9]]),
+            np.array([[0.1, 0.1]]),
+            np.zeros((1, 2)),
+            np.array([True, False]),
+            kind="average",
+            coalition_size=5,
+        )
+        self.assertEqual(q0[0], 0.0)
+        self.assertEqual(q1[0], 0.0)
+        self.assertEqual(diagnostics["erased_symbols"], 1)
+
+    def test_conditional_chernoff_covers_exact_toy_enumeration(self) -> None:
+        p = np.array([0.2, 0.45, 0.8])
+        q0 = np.array([-0.1, -1.2, -0.4])
+        q1 = np.array([-1.3, -0.2, -0.8])
+        alpha = 0.2
+        calibration = compound_score.conditional_chernoff(p, q0, q1, alpha, 1)
+        rows = np.array(
+            list(itertools.product((0, 1), repeat=3)), dtype=np.uint8
+        )
+        scores = compound_score.score_rows(rows, q0, q1)
+        implemented = compound_score.implemented_probabilities(p)
+        mass = np.prod(
+            np.where(rows == 1, implemented, 1 - implemented), axis=1
+        )
+        exact_tail = float(mass[scores > calibration["threshold"]].sum())
+        self.assertLessEqual(exact_tail, alpha + 1e-12)
+        self.assertIs(calibration["grid_selected_before_row_scoring"], True)
+
+    def test_zero_evidence_is_inconclusive(self) -> None:
+        result = compound_score.conditional_chernoff(
+            np.array([0.2, 0.8]), np.zeros(2), np.zeros(2), 1e-6, 9000
+        )
+        self.assertEqual(result["status"], "inconclusive")
+        self.assertIsNone(result["threshold"])
+
+    def test_extreme_evidence_is_numerically_finite(self) -> None:
+        p = np.array([1 / 1500, 1 - 1 / 1500, 0.5])
+        q0 = np.array([-1e5, 0.0, -700.0])
+        q1 = np.array([0.0, -1e5, -699.0])
+        result = compound_score.conditional_chernoff(
+            p, q0, q1, 1e-12, 10**9
+        )
+        self.assertEqual(result["status"], "calibrated")
+        self.assertTrue(math.isfinite(result["threshold"]))
+        self.assertTrue(math.isfinite(result["cumulant"]))
+
+    def test_all_1000_rows_are_scored_and_calibration_is_row_independent(self) -> None:
+        rng = np.random.default_rng(20260916)
+        p = rng.uniform(0.01, 0.99, 101)
+        q0 = rng.normal(-0.7, 0.2, len(p))
+        q1 = rng.normal(-0.7, 0.2, len(p))
+        rows = (rng.random((1000, len(p))) < p).astype(np.uint8)
+        before = compound_score.conditional_chernoff(p, q0, q1, 1e-6, 9000)
+        scores = compound_score.score_rows(rows, q0, q1)
+        after = compound_score.conditional_chernoff(p, q0, q1, 1e-6, 9000)
+        self.assertEqual(scores.shape, (1000,))
+        self.assertTrue(np.all(np.isfinite(scores)))
+        self.assertEqual(before, after)
+
+
+if __name__ == "__main__":
+    unittest.main()
