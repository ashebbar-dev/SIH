+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+import cv2
+import numpy as np
+from PIL import Image
+
+from nishan import watermark
+from research.n1_v2 import receiver_api
+
+
+ROOT = Path(__file__).resolve().parents[3]
+CONFIG_PATH = ROOT / "research/n1_v2/receiver_config.json"
+PACK_ENV = "N1_APPROVED_CALIBRATION_PACK"
+POPPLER_ENV = "N1_APPROVED_POPPLER_RENDERS"
+MANIFEST_SHA256 = "13d23a26a04aec12dec2f37e23eeed12e250d9385fc2c7a1c9ed237702e0a378"
+POPPLER_SHA256 = {
+    "A0": "321586b1f0ae9c8e25502bf7911ac841c19181ee1725db27634cdf268b84052e",
+    "A1": "be23323cc27abcf43dbed617c2ba7800232620f7cedbee1f58fdbb9ebbbf11b0",
+    "B0": "68f69a5e852361be24fac3b31dc146050183e59879b8c55837806be018304421",
+    "B1": "08d0cab239a543636610cba0648061fbbc8c7c55f623b972b18b6faa6580f982",
+}
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _render(path: Path) -> np.ndarray:
+    pages, _ = watermark.load_pages(path, dpi=144)
+    if len(pages) != 1:
+        raise AssertionError("registration fixture must contain exactly one page")
+    return pages[0]
