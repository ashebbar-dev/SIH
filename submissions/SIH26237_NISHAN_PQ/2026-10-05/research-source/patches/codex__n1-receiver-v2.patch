+
+class SameSizeRendererRetryTests(unittest.TestCase):
+    def test_renderer_retry_is_content_only_bounded_and_wrong_source_safe(self) -> None:
+        source = _render(ROOT / "research/robustness/receiver/sources/dev_memo.pdf")
+        height, width = source.shape[:2]
+        template_to_capture = np.array(
