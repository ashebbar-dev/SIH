+
+    def test_local_shift_weights_ignore_endpoint_and_bias_descriptors(self) -> None:
+        config = json.loads(CONFIG_PATH.read_text())
+        yy, xx = np.indices((96, 96), dtype=np.float32)
+        source = (
+            72.0
+            + 0.55 * xx
+            + 0.35 * yy
+            + 7.0 * np.sin(xx / 8.0)
+            + 5.0 * np.cos(yy / 11.0)
+        ).astype(np.float32)
+        capture = channel_fit._shift_image(1.03 * source + 2.0, 0.35, -0.4)
+        support = np.ones(source.shape, dtype=bool)
+        support[:6] = False
+        support[-6:] = False
+        support[:, :6] = False
+        support[:, -6:] = False
+        symbols = (source.shape[0] // 6) * (source.shape[1] // 6)
+        order = np.arange(symbols, dtype=np.int64)
+        global_result = {
+            "observations": np.zeros((1, symbols), dtype=np.float32),
+            "variances": np.ones((1, symbols), dtype=np.float32),
+            "erased": np.zeros(symbols, dtype=bool),
