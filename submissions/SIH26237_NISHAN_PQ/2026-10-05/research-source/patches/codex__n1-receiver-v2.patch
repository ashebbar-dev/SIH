+"""N1 v2 recipient-blind preparation, committed scoring, and command line API."""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import replace
+import hashlib
+import json
+import math
+from pathlib import Path
+import platform
+import resource
+import subprocess
+import tempfile
+import time
+from typing import Any
+
+import cv2
+import numpy as np
+
+from nishan import registration, tardos, tardos_carrier, watermark
+
+from research.n1_v2 import channel_fit, compound_score
+
+
+ROOT = Path(__file__).resolve().parents[2]
+CONFIG_PATH = Path(__file__).with_name("receiver_config.json")
+DEFAULT_FIXTURE_SECRET = hashlib.sha3_256(
+    b"NISHAN Tardos carrier public fixture v1"
+).digest()
+PROFILE_KEYS = ("hard", "global_soft", "local_soft")
+SOFT_HYPOTHESES = {
+    "single": ("average", 1),
+    "average_2": ("average", 2),
+    "average_5": ("average", 5),
+    "interleave_5": ("interleaving", 5),
+}
+REQUIRED_CARRIER = {
+    "n": 1000,
+    "c": 5,
+    "m": 52500,
+    "block": 6,
+    "dpi": 144,
+    "strength": 4.0,
+    "epsilon": 1e-6,
+}
+REQUEST_KEYS = {
+    "schema",
+    "request_id",
+    "source_pdf",
+    "source_sha256",
+    "capture_path",
+    "capture_sha256",
+    "context",
+    "carrier",
+    "receiver_config_path",
+}
+FORBIDDEN_EVALUATOR_FIELDS = {
+    "attack",
+    "sheet_kind",
+    "expected_row",
+    "expected_rows",
+    "contributors",
+    "split",
+    "label",
+    "labels",
+    "source_watermark_variant",
+    "output_verdict",
+    "verdict",
+}
+
+
+class InconclusiveError(ValueError):
+    """A scientific abstention condition, retained as prepared metadata."""
+
+    def __init__(
+        self, message: str, diagnostics: dict[str, Any] | None = None
+    ) -> None:
+        super().__init__(message)
+        self.diagnostics = diagnostics
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _json_bytes(value: Any) -> bytes:
+    return (
+        json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n"
+    ).encode("utf-8")
+
+
+def _write_exclusive(path: Path, value: Any) -> None:
+    with Path(path).open("xb") as stream:
+        stream.write(_json_bytes(value))
+
+
+def _array_hash(value: np.ndarray) -> str:
+    array = np.ascontiguousarray(value)
+    prefix = json.dumps(
+        [list(array.shape), array.dtype.str], separators=(",", ":")
+    ).encode("utf-8")
+    return hashlib.sha256(prefix + array.tobytes()).hexdigest()
+
+
+def _canonical_hash(value: Any) -> str:
+    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode(
+        "utf-8"
+    )
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _mapping_hash(value: dict[str, str]) -> str:
+    return _canonical_hash(value)
+
+
+def _json_float(value: Any) -> float | None:
+    number = float(value)
+    return number if math.isfinite(number) else None
+
+
+def _relative(path: Path) -> str:
+    resolved = Path(path).resolve()
+    try:
+        return str(resolved.relative_to(ROOT.resolve()))
+    except ValueError:
+        return str(resolved)
+
+
+def _find_forbidden(value: Any, location: str = "request") -> list[str]:
+    found: list[str] = []
+    if isinstance(value, dict):
+        for key, child in value.items():
+            child_location = f"{location}.{key}"
+            if key in FORBIDDEN_EVALUATOR_FIELDS:
+                found.append(child_location)
+            found.extend(_find_forbidden(child, child_location))
+    elif isinstance(value, list):
+        for index, child in enumerate(value):
+            found.extend(_find_forbidden(child, f"{location}[{index}]"))
+    return found
+
+
+def _verify_hash(path: Path, expected: str, label: str) -> str:
+    if not Path(path).is_file():
+        raise FileNotFoundError(f"missing {label}: {path}")
+    actual = _sha256(path)
+    if actual != expected:
+        raise ValueError(f"{label} SHA-256 mismatch: {actual} != {expected}")
+    return actual
+
+
+def _load_config(path: Path) -> tuple[dict[str, Any], str]:
+    config_path = Path(path)
+    expected = _sha256(CONFIG_PATH)
+    actual = _verify_hash(config_path, expected, "receiver config")
+    config = json.loads(config_path.read_text())
+    if config.get("schema") != "nishan.n1-receiver-config/v2":
+        raise ValueError("invalid receiver configuration schema")
+    if config.get("carrier") != REQUIRED_CARRIER:
+        raise ValueError("receiver configuration changed the N1 carrier")
+    if tuple(config.get("profiles", ())) != PROFILE_KEYS:
+        raise ValueError("receiver configuration changed profile keys")
+    soft_keys = [item.get("id") for item in config.get("soft_hypotheses", ())]
+    if soft_keys != list(SOFT_HYPOTHESES):
+        raise ValueError("receiver configuration changed soft hypothesis keys")
+    return config, actual
+
+
+def _configuration() -> tardos.Parameters:
+    config = tardos.parameters(1000, 5, 1e-6)
+    if config.code_length != 52500 or config.threshold != 2100.0:
+        raise ValueError("implemented original profile no longer matches N1")
+    return config
+
+
+def _context(request_context: Any) -> tuple[dict[str, str], bytes]:
+    if not isinstance(request_context, dict):
+        raise ValueError("context must be an object")
+    required = ("kind", "codebook_context", "carrier_context")
+    if any(not isinstance(request_context.get(name), str) for name in required):
+        raise ValueError("context requires string kind/codebook_context/carrier_context")
+    if request_context["kind"] != "public_fixture_v1":
+        raise ValueError("only public_fixture_v1 is supported by this research receiver")
+    if not request_context["codebook_context"] or not request_context["carrier_context"]:
+        raise ValueError("context strings must be nonempty")
+    raw_secret = request_context.get("fixture_secret_hex")
+    if raw_secret is None:
+        secret = DEFAULT_FIXTURE_SECRET
+        source = "default public synthetic fixture seed"
+    else:
+        if (
+            not isinstance(raw_secret, str)
+            or len(raw_secret) != 64
+            or any(character not in "0123456789abcdefABCDEF" for character in raw_secret)
+        ):
+            raise ValueError("fixture_secret_hex must contain exactly 64 hexadecimal characters")
+        secret = bytes.fromhex(raw_secret)
+        source = "request-supplied public synthetic fixture seed"
+    commitment = {
+        "kind": request_context["kind"],
+        "codebook_context": request_context["codebook_context"],
+        "codebook_context_sha256": hashlib.sha256(
+            request_context["codebook_context"].encode("utf-8")
+        ).hexdigest(),
+        "carrier_context": request_context["carrier_context"],
+        "carrier_context_sha256": hashlib.sha256(
+            request_context["carrier_context"].encode("utf-8")
+        ).hexdigest(),
+        "fixture_secret_sha256": hashlib.sha256(secret).hexdigest(),
+        "fixture_secret_source": source,
+        "credential_scope": "public synthetic test identifier; not a production credential",
+    }
+    canonical = json.dumps(commitment, sort_keys=True, separators=(",", ":")).encode(
+        "utf-8"
+    )
+    commitment["context_commitment_sha256"] = hashlib.sha256(canonical).hexdigest()
+    return commitment, secret
+
+
+def _validate_request(
+    request: dict[str, Any],
+) -> tuple[dict[str, Any], dict[str, Any], bytes, Path, Path, Path]:
+    if not isinstance(request, dict):
+        raise ValueError("receiver request must be an object")
+    forbidden = _find_forbidden(request)
+    if forbidden:
+        raise ValueError(f"forbidden evaluator field in receiver request: {forbidden[0]}")
+    missing = REQUEST_KEYS - set(request)
+    if missing:
+        raise ValueError(f"receiver request missing fields: {sorted(missing)}")
+    unexpected = set(request) - REQUEST_KEYS
+    if unexpected:
+        raise ValueError(
+            "unexpected receiver request fields: "
+            f"{sorted(str(field) for field in unexpected)}"
+        )
+    if request["schema"] != "nishan.n1-request/v2":
+        raise ValueError("invalid receiver request schema")
+    if not isinstance(request["request_id"], str) or not request["request_id"]:
+        raise ValueError("request_id must be a nonempty string")
+    if request["carrier"] != REQUIRED_CARRIER:
+        raise ValueError("receiver request changed the exact N1 carrier")
+    config_path = Path(request["receiver_config_path"]).expanduser().resolve()
+    config, config_hash = _load_config(config_path)
+    source = Path(request["source_pdf"]).expanduser().resolve()
+    capture = Path(request["capture_path"]).expanduser().resolve()
+    _verify_hash(source, request["source_sha256"], "source")
+    _verify_hash(capture, request["capture_sha256"], "capture")
+    if not watermark.is_pdf_document(source):
+        raise ValueError("source_pdf must be an exact PDF reference")
+    context_commitment, secret = _context(request["context"])
+    validated = {
+        "request_id": request["request_id"],
+        "source_pdf": str(source),
+        "source_sha256": request["source_sha256"],
+        "capture_path": str(capture),
+        "capture_sha256": request["capture_sha256"],
+        "receiver_config_path": str(config_path),
+        "receiver_config_sha256": config_hash,
+        "carrier": dict(REQUIRED_CARRIER),
+    }
+    return validated, context_commitment, secret, source, capture, config_path
+
+
+def _luma(image: np.ndarray) -> np.ndarray:
+    return watermark._luma(np.asarray(image, dtype=np.uint8)).astype(np.float32)
+
+
+def _registration_overlap(
+    capture_shape: tuple[int, ...],
+    source_shape: tuple[int, ...],
+    matrix: np.ndarray,
+) -> float:
+    mask = np.ones(capture_shape[:2], dtype=np.uint8)
+    warped = cv2.warpPerspective(
+        mask,
+        matrix,
+        (source_shape[1], source_shape[0]),
+        flags=cv2.INTER_NEAREST,
+        borderMode=cv2.BORDER_CONSTANT,
+        borderValue=0,
+    )
+    return float(np.mean(warped > 0))
+
+
+def _source_content_residual(
+    source: np.ndarray,
+    candidate: np.ndarray,
+    configuration: dict[str, Any],
+) -> dict[str, Any]:
+    """Fit a photometric residual on support defined only by source content."""
+
+    sigma = float(configuration["same_size_retry_content_blur_sigma"])
+    source_gray = cv2.GaussianBlur(_luma(source) / 255.0, (0, 0), sigma)
+    candidate_gray = cv2.GaussianBlur(_luma(candidate) / 255.0, (0, 0), sigma)
+    source_gradient = cv2.magnitude(
+        cv2.Sobel(source_gray, cv2.CV_32F, 1, 0, ksize=3),
+        cv2.Sobel(source_gray, cv2.CV_32F, 0, 1, ksize=3),
+    )
+    support = (
+        source_gray < float(configuration["same_size_retry_source_ink_threshold"])
+    ) | (
+        source_gradient
+        > float(configuration["same_size_retry_source_gradient_threshold"])
+    )
+    dilation = int(configuration["same_size_retry_support_dilation_pixels"])
+    support = cv2.dilate(
+        support.astype(np.uint8),
+        np.ones((dilation, dilation), dtype=np.uint8),
+    ).astype(bool)
+    sample_count = int(np.count_nonzero(support))
+    minimum_samples = int(configuration["same_size_retry_minimum_support_pixels"])
+    if sample_count < minimum_samples:
+        return {
+            "status": "unusable",
+            "reason": f"only {sample_count} source-content support pixels",
+            "samples": sample_count,
+            "rank": 0,
+            "condition_number": None,
+            "gain": None,
+            "offset": None,
+            "normalized_rmse": None,
+        }
+
+    reference_values = source_gray[support].astype(np.float64)
+    candidate_values = candidate_gray[support].astype(np.float64)
+    design = np.column_stack((reference_values, np.ones_like(reference_values)))
+    coefficients, _, rank, singular_values = np.linalg.lstsq(
+        design, candidate_values, rcond=None
+    )
+    if rank != 2 or singular_values[-1] <= 0.0:
+        return {
+            "status": "unusable",
+            "reason": "source-content photometric fit is rank deficient",
+            "samples": sample_count,
+            "rank": int(rank),
+            "condition_number": None,
+            "gain": None,
+            "offset": None,
+            "normalized_rmse": None,
+        }
+    gain, offset = (float(value) for value in coefficients)
+    residual = candidate_values - (gain * reference_values + offset)
+    centered = candidate_values - float(candidate_values.mean())
+    scale = float(np.sqrt(np.mean(np.square(centered))))
+    condition = float(singular_values[0] / singular_values[-1])
+    if not np.isfinite(scale) or scale <= 1e-12:
+        return {
+            "status": "unusable",
+            "reason": "source-content candidate has no measurable variation",
+            "samples": sample_count,
+            "rank": int(rank),
+            "condition_number": condition,
+            "gain": gain,
+            "offset": offset,
+            "normalized_rmse": None,
+        }
+    normalized_rmse = float(np.sqrt(np.mean(np.square(residual))) / scale)
+    return {
+        "status": "fitted",
+        "reason": None,
+        "samples": sample_count,
+        "rank": int(rank),
+        "condition_number": condition,
+        "gain": gain,
+        "offset": offset,
+        "normalized_rmse": normalized_rmse,
+    }
+
+
+def _same_size_renderer_retry(
+    source: np.ndarray,
+    capture: np.ndarray,
+    configuration: dict[str, Any],
+    trigger: str,
+) -> tuple[np.ndarray | None, dict[str, Any]]:
+    """Try one bounded, content-only affine fit for equal-sized renderings."""
+
+    retry: dict[str, Any] = {
+        "attempted": True,
+        "accepted": False,
+        "trigger": trigger,
+        "fit_scope": (
+            "visible source and capture content only; no carrier bits or recipient rows"
+        ),
+        "motion": "affine",
+        "bounds": {
+            "minimum_ecc_correlation": float(
+                configuration["same_size_retry_minimum_ecc_correlation"]
+            ),
+            "maximum_condition_number": float(
+                configuration["same_size_retry_maximum_condition_number"]
+            ),
+            "maximum_scale_deviation": float(
+                configuration["same_size_retry_maximum_scale_deviation"]
+            ),
+            "maximum_translation_pixels": float(
+                configuration["same_size_retry_maximum_translation_pixels"]
+            ),
+            "minimum_overlap_fraction": float(
+                configuration["same_size_retry_minimum_overlap_fraction"]
+            ),
+            "minimum_support_pixels": int(
+                configuration["same_size_retry_minimum_support_pixels"]
+            ),
+            "maximum_normalized_rmse": float(
+                configuration["same_size_retry_maximum_normalized_rmse"]
+            ),
+            "minimum_normalized_rmse_improvement": float(
+                configuration["same_size_retry_minimum_rmse_improvement"]
+            ),
+            "minimum_registered_similarity": float(
+                configuration["minimum_accepted_similarity"]
+            ),
+        },
+    }
+    if capture.shape[:2] != source.shape[:2]:
+        retry["attempted"] = False
+        retry["reason"] = "retry requires exact same-size rasters"
+        retry["criteria_passed"] = {}
+        return None, retry
+
+    source_gray = cv2.cvtColor(source, cv2.COLOR_RGB2GRAY).astype(np.float32) / 255.0
+    capture_gray = (
+        cv2.cvtColor(capture, cv2.COLOR_RGB2GRAY).astype(np.float32) / 255.0
+    )
+    template_to_capture = np.eye(2, 3, dtype=np.float32)
+    try:
+        coefficient, template_to_capture = cv2.findTransformECC(
+            source_gray,
+            capture_gray,
+            template_to_capture,
+            cv2.MOTION_AFFINE,
+            (
+                cv2.TERM_CRITERIA_COUNT | cv2.TERM_CRITERIA_EPS,
+                int(configuration["ecc_max_iterations"]),
+                float(configuration["ecc_stop_epsilon"]),
+            ),
+            None,
+            int(configuration["ecc_gaussian_size"]),
+        )
+    except cv2.error as error:
+        retry["reason"] = f"content-only ECC fit failed: {error}"
+        retry["criteria_passed"] = {}
+        return None, retry
+
+    template_to_capture_3x3 = np.eye(3, dtype=np.float64)
+    template_to_capture_3x3[:2] = template_to_capture.astype(np.float64)
+    try:
+        raw_to_reference = np.linalg.inv(template_to_capture_3x3)
+        singular_values = np.linalg.svd(
+            raw_to_reference[:2, :2], compute_uv=False
+        )
+    except np.linalg.LinAlgError as error:
+        retry["reason"] = f"content-only ECC transform is singular: {error}"
+        retry["criteria_passed"] = {}
+        return None, retry
+
+    minimum_singular = float(np.min(singular_values))
+    if (
+        not np.isfinite(coefficient)
+        or not np.all(np.isfinite(raw_to_reference))
+        or not np.all(np.isfinite(singular_values))
+        or minimum_singular <= 0.0
+    ):
+        retry["reason"] = "content-only ECC returned a non-finite or singular transform"
+        retry["ecc_coefficient"] = _json_float(coefficient)
+        retry["criteria_passed"] = {"finite": False}
+        return None, retry
+
+    rendered = cv2.warpPerspective(
+        capture,
+        raw_to_reference,
+        (source.shape[1], source.shape[0]),
+        flags=cv2.INTER_LANCZOS4,
+        borderMode=cv2.BORDER_CONSTANT,
+        borderValue=(255, 255, 255),
+    )
+    overlap = _registration_overlap(capture.shape, source.shape, raw_to_reference)
+    baseline_residual = _source_content_residual(source, capture, configuration)
+    registered_residual = _source_content_residual(source, rendered, configuration)
+    baseline_rmse = baseline_residual["normalized_rmse"]
+    registered_rmse = registered_residual["normalized_rmse"]
+    residual_improvement = (
+        float(baseline_rmse - registered_rmse)
+        if isinstance(baseline_rmse, float) and isinstance(registered_rmse, float)
+        else None
+    )
+    determinant = float(np.linalg.det(raw_to_reference[:2, :2]))
+    maximum_singular = float(np.max(singular_values))
+    condition = maximum_singular / minimum_singular
+    scale_deviation = float(np.max(np.abs(singular_values - 1.0)))
+    translation = float(np.linalg.norm(raw_to_reference[:2, 2]))
+    registered_similarity = registration._similarity(
+        cv2.cvtColor(source, cv2.COLOR_RGB2GRAY),
+        cv2.cvtColor(rendered, cv2.COLOR_RGB2GRAY),
+    )
+    finite = bool(
+        np.all(np.isfinite(raw_to_reference))
+        and np.isfinite(coefficient)
+        and np.isfinite(condition)
+        and np.isfinite(determinant)
+        and np.isfinite(registered_similarity)
+    )
+    criteria = {
+        "finite": finite,
+        "orientation_preserved": determinant > 0.0,
+        "ecc_content_correlation": (
+            finite
+            and float(coefficient)
+            >= float(configuration["same_size_retry_minimum_ecc_correlation"])
+        ),
+        "affine_condition": (
+            finite
+            and condition
+            <= float(configuration["same_size_retry_maximum_condition_number"])
+        ),
+        "scale_deviation": (
+            finite
+            and scale_deviation
+            <= float(configuration["same_size_retry_maximum_scale_deviation"])
+        ),
+        "translation": (
+            finite
+            and translation
+            <= float(configuration["same_size_retry_maximum_translation_pixels"])
+        ),
+        "overlap": (
+            finite
+            and overlap
+            >= float(configuration["same_size_retry_minimum_overlap_fraction"])
+        ),
+        "source_content_support": (
+            baseline_residual["status"] == "fitted"
+            and registered_residual["status"] == "fitted"
+        ),
+        "source_content_residual": (
+            isinstance(registered_rmse, float)
+            and registered_rmse
+            <= float(configuration["same_size_retry_maximum_normalized_rmse"])
+        ),
+        "source_content_residual_improvement": (
+            isinstance(residual_improvement, float)
+            and residual_improvement
+            >= float(configuration["same_size_retry_minimum_rmse_improvement"])
+        ),
+        "registered_similarity_floor": (
+            finite
+            and registered_similarity
+            >= float(configuration["minimum_accepted_similarity"])
+        ),
+    }
+    retry.update(
+        {
+            "ecc_coefficient": float(coefficient),
+            "template_to_capture": template_to_capture.tolist(),
+            "raw_to_reference": raw_to_reference.tolist(),
+            "singular_values": [float(value) for value in singular_values],
+            "condition_number": _json_float(condition),
+            "determinant": determinant,
+            "maximum_scale_deviation": scale_deviation,
+            "translation_pixels": translation,
+            "overlap_fraction": overlap,
+            "registered_similarity": _json_float(registered_similarity),
+            "baseline_content_residual": baseline_residual,
+            "registered_content_residual": registered_residual,
+            "normalized_rmse_improvement": _json_float(residual_improvement)
+            if residual_improvement is not None
+            else None,
+            "criteria_passed": criteria,
+            "accepted": bool(all(criteria.values())),
+        }
+    )
+    retry["reason"] = (
+        None
+        if retry["accepted"]
+        else "bounded same-size renderer retry failed one or more frozen criteria"
+    )
+    return (rendered if retry["accepted"] else None), retry
+
+
+def _align(
+    source: np.ndarray,
+    capture: np.ndarray,
+    configuration: dict[str, Any],
+) -> tuple[np.ndarray, dict[str, Any]]:
+    aligned, metrics = registration.align_page(
+        source,
+        capture,
+        min_matches=int(configuration["orb_min_matches"]),
+        min_inliers=int(configuration["orb_min_inliers"]),
+        min_inlier_ratio=float(configuration["orb_min_inlier_ratio"]),
+        improvement_margin=float(configuration["orb_improvement_margin"]),
+    )
+    diagnostic = metrics.to_dict()
+    diagnostic["injected_geometry_used_as_evidence"] = False
+    # Registration can reject before a warp exists.  Preserve a stable
+    # diagnostic shape without pretending that overlap was measured.
+    diagnostic["overlap_fraction"] = None
+    diagnostic["hard_gate_passed"] = False
+    if metrics.rejection_reason is not None:
+        rendered, retry = _same_size_renderer_retry(
+            source,
+            capture,
+            configuration,
+            str(metrics.rejection_reason),
+        )
+        diagnostic["same_size_retry"] = retry
+        if rendered is not None:
+            diagnostic["orb_candidate_registered_similarity"] = diagnostic[
+                "registered_similarity"
+            ]
+            diagnostic["orb_candidate_rejection_reason"] = diagnostic[
+                "rejection_reason"
+            ]
+            diagnostic["discarded_orb_homography_suspect_to_reference"] = (
+                diagnostic["homography_suspect_to_reference"]
+            )
+            diagnostic["homography_suspect_to_reference"] = retry[
+                "raw_to_reference"
+            ]
+            diagnostic["method"] = "same-size ECC-affine renderer retry"
+            diagnostic["mode"] = (
+                "same-size content-only ECC-affine renderer retry"
+            )
+            diagnostic["applied"] = True
+            diagnostic["registered_similarity"] = round(
+                float(retry["registered_similarity"]), 6
+            )
+            diagnostic["rejection_reason"] = None
+            diagnostic["ecc_coefficient"] = retry["ecc_coefficient"]
+            diagnostic["ecc_inverse_warp"] = retry["template_to_capture"]
+            diagnostic["raw_to_reference"] = retry["raw_to_reference"]
+            diagnostic["overlap_fraction"] = retry["overlap_fraction"]
+            diagnostic["single_final_resampling_from_original_capture"] = True
+            diagnostic["hard_gate_passed"] = True
+            return rendered, diagnostic
+        raise InconclusiveError(
+            "registration rejected: " + str(metrics.rejection_reason), diagnostic
+        )
+    if metrics.registered_similarity < float(
+        configuration["minimum_accepted_similarity"]
+    ):
+        diagnostic["hard_gate_passed"] = False
+        raise InconclusiveError(
+            "registration content similarity below hard gate", diagnostic
+        )
+
+    if metrics.applied:
+        if metrics.homography_suspect_to_reference is None:
+            diagnostic["hard_gate_passed"] = False
+            raise InconclusiveError(
+                "accepted registration omitted its transform", diagnostic
+            )
+        source_gray = cv2.cvtColor(source, cv2.COLOR_RGB2GRAY).astype(np.float32) / 255.0
+        aligned_gray = cv2.cvtColor(aligned, cv2.COLOR_RGB2GRAY).astype(np.float32) / 255.0
+        affine = np.eye(2, 3, dtype=np.float32)
+        try:
+            coefficient, affine = cv2.findTransformECC(
+                source_gray,
+                aligned_gray,
+                affine,
+                cv2.MOTION_AFFINE,
+                (
+                    cv2.TERM_CRITERIA_COUNT | cv2.TERM_CRITERIA_EPS,
+                    int(configuration["ecc_max_iterations"]),
+                    float(configuration["ecc_stop_epsilon"]),
+                ),
+                None,
+                int(configuration["ecc_gaussian_size"]),
+            )
+        except cv2.error as error:
+            diagnostic["hard_gate_passed"] = False
+            raise InconclusiveError(
+                f"content-only ECC refinement failed: {error}", diagnostic
+            ) from error
+        inverse = np.eye(3, dtype=np.float64)
+        inverse[:2] = affine.astype(np.float64)
+        combined = np.linalg.inv(inverse) @ np.asarray(
+            metrics.homography_suspect_to_reference, dtype=np.float64
+        )
+        if not np.all(np.isfinite(combined)):
+            diagnostic["hard_gate_passed"] = False
+            raise InconclusiveError(
+                "registration transform is not finite", diagnostic
+            )
+        rendered = cv2.warpPerspective(
+            capture,
+            combined,
+            (source.shape[1], source.shape[0]),
+            flags=cv2.INTER_LANCZOS4,
+            borderMode=cv2.BORDER_CONSTANT,
+            borderValue=(255, 255, 255),
+        )
+        overlap = _registration_overlap(capture.shape, source.shape, combined)
+        diagnostic["mode"] = "ORB/RANSAC plus content-only ECC-affine"
+        diagnostic["ecc_coefficient"] = float(coefficient)
+        diagnostic["ecc_inverse_warp"] = affine.tolist()
+        diagnostic["raw_to_reference"] = combined.tolist()
+        diagnostic["single_final_resampling_from_original_capture"] = True
+    else:
+        rendered = aligned
+        combined = np.eye(3, dtype=np.float64)
+        overlap = 1.0
+        diagnostic["mode"] = "same-geometry content-similarity guard"
+        diagnostic["raw_to_reference"] = combined.tolist()
+        diagnostic["single_final_resampling_from_original_capture"] = True
+    diagnostic["overlap_fraction"] = overlap
+    diagnostic["hard_gate_passed"] = overlap >= float(
+        configuration["minimum_overlap_fraction"]
+    )
+    if not diagnostic["hard_gate_passed"]:
+        raise InconclusiveError("registration overlap below hard gate", diagnostic)
+    return rendered, diagnostic
+
+
+def _source_response(
+    source_path: Path,
+    source_luma: np.ndarray,
+    biases: np.ndarray,
+    secret: bytes,
+    carrier_context: str,
+    carrier: dict[str, Any],
+) -> dict[str, Any]:
+    height, width = source_luma.shape
+    rows, columns = height // carrier["block"], width // carrier["block"]
+    capacity = rows * columns
+    if capacity < carrier["m"]:
+        raise InconclusiveError(
+            f"full carrier needs {carrier['m']} blocks but source has {capacity}"
+        )
+    order, orientation, polarity = tardos_carrier._plan(
+        secret, carrier_context, capacity, carrier["m"]
+    )
+    endpoints: list[np.ndarray] = []
+    with tempfile.TemporaryDirectory(prefix="nishan-n1-v2-endpoints-") as temporary:
+        temporary_root = Path(temporary)
+        for bit in (0, 1):
+            destination = temporary_root / f"endpoint-{bit}.pdf"
+            tardos_carrier.embed_pdf(
+                source_path,
+                destination,
+                np.full(carrier["m"], bit, dtype=np.uint8),
+                secret,
+                carrier_context,
+                strength=carrier["strength"],
+                dpi=carrier["dpi"],
+                block_size=carrier["block"],
+            )
+            pages, _ = watermark.load_pages(destination, dpi=carrier["dpi"])
+            if len(pages) != 1 or pages[0].shape[:2] != source_luma.shape:
+                raise InconclusiveError("rendered endpoint geometry changed")
+            endpoints.append(_luma(pages[0]))
+    probabilities = np.zeros(capacity, dtype=np.float32)
+    probabilities[order] = compound_score.implemented_probabilities(biases).astype(
+        np.float32
+    )
+    probability_crop = np.repeat(
+        np.repeat(probabilities.reshape(rows, columns), carrier["block"], axis=0),
+        carrier["block"],
+        axis=1,
+    )
+    probability_image = np.zeros(source_luma.shape, dtype=np.float32)
+    probability_image[: probability_crop.shape[0], : probability_crop.shape[1]] = (
+        probability_crop
+    )
+    expectation = endpoints[0] + probability_image * (endpoints[1] - endpoints[0])
+    return {
+        "capacity_symbols": capacity,
+        "order": order,
+        "orientation": orientation,
+        "polarity": polarity,
+        "base_templates": tardos_carrier._templates(carrier["block"]),
+        "endpoint_zero": endpoints[0],
+        "endpoint_one": endpoints[1],
+        "expectation": expectation.astype(np.float32),
+        "endpoint_zero_sha256": _array_hash(endpoints[0]),
+        "endpoint_one_sha256": _array_hash(endpoints[1]),
+        "expectation_sha256": _array_hash(expectation.astype(np.float32)),
+    }
+
+
+def _code_hashes() -> dict[str, str]:
+    paths = {
+        "research/n1_v2/receiver_api.py": Path(__file__),
+        "research/n1_v2/channel_fit.py": Path(channel_fit.__file__),
+        "research/n1_v2/compound_score.py": Path(compound_score.__file__),
+        "research/n1_v2/receiver_config.json": CONFIG_PATH,
+        "prototypes/nishan_pq/nishan/tardos.py": Path(tardos.__file__),
+        "prototypes/nishan_pq/nishan/tardos_carrier.py": Path(tardos_carrier.__file__),
+        "prototypes/nishan_pq/nishan/registration.py": Path(registration.__file__),
+        "prototypes/nishan_pq/nishan/watermark.py": Path(watermark.__file__),
+    }
+    return {name: _sha256(path) for name, path in paths.items()}
+
+
+def _config_commit() -> str | None:
+    try:
+        result = subprocess.run(
+            ["git", "log", "-1", "--format=%H", "--", _relative(CONFIG_PATH)],
+            cwd=ROOT,
+            check=True,
+            capture_output=True,
+            text=True,
+        ).stdout.strip()
+    except (OSError, subprocess.CalledProcessError):
+        return None
+    return result or None
+
+
+def _inconclusive_profiles(reason: str) -> dict[str, dict[str, Any]]:
+    return {
+        profile: {"status": "inconclusive", "reason": reason}
+        for profile in PROFILE_KEYS
+    }
+
+
+def _store_profile_arrays(
+    arrays: dict[str, np.ndarray],
+    profile: str,
+    result: dict[str, Any],
+    biases: np.ndarray,
+) -> dict[str, Any]:
+    erased = np.asarray(result["erased"], dtype=bool)
+    if np.all(erased):
+        return {
+            "status": "inconclusive",
+            "reason": "all symbols erased by endpoint-energy/noise diagnostics",
+            "diagnostics": result["diagnostics"],
+        }
+    q0, q1, evidence_diagnostics = compound_score.compound_log_evidence(
+        biases,
+        result["observations"],
+        result["variances"],
+        result["log_weights"],
+        erased,
+        kind="average",
+        coalition_size=1,
+    )
+    keys = {
+        "observations_key": f"{profile}_observations",
+        "variances_key": f"{profile}_variances",
+        "log_weights_key": f"{profile}_log_weights",
+        "erased_key": f"{profile}_erased",
+        "q0_key": f"{profile}_q0",
+        "q1_key": f"{profile}_q1",
+    }
+    arrays[keys["observations_key"]] = np.asarray(result["observations"], dtype=np.float32)
+    arrays[keys["variances_key"]] = np.asarray(result["variances"], dtype=np.float32)
+    arrays[keys["log_weights_key"]] = np.asarray(result["log_weights"], dtype=np.float32)
+    arrays[keys["erased_key"]] = erased
+    arrays[keys["q0_key"]] = q0
+    arrays[keys["q1_key"]] = q1
+    return {
+        "status": "prepared",
+        **keys,
+        "diagnostics": result["diagnostics"],
+        "single_symbol_evidence": evidence_diagnostics,
+        "candidate_independent": True,
+    }
+
+
+def _hard_profile(
+    arrays: dict[str, np.ndarray],
+    capture_luma: np.ndarray,
+    source_luma: np.ndarray,
+    response: dict[str, Any],
+    biases: np.ndarray,
+    erased: np.ndarray,
+    error_probability: float,
+    block_size: int,
+) -> dict[str, Any]:
+    indices = np.asarray(response["order"], dtype=np.int64)
+    templates = (
+        response["base_templates"][response["orientation"]]
+        * response["polarity"][:, None, None]
+    ).astype(np.float32)
+    residual = np.asarray(capture_luma, dtype=np.float32) - np.asarray(
+        source_luma, dtype=np.float32
+    )
+    blocks = channel_fit.block_view(residual, block_size)[indices]
+    correlations = np.sum(blocks * templates, axis=(1, 2), dtype=np.float32)
+    word = (correlations > 0.0).astype(np.uint8)
+    missing = np.asarray(erased, dtype=bool) | ~np.isfinite(correlations)
+    if np.all(missing):
+        return {
+            "status": "inconclusive",
+            "reason": "all hard symbols erased",
+        }
+    q0, q1, diagnostics = compound_score.hard_log_evidence(
+        biases, word, missing, error_probability
+    )
+    keys = {
+        "word_key": "hard_word",
+        "correlations_key": "hard_correlations",
+        "erased_key": "hard_erased",
+        "q0_key": "hard_q0",
+        "q1_key": "hard_q1",
+    }
+    arrays[keys["word_key"]] = word
+    arrays[keys["correlations_key"]] = correlations
+    arrays[keys["erased_key"]] = missing
+    arrays[keys["q0_key"]] = q0
+    arrays[keys["q1_key"]] = q1
+    return {
+        "status": "prepared",
+        **keys,
+        "diagnostics": diagnostics
+        | {
+            "correlation_quantiles": [
+                float(value)
+                for value in np.quantile(correlations[~missing], [0.1, 0.5, 0.9])
+            ],
+            "zero_correlation_fraction": float(np.mean(correlations == 0.0)),
+        },
+        "candidate_independent": True,
+    }
+
+
+def _write_preparation(
+    output: Path,
+    payload: dict[str, Any],
+    arrays: dict[str, np.ndarray],
+) -> dict[str, Any]:
+    if output.exists():
+        raise FileExistsError(output)
+    output.mkdir(parents=True, exist_ok=False)
+    evidence_path = output / "evidence.npz"
+    with evidence_path.open("xb") as stream:
+        np.savez_compressed(stream, **arrays)
+    payload["array_sha256"] = {
+        name: _array_hash(value) for name, value in arrays.items()
+    }
+    payload["evidence_sha256"] = _sha256(evidence_path)
+    payload["commitment"] = _canonical_hash(
+        {
+            "schema": payload["schema"],
+            "request_id": payload["request_id"],
+            "receiver_config_sha256": payload["receiver_config_sha256"],
+            "input_sha256": payload["input_sha256"],
+            "context_commitment": payload["context_commitment"],
+            "implementation_sha256": payload["implementation_sha256"],
+            "array_sha256": payload["array_sha256"],
+            "evidence_sha256": payload["evidence_sha256"],
+        }
+    )
+    _write_exclusive(output / "prepared.json", payload)
+    commitment = {
+        "schema": "nishan.n1-prepared-commitment/v2",
+        "sha256": {
+            "prepared.json": _sha256(output / "prepared.json"),
+            "evidence.npz": _sha256(evidence_path),
+        },
+        "receiver_config_sha256": payload["receiver_config_sha256"],
+        "input_sha256": payload["input_sha256"],
+    }
+    _write_exclusive(output / "commitment.json", commitment)
+    return payload
+
+
+def prepare_request(request: dict, output_directory: str) -> dict:
+    """Prepare and commit candidate-independent receiver evidence."""
+
+    started = time.perf_counter()
+    output = Path(output_directory).expanduser().resolve()
+    if output.exists():
+        raise FileExistsError(output)
+    cv2.setNumThreads(2)
+    validated, context_commitment, secret, source_path, capture_path, config_path = (
+        _validate_request(request)
+    )
+    config, config_hash = _load_config(config_path)
+    parameter = _configuration()
+    biases, empty = tardos.generate_keyed(
+        replace(parameter, roster_size=0),
+        secret,
+        context_commitment["codebook_context"],
+    )
+    if empty.shape != (0, parameter.code_length):
+        raise AssertionError("zero-roster generator returned recipient rows")
+    arrays: dict[str, np.ndarray] = {"biases": biases}
+    source_pages, _ = watermark.load_pages(source_path, dpi=REQUIRED_CARRIER["dpi"])
+    if len(source_pages) != 1:
+        raise ValueError("source PDF must contain exactly one page")
+    source_rgb = source_pages[0]
+    source_luma = _luma(source_rgb)
+    support, source_diagnostics = channel_fit.select_source_support(
+        source_luma, config["source_support"]
+    )
+    local_support = channel_fit.source_feature_mask(
+        source_luma, config["source_support"]
+    )
+    source_diagnostics["dense_local_content_pixels"] = int(
+        np.count_nonzero(local_support)
+    )
+    source_diagnostics["dense_local_content_sha256"] = _array_hash(local_support)
+    source_diagnostics["local_support_scope"] = (
+        "source-only eligible edges under the same frozen gradient/tone bounds; "
+        "no recipient row, target score, or carrier correlation"
+    )
+    source_diagnostics["capacity_symbols"] = (
+        source_luma.shape[0] // REQUIRED_CARRIER["block"]
+    ) * (source_luma.shape[1] // REQUIRED_CARRIER["block"])
+    profiles: dict[str, dict[str, Any]]
+    registration_diagnostics: dict[str, Any] | None = None
+    fit: dict[str, Any] | None = None
+    endpoint_diagnostics: dict[str, Any] | None = None
+
+    if source_diagnostics["status"] != "usable":
+        profiles = _inconclusive_profiles(source_diagnostics["reason"])
+    else:
+        try:
+            capture_pages, _ = watermark.load_pages(
+                capture_path, dpi=REQUIRED_CARRIER["dpi"]
+            )
+            if len(capture_pages) != 1:
+                raise InconclusiveError("capture must contain exactly one page")
+            aligned_rgb, registration_diagnostics = _align(
+                source_rgb, capture_pages[0], config["registration"]
+            )
+            capture_luma = _luma(aligned_rgb)
+            response = _source_response(
+                source_path,
+                source_luma,
+                biases,
+                secret,
+                context_commitment["carrier_context"],
+                REQUIRED_CARRIER,
+            )
+            endpoint_diagnostics = {
+                "capacity_symbols": response["capacity_symbols"],
+                "endpoint_zero_sha256": response["endpoint_zero_sha256"],
+                "endpoint_one_sha256": response["endpoint_one_sha256"],
+                "expectation_sha256": response["expectation_sha256"],
+                "endpoint_interpolation": "linear in rendered luma",
+            }
+            fit = channel_fit.fit_global_channel(
+                response["expectation"],
+                capture_luma,
+                support,
+                config["global_channel"],
+            )
+            component_configuration = config["global_channel"] | {
+                "minimum_endpoint_energy": config["evidence"][
+                    "minimum_endpoint_energy"
+                ],
+                "maximum_variance": config["evidence"]["maximum_variance"],
+            }
+            global_result = channel_fit.global_components(
+                capture_luma,
+                response["expectation"],
+                response["endpoint_zero"],
+                response["endpoint_one"],
+                source_luma,
+                response["order"],
+                fit,
+                component_configuration,
+                block_size=REQUIRED_CARRIER["block"],
+            )
+            profiles = {}
+            profiles["hard"] = _hard_profile(
+                arrays,
+                capture_luma,
+                source_luma,
+                response,
+                biases,
+                global_result["erased"],
+                float(config["evidence"]["hard_bit_error_probability"]),
+                REQUIRED_CARRIER["block"],
+            )
+            profiles["global_soft"] = _store_profile_arrays(
+                arrays, "global_soft", global_result, biases
+            )
+            try:
+                local_result = channel_fit.local_components(
+                    capture_luma,
+                    response["expectation"],
+                    response["endpoint_zero"],
+                    response["endpoint_one"],
+                    source_luma,
+                    local_support,
+                    response["order"],
+                    fit,
+                    global_result,
+                    component_configuration,
+                    config["local_channel"],
+                    block_size=REQUIRED_CARRIER["block"],
+                )
+                profiles["local_soft"] = _store_profile_arrays(
+                    arrays, "local_soft", local_result, biases
+                )
+            except (ValueError, cv2.error) as error:
+                profiles["local_soft"] = {
+                    "status": "inconclusive",
+                    "reason": f"local channel failed: {type(error).__name__}: {error}",
+                }
+        except (InconclusiveError, ValueError, cv2.error) as error:
+            if isinstance(error, InconclusiveError) and error.diagnostics is not None:
+                registration_diagnostics = error.diagnostics
+            profiles = _inconclusive_profiles(f"{type(error).__name__}: {error}")
+
+    status = (
+        "prepared"
+        if any(item["status"] == "prepared" for item in profiles.values())
+        else "inconclusive"
+    )
+    public_secret_hex = secret.hex()
+    code_hashes = _code_hashes()
+    payload: dict[str, Any] = {
+        "schema": "nishan.n1-prepared/v2",
+        "status": status,
+        "request_id": validated["request_id"],
+        "carrier": dict(REQUIRED_CARRIER),
+        "receiver_config_path": str(config_path),
+        "receiver_config_sha256": config_hash,
+        "receiver_config_commit": _config_commit(),
+        "input_paths": {
+            "source_pdf": str(source_path),
+            "capture_path": str(capture_path),
+        },
+        "input_sha256": {
+            "source_pdf": validated["source_sha256"],
+            "capture_path": validated["capture_sha256"],
+        },
+        "context_commitment": context_commitment,
+        "scoring_context": {
+            "codebook_context": context_commitment["codebook_context"],
+            "carrier_context": context_commitment["carrier_context"],
+            "public_fixture_secret_hex": public_secret_hex,
+            "warning": "public synthetic test identifier; not a production credential",
+        },
+        "roster_rows_loaded": 0,
+        "labels_loaded": False,
+        "source_diagnostics": source_diagnostics,
+        "registration": registration_diagnostics,
+        "global_channel_fit": fit,
+        "endpoint_diagnostics": endpoint_diagnostics,
+        "profiles": profiles,
+        "code_sha256": code_hashes,
+        "implementation_sha256": _mapping_hash(code_hashes),
+        "runtime": {
+            "elapsed_seconds": time.perf_counter() - started,
+            "opencv_threads": cv2.getNumThreads(),
+            "peak_rss_kib": int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss),
+            "python": platform.python_version(),
+            "numpy": np.__version__,
+            "opencv": cv2.__version__,
+        },
+        "warnings": [
+            "Preparation loaded no recipient row, evaluator label, or expected contributor.",
+            "Source eligibility is a separate source-only diagnostic.",
+            "Registration rejection hard-gates all attribution profiles.",
+            "Physical confirmation remains pending real frozen-stage captures.",
+        ],
+    }
+    return _write_preparation(output, payload, arrays)
+
+
+def _validate_prepared(
+    directory: Path,
+) -> tuple[dict[str, Any], dict[str, Any], dict[str, np.ndarray]]:
+    commitment_path = directory / "commitment.json"
+    prepared_path = directory / "prepared.json"
+    evidence_path = directory / "evidence.npz"
+    if not commitment_path.is_file():
+        raise ValueError("missing preparation commitment")
+    commitment = json.loads(commitment_path.read_text())
+    if commitment.get("schema") != "nishan.n1-prepared-commitment/v2":
+        raise ValueError("invalid preparation commitment schema")
+    expected_inventory = {"prepared.json", "evidence.npz"}
+    if set(commitment.get("sha256", {})) != expected_inventory:
+        raise ValueError("invalid preparation commitment inventory")
+    for name, expected in commitment["sha256"].items():
+        if not (directory / name).is_file() or _sha256(directory / name) != expected:
+            raise ValueError(f"preparation commitment mismatch: {name}")
+    prepared = json.loads(prepared_path.read_text())
+    if prepared.get("schema") != "nishan.n1-prepared/v2":
+        raise ValueError("invalid prepared metadata schema")
+    scalar_commitment = prepared.get("commitment")
+    if (
+        not isinstance(scalar_commitment, str)
+        or len(scalar_commitment) != 64
+        or any(character not in "0123456789abcdef" for character in scalar_commitment)
+    ):
+        raise ValueError("invalid prepared scalar commitment")
+    expected_scalar_commitment = _canonical_hash(
+        {
+            "schema": prepared["schema"],
+            "request_id": prepared["request_id"],
+            "receiver_config_sha256": prepared["receiver_config_sha256"],
+            "input_sha256": prepared["input_sha256"],
+            "context_commitment": prepared["context_commitment"],
+            "implementation_sha256": prepared["implementation_sha256"],
+            "array_sha256": prepared["array_sha256"],
+            "evidence_sha256": prepared["evidence_sha256"],
+        }
+    )
+    if scalar_commitment != expected_scalar_commitment:
+        raise ValueError("prepared scalar commitment mismatch")
+    if prepared.get("roster_rows_loaded") != 0 or prepared.get("labels_loaded") is not False:
+        raise ValueError("prepared stage-separation assertion failed")
+    config_path = Path(prepared["receiver_config_path"])
+    _, config_hash = _load_config(config_path)
+    if config_hash != prepared["receiver_config_sha256"]:
+        raise ValueError("prepared receiver config hash mismatch")
+    for name, path in prepared["input_paths"].items():
+        _verify_hash(Path(path), prepared["input_sha256"][name], name)
+    current_hashes = _code_hashes()
+    if current_hashes != prepared["code_sha256"]:
+        raise ValueError("prepared code hash mismatch")
+    if _mapping_hash(current_hashes) != prepared.get("implementation_sha256"):
+        raise ValueError("prepared implementation aggregate hash mismatch")
+    if _sha256(evidence_path) != prepared["evidence_sha256"]:
+        raise ValueError("prepared evidence hash mismatch")
+    arrays: dict[str, np.ndarray] = {}
+    with np.load(evidence_path, allow_pickle=False) as stored:
+        if set(stored.files) != set(prepared["array_sha256"]):
+            raise ValueError("prepared array inventory mismatch")
+        for name in stored.files:
+            arrays[name] = stored[name].copy()
+            if _array_hash(arrays[name]) != prepared["array_sha256"][name]:
+                raise ValueError(f"prepared array hash mismatch: {name}")
+    return prepared, commitment, arrays
+
+
+def _score_evidence(
+    biases: np.ndarray,
+    codebook: np.ndarray,
+    q0: np.ndarray,
+    q1: np.ndarray,
+    family_alpha: float,
+    hypothesis_count: int,
+) -> tuple[dict[str, Any], np.ndarray]:
+    calibration = compound_score.conditional_chernoff(
+        biases, q0, q1, family_alpha, hypothesis_count
+    )
+    if calibration["status"] != "calibrated":
+        raise InconclusiveError(calibration["reason"])
+    scores = compound_score.score_rows(codebook, q0, q1)
+    threshold = float(calibration["threshold"])
+    accused = np.flatnonzero(scores > threshold).astype(int).tolist()
+    return {
+        "scores": scores.tolist(),
+        "threshold": threshold,
+        "accused_rows": accused,
+        "calibration": calibration,
+        "q0_sha256": _array_hash(q0),
+        "q1_sha256": _array_hash(q1),
+    }, scores
+
+
+def score_prepared(
+    prepared_directory: str,
+    family_alpha: float,
+    hypothesis_count: int,
+) -> dict:
+    """Validate preparation, create all 1,000 rows, and score every profile."""
+
+    started = time.perf_counter()
+    cv2.setNumThreads(2)
+    directory = Path(prepared_directory).expanduser().resolve()
+    prepared, commitment, arrays = _validate_prepared(directory)
+    config, config_hash = _load_config(Path(prepared["receiver_config_path"]))
+    minimum = int(config["chernoff"]["minimum_hypothesis_count_per_request"])
+    if not isinstance(hypothesis_count, int) or hypothesis_count < minimum:
+        raise ValueError(
+            f"hypothesis_count must include all profile/attack/row decisions: "
+            f"{hypothesis_count} < {minimum}"
+        )
+    if not 0.0 < family_alpha < 1.0:
+        raise ValueError("family_alpha must lie in (0,1)")
+    context = prepared["scoring_context"]
+    secret = bytes.fromhex(context["public_fixture_secret_hex"])
+    parameter = _configuration()
+    biases, codebook = tardos.generate_keyed(
+        parameter, secret, context["codebook_context"]
+    )
+    if codebook.shape != (1000, 52500):
+        raise AssertionError("scoring did not generate all 1,000 full-length rows")
+    if not np.array_equal(biases, arrays["biases"]):
+        raise ValueError("scoring biases differ from committed zero-row biases")
+
+    profile_results: dict[str, dict[str, Any]] = {}
+    for profile in PROFILE_KEYS:
+        metadata = prepared["profiles"][profile]
+        if metadata["status"] != "prepared":
+            profile_results[profile] = {
+                "status": "inconclusive",
+                "reason": metadata.get("reason", "profile was not prepared"),
+                "accused_rows": [],
+                "hypotheses": {},
+            }
+            continue
+        hypotheses: dict[str, dict[str, Any]] = {}
+        try:
+            if profile == "hard":
+                q0 = arrays[metadata["q0_key"]]
+                q1 = arrays[metadata["q1_key"]]
+                record, _ = _score_evidence(
+                    biases,
+                    codebook,
+                    q0,
+                    q1,
+                    family_alpha,
+                    hypothesis_count,
+                )
+                hypotheses["hard"] = record
+                word = arrays[metadata["word_key"]]
+                historical_scores = tardos.accusation_scores(biases, codebook, word)
+                historical = {
+                    "name": "v1 signed-hard one-sided diagnostic",
+                    "scores": historical_scores.tolist(),
+                    "threshold": 2100.0,
+                    "accused_rows": np.flatnonzero(historical_scores > 2100.0)
+                    .astype(int)
+                    .tolist(),
+                    "compound_decoding": False,
+                }
+            else:
+                observations = arrays[metadata["observations_key"]]
+                variances = arrays[metadata["variances_key"]]
+                log_weights = arrays[metadata["log_weights_key"]]
+                erased = arrays[metadata["erased_key"]]
+                for hypothesis, (kind, size) in SOFT_HYPOTHESES.items():
+                    q0, q1, evidence_diagnostics = compound_score.compound_log_evidence(
+                        biases,
+                        observations,
+                        variances,
+                        log_weights,
+                        erased,
+                        kind=kind,
+                        coalition_size=size,
+                    )
+                    record, _ = _score_evidence(
+                        biases,
+                        codebook,
+                        q0,
+                        q1,
+                        family_alpha,
+                        hypothesis_count,
+                    )
+                    hypotheses[hypothesis] = record | {
+                        "compound_channel": evidence_diagnostics
+                    }
+                historical = None
+            accused = sorted(
+                {
+                    row
+                    for hypothesis in hypotheses.values()
+                    for row in hypothesis["accused_rows"]
+                }
+            )
+            result: dict[str, Any] = {
+                "status": "scored",
+                "reason": None,
+                "accused_rows": accused,
+                "hypotheses": hypotheses,
+                "preparation_diagnostics": metadata.get("diagnostics"),
+            }
+            if historical is not None:
+                result["historical_diagnostic"] = historical
+            profile_results[profile] = result
+        except (InconclusiveError, ValueError) as error:
+            profile_results[profile] = {
+                "status": "inconclusive",
+                "reason": f"{type(error).__name__}: {error}",
+                "accused_rows": [],
+                "hypotheses": {},
+            }
+
+    result_status = (
+        "scored"
+        if any(item["status"] == "scored" for item in profile_results.values())
+        else "inconclusive"
+    )
+    return {
+        "schema": "nishan.n1-scores/v2",
+        "status": result_status,
+        "request_id": prepared["request_id"],
+        "profiles": profile_results,
+        "family_alpha": float(family_alpha),
+        "hypothesis_count": hypothesis_count,
+        "carrier": dict(REQUIRED_CARRIER),
+        "preparation_hashes": {
+            "prepared_json_sha256": commitment["sha256"]["prepared.json"],
+            "evidence_npz_sha256": commitment["sha256"]["evidence.npz"],
+            "commitment_json_sha256": _sha256(directory / "commitment.json"),
+        },
+        "preparation_sha256": commitment["sha256"]["prepared.json"],
+        "prepared_commitment": prepared["commitment"],
+        "receiver_config_sha256": config_hash,
+        "receiver_config_commit": prepared.get("receiver_config_commit"),
+        "input_sha256": prepared["input_sha256"],
+        "context_commitment": prepared["context_commitment"],
+        "code_sha256": prepared["code_sha256"],
+        "implementation_sha256": prepared["implementation_sha256"],
+        "codebook_commitment": tardos.manifest(parameter, biases, codebook),
+        "runtime": {
+            "elapsed_seconds": time.perf_counter() - started,
+            "rows_scored": 1000,
+            "opencv_threads": cv2.getNumThreads(),
+            "peak_rss_kib": int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss),
+            "python": platform.python_version(),
+            "numpy": np.__version__,
+            "opencv": cv2.__version__,
+        },
+        "claim_limits": [
+            "Scores are conditional on the declared implemented-Bernoulli random-code model.",
+            "Numerical Chernoff calculations do not empirically certify rare physical events.",
+            "No score is a conclusion about content authenticity or human culpability.",
+            "Donor-pattern recovery is not counted as an authenticity/security success.",
+        ],
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+    prepare_parser = commands.add_parser("prepare")
+    prepare_parser.add_argument("--request", type=Path, required=True)
+    prepare_parser.add_argument("--output", type=Path, required=True)
+    score_parser = commands.add_parser("score")
+    score_parser.add_argument("--prepared", type=Path, required=True)
+    score_parser.add_argument("--alpha", type=float, required=True)
+    score_parser.add_argument("--hypotheses", type=int, required=True)
+    score_parser.add_argument("--output", type=Path, required=True)
+    arguments = parser.parse_args()
+    if arguments.command == "prepare":
+        request = json.loads(arguments.request.read_text())
+        result = prepare_request(request, str(arguments.output))
+    else:
+        result = score_prepared(
+            str(arguments.prepared), arguments.alpha, arguments.hypotheses
+        )
+        if arguments.output.exists():
+            raise FileExistsError(arguments.output)
+        arguments.output.parent.mkdir(parents=True, exist_ok=True)
+        _write_exclusive(arguments.output, result)
+    print(
+        json.dumps(
+            {
+                "schema": result["schema"],
+                "status": result["status"],
+                "request_id": result["request_id"],
+            },
+            sort_keys=True,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
