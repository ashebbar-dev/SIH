+            "minimum_endpoint_energy": config["evidence"][
+                "minimum_endpoint_energy"
+            ],
+            "maximum_variance": config["evidence"]["maximum_variance"],
+        }
+
+        pattern_a = np.sin((xx + yy) / 5.0).astype(np.float32)
+        zero_a = source - 6.0 * pattern_a
+        one_a = source + 6.0 * pattern_a
+        expectation_a = (zero_a + one_a) / 2.0
+        pattern_b = np.cos((2.0 * xx - yy) / 7.0).astype(np.float32)
