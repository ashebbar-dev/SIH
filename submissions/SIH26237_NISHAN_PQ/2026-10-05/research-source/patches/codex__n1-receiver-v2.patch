+                        self.assertTrue(np.all(np.isfinite(values)))
+                        accused = result["accused_rows"]
+                        contributor_set = set(contributors)
+                        accused_set = set(accused)
+                        if category == "negative":
+                            disposition = "abstain" if not accused else "wrong"
+                        elif category == "transplant":
