+        luma = watermark._luma(pages[0])
+        first, first_diagnostics = channel_fit.select_source_support(
+            luma, config["source_support"]
+        )
+
+        def reversed_plan(secret, context, capacity, symbols):
+            order = np.arange(
+                capacity - 1, capacity - symbols - 1, -1, dtype=np.int64
+            )
+            return (
+                order,
+                np.zeros(symbols, dtype=np.uint8),
+                np.ones(symbols, dtype=np.int8),
+            )
+
+        with patch.object(tardos_carrier, "_plan", reversed_plan):
+            second, second_diagnostics = channel_fit.select_source_support(
+                luma, config["source_support"]
+            )
+        np.testing.assert_array_equal(first, second)
+        self.assertEqual(first_diagnostics, second_diagnostics)
+
+    def test_uniform_blank_reference_is_safely_inconclusive(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
