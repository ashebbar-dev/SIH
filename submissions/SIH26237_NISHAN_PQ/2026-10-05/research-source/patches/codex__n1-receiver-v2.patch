+++ b/research/n1_v2/compound_score.py
@@ -0,0 +1,337 @@
+"""Candidate-independent compound-channel evidence and conditional scoring.
+
+The channel is represented by one or more Gaussian components per symbol.  A
+component observes the rendered endpoint interpolation coordinate: zero is the
+all-zero endpoint and one is the all-one endpoint.  Mixture weights are fitted
+without recipient rows.  This module converts those components into the two
+possible log-evidence values for a candidate symbol and only then scores rows.
+"""
+
+from __future__ import annotations
+
+import math
+from typing import Any
+
+import numpy as np
+
+
+def implemented_probabilities(biases: np.ndarray) -> np.ndarray:
+    """Return the probabilities implemented by the keyed 32-bit sampler."""
+
+    values = np.asarray(biases, dtype=np.float64)
+    if values.ndim != 1 or not np.all(np.isfinite(values)):
+        raise ValueError("biases must be a finite vector")
+    if np.any((values <= 0.0) | (values >= 1.0)):
+        raise ValueError("biases must be strictly between zero and one")
+    result = np.floor(values * float(1 << 32)) / float(1 << 32)
+    if np.any((result <= 0.0) | (result >= 1.0)):
+        raise ValueError("implemented probabilities must remain in (0, 1)")
+    return result
+
+
+def _logsumexp(values: np.ndarray, axis: int = 0) -> np.ndarray:
+    array = np.asarray(values, dtype=np.float64)
+    if array.shape[axis] == 0:
+        raise ValueError("log-sum-exp needs at least one term")
+    return np.logaddexp.reduce(array, axis=axis)
+
+
+def _validate_components(
+    biases: np.ndarray,
+    observations: np.ndarray,
+    variances: np.ndarray,
+    log_weights: np.ndarray,
+    erased: np.ndarray,
+) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+    p = implemented_probabilities(biases)
+    y = np.asarray(observations, dtype=np.float64)
+    variance = np.asarray(variances, dtype=np.float64)
+    weights = np.asarray(log_weights, dtype=np.float64)
+    missing = np.asarray(erased, dtype=bool)
+    if y.ndim != 2 or y.shape[1:] != p.shape:
+        raise ValueError("observations must have shape (components, symbols)")
+    if variance.shape != y.shape or weights.shape != y.shape:
+        raise ValueError("component variances and log weights must match observations")
+    if missing.shape != p.shape:
+        raise ValueError("erasure mask must match biases")
+    if not np.all(np.isfinite(y)):
+        raise ValueError("observations must be finite")
+    if not np.all(np.isfinite(variance)) or np.any(variance <= 0.0):
+        raise ValueError("component variances must be finite and positive")
+    if not np.all(np.isfinite(weights)):
+        raise ValueError("component log weights must be finite")
+    normalizer = _logsumexp(weights, axis=0)
+    weights = weights - normalizer[None, :]
+    return p, y, variance, weights, missing
+
+
+def channel_log_likelihood(
+    observations: np.ndarray,
+    variances: np.ndarray,
+    normalized_log_weights: np.ndarray,
+    fraction: float,
+) -> np.ndarray:
+    """Evaluate the Gaussian channel at one rendered endpoint interpolation."""
+
+    y = np.asarray(observations, dtype=np.float64)
+    variance = np.asarray(variances, dtype=np.float64)
+    weights = np.asarray(normalized_log_weights, dtype=np.float64)
+    if y.shape != variance.shape or y.shape != weights.shape or y.ndim != 2:
+        raise ValueError("channel component arrays must share a 2-D shape")
+    if not math.isfinite(fraction):
+        raise ValueError("endpoint fraction must be finite")
+    log_density = -0.5 * (
+        np.square(y - float(fraction)) / variance
+        + np.log(2.0 * math.pi * variance)
+    )
+    return _logsumexp(weights + log_density, axis=0)
+
+
+def _binomial_log_mass(size: int, count: int, p: np.ndarray) -> np.ndarray:
+    return (
+        math.lgamma(size + 1)
+        - math.lgamma(count + 1)
+        - math.lgamma(size - count + 1)
+        + count * np.log(p)
+        + (size - count) * np.log1p(-p)
+    )
+
+
+def _normalized_evidence(
+    q0: np.ndarray, q1: np.ndarray, erased: np.ndarray
+) -> tuple[np.ndarray, np.ndarray]:
+    left = np.asarray(q0, dtype=np.float64).copy()
+    right = np.asarray(q1, dtype=np.float64).copy()
+    if left.shape != right.shape or left.shape != erased.shape:
+        raise ValueError("evidence shapes do not match")
+    offset = np.maximum(left, right)
+    left -= offset
+    right -= offset
+    left[erased] = 0.0
+    right[erased] = 0.0
+    if not np.all(np.isfinite(left)) or not np.all(np.isfinite(right)):
+        raise ValueError("compound evidence is not finite")
+    return left, right
+
+
+def compound_log_evidence(
+    biases: np.ndarray,
+    observations: np.ndarray,
+    variances: np.ndarray,
+    log_weights: np.ndarray,
+    erased: np.ndarray,
+    *,
+    kind: str,
+    coalition_size: int,
+) -> tuple[np.ndarray, np.ndarray, dict[str, Any]]:
+    """Return q_j(0), q_j(1) for an average or interleaving channel.
+
+    For an average of size ``c``, the null latent count is ``Binomial(c,p)``.
+    Conditional on a tested contributor bit ``x``, it is
+    ``x + Binomial(c-1,p)``.  For interleaving, the tested contributor supplies
+    the observation with probability ``1/c`` and an independent participant
+    supplies it otherwise.  In both cases the evidence is a log likelihood
+    ratio against the corresponding random-code null, followed by a common
+    per-symbol numeric normalization.
+    """
+
+    if not isinstance(coalition_size, int) or coalition_size < 1:
+        raise ValueError("coalition_size must be a positive integer")
+    p, y, variance, weights, missing = _validate_components(
+        biases, observations, variances, log_weights, erased
+    )
+
+    if kind == "average":
+        likelihoods = [
+            channel_log_likelihood(y, variance, weights, count / coalition_size)
+            for count in range(coalition_size + 1)
+        ]
+        null_terms = [
+            _binomial_log_mass(coalition_size, count, p) + likelihoods[count]
+            for count in range(coalition_size + 1)
+        ]
+        null = _logsumexp(np.stack(null_terms), axis=0)
+        conditioned: list[np.ndarray] = []
+        for own_bit in (0, 1):
+            terms = [
+                _binomial_log_mass(coalition_size - 1, count, p)
+                + likelihoods[count + own_bit]
+                for count in range(coalition_size)
+            ]
+            conditioned.append(_logsumexp(np.stack(terms), axis=0))
+        q0, q1 = conditioned[0] - null, conditioned[1] - null
+    elif kind == "interleaving":
+        if coalition_size < 2:
+            raise ValueError("interleaving requires coalition_size at least two")
+        f0 = channel_log_likelihood(y, variance, weights, 0.0)
+        f1 = channel_log_likelihood(y, variance, weights, 1.0)
+        null = np.logaddexp(np.log1p(-p) + f0, np.log(p) + f1)
+        other = math.log((coalition_size - 1) / coalition_size) + null
+        own_weight = -math.log(coalition_size)
+        q0 = np.logaddexp(own_weight + f0, other) - null
+        q1 = np.logaddexp(own_weight + f1, other) - null
+    else:
+        raise ValueError("kind must be average or interleaving")
+
+    q0, q1 = _normalized_evidence(q0, q1, missing)
+    return q0, q1, {
+        "kind": kind,
+        "coalition_size": coalition_size,
+        "components": int(y.shape[0]),
+        "symbols": int(y.shape[1]),
+        "erased_symbols": int(np.count_nonzero(missing)),
+        "normalization": "per-symbol subtract max(q0,q1); erasures set to zero",
+        "null": (
+            "Binomial(c,p) endpoint-interpolation mixture"
+            if kind == "average"
+            else "(1-p)f(y|0)+p f(y|1)"
+        ),
+    }
+
+
+def hard_log_evidence(
+    biases: np.ndarray,
+    observed_bits: np.ndarray,
+    erased: np.ndarray,
+    error_probability: float,
+) -> tuple[np.ndarray, np.ndarray, dict[str, Any]]:
+    """Binary-symmetric calibrated evidence for the historical hard word."""
+
+    p = implemented_probabilities(biases)
+    bits = np.asarray(observed_bits, dtype=np.uint8)
+    missing = np.asarray(erased, dtype=bool)
+    if bits.shape != p.shape or missing.shape != p.shape:
+        raise ValueError("hard evidence arrays must match biases")
+    if np.any((bits != 0) & (bits != 1)):
+        raise ValueError("hard observations must be binary")
+    if not 0.0 < error_probability < 0.5:
+        raise ValueError("hard error probability must lie in (0, 0.5)")
+    match = math.log1p(-error_probability)
+    mismatch = math.log(error_probability)
+    f0 = np.where(bits == 0, match, mismatch)
+    f1 = np.where(bits == 1, match, mismatch)
+    null = np.logaddexp(np.log1p(-p) + f0, np.log(p) + f1)
+    q0, q1 = _normalized_evidence(f0 - null, f1 - null, missing)
+    return q0, q1, {
+        "kind": "binary_symmetric",
+        "error_probability": float(error_probability),
+        "erased_symbols": int(np.count_nonzero(missing)),
+    }
+
+
+def score_rows(
+    codebook: np.ndarray,
+    q0: np.ndarray,
+    q1: np.ndarray,
+    *,
+    row_chunk: int = 64,
+) -> np.ndarray:
+    """Score every supplied row without materializing a full float matrix."""
+
+    rows = np.asarray(codebook)
+    left = np.asarray(q0, dtype=np.float64)
+    right = np.asarray(q1, dtype=np.float64)
+    if rows.ndim != 2 or rows.shape[1:] != left.shape or right.shape != left.shape:
+        raise ValueError("codebook and evidence dimensions do not match")
+    if np.any((rows != 0) & (rows != 1)):
+        raise ValueError("codebook must be binary")
+    if not np.all(np.isfinite(left)) or not np.all(np.isfinite(right)):
+        raise ValueError("evidence must be finite")
+    if row_chunk < 1:
+        raise ValueError("row_chunk must be positive")
+    baseline = float(left.sum(dtype=np.float64))
+    delta = right - left
+    scores = np.empty(rows.shape[0], dtype=np.float64)
+    for start in range(0, rows.shape[0], row_chunk):
+        stop = min(start + row_chunk, rows.shape[0])
+        scores[start:stop] = baseline + np.sum(
+            rows[start:stop] * delta[None, :], axis=1, dtype=np.float64
+        )
+    if not np.all(np.isfinite(scores)):
+        raise ValueError("row scores are not finite")
+    return scores
+
+
+def conditional_chernoff(
+    biases: np.ndarray,
+    q0: np.ndarray,
+    q1: np.ndarray,
+    family_alpha: float,
+    hypothesis_count: int,
+    *,
+    lambda_grid: np.ndarray | None = None,
+) -> dict[str, Any]:
+    """Calibrate a fixed evidence pair under the conditional random-row model."""
+
+    p = implemented_probabilities(biases)
+    left = np.asarray(q0, dtype=np.float64)
+    right = np.asarray(q1, dtype=np.float64)
+    if left.shape != p.shape or right.shape != p.shape:
+        raise ValueError("q0 and q1 must match biases")
+    if not np.all(np.isfinite(left)) or not np.all(np.isfinite(right)):
+        raise ValueError("q0 and q1 must be finite")
+    if not 0.0 < family_alpha < 1.0:
+        raise ValueError("family_alpha must lie in (0,1)")
+    if not isinstance(hypothesis_count, int) or hypothesis_count < 1:
+        raise ValueError("hypothesis_count must be a positive integer")
+    if np.all(left == 0.0) and np.all(right == 0.0):
+        return {
+            "status": "inconclusive",
+            "reason": "zero evidence",
+            "threshold": None,
+            "active_symbols": 0,
+            "family_alpha": float(family_alpha),
+            "hypothesis_count": hypothesis_count,
+            "model": "conditional implemented-Bernoulli random-code model",
+        }
+
+    grid = (
+        np.logspace(-6.0, 3.0, 181, dtype=np.float64)
+        if lambda_grid is None
+        else np.asarray(lambda_grid, dtype=np.float64)
+    )
+    if grid.ndim != 1 or not len(grid) or not np.all(np.isfinite(grid)):
+        raise ValueError("lambda grid must be a nonempty finite vector")
+    if np.any(grid <= 0.0) or np.any(np.diff(grid) <= 0.0):
+        raise ValueError("lambda grid must be strictly increasing and positive")
+    budget = math.log(hypothesis_count / family_alpha)
+    boundaries = np.empty(len(grid), dtype=np.float64)
+    cumulants = np.empty(len(grid), dtype=np.float64)
+    log_zero, log_one = np.log1p(-p), np.log(p)
+    for index, value in enumerate(grid):
+        cumulant = float(
+            np.logaddexp(
+                log_zero + value * left,
+                log_one + value * right,
+            ).sum(dtype=np.float64)
+        )
+        cumulants[index] = cumulant
+        boundaries[index] = (cumulant + budget) / value
+    if not np.all(np.isfinite(boundaries)):
+        raise ValueError("Chernoff grid produced a non-finite boundary")
+    selected = int(np.argmin(boundaries))
+    lam = float(grid[selected])
+    cumulant = float(cumulants[selected])
+    threshold = float(np.nextafter(boundaries[selected], math.inf))
+    modeled_log_upper = cumulant - lam * threshold
+    return {
+        "status": "calibrated",
+        "threshold": threshold,
+        "lambda": lam,
+        "lambda_grid_index": selected,
+        "lambda_grid_count": int(len(grid)),
+        "lambda_grid_min": float(grid[0]),
+        "lambda_grid_max": float(grid[-1]),
+        "cumulant": cumulant,
+        "active_symbols": int(np.count_nonzero((left != 0.0) | (right != 0.0))),
+        "family_alpha": float(family_alpha),
+        "hypothesis_count": hypothesis_count,
+        "modeled_per_hypothesis_log_upper": float(modeled_log_upper),
+        "modeled_per_hypothesis_upper": float(
+            math.exp(modeled_log_upper) if modeled_log_upper > -745.0 else 0.0
+        ),
+        "grid_selected_before_row_scoring": True,
+        "strict_comparison": True,
+        "model": "conditional implemented-Bernoulli random-code model",
+        "claim_limit": "numerical conditional model; not empirical rare-event certification",
+    }
