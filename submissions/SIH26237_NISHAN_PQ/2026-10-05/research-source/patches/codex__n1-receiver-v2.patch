+"""Source-only eligibility and recipient-blind N1 v2 channel fitting."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from typing import Any
+
+import cv2
+import numpy as np
+
+
+_GRADIENT_QUANTUM = 1e-6
+
+
+def _array_hash(value: np.ndarray) -> str:
+    array = np.ascontiguousarray(value)
+    prefix = json.dumps(
+        [list(array.shape), array.dtype.str], separators=(",", ":")
+    ).encode("utf-8")
+    return hashlib.sha256(prefix + array.tobytes()).hexdigest()
+
+
+def _design_diagnostics(values: np.ndarray) -> tuple[int, float | None, float | None]:
+    x = np.asarray(values, dtype=np.float64).ravel()
+    if len(x) < 2 or not np.all(np.isfinite(x)):
+        return 0, None, None
+    scale = float(np.std(x))
+    if not math.isfinite(scale) or scale <= 1e-9:
+        return 1, None, scale
+    standardized = (x - float(np.mean(x))) / scale
+    design = np.column_stack((standardized, np.ones(len(x), dtype=np.float64)))
+    rank = int(np.linalg.matrix_rank(design))
+    condition = float(np.linalg.cond(design)) if rank == 2 else None
+    return rank, condition, scale
+
+
+def _normalized_gradient(source: np.ndarray) -> np.ndarray:
+    """Compute a deterministic normalized Sobel magnitude.
+
+    OpenCV's float32 threaded Sobel path can differ by a few ulps between
+    otherwise identical calls.  Quantizing a float64 calculation far below
+    the frozen threshold precision keeps quota tie-breaking and commitments
+    reproducible without materially changing source eligibility.
+    """
+
+    stable = np.asarray(source, dtype=np.float64)
+    gx = cv2.Sobel(stable, cv2.CV_64F, 1, 0, ksize=3) / 8.0
+    gy = cv2.Sobel(stable, cv2.CV_64F, 0, 1, ksize=3) / 8.0
+    magnitude = np.hypot(gx, gy)
+    return np.rint(magnitude / _GRADIENT_QUANTUM) * _GRADIENT_QUANTUM
+
+
+def source_feature_mask(
+    source_luma: np.ndarray,
+    configuration: dict[str, Any],
+) -> np.ndarray:
+    """Return the dense source-only edge mask used for local content fitting."""
+
+    source = np.asarray(source_luma, dtype=np.float32)
+    if source.ndim != 2 or not np.all(np.isfinite(source)):
+        raise ValueError("source_luma must be a finite 2-D array")
+    tone_edges = np.asarray(configuration["tone_edges_luma"], dtype=np.float64)
+    border = int(configuration["border_pixels"])
+    gradient = _normalized_gradient(source)
+    eligible = (
+        (gradient >= float(configuration["normalized_gradient_min"]))
+        & (gradient <= float(configuration["normalized_gradient_max"]))
+        & (source >= tone_edges[0])
+        & (source < tone_edges[-1])
+    )
+    if border:
+        eligible[:border] = False
+        eligible[-border:] = False
+        eligible[:, :border] = False
+        eligible[:, -border:] = False
+    return eligible
+
+
+def select_source_support(
+    source_luma: np.ndarray,
+    configuration: dict[str, Any],
+) -> tuple[np.ndarray, dict[str, Any]]:
+    """Select deterministic, spatially and tonally distributed source features.
+
+    This function deliberately has no carrier, bias, codebook, target-row, or
+    capture input.  Its eligibility decision therefore cannot change when a
+    codebook or its symbol permutation changes.
+    """
+
+    source = np.asarray(source_luma, dtype=np.float32)
+    if source.ndim != 2 or not np.all(np.isfinite(source)):
+        raise ValueError("source_luma must be a finite 2-D array")
+    required = {
+        "border_pixels",
+        "grid_rows",
+        "grid_columns",
+        "tone_edges_luma",
+        "normalized_gradient_min",
+        "normalized_gradient_max",
+        "samples_per_grid_tone",
+        "minimum_samples",
+        "minimum_occupied_grid_cells",
+        "minimum_tone_bins",
+        "maximum_design_condition",
+    }
+    missing = required - set(configuration)
+    if missing:
+        raise ValueError(f"source-support configuration missing: {sorted(missing)}")
+    height, width = source.shape
+    grid_rows = int(configuration["grid_rows"])
+    grid_columns = int(configuration["grid_columns"])
+    border = int(configuration["border_pixels"])
+    quota = int(configuration["samples_per_grid_tone"])
+    tone_edges = np.asarray(configuration["tone_edges_luma"], dtype=np.float64)
+    if (
+        grid_rows < 1
+        or grid_columns < 1
+        or quota < 1
+        or border < 0
+        or tone_edges.ndim != 1
+        or len(tone_edges) < 3
+        or not np.all(np.diff(tone_edges) > 0)
+    ):
+        raise ValueError("invalid source-support configuration")
+
+    gradient = _normalized_gradient(source)
+    eligible = source_feature_mask(source, configuration)
+
+    tones = np.digitize(source, tone_edges[1:-1], right=False)
+    support = np.zeros(source.shape, dtype=bool)
+    row_edges = np.linspace(0, height, grid_rows + 1, dtype=np.int64)
+    column_edges = np.linspace(0, width, grid_columns + 1, dtype=np.int64)
+    for grid_y in range(grid_rows):
+        y0, y1 = int(row_edges[grid_y]), int(row_edges[grid_y + 1])
+        for grid_x in range(grid_columns):
+            x0, x1 = int(column_edges[grid_x]), int(column_edges[grid_x + 1])
+            for tone in range(len(tone_edges) - 1):
+                local = eligible[y0:y1, x0:x1] & (
+                    tones[y0:y1, x0:x1] == tone
+                )
+                yy, xx = np.nonzero(local)
+                if not len(yy):
+                    continue
+                yy = yy + y0
+                xx = xx + x0
+                flat = yy.astype(np.int64) * width + xx.astype(np.int64)
+                order = np.lexsort((flat, -gradient[yy, xx]))[:quota]
+                support[yy[order], xx[order]] = True
+
+    selected_values = source[support]
+    selected_tones = tones[support]
+    selected_y, selected_x = np.nonzero(support)
+    occupied_cells: set[tuple[int, int]] = set()
+    if len(selected_y):
+        cell_y = np.minimum(
+            grid_rows - 1, selected_y * grid_rows // max(height, 1)
+        )
+        cell_x = np.minimum(
+            grid_columns - 1, selected_x * grid_columns // max(width, 1)
+        )
+        occupied_cells = set(zip(cell_y.tolist(), cell_x.tolist(), strict=True))
+    tone_counts = [
+        int(np.count_nonzero(selected_tones == tone))
+        for tone in range(len(tone_edges) - 1)
+    ]
+    occupied_tones = int(np.count_nonzero(tone_counts))
+    rank, condition, scale = _design_diagnostics(selected_values)
+    raw_condition: float | None = None
+    if count := int(np.count_nonzero(support)):
+        raw_design = np.column_stack(
+            (selected_values.astype(np.float64), np.ones(count, dtype=np.float64))
+        )
+        if np.linalg.matrix_rank(raw_design) == 2:
+            raw_condition = float(np.linalg.cond(raw_design))
+    reasons: list[str] = []
+    if count < int(configuration["minimum_samples"]):
+        reasons.append(
+            f"insufficient source support: {count} < {int(configuration['minimum_samples'])}"
+        )
+    if len(occupied_cells) < int(configuration["minimum_occupied_grid_cells"]):
+        reasons.append(
+            "insufficient spatial coverage: "
+            f"{len(occupied_cells)} < {int(configuration['minimum_occupied_grid_cells'])}"
+        )
+    if occupied_tones < int(configuration["minimum_tone_bins"]):
+        reasons.append(
+            f"insufficient tone diversity: {occupied_tones} < "
+            f"{int(configuration['minimum_tone_bins'])}"
+        )
+    if rank < 2:
+        reasons.append("rank-deficient source photometric design")
+    if condition is not None and condition > float(
+        configuration["maximum_design_condition"]
+    ):
+        reasons.append(
+            f"ill-conditioned source photometric design: {condition:.6g}"
+        )
+    candidate_gradients = gradient[eligible]
+    quantiles = (
+        [float(value) for value in np.quantile(candidate_gradients, [0.1, 0.5, 0.9])]
+        if len(candidate_gradients)
+        else []
+    )
+    diagnostics: dict[str, Any] = {
+        "status": "usable" if not reasons else "inconclusive",
+        "reason": None if not reasons else "; ".join(reasons),
+        "source_only": True,
+        "decision_inputs": ["source_luma", "frozen_source_support_configuration"],
+        "normalized_gradient_definition": configuration.get(
+            "gradient_definition",
+            "sqrt(Sobel_x^2 + Sobel_y^2) / 8 for 3x3 Sobel",
+        ),
+        "normalized_gradient_quantum": _GRADIENT_QUANTUM,
+        "raw_eligible_pixels": int(np.count_nonzero(eligible)),
+        "selected_pixels": count,
+        "support_sha256": _array_hash(support),
+        "occupied_grid_cells": len(occupied_cells),
+        "total_grid_cells": grid_rows * grid_columns,
+        "spatial_coverage_fraction": len(occupied_cells) / (grid_rows * grid_columns),
+        "tone_counts": tone_counts,
+        "occupied_tone_bins": occupied_tones,
+        "fit_rank": rank,
+        "fit_condition_number": condition,
+        "raw_unscaled_design_condition_number": raw_condition,
+        "source_luma_standard_deviation": scale,
+        "candidate_gradient_quantiles": quantiles,
+        "arbitrary_4096_cutoff_used": False,
+    }
+    return support, diagnostics
+
+
+def fit_photometric(
+    reference: np.ndarray,
+    capture: np.ndarray,
+    *,
+    trim_fraction: float,
+    iterations: int,
+    gain_bounds: tuple[float, float] = (0.35, 1.8),
+    offset_bounds: tuple[float, float] = (-100.0, 100.0),
+) -> dict[str, Any]:
+    """Fit capture = gain * reference + offset in standardized coordinates."""
+
+    x = np.asarray(reference, dtype=np.float64).ravel()
+    y = np.asarray(capture, dtype=np.float64).ravel()
+    if x.shape != y.shape or len(x) < 2:
+        raise ValueError("photometric fit needs matching samples")
+    if not np.all(np.isfinite(x)) or not np.all(np.isfinite(y)):
+        raise ValueError("photometric samples must be finite")
+    if not 0.5 <= trim_fraction <= 1.0 or iterations < 1:
+        raise ValueError("invalid robust-fit configuration")
+    retained = np.ones(len(x), dtype=bool)
+    gain = offset = 0.0
+    rank = 0
+    condition: float | None = None
+    for _ in range(iterations):
+        selected_x = x[retained]
+        selected_y = y[retained]
+        rank, condition, scale = _design_diagnostics(selected_x)
+        if rank < 2 or scale is None or scale <= 1e-9:
+            raise ValueError("rank-deficient photometric fit")
+        if condition is None or not math.isfinite(condition):
+            raise ValueError("ill-conditioned photometric fit")
+        center = float(np.mean(selected_x))
+        normalized = (selected_x - center) / scale
+        design = np.column_stack((normalized, np.ones(len(normalized))))
+        slope, intercept = np.linalg.lstsq(design, selected_y, rcond=None)[0]
+        gain = float(slope / scale)
+        offset = float(intercept - gain * center)
+        residual = np.abs(y - (gain * x + offset))
+        boundary = float(np.quantile(residual, trim_fraction))
+        retained = residual <= boundary
+        if int(np.count_nonzero(retained)) < 2:
+            raise ValueError("robust photometric fit retained too few samples")
+    if not gain_bounds[0] <= gain <= gain_bounds[1]:
+        raise ValueError("photometric gain outside frozen bounds")
+    if not offset_bounds[0] <= offset <= offset_bounds[1]:
+        raise ValueError("photometric offset outside frozen bounds")
+    signed_residual = y - (gain * x + offset)
+    residual_median = float(np.median(signed_residual))
+    noise = max(
+        1e-9,
+        float(1.4826 * np.median(np.abs(signed_residual - residual_median))),
+    )
+    prediction = gain * x + offset
+    denominator = float(np.linalg.norm(prediction - prediction.mean()) * np.linalg.norm(y - y.mean()))
+    correlation = (
+        float(np.dot(prediction - prediction.mean(), y - y.mean()) / denominator)
+        if denominator > 0.0
+        else 0.0
+    )
+    final_rank, final_condition, _ = _design_diagnostics(x[retained])
+    if final_rank < 2 or final_condition is None:
+        raise ValueError("rank-deficient photometric fit after trimming")
+    return {
+        "gain": gain,
+        "offset": offset,
+        "loss": float(np.median(np.abs(signed_residual))),
+        "noise_mad": noise,
+        "retained_samples": int(np.count_nonzero(retained)),
+        "total_samples": int(len(x)),
+        "rank": final_rank,
+        "condition_number": final_condition,
+        "fit_correlation": correlation,
+    }
+
+
+def _blur(image: np.ndarray, sigma: float) -> np.ndarray:
+    value = np.asarray(image, dtype=np.float32)
+    return value.copy() if sigma == 0.0 else cv2.GaussianBlur(value, (0, 0), sigma)
+
+
+def fit_global_channel(
+    reference_expectation: np.ndarray,
+    capture_luma: np.ndarray,
+    support: np.ndarray,
+    configuration: dict[str, Any],
+) -> dict[str, Any]:
+    reference = np.asarray(reference_expectation, dtype=np.float32)
+    capture = np.asarray(capture_luma, dtype=np.float32)
+    selected = np.asarray(support, dtype=bool)
+    if reference.shape != capture.shape or reference.shape != selected.shape:
+        raise ValueError("global-channel images and support must share a shape")
+    if not np.any(selected):
+        raise ValueError("global-channel fit has no source support")
+    candidates: list[dict[str, Any]] = []
+    usable: list[dict[str, Any]] = []
+    for raw_sigma in configuration["gaussian_sigmas"]:
+        sigma = float(raw_sigma)
+        blurred = _blur(reference, sigma)
+        try:
+            fit = fit_photometric(
+                blurred[selected],
+                capture[selected],
+                trim_fraction=float(configuration["trim_fraction"]),
+                iterations=int(configuration["trim_iterations"]),
+                gain_bounds=tuple(float(v) for v in configuration["gain_bounds"]),
+                offset_bounds=tuple(float(v) for v in configuration["offset_bounds"]),
+            )
+        except ValueError as error:
+            candidates.append(
+                {"sigma": sigma, "status": "rejected", "reason": str(error)}
+            )
+            continue
+        record = {"sigma": sigma, "status": "fit"} | fit
+        candidates.append(record)
+        usable.append(record)
+    if not usable:
+        raise ValueError("all frozen global channel candidates failed")
+    selected_fit = min(usable, key=lambda item: (item["loss"], item["sigma"]))
+    return {
+        "sigma": selected_fit["sigma"],
+        "gain": selected_fit["gain"],
+        "offset": selected_fit["offset"],
+        "loss": selected_fit["loss"],
+        "noise_mad": selected_fit["noise_mad"],
+        "retained_samples": selected_fit["retained_samples"],
+        "rank": selected_fit["rank"],
+        "condition_number": selected_fit["condition_number"],
+        "fit_correlation": selected_fit["fit_correlation"],
+        "candidate_fits": candidates,
+    }
+
+
+def block_view(values: np.ndarray, block_size: int = 6) -> np.ndarray:
+    image = np.asarray(values)
+    if image.ndim != 2:
+        raise ValueError("block_view requires a scalar image")
+    rows = image.shape[0] // block_size
+    columns = image.shape[1] // block_size
+    crop = image[: rows * block_size, : columns * block_size]
+    return (
+        crop.reshape(rows, block_size, columns, block_size)
+        .transpose(0, 2, 1, 3)
+        .reshape(rows * columns, block_size, block_size)
+    )
+
+
+def _tile_layout(shape: tuple[int, int], tile_size: int) -> tuple[int, int, np.ndarray]:
+    height, width = shape
+    tile_rows = math.ceil(height / tile_size)
+    tile_columns = math.ceil(width / tile_size)
+    y, x = np.indices(shape)
+    pixels = (y // tile_size) * tile_columns + x // tile_size
+    return tile_rows, tile_columns, pixels.astype(np.int32)
+
+
+def _tile_noise(
+    residual: np.ndarray,
+    tile_pixels: np.ndarray,
+    tile_count: int,
+    noise_floor: float,
+) -> np.ndarray:
+    output = np.full(tile_count, float(noise_floor), dtype=np.float64)
+    flat_residual = np.asarray(residual, dtype=np.float64).ravel()
+    flat_tiles = tile_pixels.ravel()
+    for tile in range(tile_count):
+        values = flat_residual[flat_tiles == tile]
+        if len(values):
+            median = float(np.median(values))
+            output[tile] = max(
+                noise_floor,
+                float(1.4826 * np.median(np.abs(values - median))),
+            )
+    return output
+
+
+def _symbol_tiles(
+    order: np.ndarray,
+    shape: tuple[int, int],
+    block_size: int,
+    tile_size: int,
+) -> np.ndarray:
+    columns = shape[1] // block_size
+    indices = np.asarray(order, dtype=np.int64)
+    block_y, block_x = indices // columns, indices % columns
+    tile_columns = math.ceil(shape[1] / tile_size)
+    return (
+        ((block_y * block_size + block_size // 2) // tile_size) * tile_columns
+        + ((block_x * block_size + block_size // 2) // tile_size)
+    ).astype(np.int32)
+
+
+def _tone_amplitude(
+    source_luma: np.ndarray,
+    order: np.ndarray,
+    amplitudes: np.ndarray,
+    block_size: int,
+) -> dict[str, Any]:
+    source_blocks = block_view(source_luma, block_size)[np.asarray(order, dtype=np.int64)]
+    tones = source_blocks.mean(axis=(1, 2))
+    edges = (0.0, 64.0, 128.0, 192.0, 256.0)
+    result: dict[str, Any] = {}
+    for index, (low, high) in enumerate(zip(edges[:-1], edges[1:], strict=True)):
+        selected = (tones >= low) & (tones < high) & np.isfinite(amplitudes)
+        result[str(index)] = {
+            "luma_range": [low, high],
+            "symbols": int(np.count_nonzero(selected)),
+            "amplitude_median": (
+                float(np.median(amplitudes[selected])) if np.any(selected) else None
+            ),
+        }
+    return result
+
+
+def global_components(
+    capture_luma: np.ndarray,
+    reference_expectation: np.ndarray,
+    endpoint_zero: np.ndarray,
+    endpoint_one: np.ndarray,
+    source_luma: np.ndarray,
+    order: np.ndarray,
+    fit: dict[str, Any],
+    configuration: dict[str, Any],
+    *,
+    block_size: int = 6,
+) -> dict[str, Any]:
+    """Build the one-component global endpoint-interpolation channel."""
+
+    capture = np.asarray(capture_luma, dtype=np.float32)
+    expectation = _blur(reference_expectation, float(fit["sigma"]))
+    zero = _blur(endpoint_zero, float(fit["sigma"]))
+    one = _blur(endpoint_one, float(fit["sigma"]))
+    gain, offset = float(fit["gain"]), float(fit["offset"])
+    predicted_expectation = gain * expectation + offset
+    predicted_zero = gain * zero + offset
+    predicted_one = gain * one + offset
+    residual = capture - predicted_expectation
+    tile_size = int(configuration["noise_tile_pixels"])
+    tile_rows, tile_columns, tile_pixels = _tile_layout(capture.shape, tile_size)
+    tile_count = tile_rows * tile_columns
+    noise = _tile_noise(
+        residual,
+        tile_pixels,
+        tile_count,
+        float(configuration["noise_floor_luma"]),
+    )
+    indices = np.asarray(order, dtype=np.int64)
+    observed = block_view(capture, block_size)[indices].astype(np.float64)
+    zero_blocks = block_view(predicted_zero, block_size)[indices].astype(np.float64)
+    one_blocks = block_view(predicted_one, block_size)[indices].astype(np.float64)
+    direction = one_blocks - zero_blocks
+    energy = np.sum(np.square(direction), axis=(1, 2), dtype=np.float64)
+    numerator = np.sum(
+        (observed - zero_blocks) * direction, axis=(1, 2), dtype=np.float64
+    )
+    coordinate = np.divide(
+        numerator,
+        energy,
+        out=np.zeros_like(numerator),
+        where=energy > 0.0,
+    )
+    symbol_tiles = _symbol_tiles(indices, capture.shape, block_size, tile_size)
+    variance = np.divide(
+        np.square(noise[symbol_tiles]),
+        energy,
+        out=np.full_like(energy, math.inf),
+        where=energy > 0.0,
+    )
+    variance = np.maximum(variance, float(configuration["variance_floor_fraction"]))
+    erased = (
+        (energy < float(configuration.get("minimum_endpoint_energy", 1e-6)))
+        | ~np.isfinite(coordinate)
+        | ~np.isfinite(variance)
+        | (variance > float(configuration.get("maximum_variance", 1e6)))
+    )
+    coordinate[erased] = 0.0
+    variance[erased] = 1.0
+    amplitudes = np.sqrt(np.maximum(energy, 0.0))
+    expected_blocks = block_view(expectation, block_size)[indices]
+    source_blocks = block_view(source_luma, block_size)[indices]
+    expected_modulation = np.mean(expected_blocks - source_blocks, axis=(1, 2))
+    signal_mask = ~erased & np.isfinite(expected_modulation)
+    signal_correlation = None
+    if np.count_nonzero(signal_mask) >= 2:
+        left = coordinate[signal_mask] - np.mean(coordinate[signal_mask])
+        right = expected_modulation[signal_mask] - np.mean(
+            expected_modulation[signal_mask]
+        )
+        denominator = float(np.linalg.norm(left) * np.linalg.norm(right))
+        signal_correlation = (
+            float(np.dot(left, right) / denominator) if denominator > 0 else 0.0
+        )
+    return {
+        "observations": coordinate[None, :].astype(np.float32),
+        "variances": variance[None, :].astype(np.float32),
+        "log_weights": np.zeros((1, len(indices)), dtype=np.float32),
+        "erased": erased,
+        "diagnostics": {
+            "components": 1,
+            "symbols": int(len(indices)),
+            "erased_symbols": int(np.count_nonzero(erased)),
+            "discarded_evidence_fraction": float(np.mean(erased)),
+            "noise_median_luma": float(np.median(noise)),
+            "noise_max_luma": float(np.max(noise)),
+            "rendered_endpoint_separation_median": float(np.median(amplitudes[~erased]))
+            if np.any(~erased)
+            else None,
+            "rendered_endpoint_separation_by_source_tone": _tone_amplitude(
+                source_luma, indices, amplitudes, block_size
+            ),
+            "inferred_coordinate_vs_bias_expectation_correlation": signal_correlation,
+            "correlation_limit": (
+                "Recipient-blind fit diagnostic only; not true-carrier survival, "
+                "BER, or evaluator-labelled recovery."
+            ),
+            "coordinate_quantiles": [
+                float(value)
+                for value in np.quantile(coordinate[~erased], [0.1, 0.5, 0.9])
+            ]
+            if np.any(~erased)
+            else [],
+        },
+    }
+
+
+def _shift_image(image: np.ndarray, dx: float, dy: float) -> np.ndarray:
+    return cv2.warpAffine(
+        np.asarray(image, dtype=np.float32),
+        np.array([[1.0, 0.0, dx], [0.0, 1.0, dy]], dtype=np.float32),
+        (image.shape[1], image.shape[0]),
+        flags=cv2.INTER_LANCZOS4,
+        borderMode=cv2.BORDER_CONSTANT,
+        borderValue=255.0,
+    )
+
+
+def local_components(
+    capture_luma: np.ndarray,
+    _reference_expectation: np.ndarray,
+    endpoint_zero: np.ndarray,
+    endpoint_one: np.ndarray,
+    source_luma: np.ndarray,
+    support: np.ndarray,
+    order: np.ndarray,
+    fit: dict[str, Any],
+    global_result: dict[str, Any],
+    global_configuration: dict[str, Any],
+    local_configuration: dict[str, Any],
+    *,
+    block_size: int = 6,
+) -> dict[str, Any]:
+    """Build a fixed-shift mixture using only content losses for its weights."""
+
+    capture = np.asarray(capture_luma, dtype=np.float32)
+    selected_support = np.asarray(support, dtype=bool)
+    sigma = float(fit["sigma"])
+    content_reference = _blur(source_luma, sigma)
+    zero = _blur(endpoint_zero, sigma)
+    one = _blur(endpoint_one, sigma)
+    shifts = [float(value) for value in local_configuration["shifts_pixels"]]
+    candidates = [(dx, dy) for dy in shifts for dx in shifts]
+    shifted_captures = [_shift_image(capture, dx, dy) for dx, dy in candidates]
+    tile_size = int(local_configuration["tile_pixels"])
+    tile_rows, tile_columns, tile_pixels = _tile_layout(capture.shape, tile_size)
+    tile_count = tile_rows * tile_columns
+    candidate_count = len(candidates)
+    gains = np.full((tile_count, candidate_count), np.nan, dtype=np.float64)
+    offsets = np.full_like(gains, np.nan)
+    losses = np.full_like(gains, np.inf)
+    noises = np.full_like(gains, np.nan)
+    valid_tiles = np.zeros(tile_count, dtype=bool)
+    for tile in range(tile_count):
+        mask = (tile_pixels == tile) & selected_support
+        if int(np.count_nonzero(mask)) < int(
+            local_configuration["minimum_support_per_tile"]
+        ):
+            continue
+        reference_values = content_reference[mask]
+        all_valid = True
+        for candidate, shifted in enumerate(shifted_captures):
+            try:
+                local_fit = fit_photometric(
+                    reference_values,
+                    shifted[mask],
+                    trim_fraction=float(global_configuration["trim_fraction"]),
+                    iterations=max(1, int(global_configuration["trim_iterations"]) - 1),
+                    gain_bounds=tuple(
+                        float(v) for v in global_configuration["gain_bounds"]
+                    ),
+                    offset_bounds=tuple(
+                        float(v) for v in global_configuration["offset_bounds"]
+                    ),
+                )
+            except ValueError:
+                all_valid = False
+                break
+            gains[tile, candidate] = local_fit["gain"]
+            offsets[tile, candidate] = local_fit["offset"]
+            losses[tile, candidate] = local_fit["loss"]
+            noises[tile, candidate] = max(
+                float(global_configuration["noise_floor_luma"]),
+                float(local_fit["noise_mad"]),
+            )
+        valid_tiles[tile] = all_valid
+
+    posterior = np.full(
+        (tile_count, candidate_count), 1.0 / candidate_count, dtype=np.float64
+    )
+    for tile in np.flatnonzero(valid_tiles):
+        minimum = float(np.min(losses[tile]))
+        scale = max(
+            float(local_configuration["loss_scale_floor"]),
+            float(np.median(losses[tile]) - minimum),
+        )
+        mass = np.exp(-(losses[tile] - minimum) / scale) + float(
+            local_configuration["posterior_floor"]
+        )
+        posterior[tile] = mass / mass.sum()
+
+    indices = np.asarray(order, dtype=np.int64)
+    symbol_tiles = _symbol_tiles(indices, capture.shape, block_size, tile_size)
+    valid_symbols = valid_tiles[symbol_tiles]
+    global_y = np.asarray(global_result["observations"], dtype=np.float64)[0]
+    global_variance = np.asarray(global_result["variances"], dtype=np.float64)[0]
+    global_erased = np.asarray(global_result["erased"], dtype=bool)
+    observations = np.repeat(global_y[None, :], candidate_count, axis=0)
+    variances = np.repeat(global_variance[None, :], candidate_count, axis=0)
+    log_weights = np.full(
+        (candidate_count, len(indices)), -math.log(candidate_count), dtype=np.float64
+    )
+    component_erased = np.zeros((candidate_count, len(indices)), dtype=bool)
+    zero_blocks = block_view(zero, block_size)[indices].astype(np.float64)
+    one_blocks = block_view(one, block_size)[indices].astype(np.float64)
+    for candidate, shifted in enumerate(shifted_captures):
+        shifted_blocks = block_view(shifted, block_size)[indices].astype(np.float64)
+        gain = gains[symbol_tiles, candidate]
+        offset = offsets[symbol_tiles, candidate]
+        predicted_zero = gain[:, None, None] * zero_blocks + offset[:, None, None]
+        direction = gain[:, None, None] * (one_blocks - zero_blocks)
+        energy = np.sum(np.square(direction), axis=(1, 2), dtype=np.float64)
+        numerator = np.sum(
+            (shifted_blocks - predicted_zero) * direction,
+            axis=(1, 2),
+            dtype=np.float64,
+        )
+        coordinate = np.divide(
+            numerator,
+            energy,
+            out=np.zeros_like(numerator),
+            where=energy > 0.0,
+        )
+        variance = np.divide(
+            np.square(noises[symbol_tiles, candidate]),
+            energy,
+            out=np.full_like(energy, math.inf),
+            where=energy > 0.0,
+        )
+        variance = np.maximum(
+            variance, float(global_configuration["variance_floor_fraction"])
+        )
+        invalid = (
+            ~valid_symbols
+            | (energy < float(global_configuration.get("minimum_endpoint_energy", 1e-6)))
+            | ~np.isfinite(coordinate)
+            | ~np.isfinite(variance)
+            | (variance > float(global_configuration.get("maximum_variance", 1e6)))
+        )
+        use = ~invalid
+        observations[candidate, use] = coordinate[use]
+        variances[candidate, use] = variance[use]
+        component_erased[candidate] = invalid
+        log_weights[candidate, valid_symbols] = np.log(
+            posterior[symbol_tiles[valid_symbols], candidate]
+        )
+
+    erased = global_erased.copy()
+    observations[:, erased] = 0.0
+    variances[:, erased] = 1.0
+    log_weights[:, erased] = -math.log(candidate_count)
+    entropy = -np.sum(
+        posterior[valid_tiles] * np.log(np.maximum(posterior[valid_tiles], 1e-300)),
+        axis=1,
+    )
+    return {
+        "observations": observations.astype(np.float32),
+        "variances": variances.astype(np.float32),
+        "log_weights": log_weights.astype(np.float32),
+        "erased": erased,
+        "diagnostics": {
+            "components": candidate_count,
+            "candidate_shifts": [
+                {"dx": dx, "dy": dy} for dx, dy in candidates
+            ],
+            "valid_tiles": int(np.count_nonzero(valid_tiles)),
+            "fallback_tiles": int(np.count_nonzero(~valid_tiles)),
+            "total_tiles": int(tile_count),
+            "valid_tile_fraction": float(np.mean(valid_tiles)),
+            "fallback_symbols": int(np.count_nonzero(~valid_symbols)),
+            "valid_symbols": int(np.count_nonzero(valid_symbols)),
+            "valid_symbol_fraction": float(np.mean(valid_symbols)),
+            "erased_symbols": int(np.count_nonzero(erased)),
+            "discarded_evidence_fraction": float(np.mean(erased)),
+            "posterior_entropy_mean": float(np.mean(entropy)) if len(entropy) else None,
+            "posterior_max_mean": float(np.mean(np.max(posterior[valid_tiles], axis=1)))
+            if np.any(valid_tiles)
+            else None,
+            "invalid_component_symbol_pairs": int(np.count_nonzero(component_erased)),
+            "recipient_blind": True,
+            "warp_selection_objective": "source-content photometric residual only",
+            "local_photometric_reference": (
+                "blurred source_luma; endpoint and bias descriptors are excluded"
+            ),
+            "uncertainty_approximation": (
+                "fixed local translation mixture conditional on the single globally "
+                "selected blur; blur uncertainty is not marginalized"
+            ),
+        },
+    }
