+"""Row-blind evidence extraction for the existing NISHAN visual carrier.
+
+The preparation functions in this module accept source/channel state but no
+recipient rows, target labels, or accusation scores.  Signed-score calibration
+is separate and explicit because the historical threshold 2100 applies only to
+the historical asymmetric hard scorer.
+"""
+
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+import hashlib
+import json
+import math
+import time
+from typing import Iterable
+
+import cv2
+import numpy as np
+from scipy.optimize import minimize_scalar
+
+
+def array_hash(value: np.ndarray) -> str:
+    array = np.ascontiguousarray(value)
+    prefix = json.dumps([list(array.shape), array.dtype.str], separators=(",", ":"))
+    return hashlib.sha256(prefix.encode() + array.tobytes()).hexdigest()
+
+
+def implemented_probabilities(biases: np.ndarray) -> np.ndarray:
+    p = np.asarray(biases, dtype=np.float64)
+    if p.ndim != 1 or not np.all(np.isfinite(p) & (p > 0) & (p < 1)):
+        raise ValueError("biases must be a finite vector strictly between zero and one")
+    q = np.floor(p * float(1 << 32)) / float(1 << 32)
+    if not np.all((q > 0) & (q < 1)):
+        raise ValueError("implemented probabilities must remain strictly between zero and one")
+    return q
+
+
+def signed_scores(
+    biases: np.ndarray,
+    codebook: np.ndarray,
+    weights: np.ndarray,
+    *,
+    row_chunk: int = 64,
+) -> np.ndarray:
+    """Score fixed signed evidence under the implemented Bernoulli law."""
+
+    q = implemented_probabilities(biases)
+    rows = np.asarray(codebook)
+    w = np.asarray(weights, dtype=np.float64)
+    if rows.ndim != 2 or rows.shape[1] != len(q):
+        raise ValueError("codebook dimensions do not match biases")
+    if w.shape != q.shape or not np.all(np.isfinite(w)):
+        raise ValueError("weights must be a finite vector matching biases")
+    if np.any((rows != 0) & (rows != 1)):
+        raise ValueError("codebook must be binary")
+    if row_chunk < 1:
+        raise ValueError("row_chunk must be positive")
+    positive = w * np.sqrt((1.0 - q) / q)
+    negative = -w * np.sqrt(q / (1.0 - q))
+    result = np.empty(rows.shape[0], dtype=np.float64)
+    for start in range(0, rows.shape[0], row_chunk):
+        stop = min(start + row_chunk, rows.shape[0])
+        result[start:stop] = np.where(rows[start:stop] == 1, positive, negative).sum(axis=1)
+    return result
+
+
+def conditional_signed_threshold(
+    biases: np.ndarray,
+    weights: np.ndarray,
+    family_epsilon: float,
+    hypotheses: int,
+) -> dict[str, object]:
+    """Chernoff boundary for a fixed, row-independent signed evidence vector."""
+
+    q = implemented_probabilities(biases)
+    w = np.asarray(weights, dtype=np.float64)
+    if w.shape != q.shape or not np.all(np.isfinite(w)):
+        raise ValueError("weights must be a finite vector matching biases")
+    if not 0 < family_epsilon < 1 or hypotheses < 1:
+        raise ValueError("invalid family budget")
+    active = w != 0
+    if not np.any(active):
+        return {
+            "threshold": None,
+            "reason": "zero signed evidence",
+            "active_symbols": 0,
+            "hypotheses": hypotheses,
+            "family_epsilon": family_epsilon,
+        }
+    q = q[active]
+    w = w[active]
+    positive = w * np.sqrt((1.0 - q) / q)
+    negative = -w * np.sqrt(q / (1.0 - q))
+    log_budget = float(math.log(hypotheses / family_epsilon))
+
+    def cumulant(theta: float) -> float:
+        return float(
+            np.logaddexp(
+                np.log(q) + theta * positive,
+                np.log1p(-q) + theta * negative,
+            ).sum()
+        )
+
+    def boundary(log_theta: float) -> float:
+        theta = float(math.exp(log_theta))
+        return (cumulant(theta) + log_budget) / theta
+
+    optimum = minimize_scalar(boundary, bounds=(-20.0, 4.0), method="bounded")
+    if not optimum.success or not np.isfinite(optimum.fun):
+        raise RuntimeError("signed Chernoff optimization failed")
+    theta = float(math.exp(optimum.x))
+    k = cumulant(theta)
+    threshold = float((k + log_budget) / theta + 1e-9)
+    return {
+        "threshold": threshold,
+        "theta": theta,
+        "cumulant": k,
+        "active_symbols": int(active.sum()),
+        "hypotheses": hypotheses,
+        "family_epsilon": family_epsilon,
+        "modeled_per_hypothesis_upper": float(math.exp(k - theta * threshold)),
+        "sample_probability": "floor(p * 2^32) / 2^32",
+        "score": "signed centered implemented-Bernoulli score",
+    }
+
+
+def block_view(values: np.ndarray, block_size: int = 6) -> np.ndarray:
+    image = np.asarray(values)
+    if image.ndim != 2:
+        raise ValueError("block view requires a scalar image")
+    rows, columns = image.shape[0] // block_size, image.shape[1] // block_size
+    crop = image[: rows * block_size, : columns * block_size]
+    return (
+        crop.reshape(rows, block_size, columns, block_size)
+        .transpose(0, 2, 1, 3)
+        .reshape(rows * columns, block_size, block_size)
+    )
+
+
+def extract_hard(
+    captured: np.ndarray,
+    source: np.ndarray,
+    order: np.ndarray,
+    templates: np.ndarray,
+) -> dict[str, object]:
+    """Reproduce the float32 historical block correlations and strict signs."""
+
+    captured = np.asarray(captured, dtype=np.float32)
+    source = np.asarray(source, dtype=np.float32)
+    selected_templates = np.asarray(templates, dtype=np.float32)
+    indices = np.asarray(order, dtype=np.int64)
+    if captured.shape != source.shape or captured.ndim != 2:
+        raise ValueError("captured and source luma must have the same 2-D shape")
+    if selected_templates.shape != (len(indices), 6, 6):
+        raise ValueError("templates must be one 6x6 array per symbol")
+    blocks = block_view(captured - source)[indices]
+    correlations = np.sum(blocks * selected_templates, axis=(1, 2), dtype=np.float32)
+    word = (correlations > 0).astype(np.uint8)
+    return {
+        "correlations": correlations,
+        "word": word,
+        "correlations_sha256": array_hash(correlations),
+        "word_sha256": array_hash(word),
+        "zero_correlation_fraction": float(np.mean(correlations == 0)),
+    }
+
+
+@dataclass(frozen=True)
+class GlobalFit:
+    sigma: float
+    gain: float
+    offset: float
+    loss: float
+    retained_pixels: int
+    candidate_losses: tuple[dict[str, float | int | str], ...]
+    elapsed_seconds: float
+
+    def to_dict(self) -> dict[str, object]:
+        return asdict(self)
+
+
+def content_mask(
+    midpoint: np.ndarray,
+    *,
+    border: int = 12,
+    gradient_min: float = 8.0,
+    gradient_max: float = 160.0,
+    luma_min: float = 8.0,
+    luma_max: float = 247.0,
+    stride: int = 2,
+) -> np.ndarray:
+    reference = np.asarray(midpoint, dtype=np.float32)
+    if reference.ndim != 2 or not np.all(np.isfinite(reference)):
+        raise ValueError("midpoint must be a finite scalar image")
+    gx = cv2.Sobel(reference, cv2.CV_32F, 1, 0, ksize=3)
+    gy = cv2.Sobel(reference, cv2.CV_32F, 0, 1, ksize=3)
+    gradient = cv2.magnitude(gx, gy)
+    mask = (
+        (gradient >= gradient_min)
+        & (gradient <= gradient_max)
+        & (reference >= luma_min)
+        & (reference <= luma_max)
+    )
+    if border:
+        mask[:border] = False
+        mask[-border:] = False
+        mask[:, :border] = False
+        mask[:, -border:] = False
+    if stride > 1:
+        sampling = np.zeros(mask.shape, dtype=bool)
+        sampling[::stride, ::stride] = True
+        mask &= sampling
+    return mask
+
+
+def _fit_affine(
+    reference: np.ndarray,
+    captured: np.ndarray,
+    *,
+    trim_fraction: float = 0.8,
+    iterations: int = 3,
+    gain_bounds: tuple[float, float] = (0.35, 1.8),
+    offset_bounds: tuple[float, float] = (-100.0, 100.0),
+) -> tuple[float, float, float, float]:
+    x = np.asarray(reference, dtype=np.float64).ravel()
+    y = np.asarray(captured, dtype=np.float64).ravel()
+    if x.shape != y.shape or len(x) < 2 or not np.all(np.isfinite(x)) or not np.all(np.isfinite(y)):
+        raise ValueError("affine fit needs matching finite samples")
+    kept = np.ones(len(x), dtype=bool)
+    gain = offset = 0.0
+    for _ in range(iterations):
+        design = np.column_stack((x[kept], np.ones(int(kept.sum()))))
+        if np.linalg.matrix_rank(design) < 2:
+            raise ValueError("rank-deficient photometric fit")
+        gain, offset = np.linalg.lstsq(design, y[kept], rcond=None)[0]
+        residual = np.abs(y - (gain * x + offset))
+        boundary = float(np.quantile(residual, trim_fraction))
+        kept = residual <= boundary
+    if not gain_bounds[0] <= gain <= gain_bounds[1]:
+        raise ValueError("photometric gain outside frozen bounds")
+    if not offset_bounds[0] <= offset <= offset_bounds[1]:
+        raise ValueError("photometric offset outside frozen bounds")
+    residual = y - (gain * x + offset)
+    loss = float(np.median(np.abs(residual)))
+    noise = max(1.0, float(1.4826 * np.median(np.abs(residual - np.median(residual)))))
+    return float(gain), float(offset), loss, noise
+
+
+def _blur(values: np.ndarray, sigma: float) -> np.ndarray:
+    image = np.asarray(values, dtype=np.float32)
+    return image.copy() if sigma == 0 else cv2.GaussianBlur(image, (0, 0), sigma)
+
+
+def fit_global_channel(
+    midpoint: np.ndarray,
+    captured: np.ndarray,
+    mask: np.ndarray,
+    *,
+    sigmas: Iterable[float] = (0.0, 0.6, 1.0, 1.4),
+    minimum_pixels: int = 4096,
+) -> GlobalFit:
+    started = time.perf_counter()
+    midpoint = np.asarray(midpoint, dtype=np.float32)
+    captured = np.asarray(captured, dtype=np.float32)
+    mask = np.asarray(mask, dtype=bool)
+    if midpoint.shape != captured.shape or midpoint.shape != mask.shape or midpoint.ndim != 2:
+        raise ValueError("midpoint, capture, and mask must have the same scalar shape")
+    if not np.all(np.isfinite(midpoint)) or not np.all(np.isfinite(captured)):
+        raise ValueError("channel fit images must be finite")
+    retained = int(mask.sum())
+    if retained < minimum_pixels:
+        raise ValueError(f"content mask has {retained} pixels; need {minimum_pixels}")
+    candidates: list[dict[str, float | int | str]] = []
+    valid: list[tuple[float, float, float, float]] = []
+    for sigma in sigmas:
+        reference = _blur(midpoint, float(sigma))
+        try:
+            gain, offset, loss, _ = _fit_affine(reference[mask], captured[mask])
+        except ValueError as error:
+            candidates.append({"sigma": float(sigma), "status": "failed", "reason": str(error)})
+            continue
+        candidates.append({"sigma": float(sigma), "status": "fit", "gain": gain, "offset": offset, "loss": loss})
+        valid.append((loss, float(sigma), gain, offset))
+    if not valid:
+        raise ValueError("all frozen global channel candidates failed")
+    loss, sigma, gain, offset = min(valid, key=lambda row: (row[0], row[1]))
+    return GlobalFit(
+        sigma=sigma,
+        gain=gain,
+        offset=offset,
+        loss=loss,
+        retained_pixels=retained,
+        candidate_losses=tuple(candidates),
+        elapsed_seconds=time.perf_counter() - started,
+    )
+
+
+def _blurred_template_bank(base_templates: np.ndarray, sigma: float) -> np.ndarray:
+    base = np.asarray(base_templates, dtype=np.float32)
+    if base.shape != (2, 6, 6):
+        raise ValueError("base template bank must be 2x6x6")
+    output = np.empty_like(base)
+    for index, template in enumerate(base):
+        padded = np.zeros((18, 18), dtype=np.float32)
+        padded[6:12, 6:12] = template
+        output[index] = _blur(padded, sigma)[6:12, 6:12]
+        output[index] -= float(output[index].mean())
+    return output
+
+
+def _tile_geometry(shape: tuple[int, int], tile_size: int) -> tuple[int, int, np.ndarray]:
+    height, width = shape
+    tile_rows = math.ceil(height / tile_size)
+    tile_columns = math.ceil(width / tile_size)
+    y, x = np.indices(shape)
+    pixels = (y // tile_size) * tile_columns + x // tile_size
+    return tile_rows, tile_columns, pixels.astype(np.int32)
+
+
+def _tile_noise(residual: np.ndarray, tile_pixels: np.ndarray, tile_count: int) -> np.ndarray:
+    noise = np.ones(tile_count, dtype=np.float32)
+    flat_residual = np.asarray(residual, dtype=np.float32).ravel()
+    flat_tiles = tile_pixels.ravel()
+    order = np.argsort(flat_tiles, kind="stable")
+    sorted_residual = flat_residual[order]
+    counts = np.bincount(flat_tiles, minlength=tile_count)
+    boundaries = np.concatenate(([0], np.cumsum(counts)))
+    for tile in range(tile_count):
+        values = sorted_residual[boundaries[tile] : boundaries[tile + 1]]
+        if len(values):
+            median = float(np.median(values))
+            noise[tile] = max(1.0, float(1.4826 * np.median(np.abs(values - median))))
+    return noise
+
+
+def _symbol_tiles(order: np.ndarray, shape: tuple[int, int], tile_size: int) -> np.ndarray:
+    rows, columns = shape[0] // 6, shape[1] // 6
+    block_indices = np.asarray(order, dtype=np.int64)
+    block_y, block_x = block_indices // columns, block_indices % columns
+    tile_columns = math.ceil(shape[1] / tile_size)
+    return (((block_y * 6 + 3) // tile_size) * tile_columns + ((block_x * 6 + 3) // tile_size)).astype(np.int32)
+
+
+def _selected_templates(
+    base_templates: np.ndarray,
+    orientations: np.ndarray,
+    polarities: np.ndarray,
+    sigma: float,
+) -> np.ndarray:
+    bank = _blurred_template_bank(base_templates, sigma)
+    orientation = np.asarray(orientations, dtype=np.int64)
+    polarity = np.asarray(polarities, dtype=np.float32)
+    if orientation.shape != polarity.shape or np.any((orientation < 0) | (orientation > 1)):
+        raise ValueError("invalid carrier orientation/polarity")
+    return bank[orientation] * polarity[:, None, None]
+
+
+def extract_global_soft(
+    captured: np.ndarray,
+    midpoint: np.ndarray,
+    order: np.ndarray,
+    orientations: np.ndarray,
+    polarities: np.ndarray,
+    base_templates: np.ndarray,
+    *,
+    sigmas: Iterable[float] = (0.0, 0.6, 1.0, 1.4),
+    tile_size: int = 96,
+    prefit: GlobalFit | None = None,
+) -> dict[str, object]:
+    started = time.perf_counter()
+    captured = np.asarray(captured, dtype=np.float32)
+    midpoint = np.asarray(midpoint, dtype=np.float32)
+    mask = content_mask(midpoint)
+    fit = prefit or fit_global_channel(midpoint, captured, mask, sigmas=sigmas)
+    reference = _blur(midpoint, fit.sigma)
+    residual = captured - (fit.gain * reference + fit.offset)
+    tile_rows, tile_columns, tile_pixels = _tile_geometry(residual.shape, tile_size)
+    tile_count = tile_rows * tile_columns
+    noise = _tile_noise(residual, tile_pixels, tile_count)
+    symbol_tiles = _symbol_tiles(order, residual.shape, tile_size)
+    templates = _selected_templates(base_templates, orientations, polarities, fit.sigma)
+    selected = block_view(residual)[np.asarray(order, dtype=np.int64)]
+    correlations = np.sum(selected * templates, axis=(1, 2), dtype=np.float32)
+    norms = np.sqrt(np.sum(templates * templates, axis=(1, 2), dtype=np.float32))
+    denominator = np.maximum(1e-6, noise[symbol_tiles] * norms)
+    z = np.clip(correlations / denominator, -12.0, 12.0)
+    weights = np.tanh(z / 3.0).astype(np.float32)
+    return {
+        "weights": weights,
+        "correlations": correlations,
+        "z": z.astype(np.float32),
+        "fit": fit.to_dict(),
+        "mask_pixels": int(mask.sum()),
+        "noise_median": float(np.median(noise)),
+        "weights_sha256": array_hash(weights),
+        "elapsed_seconds": time.perf_counter() - started,
+    }
+
+
+def _shift_image(image: np.ndarray, dx: float, dy: float) -> np.ndarray:
+    return cv2.warpAffine(
+        np.asarray(image, dtype=np.float32),
+        np.array([[1.0, 0.0, dx], [0.0, 1.0, dy]], dtype=np.float32),
+        (image.shape[1], image.shape[0]),
+        flags=cv2.INTER_LANCZOS4,
+        borderMode=cv2.BORDER_CONSTANT,
+        borderValue=255.0,
+    )
+
+
+def extract_local_mixture_soft(
+    captured: np.ndarray,
+    midpoint: np.ndarray,
+    order: np.ndarray,
+    orientations: np.ndarray,
+    polarities: np.ndarray,
+    base_templates: np.ndarray,
+    *,
+    sigmas: Iterable[float] = (0.0, 0.6, 1.0, 1.4),
+    shifts: Iterable[float] = (-0.75, 0.0, 0.75),
+    tile_size: int = 96,
+    minimum_tile_pixels: int = 64,
+    prefit: GlobalFit | None = None,
+) -> dict[str, object]:
+    """Marginalize fixed local shifts using only source-content losses."""
+
+    started = time.perf_counter()
+    captured = np.asarray(captured, dtype=np.float32)
+    midpoint = np.asarray(midpoint, dtype=np.float32)
+    mask = content_mask(midpoint)
+    fit = prefit or fit_global_channel(midpoint, captured, mask, sigmas=sigmas)
+    reference = _blur(midpoint, fit.sigma)
+    global_result = extract_global_soft(
+        captured,
+        midpoint,
+        order,
+        orientations,
+        polarities,
+        base_templates,
+        sigmas=sigmas,
+        tile_size=tile_size,
+        prefit=fit,
+    )
+    candidates = [(float(dx), float(dy)) for dy in shifts for dx in shifts]
+    shifted = [_shift_image(captured, dx, dy) for dx, dy in candidates]
+    tile_rows, tile_columns, tile_pixels = _tile_geometry(captured.shape, tile_size)
+    tile_count = tile_rows * tile_columns
+    candidate_count = len(candidates)
+    gains = np.full((tile_count, candidate_count), np.nan, dtype=np.float32)
+    offsets = np.full_like(gains, np.nan)
+    losses = np.full_like(gains, np.inf)
+    noises = np.full_like(gains, np.nan)
+    valid_tiles = np.zeros(tile_count, dtype=bool)
+    for tile in range(tile_count):
+        tile_y, tile_x = divmod(tile, tile_columns)
+        y0, x0 = tile_y * tile_size, tile_x * tile_size
+        y1 = min(y0 + tile_size, captured.shape[0])
+        x1 = min(x0 + tile_size, captured.shape[1])
+        selected = mask[y0:y1, x0:x1].ravel()
+        if int(selected.sum()) < minimum_tile_pixels:
+            continue
+        tile_reference = reference[y0:y1, x0:x1].ravel()[selected]
+        for candidate, image in enumerate(shifted):
+            try:
+                gain, offset, loss, noise = _fit_affine(
+                    tile_reference,
+                    image[y0:y1, x0:x1].ravel()[selected],
+                    iterations=2,
+                )
+            except ValueError:
+                continue
+            gains[tile, candidate] = gain
+            offsets[tile, candidate] = offset
+            losses[tile, candidate] = loss
+            noises[tile, candidate] = noise
+        valid_tiles[tile] = bool(np.isfinite(losses[tile]).all())
+    posterior = np.zeros_like(losses)
+    for tile in np.flatnonzero(valid_tiles):
+        minimum = float(np.min(losses[tile]))
+        scale = max(0.35, float(np.median(losses[tile]) - minimum))
+        mass = np.exp(-(losses[tile] - minimum) / scale) + 0.02
+        posterior[tile] = mass / mass.sum()
+    symbol_tiles = _symbol_tiles(order, captured.shape, tile_size)
+    templates = _selected_templates(base_templates, orientations, polarities, fit.sigma)
+    template_norms = np.sqrt(np.sum(templates * templates, axis=(1, 2), dtype=np.float32))
+    weights = np.zeros(len(order), dtype=np.float64)
+    correlations = np.zeros(len(order), dtype=np.float64)
+    block_indices = np.asarray(order, dtype=np.int64)
+    for candidate, image in enumerate(shifted):
+        cap_blocks = block_view(image)[block_indices]
+        ref_blocks = block_view(reference)[block_indices]
+        gain = gains[symbol_tiles, candidate]
+        offset = offsets[symbol_tiles, candidate]
+        valid_symbols = valid_tiles[symbol_tiles]
+        local_residual = cap_blocks - gain[:, None, None] * ref_blocks - offset[:, None, None]
+        correlation = np.sum(local_residual * templates, axis=(1, 2), dtype=np.float32)
+        denominator = np.maximum(1e-6, noises[symbol_tiles, candidate] * template_norms)
+        confidence = np.tanh(np.clip(correlation / denominator, -12.0, 12.0) / 3.0)
+        mixture = posterior[symbol_tiles, candidate]
+        weights[valid_symbols] += mixture[valid_symbols] * confidence[valid_symbols]
+        correlations[valid_symbols] += mixture[valid_symbols] * correlation[valid_symbols]
+    fallback = ~valid_tiles[symbol_tiles]
+    weights[fallback] = np.asarray(global_result["weights"])[fallback]
+    correlations[fallback] = np.asarray(global_result["correlations"])[fallback]
+    weights32 = weights.astype(np.float32)
+    return {
+        "weights": weights32,
+        "correlations": correlations.astype(np.float32),
+        "fit": fit.to_dict(),
+        "candidate_shifts": [{"dx": dx, "dy": dy} for dx, dy in candidates],
+        "valid_tiles": int(valid_tiles.sum()),
+        "fallback_tiles": int((~valid_tiles).sum()),
+        "fallback_symbols": int(fallback.sum()),
+        "posterior_entropy_mean": float(
+            np.mean(-np.sum(posterior[valid_tiles] * np.log(np.maximum(posterior[valid_tiles], 1e-30)), axis=1))
+        ) if np.any(valid_tiles) else None,
+        "weights_sha256": array_hash(weights32),
+        "elapsed_seconds": time.perf_counter() - started,
+    }
