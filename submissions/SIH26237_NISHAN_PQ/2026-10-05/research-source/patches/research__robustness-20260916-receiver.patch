+#!/usr/bin/env python3
+"""Frozen three-stage runner for the unchanged NISHAN carrier pilot.
+
+``fixtures`` may issue public synthetic rows and writes evaluation labels to a
+separate file. ``prepare`` never opens that label file and obtains only the
+bias vector through a zero-row keyed-generator call. ``score`` verifies the
+prepared commitment, creates the full roster, and evaluates every row.
+
+This is research tooling.  It does not alter the production/demo receiver and
+does not turn a recovered visual pattern into content authenticity or human
+culpability.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+from dataclasses import asdict, replace
+import hashlib
+import io
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import resource
+import subprocess
+import tempfile
+import time
+import traceback
+from typing import Any
+
+import cv2
+import numpy as np
+from PIL import Image
+
+from nishan import registration, tardos, tardos_carrier, watermark
+
+from research.robustness.receiver import receiver
+
+
+ROOT = Path(__file__).resolve().parents[3]
+DEFAULT_PREREGISTRATION = Path(__file__).with_name("preregistration.json")
+FIXTURE_SECRET = hashlib.sha3_256(
+    b"NISHAN Tardos carrier public fixture v1"
+).digest()
+WRONG_KEY_SECRET = hashlib.sha3_256(
+    b"NISHAN Tardos carrier public fixture v1\x00wrong-key-control/v1"
+).digest()
+CODEBOOK_CONTEXT = "public-benchmark-codebook/v1"
+CARRIER_CONTEXT = "synthetic-source/full-tardos-profile-v1"
+PROFILES = (
+    "affine_hard_asymmetric",
+    "affine_global_signed_soft",
+    "affine_local_mixture_signed_soft",
+)
+
+
+def digest(path: Path) -> str:
+    handle = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            handle.update(chunk)
+    return handle.hexdigest()
+
+
+def _json_bytes(value: object) -> bytes:
+    return (json.dumps(
+        value, indent=2, sort_keys=True, allow_nan=False
+    ) + "\n").encode("utf-8")
+
+
+def dump_exclusive(path: Path, value: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("xb") as handle:
+        handle.write(_json_bytes(value))
+
+
+def _relative(path: Path) -> str:
+    resolved = path.resolve()
+    try:
+        return str(resolved.relative_to(ROOT.resolve()))
+    except ValueError:
+        return str(resolved)
+
+
+def _resolve(path: str) -> Path:
+    value = Path(path)
+    return value if value.is_absolute() else ROOT / value
+
+
+def _git_head() -> str:
+    return subprocess.run(
+        ["git", "rev-parse", "HEAD"],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.strip()
+
+
+def _git_file_commit(path: Path) -> dict[str, str]:
+    relative = str(Path(path).resolve().relative_to(ROOT.resolve()))
+    output = subprocess.run(
+        [
+            "git", "log", "-1",
+            "--format=%H%n%aI%n%cI%n%s",
+            "--", relative,
+        ],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.splitlines()
+    if len(output) != 4:
+        raise ValueError(f"cannot resolve Git chronology for {relative}")
+    return {
+        "commit": output[0],
+        "author_time": output[1],
+        "committer_time": output[2],
+        "subject": output[3],
+    }
+
+
+def _peak_rss_kib() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+
+
+def _load_preregistration(path: Path) -> tuple[dict[str, Any], str]:
+    path = Path(path)
+    payload = json.loads(path.read_text())
+    required = {
+        "schema": "nishan.receiver-preregistration/v1",
+        "protected_baseline": "f37e861dc02815adf1bebb3e1b45ff222dccf821",
+    }
+    for name, expected in required.items():
+        if payload.get(name) != expected:
+            raise ValueError(f"changed preregistration field: {name}")
+    carrier = payload["carrier"]
+    expected_carrier = {
+        "roster_size": 1000,
+        "coalition_limit": 5,
+        "code_length": 52500,
+        "block_size_pixels": 6,
+        "dpi": 144,
+        "strength": 4.0,
+        "historical_threshold": 2100.0,
+    }
+    for name, expected in expected_carrier.items():
+        if carrier.get(name) != expected:
+            raise ValueError(f"changed frozen carrier field: {name}")
+    ids = [item["id"] for item in payload["receiver_profiles"]]
+    if ids != list(PROFILES):
+        raise ValueError("changed receiver profile order")
+    if payload["family_calibration"]["hypotheses"] != 60000:
+        raise ValueError("changed frozen hypothesis count")
+    return payload, digest(path)
+
+
+def _configuration(preregistration: dict[str, Any]) -> tardos.Parameters:
+    carrier = preregistration["carrier"]
+    config = tardos.parameters(
+        carrier["roster_size"],
+        carrier["coalition_limit"],
+        carrier["familywise_epsilon_original_profile"],
+    )
+    if config.code_length != carrier["code_length"] or config.threshold != 2100:
+        raise ValueError("implemented original profile no longer matches frozen carrier")
+    return config
+
+
+def generate_biases(config: tardos.Parameters) -> np.ndarray:
+    """Return only biases through the reviewed zero-row generator path."""
+
+    biases, empty = tardos.generate_keyed(
+        replace(config, roster_size=0), FIXTURE_SECRET, CODEBOOK_CONTEXT
+    )
+    if empty.shape != (0, config.code_length):
+        raise AssertionError("zero-row generator returned recipient data")
+    return biases
+
+
+def generate_roster(config: tardos.Parameters) -> tuple[np.ndarray, np.ndarray]:
+    """Full roster access: callers are restricted to fixtures and score."""
+
+    return tardos.generate_keyed(config, FIXTURE_SECRET, CODEBOOK_CONTEXT)
+
+
+def _verify_hash(path: Path, expected: str, label: str) -> str:
+    if not path.is_file():
+        raise FileNotFoundError(f"missing {label}: {path}")
+    actual = digest(path)
+    if actual != expected:
+        raise ValueError(f"{label} SHA-256 mismatch: {actual} != {expected}")
+    return actual
+
+
+def _luma(image: np.ndarray) -> np.ndarray:
+    return watermark._luma(np.asarray(image, dtype=np.uint8)).astype(np.float32)
+
+
+def _psnr(reference: np.ndarray, observed: np.ndarray, mask: np.ndarray | None = None) -> float | None:
+    left = np.asarray(reference, dtype=np.float32)
+    right = np.asarray(observed, dtype=np.float32)
+    if left.shape != right.shape:
+        return None
+    delta = left - right
+    if mask is not None:
+        selected = np.asarray(mask, dtype=bool)
+        if selected.shape != left.shape[:2] or not np.any(selected):
+            return None
+        delta = delta[selected]
+    mse = float(np.mean(np.square(delta, dtype=np.float64)))
+    return None if mse == 0 else float(20 * math.log10(255 / math.sqrt(mse)))
+
+
+def _text_mask(source: np.ndarray) -> np.ndarray:
+    gray = _luma(source)
+    gx = cv2.Sobel(gray, cv2.CV_32F, 1, 0, ksize=3)
+    gy = cv2.Sobel(gray, cv2.CV_32F, 0, 1, ksize=3)
+    return (gray < 247) | (cv2.magnitude(gx, gy) >= 8)
+
+
+def _jpeg_roundtrip(image: np.ndarray, quality: int) -> np.ndarray:
+    stream = io.BytesIO()
+    Image.fromarray(image).save(stream, format="JPEG", quality=quality)
+    stream.seek(0)
+    with Image.open(stream) as decoded:
+        return np.asarray(decoded.convert("RGB"), dtype=np.uint8)
+
+
+def _global_transform(image: np.ndarray, settings: dict[str, Any]) -> np.ndarray:
+    values = cv2.GaussianBlur(
+        np.asarray(image, dtype=np.float32), (0, 0), settings["blur_sigma"]
+    )
+    values = 255 * np.power(np.clip(values / 255, 0, 1), settings["gamma"])
+    return np.clip(settings["gain"] * values + settings["offset"], 0, 255).astype(np.uint8)
+
+
+def _local_transform(image: np.ndarray, settings: dict[str, Any]) -> np.ndarray:
+    source = np.asarray(image, dtype=np.float32)
+    height, width = source.shape[:2]
+    y, x = np.indices((height, width), dtype=np.float32)
+    map_x = x + settings["x_amplitude_pixels"] * np.sin(
+        2 * np.pi * y / settings["x_period_pixels"]
+    )
+    map_y = y + settings["y_amplitude_pixels"] * np.sin(
+        2 * np.pi * x / settings["y_period_pixels"]
+    )
+    warped = cv2.remap(
+        source,
+        map_x,
+        map_y,
+        cv2.INTER_LANCZOS4,
+        borderMode=cv2.BORDER_CONSTANT,
+        borderValue=(255, 255, 255),
+    )
+    blurred = cv2.GaussianBlur(warped, (0, 0), settings["blur_sigma"])
+    shading = (
+        settings.get("planar_shading_x", 0) * (x / max(width - 1, 1) - 0.5)
+        + settings.get("planar_shading_y", 0) * (y / max(height - 1, 1) - 0.5)
+    )
+    return np.clip(blurred + shading[:, :, None], 0, 255).astype(np.uint8)
+
+
+def _combined_transform(image: np.ndarray, settings: dict[str, Any]) -> np.ndarray:
+    """Apply the frozen warp, one blur, photometric map, then one JPEG pass."""
+
+    source = np.asarray(image, dtype=np.float32)
+    height, width = source.shape[:2]
+    y, x = np.indices((height, width), dtype=np.float32)
+    map_x = x + settings["x_amplitude_pixels"] * np.sin(
+        2 * np.pi * y / settings["x_period_pixels"]
+    )
+    map_y = y + settings["y_amplitude_pixels"] * np.sin(
+        2 * np.pi * x / settings["y_period_pixels"]
+    )
+    warped = cv2.remap(
+        source,
+        map_x,
+        map_y,
+        cv2.INTER_LANCZOS4,
+        borderMode=cv2.BORDER_CONSTANT,
+        borderValue=(255, 255, 255),
+    )
+    blurred = cv2.GaussianBlur(warped, (0, 0), settings["blur_sigma"])
+    values = 255 * np.power(np.clip(blurred / 255, 0, 1), settings["gamma"])
+    values = np.clip(settings["gain"] * values + settings["offset"], 0, 255)
+    return _jpeg_roundtrip(values.astype(np.uint8), settings["jpeg_quality"])
+
+
+def _transform(image: np.ndarray, name: str, settings: dict[str, Any]) -> np.ndarray:
+    if name == "identity":
+        return np.asarray(image, dtype=np.uint8).copy()
+    if name == "jpeg_q55":
+        return _jpeg_roundtrip(image, settings["jpeg_q55"]["quality"])
+    if name == "global":
+        return _global_transform(image, settings["global"])
+    if name == "local":
+        return _local_transform(image, settings["local"])
+    if name == "combined":
+        return _combined_transform(image, settings["combined"])
+    if name == "white_clip":
+        values = np.asarray(image, dtype=np.uint8).copy()
+        spec = settings["white_clip"]
+        values[values >= spec["values_at_or_above"]] = spec["replacement"]
+        return values
+    raise ValueError(f"unsupported frozen transform: {name}")
+
+
+def _save_png(path: Path, image: np.ndarray) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("xb") as handle:
+        Image.fromarray(np.asarray(image, dtype=np.uint8)).save(handle, format="PNG", optimize=True)
+
+
+def _image_metadata(path: Path) -> dict[str, Any]:
+    with Image.open(path) as image:
+        exif = {
+            str(key): str(value)
+            for key, value in image.getexif().items()
+        }
+        return {
+            "byte_size": path.stat().st_size,
+            "width": image.width,
+            "height": image.height,
+            "format": image.format,
+            "mode": image.mode,
+            "exif": exif,
+        }
+
+
+def _source_inventory(preregistration: dict[str, Any]) -> dict[str, Path]:
+    inventory = {"existing": _resolve(preregistration["inputs"]["existing_source"]["path"])}
+    source_manifest_path = _resolve(
+        preregistration["inputs"]["source_pack_manifest"]["path"]
+    )
+    source_manifest = json.loads(source_manifest_path.read_text())
+    for item in source_manifest["cases"]:
+        path = source_manifest_path.parent / item["file"]
+        _verify_hash(path, item["sha256"], f"source pack {item['id']}")
+        inventory[item["id"]] = path
+    return inventory
+
+
+def fixtures(
+    preregistration_path: Path,
+    output_directory: Path,
+    *,
+    release_pending: bool = False,
+) -> dict[str, Any]:
+    """Create matched captures and a separate scoring-only label file."""
+
+    output = Path(output_directory)
+    if output.exists():
+        raise FileExistsError(output)
+    output.mkdir(parents=True, exist_ok=False)
+    started = time.perf_counter()
+    cv2.setNumThreads(2)
+    preregistration, preregistration_hash = _load_preregistration(preregistration_path)
+    config = _configuration(preregistration)
+    sources = _source_inventory(preregistration)
+    existing_source_spec = preregistration["inputs"]["existing_source"]
+    existing_marked_spec = preregistration["inputs"]["existing_marked"]
+    _verify_hash(sources["existing"], existing_source_spec["sha256"], "existing source")
+    existing_marked = _resolve(existing_marked_spec["path"])
+    _verify_hash(existing_marked, existing_marked_spec["sha256"], "existing marked PDF")
+    for item in preregistration["inputs"]["historical_captures"]:
+        _verify_hash(Path(item["path"]), item["sha256"], item["id"])
+
+    biases, codebook = generate_roster(config)
+    labels = {
+        "schema": "nishan.receiver-labels/v1",
+        "preregistration_sha256": preregistration_hash,
+        "cases": {
+            item["id"]: {
+                "expected_rows": item["score_expected_rows"],
+                "safe_outcome": item["safe_outcome"],
+            }
+            for item in preregistration["cases"]
+        },
+    }
+    label_path = output / "labels.json"
+    dump_exclusive(label_path, labels)
+
+    rendered_sources: dict[str, np.ndarray] = {}
+    marked_cache: dict[tuple[str, int], tuple[np.ndarray, dict[str, Any]]] = {}
+
+    def source_rgb(source_id: str) -> np.ndarray:
+        if source_id not in rendered_sources:
+            pages, _ = watermark.load_pages(sources[source_id], dpi=144)
+            if len(pages) != 1:
+                raise ValueError(f"{source_id} is not a one-page source")
+            rendered_sources[source_id] = pages[0]
+        return rendered_sources[source_id]
+
+    with tempfile.TemporaryDirectory(prefix="nishan-receiver-fixtures-") as temporary:
+        temporary_path = Path(temporary)
+
+        def marked(source_id: str, row: int) -> tuple[np.ndarray, dict[str, Any]]:
+            key = (source_id, row)
+            if key not in marked_cache:
+                destination = temporary_path / f"{source_id}-row{row}.pdf"
+                metrics = tardos_carrier.embed_pdf(
+                    sources[source_id], destination, codebook[row],
+                    FIXTURE_SECRET, CARRIER_CONTEXT,
+                    strength=4.0, dpi=144, block_size=6,
+                )
+                pages, _ = watermark.load_pages(destination, dpi=144)
+                marked_cache[key] = (pages[0], asdict(metrics))
+            return marked_cache[key]
+
+        records: list[dict[str, Any]] = []
+        for frozen_case in preregistration["cases"]:
+            case_id = frozen_case["id"]
+            record: dict[str, Any] = {
+                "id": case_id,
+                "split": frozen_case["split"],
+                "category": frozen_case["category"],
+                "transform": frozen_case["transform"],
+                "source_id": frozen_case["source"],
+                "receiver_variant": frozen_case.get("receiver_variant", "frozen_correct_key"),
+            }
+            try:
+                if frozen_case["transform"] == "external_pending":
+                    if not release_pending:
+                        record.update(
+                            status="sealed_pending_release",
+                            reason="prospective capture deliberately not read by fixtures",
+                            source_path=_relative(sources["existing"]),
+                            source_sha256=digest(sources["existing"]),
+                            capture_path=None,
+                            capture_sha256=None,
+                        )
+                    else:
+                        pending = Path(preregistration["inputs"]["pending_capture"]["path"])
+                        metadata = _image_metadata(pending)
+                        record.update(
+                            status="ready",
+                            source_path=_relative(sources["existing"]),
+                            source_sha256=digest(sources["existing"]),
+                            capture_path=str(pending.resolve()),
+                            capture_sha256=digest(pending),
+                            intake=metadata | {
+                                "transfer_statement": "unverified; supplied filename alone does not establish transfer processing",
+                            },
+                            observed_category="real_camera_transfer_unknown_confirmation",
+                            preregistered_category=frozen_case["category"],
+                            category_deviation=(
+                                "The preregistered WhatsApp-document label is not factually verified; "
+                                "measurement is reported as camera/transfer-unknown."
+                            ),
+                        )
+                    records.append(record)
+                    continue
+
+                if frozen_case["transform"] == "external":
+                    item = next(
+                        value for value in preregistration["inputs"]["historical_captures"]
+                        if value["id"] == case_id
+                    )
+                    capture = Path(item["path"])
+                    record.update(
+                        status="ready",
+                        source_path=_relative(sources["existing"]),
+                        source_sha256=digest(sources["existing"]),
+                        capture_path=str(capture.resolve()),
+                        capture_sha256=digest(capture),
+                        intake=_image_metadata(capture),
+                        synthetic_metrics=None,
+                    )
+                    records.append(record)
+                    continue
+
+                source_id = frozen_case["source"]
+                source = source_rgb(source_id)
+                embedding_metrics: dict[str, Any] | None
+                fixture_kind = frozen_case["fixture"]
+                if case_id == "existing_exact":
+                    pages, _ = watermark.load_pages(existing_marked, dpi=144)
+                    observed = pages[0]
+                    embedding_metrics = asdict(
+                        tardos_carrier.measure_pdf_pair(sources["existing"], existing_marked, dpi=144)
+                    )
+                    capture_path = existing_marked
+                elif fixture_kind == "unmarked":
+                    observed = source.copy()
+                    embedding_metrics = None
+                    capture_path = None
+                elif fixture_kind == "transplanted_row0_overlay":
+                    donor_source = source_rgb(frozen_case["donor_source"])
+                    donor_marked, donor_metrics = marked(frozen_case["donor_source"], 0)
+                    if donor_source.shape != source.shape:
+                        raise ValueError("transplant donor and target geometry differ")
+                    observed = np.clip(
+                        source.astype(np.int16)
+                        + donor_marked.astype(np.int16)
+                        - donor_source.astype(np.int16),
+                        0,
+                        255,
+                    ).astype(np.uint8)
+                    embedding_metrics = donor_metrics | {
+                        "transplant_definition": "target + (donor_marked - donor_unmarked)",
+                    }
+                    capture_path = None
+                else:
+                    row = 1 if fixture_kind == "row1" else 0
+                    capture_source_id = frozen_case.get("capture_source", source_id)
+                    observed, embedding_metrics = marked(capture_source_id, row)
+                    capture_path = None
+
+                transformed = _transform(
+                    observed,
+                    frozen_case["transform"],
+                    preregistration["synthetic_transform_configuration"],
+                )
+                if capture_path is None:
+                    capture_path = output / "captures" / f"{case_id}.png"
+                    _save_png(capture_path, transformed)
+                capture_hash = digest(capture_path)
+                mask = _text_mask(source)
+                record.update(
+                    status="ready",
+                    source_path=_relative(sources[source_id]),
+                    source_sha256=digest(sources[source_id]),
+                    capture_path=_relative(capture_path),
+                    capture_sha256=capture_hash,
+                    synthetic_metrics={
+                        "embedding": embedding_metrics,
+                        "source_to_observation_psnr_db": _psnr(source, transformed),
+                        "source_text_region_psnr_db": _psnr(source, transformed, mask),
+                        "text_region_definition": "source luma <247 OR Sobel magnitude >=8",
+                        "saturation_fraction": float(np.mean((transformed == 0) | (transformed == 255))),
+                        "pixel_shape": list(transformed.shape),
+                    },
+                )
+            except Exception as error:  # Retain every frozen failure.
+                record.update(
+                    status="fixture_failed",
+                    reason=f"{type(error).__name__}: {error}",
+                    traceback=traceback.format_exc(),
+                    capture_path=None,
+                    capture_sha256=None,
+                )
+            records.append(record)
+
+    payload = {
+        "schema": "nishan.receiver-fixtures/v1",
+        "completed": True,
+        "preregistration_path": _relative(preregistration_path),
+        "preregistration_sha256": preregistration_hash,
+        "freeze_chronology": {
+            "typed_frozen_at": preregistration["frozen_at"],
+            "authoritative_protocol_commit": _git_file_commit(preregistration_path),
+            "interpretation": (
+                "Git commit ancestry and commit time establish that the protocol file was committed "
+                "before receiver measurements. The typed frozen_at value is inaccurate metadata and "
+                "is not used to claim ordering."
+            ),
+        },
+        "labels_sha256": digest(label_path),
+        "release_pending_capture": release_pending,
+        "codebook_commitment": tardos.manifest(config, biases, codebook),
+        "carrier": {
+            "roster_size": 1000,
+            "coalition_limit": 5,
+            "code_length": 52500,
+            "block_size_pixels": 6,
+            "dpi": 144,
+            "strength": 4.0,
+            "carrier_context": CARRIER_CONTEXT,
+            "same_embedded_row_bytes_across_receiver_profiles": True,
+        },
+        "cases": records,
+        "runtime": {
+            "elapsed_seconds": time.perf_counter() - started,
+            "peak_rss_kib": _peak_rss_kib(),
+            "python": platform.python_version(),
+            "numpy": np.__version__,
+            "opencv": cv2.__version__,
+            "git_head": _git_head(),
+        },
+        "warnings": [
+            "Synthetic transforms are diagnostics, not physical print/camera evidence.",
+            "Historical captures are development-only repeated observations.",
+            "Labels are separate from receiver-preparation inputs.",
+        ],
+    }
+    dump_exclusive(output / "manifest.json", payload)
+    return payload
+
+
+def _ecc_affine(
+    source: np.ndarray, aligned: np.ndarray
+) -> tuple[np.ndarray, dict[str, Any]]:
+    """Frozen content-only ECC refinement; warp maps source into ORB input."""
+
+    matrix = np.eye(2, 3, dtype=np.float32)
+    gray_source = cv2.cvtColor(source, cv2.COLOR_RGB2GRAY).astype(np.float32) / 255
+    gray_aligned = cv2.cvtColor(aligned, cv2.COLOR_RGB2GRAY).astype(np.float32) / 255
+    coefficient, matrix = cv2.findTransformECC(
+        gray_source,
+        gray_aligned,
+        matrix,
+        cv2.MOTION_AFFINE,
+        (cv2.TERM_CRITERIA_COUNT | cv2.TERM_CRITERIA_EPS, 200, 1e-6),
+        None,
+        5,
+    )
+    return matrix, {
+        "ecc_coefficient": float(coefficient),
+        "inverse_warp": matrix.tolist(),
+        "motion": "affine",
+        "iterations": 200,
+        "stop_epsilon": 1e-6,
+        "gaussian_size": 5,
+    }
+
+
+def _compose_single_resampling(
+    capture: np.ndarray,
+    source_shape: tuple[int, ...],
+    orb_homography: list[list[float]],
+    ecc_inverse_warp: np.ndarray,
+) -> tuple[np.ndarray, np.ndarray]:
+    inverse = np.eye(3, dtype=np.float64)
+    inverse[:2] = np.asarray(ecc_inverse_warp, dtype=np.float64)
+    combined = np.linalg.inv(inverse) @ np.asarray(orb_homography, dtype=np.float64)
+    result = cv2.warpPerspective(
+        capture,
+        combined,
+        (source_shape[1], source_shape[0]),
+        flags=cv2.INTER_LANCZOS4,
+        borderMode=cv2.BORDER_CONSTANT,
+        borderValue=(255, 255, 255),
+    )
+    return result, combined
+
+
+def _align(source: np.ndarray, capture: np.ndarray) -> tuple[np.ndarray, dict[str, Any]]:
+    aligned, orb = registration.align_page(source, capture)
+    metrics = {"orb": orb.to_dict()}
+    same_shape_identity = (
+        source.shape == capture.shape
+        and not orb.applied
+        and orb.rejection_reason is None
+        and orb.baseline_similarity >= 0.92
+    )
+    if same_shape_identity:
+        metrics.update(
+            mode="same-geometry content-similarity guard",
+            raw_to_reference=np.eye(3).tolist(),
+            single_final_resampling=True,
+        )
+        return aligned, metrics
+    if not orb.applied or orb.homography_suspect_to_reference is None:
+        raise ValueError(
+            "ORB initialization was not accepted: " + str(orb.rejection_reason)
+        )
+    inverse, ecc = _ecc_affine(source, aligned)
+    rendered, combined = _compose_single_resampling(
+        capture, source.shape, orb.homography_suspect_to_reference, inverse
+    )
+    metrics.update(
+        mode="ORB then ECC-affine; composed original-capture resampling",
+        ecc=ecc,
+        raw_to_reference=combined.tolist(),
+        single_final_resampling=True,
+    )
+    return rendered, metrics
+
+
+def _source_response(
+    source_path: Path,
+    biases: np.ndarray,
+    secret: bytes,
+) -> dict[str, Any]:
+    pages, _ = watermark.load_pages(source_path, dpi=144)
+    if len(pages) != 1:
+        raise ValueError("frozen runner supports exactly one page per source")
+    source_rgb = pages[0]
+    source_luma = _luma(source_rgb)
+    rows, columns = source_luma.shape[0] // 6, source_luma.shape[1] // 6
+    order, orientation, polarity = tardos_carrier._plan(
+        secret, CARRIER_CONTEXT, rows * columns, len(biases)
+    )
+    endpoints = []
+    with tempfile.TemporaryDirectory(prefix="nishan-receiver-endpoints-") as temporary:
+        for bit in (0, 1):
+            destination = Path(temporary) / f"endpoint-{bit}.pdf"
+            tardos_carrier.embed_pdf(
+                source_path,
+                destination,
+                np.full(len(biases), bit, dtype=np.uint8),
+                secret,
+                CARRIER_CONTEXT,
+                strength=4.0,
+                dpi=144,
+                block_size=6,
+            )
+            rendered, _ = watermark.load_pages(destination, dpi=144)
+            endpoints.append(_luma(rendered[0]))
+    q = receiver.implemented_probabilities(biases)
+    probabilities = np.full(rows * columns, 0.5, dtype=np.float32)
+    probabilities[order] = q.astype(np.float32)
+    q_image = np.full(source_luma.shape, 0.5, dtype=np.float32)
+    q_image[: rows * 6, : columns * 6] = np.repeat(
+        np.repeat(probabilities.reshape(rows, columns), 6, axis=0), 6, axis=1
+    )
+    expectation = endpoints[0] + q_image * (endpoints[1] - endpoints[0])
+    return {
+        "source_rgb": source_rgb,
+        "source_luma": source_luma,
+        "expectation": expectation.astype(np.float32),
+        "order": order,
+        "orientation": orientation,
+        "polarity": polarity,
+        "base_templates": tardos_carrier._templates(6),
+        "endpoint_zero_sha256": receiver.array_hash(endpoints[0]),
+        "endpoint_one_sha256": receiver.array_hash(endpoints[1]),
+        "expectation_sha256": receiver.array_hash(expectation.astype(np.float32)),
+    }
+
+
+def _manifest_cases(fixtures_directory: Path) -> tuple[dict[str, Any], str]:
+    path = Path(fixtures_directory) / "manifest.json"
+    payload = json.loads(path.read_text())
+    if payload.get("schema") != "nishan.receiver-fixtures/v1" or not payload.get("completed"):
+        raise ValueError("invalid or incomplete fixture manifest")
+    return payload, digest(path)
+
+
+def _validate_fixture_inventory(
+    preregistration: dict[str, Any], fixtures_payload: dict[str, Any]
+) -> None:
+    frozen = [
+        (item["id"], item["split"], item["category"], item["transform"])
+        for item in preregistration["cases"]
+    ]
+    observed = [
+        (item["id"], item["split"], item["category"], item["transform"])
+        for item in fixtures_payload.get("cases", [])
+    ]
+    if observed != frozen:
+        raise ValueError("fixture manifest does not retain the frozen case inventory")
+
+
+def _record_failure(
+    records: list[dict[str, Any]], case: dict[str, Any], status: str, reason: str
+) -> None:
+    for profile in PROFILES:
+        records.append({
+            "case_id": case["id"],
+            "profile": profile,
+            "status": status,
+            "reason": reason,
+            "source_sha256": case.get("source_sha256"),
+            "capture_sha256": case.get("capture_sha256"),
+        })
+
+
+def _metadata_without_arrays(result: dict[str, Any]) -> dict[str, Any]:
+    return {
+        key: value
+        for key, value in result.items()
+        if not isinstance(value, np.ndarray)
+    }
+
+
+def prepare(
+    preregistration_path: Path,
+    fixtures_directory: Path,
+    output_directory: Path,
+) -> dict[str, Any]:
+    """Fit geometry/channel and commit evidence without roster rows or labels."""
+
+    output = Path(output_directory)
+    if output.exists():
+        raise FileExistsError(output)
+    output.mkdir(parents=True, exist_ok=False)
+    started = time.perf_counter()
+    cv2.setNumThreads(2)
+    preregistration, preregistration_hash = _load_preregistration(preregistration_path)
+    fixtures_payload, fixtures_hash = _manifest_cases(fixtures_directory)
+    if fixtures_payload["preregistration_sha256"] != preregistration_hash:
+        raise ValueError("fixture/preregistration commitment mismatch")
+    _validate_fixture_inventory(preregistration, fixtures_payload)
+    config = _configuration(preregistration)
+    biases = generate_biases(config)
+    fixed = preregistration["fixed_receiver_configuration"]
+    sigmas = tuple(fixed["global_channel"]["gaussian_sigmas"])
+    shifts = tuple(fixed["local_uncertainty"]["shift_x_pixels"])
+    arrays: dict[str, np.ndarray] = {"biases": biases}
+    records: list[dict[str, Any]] = []
+    source_cache: dict[tuple[str, str], dict[str, Any]] = {}
+
+    for case in fixtures_payload["cases"]:
+        if case.get("status") != "ready":
+            _record_failure(
+                records, case, "input_unavailable", case.get("reason", case.get("status", "unavailable"))
+            )
+            continue
+        try:
+            source_path = _resolve(case["source_path"])
+            capture_path = _resolve(case["capture_path"])
+            _verify_hash(source_path, case["source_sha256"], f"{case['id']} source")
+            _verify_hash(capture_path, case["capture_sha256"], f"{case['id']} capture")
+            receiver_secret = WRONG_KEY_SECRET if case.get("receiver_variant") == "wrong_key" else FIXTURE_SECRET
+            cache_key = (str(source_path.resolve()), hashlib.sha256(receiver_secret).hexdigest())
+            if cache_key not in source_cache:
+                source_cache[cache_key] = _source_response(source_path, biases, receiver_secret)
+            response = source_cache[cache_key]
+            capture_pages, _ = watermark.load_pages(capture_path, dpi=144)
+            if len(capture_pages) != 1:
+                raise ValueError("capture must contain exactly one page")
+            aligned_rgb, alignment = _align(response["source_rgb"], capture_pages[0])
+            captured_luma = _luma(aligned_rgb)
+        except Exception as error:
+            _record_failure(
+                records,
+                case,
+                "initialization_failed",
+                f"{type(error).__name__}: {error}",
+            )
+            continue
+
+        common = {
+            "case_id": case["id"],
+            "source_sha256": case["source_sha256"],
+            "capture_sha256": case["capture_sha256"],
+            "receiver_variant": case.get("receiver_variant", "frozen_correct_key"),
+            "registration": alignment,
+            "expectation_sha256": response["expectation_sha256"],
+            "endpoint_zero_sha256": response["endpoint_zero_sha256"],
+            "endpoint_one_sha256": response["endpoint_one_sha256"],
+        }
+        selected_templates = (
+            response["base_templates"][response["orientation"]]
+            * response["polarity"][:, None, None]
+        )
+
+        hard_started = time.perf_counter()
+        try:
+            hard = receiver.extract_hard(
+                captured_luma,
+                response["source_luma"],
+                response["order"],
+                selected_templates,
+            )
+            index = len(records)
+            word_key = f"record_{index}_word"
+            correlations_key = f"record_{index}_correlations"
+            arrays[word_key] = hard["word"]
+            arrays[correlations_key] = hard["correlations"]
+            records.append(common | {
+                "profile": PROFILES[0],
+                "status": "prepared",
+                "word_key": word_key,
+                "correlations_key": correlations_key,
+                "diagnostics": _metadata_without_arrays(hard),
+                "runtime_seconds": time.perf_counter() - hard_started,
+            })
+        except Exception as error:
+            records.append(common | {
+                "profile": PROFILES[0],
+                "status": "evidence_failed",
+                "reason": f"{type(error).__name__}: {error}",
+                "runtime_seconds": time.perf_counter() - hard_started,
+            })
+
+        fit = None
+        global_started = time.perf_counter()
+        try:
+            mask = receiver.content_mask(response["expectation"])
+            fit = receiver.fit_global_channel(
+                response["expectation"],
+                captured_luma,
+                mask,
+                sigmas=sigmas,
+                minimum_pixels=fixed["content_mask"]["minimum_pixels_global"],
+            )
+            global_result = receiver.extract_global_soft(
+                captured_luma,
+                response["expectation"],
+                response["order"],
+                response["orientation"],
+                response["polarity"],
+                response["base_templates"],
+                sigmas=sigmas,
+                tile_size=fixed["soft_evidence"]["noise_tiles_pixels"],
+                prefit=fit,
+            )
+            index = len(records)
+            weights_key = f"record_{index}_weights"
+            correlations_key = f"record_{index}_correlations"
+            arrays[weights_key] = global_result["weights"]
+            arrays[correlations_key] = global_result["correlations"]
+            records.append(common | {
+                "profile": PROFILES[1],
+                "status": "prepared",
+                "weights_key": weights_key,
+                "correlations_key": correlations_key,
+                "diagnostics": _metadata_without_arrays(global_result),
+                "runtime_seconds": time.perf_counter() - global_started,
+            })
+        except Exception as error:
+            records.append(common | {
+                "profile": PROFILES[1],
+                "status": "evidence_failed",
+                "reason": f"{type(error).__name__}: {error}",
+                "runtime_seconds": time.perf_counter() - global_started,
+            })
+
+        local_started = time.perf_counter()
+        try:
+            if fit is None:
+                raise ValueError("shared frozen global channel fit unavailable")
+            local_result = receiver.extract_local_mixture_soft(
+                captured_luma,
+                response["expectation"],
+                response["order"],
+                response["orientation"],
+                response["polarity"],
+                response["base_templates"],
+                sigmas=sigmas,
+                shifts=shifts,
+                tile_size=fixed["local_uncertainty"]["tile_pixels"],
+                minimum_tile_pixels=fixed["content_mask"]["minimum_pixels_tile"],
+                prefit=fit,
+            )
+            index = len(records)
+            weights_key = f"record_{index}_weights"
+            correlations_key = f"record_{index}_correlations"
+            arrays[weights_key] = local_result["weights"]
+            arrays[correlations_key] = local_result["correlations"]
+            records.append(common | {
+                "profile": PROFILES[2],
+                "status": "prepared",
+                "weights_key": weights_key,
+                "correlations_key": correlations_key,
+                "diagnostics": _metadata_without_arrays(local_result),
+                "runtime_seconds": time.perf_counter() - local_started,
+            })
+        except Exception as error:
+            records.append(common | {
+                "profile": PROFILES[2],
+                "status": "evidence_failed",
+                "reason": f"{type(error).__name__}: {error}",
+                "runtime_seconds": time.perf_counter() - local_started,
+            })
+
+    expected_pairs = [
+        (case["id"], profile)
+        for case in fixtures_payload["cases"]
+        for profile in PROFILES
+    ]
+    actual_pairs = [(item["case_id"], item["profile"]) for item in records]
+    if actual_pairs != expected_pairs:
+        raise AssertionError("preparation did not retain the frozen case/profile Cartesian product")
+    payload = {
+        "schema": "nishan.receiver-preparation/v1",
+        "completed": True,
+        "preregistration_sha256": preregistration_hash,
+        "fixture_manifest_sha256": fixtures_hash,
+        "labels_loaded": False,
+        "roster_rows_loaded": 0,
+        "profiles": list(PROFILES),
+        "records": records,
+        "array_sha256": {
+            name: receiver.array_hash(value) for name, value in arrays.items()
+        },
+        "code_sha256": {
+            "research/robustness/receiver/run_pilot.py": digest(Path(__file__)),
+            "research/robustness/receiver/receiver.py": digest(Path(receiver.__file__)),
+            "prototypes/nishan_pq/nishan/tardos.py": digest(Path(tardos.__file__)),
+            "prototypes/nishan_pq/nishan/tardos_carrier.py": digest(Path(tardos_carrier.__file__)),
+            "prototypes/nishan_pq/nishan/registration.py": digest(Path(registration.__file__)),
+        },
+        "runtime": {
+            "elapsed_seconds": time.perf_counter() - started,
+            "peak_rss_kib": _peak_rss_kib(),
+            "python": platform.python_version(),
+            "numpy": np.__version__,
+            "opencv": cv2.__version__,
+            "git_head": _git_head(),
+        },
+        "warnings": [
+            "No recipient row, expected label, or prior attribution score was loaded.",
+            "Channel/geometry fitting used only source descriptors, bias expectation, and capture pixels.",
+            "Failures are retained; profiles are never substituted after scoring.",
+        ],
+    }
+    evidence_path = output / "evidence.npz"
+    with evidence_path.open("xb") as handle:
+        np.savez_compressed(handle, **arrays)
+    dump_exclusive(output / "preparation.json", payload)
+    commitment = {
+        "schema": "nishan.receiver-preparation-commitment/v1",
+        "completed": True,
+        "sha256": {
+            "preparation.json": digest(output / "preparation.json"),
+            "evidence.npz": digest(evidence_path),
+        },
+    }
+    dump_exclusive(output / "commitment.json", commitment)
+    return payload
+
+
+def validate_prepared(
+    preregistration_path: Path,
+    fixtures_directory: Path,
+    prepared_directory: Path,
+) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any], str]:
+    preregistration, preregistration_hash = _load_preregistration(preregistration_path)
+    fixtures_payload, fixtures_hash = _manifest_cases(fixtures_directory)
+    _validate_fixture_inventory(preregistration, fixtures_payload)
+    directory = Path(prepared_directory)
+    commitment = json.loads((directory / "commitment.json").read_text())
+    if commitment.get("completed") is not True or set(commitment.get("sha256", {})) != {
+        "preparation.json", "evidence.npz"
+    }:
+        raise ValueError("invalid preparation commitment inventory")
+    for name, expected in commitment["sha256"].items():
+        if digest(directory / name) != expected:
+            raise ValueError(f"prepared file hash mismatch: {name}")
+    payload = json.loads((directory / "preparation.json").read_text())
+    if payload.get("schema") != "nishan.receiver-preparation/v1" or not payload.get("completed"):
+        raise ValueError("invalid preparation metadata")
+    if payload["preregistration_sha256"] != preregistration_hash:
+        raise ValueError("prepared preregistration mismatch")
+    if payload["fixture_manifest_sha256"] != fixtures_hash:
+        raise ValueError("prepared fixture manifest mismatch")
+    if payload.get("labels_loaded") is not False or payload.get("roster_rows_loaded") != 0:
+        raise ValueError("preparation stage-separation assertion failed")
+    for name, expected in payload["code_sha256"].items():
+        path = ROOT / name
+        if digest(path) != expected:
+            raise ValueError(f"prepared code hash mismatch: {name}")
+    with np.load(directory / "evidence.npz", allow_pickle=False) as stored:
+        if set(stored.files) != set(payload["array_sha256"]):
+            raise ValueError("prepared array inventory mismatch")
+        for name, expected in payload["array_sha256"].items():
+            if receiver.array_hash(stored[name]) != expected:
+                raise ValueError(f"prepared array hash mismatch: {name}")
+    return preregistration, fixtures_payload, payload, preregistration_hash
+
+
+def _outcome(
+    expected: list[int], accused: list[int], safe_outcome: str
+) -> tuple[str, str]:
+    expected_set, accused_set = set(expected), set(accused)
+    if not expected:
+        score_outcome = "abstain" if not accused else "wrong"
+    elif not accused:
+        score_outcome = "abstain"
+    elif accused_set == expected_set:
+        score_outcome = "correct"
+    else:
+        score_outcome = "wrong"
+    if safe_outcome == "abstain_transplant_pattern_is_not_authenticity":
+        return score_outcome, "abstain_transplant_pattern_is_not_authenticity"
+    return score_outcome, score_outcome
+
+
+def _rank(scores: np.ndarray, row: int) -> int:
+    return int(1 + np.count_nonzero(scores > scores[row]))
+
+
+def _score_record(
+    item: dict[str, Any],
+    arrays: Any,
+    biases: np.ndarray,
+    codebook: np.ndarray,
+    label: dict[str, Any],
+    preregistration: dict[str, Any],
+) -> dict[str, Any]:
+    base = {
+        "case_id": item["case_id"],
+        "profile": item["profile"],
+        "prepared_status": item["status"],
+        "expected_rows": label["expected_rows"],
+        "safe_outcome": label["safe_outcome"],
+        "source_sha256": item.get("source_sha256"),
+        "capture_sha256": item.get("capture_sha256"),
+        "registration": item.get("registration"),
+        "fit_parameters": item.get("diagnostics", {}).get("fit"),
+        "fit_loss": (item.get("diagnostics", {}).get("fit") or {}).get("loss"),
+        "fallback_tiles": item.get("diagnostics", {}).get("fallback_tiles"),
+        "preparation_runtime_seconds": item.get("runtime_seconds"),
+    }
+    if item["status"] != "prepared":
+        return base | {
+            "status": "failure",
+            "reason": item.get("reason"),
+            "score_outcome": "failure",
+            "outcome": "failure",
+            "accused_rows": [],
+            "all_1000_scores": None,
+            "threshold": None,
+        }
+    family = preregistration["family_calibration"]
+    if item["profile"] == PROFILES[0]:
+        word = arrays[item["word_key"]]
+        scores = tardos.accusation_scores(biases, codebook, word)
+        threshold = receiver.conditional_signed_threshold(
+            biases,
+            word.astype(np.float64),
+            family["family_epsilon"],
+            family["hypotheses"],
+        )
+        historical_accused = np.flatnonzero(scores > 2100.0).tolist()
+        evidence_bits = word
+        weight_hash = receiver.array_hash(word)
+        nonzero_fraction = float(np.mean(word != 0))
+    else:
+        weights = arrays[item["weights_key"]]
+        scores = receiver.signed_scores(biases, codebook, weights)
+        threshold = receiver.conditional_signed_threshold(
+            biases,
+            weights,
+            family["family_epsilon"],
+            family["hypotheses"],
+        )
+        historical_accused = None
+        evidence_bits = (weights > 0).astype(np.uint8)
+        weight_hash = receiver.array_hash(weights)
+        nonzero_fraction = float(np.mean(weights != 0))
+    boundary = threshold["threshold"]
+    accused = [] if boundary is None else np.flatnonzero(scores > boundary).tolist()
+    score_outcome, evaluator_disposition = _outcome(
+        label["expected_rows"], accused, label["safe_outcome"]
+    )
+    is_transplant = label["safe_outcome"] == "abstain_transplant_pattern_is_not_authenticity"
+    expected = label["expected_rows"]
+    nonexpected = np.ones(len(scores), dtype=bool)
+    nonexpected[expected] = False
+    expected_scores = [float(scores[row]) for row in expected]
+    expected_ranks = [_rank(scores, row) for row in expected]
+    bit_errors = [float(np.mean(evidence_bits != codebook[row])) for row in expected]
+    highest_other = float(np.max(scores[nonexpected])) if np.any(nonexpected) else None
+    margin = None
+    if expected_scores and boundary is not None:
+        margin = min(expected_scores) - boundary
+    return base | {
+        "status": "scored",
+        "score_outcome": score_outcome,
+        "outcome": score_outcome,
+        "evaluator_safe_disposition": evaluator_disposition,
+        "deployable_manipulation_detected": False if is_transplant else None,
+        "security_success_counted": False if is_transplant else None,
+        "accused_rows": accused,
+        "all_1000_scores": scores.tolist(),
+        "expected_scores": expected_scores,
+        "expected_ranks": expected_ranks,
+        "highest_nonexpected_score": highest_other,
+        "threshold": boundary,
+        "threshold_theta": threshold.get("theta"),
+        "conditional_null": threshold,
+        "score_margin": margin,
+        "bit_error_fraction_if_labeled": bit_errors,
+        "weight_hash": weight_hash,
+        "weight_nonzero_fraction": nonzero_fraction,
+        "historical_threshold": 2100.0 if item["profile"] == PROFILES[0] else None,
+        "historical_accused_rows": historical_accused,
+        "historical_outcome": (
+            _outcome(expected, historical_accused, label["safe_outcome"])[0]
+            if historical_accused is not None else None
+        ),
+    }
+
+
+def _write_csv(path: Path, records: list[dict[str, Any]], cases: dict[str, dict[str, Any]]) -> None:
+    fields = [
+        "case_id", "split", "category", "profile", "status", "outcome",
+        "score_outcome", "evaluator_safe_disposition", "deployable_manipulation_detected",
+        "security_success_counted", "expected_rows", "accused_rows", "expected_scores",
+        "expected_ranks", "highest_nonexpected_score", "threshold",
+        "threshold_theta", "score_margin", "bit_error_fraction_if_labeled",
+        "weight_nonzero_fraction", "fit_loss", "fallback_tiles",
+        "historical_accused_rows", "historical_outcome", "reason",
+    ]
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("x", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fields)
+        writer.writeheader()
+        for record in records:
+            case = cases[record["case_id"]]
+            row = {name: record.get(name) for name in fields}
+            row["split"] = case["split"]
+            row["category"] = case["category"]
+            for name in (
+                "expected_rows", "accused_rows", "expected_scores", "expected_ranks",
+                "bit_error_fraction_if_labeled", "historical_accused_rows",
+            ):
+                if isinstance(row[name], list):
+                    row[name] = json.dumps(row[name], separators=(",", ":"))
+            writer.writerow(row)
+
+
+def _hash_inventory(root: Path, excluded: set[Path]) -> list[str]:
+    lines = []
+    for path in sorted(value for value in root.rglob("*") if value.is_file()):
+        if path in excluded:
+            continue
+        lines.append(f"{digest(path)}  {path.relative_to(root)}")
+    return lines
+
+
+def score(
+    preregistration_path: Path,
+    fixtures_directory: Path,
+    prepared_directory: Path,
+    output_directory: Path,
+) -> dict[str, Any]:
+    """Verify commitments, generate the roster once, and score all 1,000 rows."""
+
+    output = Path(output_directory)
+    output.mkdir(parents=True, exist_ok=True)
+    targets = [output / "scores.json", output / "cases.csv", output / "hashes.sha256"]
+    existing = [path for path in targets if path.exists()]
+    if existing:
+        raise FileExistsError(existing[0])
+    started = time.perf_counter()
+    preregistration, fixture_payload, prepared, preregistration_hash = validate_prepared(
+        preregistration_path, fixtures_directory, prepared_directory
+    )
+    labels_path = Path(fixtures_directory) / "labels.json"
+    if digest(labels_path) != fixture_payload["labels_sha256"]:
+        raise ValueError("fixture label commitment mismatch")
+    labels = json.loads(labels_path.read_text())
+    if labels["preregistration_sha256"] != preregistration_hash:
+        raise ValueError("labels/preregistration mismatch")
+    case_ids = [item["id"] for item in fixture_payload["cases"]]
+    if set(labels["cases"]) != set(case_ids):
+        raise ValueError("fixture/label case inventory mismatch")
+    config = _configuration(preregistration)
+    biases, codebook = generate_roster(config)
+    records: list[dict[str, Any]] = []
+    with np.load(Path(prepared_directory) / "evidence.npz", allow_pickle=False) as arrays:
+        if not np.array_equal(biases, arrays["biases"]):
+            raise ValueError("full-roster biases differ from committed zero-row biases")
+        for item in prepared["records"]:
+            records.append(_score_record(
+                item,
+                arrays,
+                biases,
+                codebook,
+                labels["cases"][item["case_id"]],
+                preregistration,
+            ))
+    expected_pairs = [
+        (case_id, profile) for case_id in case_ids for profile in PROFILES
+    ]
+    if [(item["case_id"], item["profile"]) for item in records] != expected_pairs:
+        raise AssertionError("score output is not the complete frozen Cartesian product")
+    case_map = {item["id"]: item for item in fixture_payload["cases"]}
+    aggregate: dict[str, Any] = {"profiles": {}, "categories": {}}
+    for profile in PROFILES:
+        selected = [item for item in records if item["profile"] == profile]
+        aggregate["profiles"][profile] = {
+            name: sum(item["outcome"] == name for item in selected)
+            for name in (
+                "correct", "wrong", "abstain", "failure",
+                "abstain_transplant_pattern_is_not_authenticity",
+            )
+        } | {
+            "scored": sum(item["status"] == "scored" for item in selected),
+            "total": len(selected),
+        }
+    for category in sorted({case_map[item["case_id"]]["category"] for item in records}):
+        selected = [
+            item for item in records if case_map[item["case_id"]]["category"] == category
+        ]
+        aggregate["categories"][category] = {
+            "scored": sum(item["status"] == "scored" for item in selected),
+            "correct": sum(item["outcome"] == "correct" for item in selected),
+            "wrong": sum(item["outcome"] == "wrong" for item in selected),
+            "abstain": sum(item["outcome"] == "abstain" for item in selected),
+            "failure": sum(item["outcome"] == "failure" for item in selected),
+            "total": len(selected),
+        }
+    payload = {
+        "schema": "nishan.receiver-scores/v1",
+        "completed": True,
+        "preregistration_sha256": preregistration_hash,
+        "fixture_manifest_sha256": digest(Path(fixtures_directory) / "manifest.json"),
+        "fixture_labels_sha256": digest(labels_path),
+        "preparation_sha256": digest(Path(prepared_directory) / "preparation.json"),
+        "evidence_npz_sha256": digest(Path(prepared_directory) / "evidence.npz"),
+        "preparation_commitment_sha256": digest(Path(prepared_directory) / "commitment.json"),
+        "codebook_commitment": tardos.manifest(config, biases, codebook),
+        "family_calibration": preregistration["family_calibration"],
+        "decision_note": (
+            "The matched primary hard outcome uses its conditional hard-word Chernoff boundary. "
+            "The unchanged historical 2100 boundary is retained separately and is never applied to signed-soft scores. "
+            "For the known transplant fixture, evaluator abstention is recorded separately from the "
+            "receiver's actual donor-pattern result and is never counted as deployable manipulation detection."
+        ),
+        "records": records,
+        "aggregate": aggregate,
+        "runtime": {
+            "elapsed_seconds": time.perf_counter() - started,
+            "peak_rss_kib": _peak_rss_kib(),
+            "python": platform.python_version(),
+            "numpy": np.__version__,
+            "opencv": cv2.__version__,
+            "git_head": _git_head(),
+        },
+        "claim_limits": preregistration["claim_limits"],
+    }
+    dump_exclusive(output / "scores.json", payload)
+    _write_csv(output / "cases.csv", records, case_map)
+    inventory = _hash_inventory(output, {output / "hashes.sha256"})
+    with (output / "hashes.sha256").open("x") as handle:
+        handle.write("\n".join(inventory) + "\n")
+    return payload
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--preregistration", type=Path, default=DEFAULT_PREREGISTRATION
+    )
+    commands = parser.add_subparsers(dest="command", required=True)
+    fixture_parser = commands.add_parser("fixtures")
+    fixture_parser.add_argument("--output", type=Path, required=True)
+    fixture_parser.add_argument(
+        "--release-pending",
+        action="store_true",
+        help="read the reserved prospective capture; use only after coordinator release",
+    )
+    prepare_parser = commands.add_parser("prepare")
+    prepare_parser.add_argument("--fixtures", type=Path, required=True)
+    prepare_parser.add_argument("--output", type=Path, required=True)
+    score_parser = commands.add_parser("score")
+    score_parser.add_argument("--fixtures", type=Path, required=True)
+    score_parser.add_argument("--prepared", type=Path, required=True)
+    score_parser.add_argument("--output", type=Path, required=True)
+    arguments = parser.parse_args()
+    if arguments.command == "fixtures":
+        result = fixtures(
+            arguments.preregistration,
+            arguments.output,
+            release_pending=arguments.release_pending,
+        )
+    elif arguments.command == "prepare":
+        result = prepare(
+            arguments.preregistration, arguments.fixtures, arguments.output
+        )
+    else:
+        result = score(
+            arguments.preregistration,
+            arguments.fixtures,
+            arguments.prepared,
+            arguments.output,
+        )
+    print(json.dumps({
+        "completed": result.get("completed"),
+        "schema": result.get("schema"),
+        "peak_rss_kib": result.get("runtime", {}).get("peak_rss_kib"),
+    }, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
