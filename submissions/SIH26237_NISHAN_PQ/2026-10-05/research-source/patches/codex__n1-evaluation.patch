+class EvidenceTests(unittest.TestCase):
+    def test_hard_decoder_preserves_float32_sum_and_strict_sign(self):
+        source = np.zeros((6, 12), dtype=np.float32)
+        captured = source.copy()
+        captured[0, :3] = [2**24, 1, -(2**24)]
+        templates = np.ones((2, 6, 6), dtype=np.float32)
+        result = receiver.extract_hard(captured, source, np.array([0, 1]), templates)
+        expected_blocks = receiver.block_view(captured - source)
+        expected = np.sum(expected_blocks * templates, axis=(1, 2), dtype=np.float32)
+        np.testing.assert_array_equal(result["correlations"], expected)
+        np.testing.assert_array_equal(result["word"], expected > 0)
+        self.assertEqual(result["word"][1], 0)
+
+    def test_global_fit_recovers_frozen_blur_and_photometric_map(self):
+        y, x = np.indices((160, 160), dtype=np.float32)
+        midpoint = 128 + 45 * np.sin(x / 8) + 35 * np.cos(y / 11)
+        captured = 0.82 * cv2.GaussianBlur(midpoint, (0, 0), 1.0) + 17.0
+        fit = receiver.fit_global_channel(
+            midpoint,
+            captured,
+            np.ones(midpoint.shape, bool),
+            minimum_pixels=100,
+        )
+        self.assertEqual(fit.sigma, 1.0)
+        self.assertAlmostEqual(fit.gain, 0.82, places=3)
+        self.assertAlmostEqual(fit.offset, 17.0, places=2)
+        self.assertLess(fit.loss, 1e-3)
+
+    def test_global_and_local_extractors_are_finite_and_row_blind(self):
+        height = width = 192
+        y, x = np.indices((height, width), dtype=np.float32)
+        midpoint = 128 + 35 * np.sin(x / 5) + 30 * np.cos(y / 7)
+        captured = 0.9 * cv2.GaussianBlur(midpoint, (0, 0), 0.6) + 9
+        rows = height // 6
+        columns = width // 6
+        symbols = 900
+        order = np.arange(symbols)
+        orientations = np.arange(symbols) % 2
+        polarities = np.where(np.arange(symbols) % 3, 1, -1)
+        vertical = np.ones((6, 6), np.float32)
+        vertical[:, 3:] = -1
+        horizontal = np.ones((6, 6), np.float32)
+        horizontal[3:, :] = -1
+        templates = np.stack([vertical, horizontal])
+        global_result = receiver.extract_global_soft(
+            captured, midpoint, order, orientations, polarities, templates
+        )
+        local_result = receiver.extract_local_mixture_soft(
+            captured, midpoint, order, orientations, polarities, templates
+        )
+        self.assertEqual((rows * columns), 1024)
+        for result in (global_result, local_result):
+            self.assertEqual(result["weights"].shape, (symbols,))
+            self.assertTrue(np.isfinite(result["weights"]).all())
+            self.assertTrue(np.all(np.abs(result["weights"]) <= 1))
+        for function in (receiver.fit_global_channel, receiver.extract_global_soft,
+                         receiver.extract_local_mixture_soft):
+            parameters = inspect.signature(function).parameters
+            self.assertFalse({"codebook", "row", "target", "scores", "labels"} & set(parameters))
+
+    def test_content_mask_rejects_flat_page(self):
+        midpoint = np.full((128, 128), 200, dtype=np.float32)
+        mask = receiver.content_mask(midpoint)
+        self.assertEqual(int(mask.sum()), 0)
+        with self.assertRaisesRegex(ValueError, "content mask"):
+            receiver.fit_global_channel(midpoint, midpoint, mask)
+
