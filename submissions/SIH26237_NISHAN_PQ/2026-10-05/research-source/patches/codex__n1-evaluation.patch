+def _normalize_phone(value: Any, field: str) -> dict[str, str]:
+    if isinstance(value, str):
+        text = _require_string(value, field)
+        head, separator, tail = text.partition(":")
+        role = head if head in {"phone_a", "phone_b"} else "unknown"
+        words = tail.strip().split() if separator else []
+        make = words[0] if words else "unknown"
+        model = " ".join(words[1:]) if len(words) > 1 else "unknown"
+        return {"role": role, "make": make, "model": model, "recorded_as": text}
+    phone = _require_dict(value, field)
+    _require_keys(phone, {"role", "make", "model"}, {"role", "make", "model", "device_id"}, field)
+    role = phone["role"]
+    if role not in {"phone_a", "phone_b", "unknown"}:
+        raise StudyValidationError(f"{field}.role must be phone_a, phone_b, or unknown")
+    normalized = {
+        "role": role,
+        "make": _require_string(phone["make"], f"{field}.make"),
+        "model": _require_string(phone["model"], f"{field}.model"),
+    }
+    if "device_id" in phone:
+        normalized["device_id"] = _require_string(phone["device_id"], f"{field}.device_id")
+    return normalized
+
+
+def _phone_identity_tuple(phone: Any) -> tuple[str, str, str, str | None] | None:
+    if not isinstance(phone, dict):
+        return None
+    return (
+        str(phone.get("role", "unknown")).strip().lower(),
+        str(phone.get("make", "unknown")).strip().lower(),
+        str(phone.get("model", "unknown")).strip().lower(),
+        (
+            str(phone["device_id"]).strip().lower()
+            if _known_text(phone.get("device_id"))
+            else None
+        ),
+    )
+
+
+def _image_metadata(path: Path) -> tuple[dict[str, int], dict[str, Any], str]:
+    try:
+        with Image.open(path) as image:
+            width, height = image.size
+            image_format = image.format or "unknown"
+            exif = image.getexif()
+            selected: dict[str, Any] = {}
+            names = {value: key for key, value in ExifTags.TAGS.items()}
+            for name in ("Make", "Model", "Orientation", "DateTimeOriginal", "Software"):
+                tag = names.get(name)
+                if tag is not None and tag in exif:
+                    value = exif.get(tag)
+                    selected[name] = str(value)
+            gps_tag = names.get("GPSInfo")
+            gps_present = bool(gps_tag is not None and gps_tag in exif)
+            safe_serialized = {
+                str(key): str(value)
+                for key, value in exif.items()
+                if key != gps_tag
+            }
+    except (OSError, UnidentifiedImageError, ValueError) as exc:
+        raise StudyValidationError(f"capture is not a readable image: {path}: {exc}") from exc
+    return (
+        {"width": int(width), "height": int(height)},
+        {
+            "access": "read_only",
+            "present": bool(exif),
+            "selected": selected,
+            "gps_present": gps_present,
+            "non_gps_metadata_sha256": _sha256_json(safe_serialized),
+        },
+        image_format,
+    )
+
+
+def _normalize_printer_settings(value: Any) -> dict[str, Any]:
+    if value is None:
+        return {
+            "printer": "unknown",
+            "paper": "unknown",
+            "scale": "unknown",
+            "borderless": "unknown",
+            "fit_to_page": "unknown",
+            "economy_or_toner_save": "unknown",
+            "driver": "unknown",
+            "quality": "unknown",
+            "colour": "unknown",
+            "metadata_complete": False,
+        }
+    settings = _require_dict(value, "capture.printer_settings")
+    allowed = {
+        "printer",
+        "paper",
+        "scale",
+        "borderless",
+        "fit_to_page",
+        "economy_or_toner_save",
+        "driver",
+        "quality",
+        "colour",
+        "unprintable_margin_clipping",
+    }
+    _require_keys(settings, set(), allowed, "capture.printer_settings")
+    normalized: dict[str, Any] = {}
+    for key in allowed:
+        normalized[key] = settings.get(key, "unknown")
+    for key in ("borderless", "fit_to_page", "economy_or_toner_save"):
+        if normalized[key] != "unknown" and not isinstance(normalized[key], bool):
+            raise StudyValidationError(f"capture.printer_settings.{key} must be boolean or unknown")
+    normalized["metadata_complete"] = all(
+        normalized[key] != "unknown"
+        for key in (
+            "printer",
+            "paper",
+            "scale",
+            "borderless",
+            "fit_to_page",
+            "economy_or_toner_save",
+            "driver",
+            "quality",
+            "colour",
+            "unprintable_margin_clipping",
+        )
+    )
+    return normalized
+
+
+def intake(
+    manifest_path: str | os.PathLike[str],
+    captures_path: str | os.PathLike[str],
+    output_path: str | os.PathLike[str],
+) -> dict[str, Any]:
+    """Inventory capture bytes in place and write an exclusive intake JSON."""
+
+    protocol, protocol_sha = _load_protocol()
+    pack = validate_pack(manifest_path, open_labels=False)
+    capture_list_path = Path(captures_path).resolve()
+    raw_rows = _require_list(
+        _load_json(capture_list_path, description="capture list"), "capture list"
+    )
+    allowed = {
+        "sheet_id",
+        "path",
+        "view",
+        "phone",
+        "transfer",
+        "category",
+        "parent_capture_sha256",
+        "printer_settings",
+        "sha256",
+        "capture_id",
+        "notes",
+        "receiver_context",
+        "receiver_source_sheet_id",
+        "sender_sha256",
+    }
+    required = {"sheet_id", "path", "view", "phone", "transfer", "category"}
+    sheets = {entry["sheet_id"]: entry for entry in pack["sheets"]}
+    captures: list[dict[str, Any]] = []
+    first_by_sha: dict[str, str] = {}
+    capture_ids: set[str] = set()
+    for index, raw in enumerate(raw_rows):
+        row = _require_dict(raw, f"captures[{index}]")
+        _require_keys(row, required, allowed, f"captures[{index}]")
+        sheet_id = _require_string(row["sheet_id"], f"captures[{index}].sheet_id", pattern=ID_RE)
+        if sheet_id not in sheets:
+            raise StudyValidationError(f"captures[{index}] references unknown sheet_id {sheet_id}")
+        view = row["view"]
+        if view not in VIEWS:
+            raise StudyValidationError(f"captures[{index}].view must be one of {sorted(VIEWS)}")
+        transfer = row["transfer"]
+        category = row["category"]
+        if transfer not in TRANSFERS:
+            raise StudyValidationError(f"captures[{index}].transfer is unsupported")
+        if category not in CATEGORIES:
+            raise StudyValidationError(f"captures[{index}].category is unsupported")
+        if transfer not in CATEGORY_TRANSFERS[category]:
+            raise StudyValidationError(
+                f"captures[{index}] transfer {transfer!r} is incompatible with category {category!r}"
+            )
+        capture_path = _resolve_capture_path(
+            capture_list_path.parent, row["path"], f"captures[{index}].path"
+        )
+        actual_sha = _sha256_file(capture_path)
+        if "sha256" in row:
+            declared_sha = _require_sha256(row["sha256"], f"captures[{index}].sha256")
+            if declared_sha != actual_sha:
+                raise StudyValidationError(f"captures[{index}] capture hash mismatch")
+        parent_sha = row.get("parent_capture_sha256")
+        if parent_sha is not None:
+            parent_sha = _require_sha256(parent_sha, f"captures[{index}].parent_capture_sha256")
+        if category in DERIVATIVE_CATEGORIES and parent_sha is None:
+            raise StudyValidationError(
+                f"captures[{index}] derivative category {category} requires parent_capture_sha256"
+            )
+        sender_sha = row.get("sender_sha256")
+        if sender_sha is not None:
+            sender_sha = _require_sha256(sender_sha, f"captures[{index}].sender_sha256")
+            if transfer != "whatsapp_document":
+                raise StudyValidationError(
+                    f"captures[{index}].sender_sha256 is only valid for WhatsApp document transport"
+                )
+            if sender_sha != actual_sha:
+                raise StudyValidationError(
+                    f"captures[{index}] differs from the sender-provided byte hash"
+                )
+        dimensions, exif, image_format = _image_metadata(capture_path)
+        stat = capture_path.stat()
+        capture_id = row.get("capture_id", f"{sheet_id}-{index + 1:03d}")
+        capture_id = _require_string(capture_id, f"captures[{index}].capture_id", pattern=ID_RE)
+        if capture_id in capture_ids:
+            raise StudyValidationError(f"duplicate capture_id: {capture_id}")
+        capture_ids.add(capture_id)
+        duplicate_of = first_by_sha.get(actual_sha)
+        independent = duplicate_of is None
+        if independent:
+            first_by_sha[actual_sha] = capture_id
+        relationship = "independent_original"
+        if duplicate_of is not None:
+            relationship = (
+                "byte_preserving_retransfer"
+                if category == "whatsapp_document" and parent_sha == actual_sha
+                else "duplicate_bytes"
+            )
+        elif category in DERIVATIVE_CATEGORIES:
+            relationship = "derivative"
+        if transfer == "original":
+            transport_integrity = "direct_local_original"
+        elif transfer == "whatsapp_document" and sender_sha is not None:
+            transport_integrity = "verified_sender_sha256"
+        elif (
+            transfer == "whatsapp_document"
+            and parent_sha is not None
+            and parent_sha == actual_sha
+        ):
+            transport_integrity = "verified_local_parent_byte_identity"
+        elif transfer == "whatsapp_document":
+            transport_integrity = "operator_declared_unverified"
+        else:
+            transport_integrity = "transformed_transport"
+        capture = {
+            "capture_id": capture_id,
+            "sheet_id": sheet_id,
+            "path": str(capture_path),
+            "view": view,
+            "phone": _normalize_phone(row["phone"], f"captures[{index}].phone"),
+            "transfer": transfer,
+            "category": category,
+            "parent_capture_sha256": parent_sha,
+            "sender_sha256": sender_sha,
+            "transport_integrity": transport_integrity,
+            "printer_settings": _normalize_printer_settings(row.get("printer_settings")),
+            "dimensions": dimensions,
+            "image_format": image_format,
+            "exif": exif,
+            "file_identity": {
+                "sha256": actual_sha,
+                "size_bytes": stat.st_size,
+                "device": stat.st_dev,
+                "inode": stat.st_ino,
+                "mtime_ns": stat.st_mtime_ns,
+                "canonical_path": str(capture_path),
+            },
+            "independent_bytes": independent,
+            "duplicate_of": duplicate_of,
+            "relationship": relationship,
+        }
+        receiver_context = row.get("receiver_context")
+        receiver_source_sheet_id = row.get("receiver_source_sheet_id")
+        if receiver_context is not None:
+            receiver_context = _validate_context(receiver_context)
+        if receiver_source_sheet_id is not None:
+            receiver_source_sheet_id = _require_string(
+                receiver_source_sheet_id,
+                f"captures[{index}].receiver_source_sheet_id",
+                pattern=ID_RE,
+            )
+            if receiver_source_sheet_id not in sheets:
+                raise StudyValidationError(
+                    f"captures[{index}] receiver_source_sheet_id is not in this pack"
+                )
+        if category == "wrong_key":
+            if receiver_context is None or "fixture_secret_hex" not in receiver_context:
+                raise StudyValidationError("wrong_key control requires an explicit receiver_context seed")
+            if "fixture_secret_hex" not in pack["context"]:
+                raise StudyValidationError(
+                    "wrong_key control requires the pack's public fixture seed to be explicit"
+                )
+            if any(
+                receiver_context[key] != pack["context"][key]
+                for key in ("kind", "codebook_context", "carrier_context")
+            ) or receiver_context["fixture_secret_hex"] == pack["context"]["fixture_secret_hex"]:
+                raise StudyValidationError(
+                    "wrong_key control must change only the explicit public fixture seed"
+                )
+        elif category == "wrong_context":
+            if receiver_context is None:
+                raise StudyValidationError("wrong_context control requires receiver_context")
+            context_changed = any(
+                receiver_context[key] != pack["context"][key]
+                for key in ("codebook_context", "carrier_context")
+            )
+            if not context_changed or receiver_context.get("fixture_secret_hex") != pack[
+                "context"
+            ].get("fixture_secret_hex"):
+                raise StudyValidationError(
+                    "wrong_context control must change a context string without changing the seed"
+                )
+        elif receiver_context is not None:
+            raise StudyValidationError(
+                f"captures[{index}] receiver_context is only valid for wrong_key/wrong_context controls"
+            )
+        if category == "wrong_source":
+            if receiver_source_sheet_id is None:
+                raise StudyValidationError("wrong_source control requires receiver_source_sheet_id")
+            original_sheet = sheets[sheet_id]
+            replacement_sheet = sheets[receiver_source_sheet_id]
+            if replacement_sheet["source_sha256"] == original_sheet["source_sha256"]:
+                raise StudyValidationError("wrong_source control must select different source bytes")
+        elif receiver_source_sheet_id is not None:
+            raise StudyValidationError(
+                f"captures[{index}] receiver_source_sheet_id is only valid for wrong_source controls"
+            )
+        capture["receiver_context"] = receiver_context
+        capture["receiver_source_sheet_id"] = receiver_source_sheet_id
+        captures.append(capture)
+
+    available_hashes = {entry["file_identity"]["sha256"] for entry in captures}
+    captures_by_sha: dict[str, list[Mapping[str, Any]]] = defaultdict(list)
+    for entry in captures:
+        captures_by_sha[entry["file_identity"]["sha256"]].append(entry)
+    for entry in captures:
+        parent_sha = entry["parent_capture_sha256"]
+        if parent_sha is not None and parent_sha not in available_hashes:
+            raise StudyValidationError(
+                f"capture {entry['capture_id']} has no matching parent bytes in this intake"
+            )
+        if parent_sha is not None:
+            eligible_parents = [
+                parent
+                for parent in captures_by_sha[parent_sha]
+                if parent["sheet_id"] == entry["sheet_id"]
+                and parent["category"] in {"original_camera", "rendered_digital_self_test"}
+                and parent["independent_bytes"] is True
+            ]
+            if not eligible_parents:
+                raise StudyValidationError(
+                    f"capture {entry['capture_id']} parent must be an independent original of the same sheet"
+                )
+            matched_parents = [
+                parent
+                for parent in eligible_parents
+                if parent["view"] == entry["view"]
+                and _phone_identity_tuple(parent["phone"])
+                == _phone_identity_tuple(entry["phone"])
+            ]
+            if not matched_parents:
+                raise StudyValidationError(
+                    f"capture {entry['capture_id']} derivative must preserve its parent's phone and view"
+                )
+            if entry["category"] in DIAGNOSTIC_CATEGORIES and not any(
+                parent["category"] == "original_camera"
+                and parent["view"] == "front"
+                and parent["phone"].get("role") == "phone_a"
+                for parent in matched_parents
+            ):
+                raise StudyValidationError(
+                    f"capture {entry['capture_id']} diagnostic parent must be a phone-A/front camera original"
+                )
+        if entry["category"] == "whatsapp_document" and parent_sha == entry["file_identity"]["sha256"]:
+            entry["independent_bytes"] = False
+            entry["relationship"] = "byte_preserving_retransfer"
+
+    result = {
+        "schema": INTAKE_SCHEMA,
+        "created_at": _utc_now(),
+        "protocol_path": str(PROTOCOL_PATH.resolve()),
+        "protocol_sha256": protocol_sha,
+        "protocol_id": protocol["protocol_id"],
+        "manifest_path": pack["manifest_path"],
+        "manifest_sha256": pack["manifest_sha256"],
+        "pack_id": pack["pack_id"],
+        "split": pack["split"],
+        "labels_path": pack["labels_path"],
+        "labels_sha256": pack["labels_sha256"],
+        "capture_list_path": str(capture_list_path),
+        "capture_list_sha256": _sha256_file(capture_list_path),
+        "capture_count": len(captures),
+        "unique_byte_count": len({entry["file_identity"]["sha256"] for entry in captures}),
+        "captures": captures,
+        "raw_files_copied": False,
+        "raw_files_modified": False,
+        "exif_write_performed": False,
+        "claim_status": "inventory_only_not_physical_result",
+    }
+    _write_json_exclusive(Path(output_path), result)
+    return result
+
+
+def _write_json_exclusive(path: Path, value: Any) -> None:
+    path = path.resolve()
+    if path.exists():
+        raise StudyValidationError(f"refusing to overwrite existing output: {path}")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        encoded = json.dumps(
+            value, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False
+        ) + "\n"
+        with path.open("x", encoding="utf-8") as handle:
+            handle.write(encoded)
+    except (OSError, ValueError) as exc:
+        raise StudyValidationError(f"cannot write exclusive output {path}: {exc}") from exc
+
+
+def _git_binding_for_file(path: Path) -> dict[str, str] | None:
+    try:
+        top_level = subprocess.run(
+            ["git", "-C", str(path.parent), "rev-parse", "--show-toplevel"],
+            check=True,
+            capture_output=True,
+            text=True,
+            timeout=10,
+        ).stdout.strip()
+        root = Path(top_level).resolve()
+        relative = path.resolve().relative_to(root).as_posix()
+        commit = subprocess.run(
+            ["git", "-C", str(root), "rev-parse", "HEAD"],
+            check=True,
+            capture_output=True,
+            text=True,
+            timeout=10,
+        ).stdout.strip()
+        if GIT_COMMIT_RE.fullmatch(commit) is None:
+            return None
+        committed_bytes = subprocess.run(
+            ["git", "-C", str(root), "show", f"{commit}:{relative}"],
+            check=True,
+            capture_output=True,
+            timeout=10,
+        ).stdout
+    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
+        return None
+    except ValueError:
+        return None
+    committed_sha = hashlib.sha256(committed_bytes).hexdigest()
+    actual_sha = _sha256_file(path)
+    if committed_sha != actual_sha:
+        return None
+    return {
+        "commit": commit,
+        "repo_root": str(root),
+        "repo_path": relative,
+        "sha256": actual_sha,
+    }
+
+
+def _receiver_code_binding(receiver: Any) -> dict[str, str] | None:
+    module_path = getattr(receiver, "__file__", None)
+    if not isinstance(module_path, str):
+        return None
+    path = Path(module_path).resolve()
+    if not path.is_file():
+        return None
+    return _git_binding_for_file(path)
+
+
+def _validate_code_hash_mapping(
+    value: Any,
+    implementation_sha256: Any,
+    *,
+    receiver: Any,
+    config_path: Path,
+    git_binding: Mapping[str, str] | None,
+) -> tuple[dict[str, str], str]:
+    mapping = _require_dict(value, "prepared.code_sha256")
+    normalized: dict[str, str] = {}
+    for raw_path, raw_sha in mapping.items():
+        path_text = _require_string(raw_path, "prepared.code_sha256 path")
+        candidate = Path(path_text)
+        if candidate.is_absolute() or ".." in candidate.parts or candidate.as_posix() != path_text:
+            raise StudyValidationError("prepared.code_sha256 keys must be safe repo-relative POSIX paths")
+        normalized[path_text] = _require_sha256(
+            raw_sha, f"prepared.code_sha256[{path_text!r}]"
+        )
+    basenames = {Path(path).name for path in normalized}
+    if len(normalized) != len(RECEIVER_CODE_BASENAMES) or basenames != RECEIVER_CODE_BASENAMES:
+        raise StudyValidationError(
+            "prepared.code_sha256 must bind exactly the eight receiver/config/dependency artifacts"
+        )
+    computed_implementation = _sha256_json(normalized)
+    declared_implementation = _require_sha256(
+        implementation_sha256, "prepared.implementation_sha256"
+    )
+    if declared_implementation != computed_implementation:
+        raise CommitmentError("prepared implementation hash does not bind code_sha256 mapping")
+
+    module_path = getattr(receiver, "__file__", None)
+    if isinstance(module_path, str):
+        receiver_path = Path(module_path).resolve()
+        if git_binding is None:
+            raise CommitmentError("receiver implementation is not bound to committed bytes")
+        root = Path(git_binding["repo_root"]).resolve()
+        expected_commit = git_binding["commit"]
+        resolved_by_basename: dict[str, Path] = {}
+        for repo_path, expected_sha in normalized.items():
+            resolved = (root / repo_path).resolve()
+            try:
+                resolved.relative_to(root)
+            except ValueError as exc:
+                raise CommitmentError("receiver code mapping escapes repository root") from exc
+            if not resolved.is_file() or _sha256_file(resolved) != expected_sha:
+                raise CommitmentError(f"receiver code hash does not match actual bytes: {repo_path}")
+            binding = _git_binding_for_file(resolved)
+            if binding is None or binding["commit"] != expected_commit:
+                raise CommitmentError(
+                    f"receiver dependency is not bound to commit {expected_commit}: {repo_path}"
+                )
+            resolved_by_basename[resolved.name] = resolved
+        if resolved_by_basename["receiver_api.py"] != receiver_path:
+            raise CommitmentError("code mapping receiver_api.py is not the imported receiver module")
+        if resolved_by_basename["receiver_config.json"] != config_path.resolve():
+            raise CommitmentError("code mapping receiver_config.json is not the supplied config")
+    return normalized, declared_implementation
+
+
+def _validate_intake(path: Path) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
+    intake_data = _require_dict(_load_json(path, description="capture intake"), "intake")
+    if intake_data.get("schema") != INTAKE_SCHEMA:
+        raise StudyValidationError(f"intake.schema must be {INTAKE_SCHEMA}")
+    protocol, protocol_sha = _load_protocol()
+    if intake_data.get("protocol_sha256") != protocol_sha:
+        raise CommitmentError("study protocol changed after intake")
+    manifest_path = Path(_require_string(intake_data.get("manifest_path"), "intake.manifest_path"))
+    if _sha256_file(manifest_path) != intake_data.get("manifest_sha256"):
+        raise CommitmentError("pack manifest changed after intake")
+    pack = validate_pack(manifest_path, open_labels=False)
+    if pack["labels_sha256"] != intake_data.get("labels_sha256"):
+        raise CommitmentError("evaluator label hash differs from intake commitment")
+    captures = _require_list(intake_data.get("captures"), "intake.captures")
+    capture_ids: set[str] = set()
+    for index, raw in enumerate(captures):
+        capture = _require_dict(raw, f"intake.captures[{index}]")
+        capture_id = _require_string(
+            capture.get("capture_id"), f"intake.captures[{index}].capture_id", pattern=ID_RE
+        )
+        if capture_id in capture_ids:
+            raise StudyValidationError(f"duplicate intake capture_id: {capture_id}")
+        capture_ids.add(capture_id)
+        capture_path = Path(
+            _require_string(capture.get("path"), f"intake.captures[{index}].path")
+        ).resolve()
+        identity = _require_dict(
+            capture.get("file_identity"), f"intake.captures[{index}].file_identity"
+        )
+        expected_sha = _require_sha256(
+            identity.get("sha256"), f"intake.captures[{index}].file_identity.sha256"
+        )
+        if _sha256_file(capture_path) != expected_sha:
+            raise CommitmentError(f"capture bytes changed after intake: {capture_id}")
+        current = capture_path.stat()
+        for key, actual in {
+            "size_bytes": current.st_size,
+            "device": current.st_dev,
+            "inode": current.st_ino,
+        }.items():
+            if identity.get(key) != actual:
+                raise CommitmentError(f"capture file identity changed after intake: {capture_id}")
+    return intake_data, pack, protocol
+
+
+def _planned_budget(protocol: Mapping[str, Any], split: str, observed: int) -> tuple[int, int]:
+    stage_key = "held_out" if split == "heldout" else split
+    stage = protocol["stages"].get(stage_key)
+    if split == "development":
+        planned = max(observed, 1)
+        return planned, planned * 1000 * 9
+    if not isinstance(stage, dict):
+        raise StudyValidationError(f"protocol does not define stage {split}")
+    planned = stage.get("planned_decisions")
+    floor = stage.get("hypothesis_count_floor")
+    if not isinstance(planned, int) or planned <= 0 or not isinstance(floor, int):
+        raise StudyValidationError(f"protocol has invalid planned budget for {split}")
+    if floor != planned * 1000 * 9:
+        raise StudyValidationError(f"protocol hypothesis floor is inconsistent for {split}")
+    return planned, floor
+
+
+def _validate_preparation(
+    returned: Any,
+    prepared_path: Path,
+    expected_config_sha: str,
+    expected_input_sha: Mapping[str, str],
+    expected_context: Mapping[str, str],
+    receiver: Any,
+    config_path: Path,
+    code_git_binding: Mapping[str, str] | None,
+) -> dict[str, Any]:
+    prepared_directory = prepared_path.parent
+    expected_files = {"prepared.json", "evidence.npz", "commitment.json"}
+    try:
+        observed_files = {entry.name for entry in prepared_directory.iterdir() if entry.is_file()}
+    except OSError as exc:
+        raise StudyValidationError(f"cannot inventory receiver preparation: {exc}") from exc
+    if observed_files != expected_files:
+        raise StudyValidationError(
+            f"receiver preparation inventory must be exactly {sorted(expected_files)}"
+        )
+    prepared = _require_dict(
+        _load_json(prepared_path, description="receiver preparation"), "prepared"
+    )
+    if returned is not None and returned != prepared:
+        raise StudyValidationError("prepare_request return does not match prepared.json")
+    if prepared.get("schema") != "nishan.n1-prepared/v2":
+        raise StudyValidationError("prepared.schema must be nishan.n1-prepared/v2")
+    _validate_carrier(prepared.get("carrier"))
+    if prepared.get("status") not in {"prepared", "inconclusive"}:
+        raise StudyValidationError("prepared.status must be prepared or inconclusive")
+    _require_sha256(prepared.get("commitment"), "prepared.commitment")
+    config_sha = _require_sha256(
+        prepared.get("receiver_config_sha256"), "prepared.receiver_config_sha256"
+    )
+    input_raw = _require_dict(prepared.get("input_sha256"), "prepared.input_sha256")
+    _require_keys(
+        input_raw,
+        {"source_pdf", "capture_path"},
+        {"source_pdf", "capture_path"},
+        "prepared.input_sha256",
+    )
+    input_sha = {
+        "source_pdf": _require_sha256(
+            input_raw["source_pdf"], "prepared.input_sha256.source_pdf"
+        ),
+        "capture_path": _require_sha256(
+            input_raw["capture_path"], "prepared.input_sha256.capture_path"
+        ),
+    }
+    _code_mapping, implementation_sha = _validate_code_hash_mapping(
+        prepared.get("code_sha256"),
+        prepared.get("implementation_sha256"),
+        receiver=receiver,
+        config_path=config_path,
+        git_binding=code_git_binding,
+    )
+    if config_sha != expected_config_sha:
+        raise CommitmentError("preparation recorded the wrong receiver configuration hash")
+    if input_sha != dict(expected_input_sha):
+        raise CommitmentError("preparation recorded the wrong source/capture hashes")
+    request_id = _require_string(prepared.get("request_id"), "prepared.request_id", pattern=ID_RE)
+    if request_id != prepared_directory.name:
+        raise CommitmentError("prepared request_id does not match its exclusive directory")
+    context_commitment = _validate_context_commitment(
+        prepared.get("context_commitment"), expected_context
+    )
+    array_hashes_raw = _require_dict(prepared.get("array_sha256"), "prepared.array_sha256")
+    if not array_hashes_raw:
+        raise StudyValidationError("prepared.array_sha256 must not be empty")
+    array_hashes = {
+        _require_string(name, "prepared.array_sha256 key", pattern=ID_RE): _require_sha256(
+            digest, f"prepared.array_sha256[{name!r}]"
+        )
+        for name, digest in array_hashes_raw.items()
+    }
+    evidence_path = prepared_directory / "evidence.npz"
+    evidence_sha = _require_sha256(prepared.get("evidence_sha256"), "prepared.evidence_sha256")
+    if _sha256_file(evidence_path) != evidence_sha:
+        raise CommitmentError("prepared evidence.npz hash mismatch")
+    try:
+        with np.load(evidence_path, allow_pickle=False) as stored:
+            if set(stored.files) != set(array_hashes):
+                raise CommitmentError("prepared evidence array inventory mismatch")
+            for name in stored.files:
+                if _sha256_array(stored[name]) != array_hashes[name]:
+                    raise CommitmentError(f"prepared evidence array hash mismatch: {name}")
+    except (OSError, ValueError) as exc:
+        raise StudyValidationError(f"cannot validate prepared evidence arrays: {exc}") from exc
+    expected_scalar_commitment = _sha256_json(
+        {
+            "schema": prepared["schema"],
+            "request_id": request_id,
+            "receiver_config_sha256": config_sha,
+            "input_sha256": input_sha,
+            "context_commitment": context_commitment,
+            "implementation_sha256": implementation_sha,
+            "array_sha256": array_hashes,
+            "evidence_sha256": evidence_sha,
+        }
+    )
+    if prepared["commitment"] != expected_scalar_commitment:
+        raise CommitmentError("prepared scalar commitment does not bind its evidence")
+    commitment_path = prepared_directory / "commitment.json"
+    commitment = _require_dict(
+        _load_json(commitment_path, description="receiver preparation commitment"),
+        "receiver preparation commitment",
+    )
+    _require_keys(
+        commitment,
+        {"schema", "sha256", "receiver_config_sha256", "input_sha256"},
+        {"schema", "sha256", "receiver_config_sha256", "input_sha256"},
+        "receiver preparation commitment",
+    )
+    if commitment["schema"] != "nishan.n1-prepared-commitment/v2":
+        raise StudyValidationError("receiver preparation commitment schema mismatch")
+    committed_files = _require_dict(commitment["sha256"], "commitment.sha256")
+    _require_keys(
+        committed_files,
+        {"prepared.json", "evidence.npz"},
+        {"prepared.json", "evidence.npz"},
+        "commitment.sha256",
+    )
+    if _require_sha256(committed_files["prepared.json"], "commitment.sha256.prepared.json") != _sha256_file(prepared_path):
+        raise CommitmentError("commitment.json does not bind prepared.json")
+    if _require_sha256(committed_files["evidence.npz"], "commitment.sha256.evidence.npz") != evidence_sha:
+        raise CommitmentError("commitment.json does not bind evidence.npz")
+    if commitment["receiver_config_sha256"] != config_sha or commitment["input_sha256"] != input_sha:
+        raise CommitmentError("commitment.json disagrees with prepared inputs")
+    profiles = _require_dict(prepared.get("profiles"), "prepared.profiles")
+    if set(profiles) != set(PROFILE_HYPOTHESES):
+        raise StudyValidationError("prepared.profiles must contain hard/global_soft/local_soft")
+    for profile_name, raw in profiles.items():
+        profile = _require_dict(raw, f"prepared.profiles.{profile_name}")
+        status = profile.get("status")
+        if status not in {"prepared", "inconclusive"}:
+            raise StudyValidationError(f"prepared profile {profile_name} has invalid status")
+        if status == "inconclusive" and not isinstance(profile.get("reason"), str):
+            raise StudyValidationError(
+                f"inconclusive prepared profile {profile_name} requires a reason"
+            )
+    return prepared
+
+
+def _sorted_rows(value: Any, field: str) -> list[int]:
+    rows = _require_list(value, field)
+    if any(isinstance(row, bool) or not isinstance(row, int) or not 0 <= row < 1000 for row in rows):
+        raise StudyValidationError(f"{field} contains an invalid row")
+    if rows != sorted(set(rows)):
+        raise StudyValidationError(f"{field} must be sorted and unique")
+    return list(rows)
+
+
+def validate_score_result(
+    value: Any,
+    hypothesis_floor: int,
+    expected_config_sha256: str,
+    expected_input_sha256: Mapping[str, str],
+    expected_preparation_sha256: str | None = None,
+    expected_code_sha256: Mapping[str, str] | None = None,
+    expected_implementation_sha256: str | None = None,
+    expected_request_id: str | None = None,
+    expected_prepared_commitment: str | None = None,
+) -> dict[str, Any]:
+    """Validate the full receiver score contract, including all-row unions."""
+
+    result = _require_dict(value, "scores")
+    if result.get("schema") != SCORES_SCHEMA:
+        raise StudyValidationError(f"scores.schema must be {SCORES_SCHEMA}")
+    request_id = _require_string(result.get("request_id"), "scores.request_id", pattern=ID_RE)
+    if expected_request_id is not None and request_id != expected_request_id:
+        raise CommitmentError("scores.request_id differs from the prepared request")
+    prepared_commitment = _require_sha256(
+        result.get("prepared_commitment"), "scores.prepared_commitment"
+    )
+    if (
+        expected_prepared_commitment is not None
+        and prepared_commitment != expected_prepared_commitment
+    ):
+        raise CommitmentError("scores prepared commitment differs from prepared.json")
+    family_alpha = result.get("family_alpha")
+    if isinstance(family_alpha, bool) or not isinstance(family_alpha, (int, float)):
+        raise StudyValidationError("scores.family_alpha must be numeric")
+    if float(family_alpha) != 1e-6:
+        raise StudyValidationError("scores.family_alpha must remain 1e-6")
+    result_hypothesis_count = result.get("hypothesis_count")
+    if (
+        isinstance(result_hypothesis_count, bool)
+        or not isinstance(result_hypothesis_count, int)
+        or result_hypothesis_count < hypothesis_floor
+    ):
+        raise StudyValidationError("scores.hypothesis_count shrinks the planned family budget")
+    preparation_sha = _require_sha256(
+        result.get("preparation_sha256"), "scores.preparation_sha256"
+    )
+    config_sha = _require_sha256(
+        result.get("receiver_config_sha256"), "scores.receiver_config_sha256"
+    )
+    input_sha_raw = _require_dict(result.get("input_sha256"), "scores.input_sha256")
+    _require_keys(
+        input_sha_raw,
+        {"source_pdf", "capture_path"},
+        {"source_pdf", "capture_path"},
+        "scores.input_sha256",
+    )
+    input_sha = {
+        "source_pdf": _require_sha256(
+            input_sha_raw["source_pdf"], "scores.input_sha256.source_pdf"
+        ),
+        "capture_path": _require_sha256(
+            input_sha_raw["capture_path"], "scores.input_sha256.capture_path"
+        ),
+    }
+    if expected_preparation_sha256 is not None and preparation_sha != expected_preparation_sha256:
+        raise CommitmentError("scoring used a different preparation commitment")
+    if config_sha != expected_config_sha256:
+        raise CommitmentError("scoring used a different receiver configuration")
+    if input_sha != dict(expected_input_sha256):
+        raise CommitmentError("scoring used different source/capture input bytes")
+    code_raw = _require_dict(result.get("code_sha256"), "scores.code_sha256")
+    code_mapping: dict[str, str] = {}
+    for path, digest in code_raw.items():
+        path_text = _require_string(path, "scores.code_sha256 path")
+        candidate = Path(path_text)
+        if candidate.is_absolute() or ".." in candidate.parts or candidate.as_posix() != path_text:
+            raise StudyValidationError(
+                "scores.code_sha256 keys must be safe repo-relative POSIX paths"
+            )
+        code_mapping[path_text] = _require_sha256(
+            digest, f"scores.code_sha256[{path_text!r}]"
+        )
+    if (
+        len(code_mapping) != len(RECEIVER_CODE_BASENAMES)
+        or {Path(path).name for path in code_mapping} != RECEIVER_CODE_BASENAMES
+    ):
+        raise StudyValidationError("scores.code_sha256 does not bind the eight required artifacts")
+    implementation_sha = _require_sha256(
+        result.get("implementation_sha256"), "scores.implementation_sha256"
+    )
+    if implementation_sha != _sha256_json(code_mapping):
+        raise CommitmentError("scores implementation hash does not bind code_sha256 mapping")
+    if expected_code_sha256 is not None and code_mapping != dict(expected_code_sha256):
+        raise CommitmentError("scoring code hashes differ from prepared code hashes")
+    if (
+        expected_implementation_sha256 is not None
+        and implementation_sha != expected_implementation_sha256
+    ):
+        raise CommitmentError("scoring implementation hash differs from preparation")
+    profiles = _require_dict(result.get("profiles"), "scores.profiles")
+    if set(profiles) != set(PROFILE_HYPOTHESES):
+        raise StudyValidationError("scores.profiles must contain hard/global_soft/local_soft")
+    for profile_name, expected_hypotheses in PROFILE_HYPOTHESES.items():
+        profile = _require_dict(profiles[profile_name], f"scores.profiles.{profile_name}")
+        status = profile.get("status")
+        if status not in {"scored", "inconclusive"}:
+            raise StudyValidationError(f"score profile {profile_name} has invalid status")
+        accused_union = _sorted_rows(
+            profile.get("accused_rows"), f"scores.profiles.{profile_name}.accused_rows"
+        )
+        hypotheses = _require_dict(
+            profile.get("hypotheses"), f"scores.profiles.{profile_name}.hypotheses"
+        )
+        if status == "inconclusive":
+            if accused_union:
+                raise StudyValidationError("inconclusive profile cannot accuse rows")
+            if not isinstance(profile.get("reason"), str) or not profile["reason"]:
+                raise StudyValidationError("inconclusive profile requires a reason")
+            if hypotheses:
+                raise StudyValidationError("inconclusive profile must not invent hypotheses")
+            continue
+        if set(hypotheses) != set(expected_hypotheses):
+            raise StudyValidationError(
+                f"scored {profile_name} hypotheses must equal {list(expected_hypotheses)}"
+            )
+        observed_union: set[int] = set()
+        for hypothesis_name in expected_hypotheses:
+            hypothesis = _require_dict(
+                hypotheses[hypothesis_name],
+                f"scores.profiles.{profile_name}.hypotheses.{hypothesis_name}",
+            )
+            scores = _require_list(
+                hypothesis.get("scores"),
+                f"scores.profiles.{profile_name}.hypotheses.{hypothesis_name}.scores",
+            )
+            if len(scores) != 1000 or any(
+                isinstance(score, bool)
+                or not isinstance(score, (int, float))
+                or not math.isfinite(float(score))
+                for score in scores
+            ):
+                raise StudyValidationError(
+                    f"{profile_name}/{hypothesis_name} must retain 1000 finite scores"
+                )
+            threshold = hypothesis.get("threshold")
+            if (
+                isinstance(threshold, bool)
+                or not isinstance(threshold, (int, float))
+                or not math.isfinite(float(threshold))
+            ):
+                raise StudyValidationError(f"{profile_name}/{hypothesis_name} threshold invalid")
+            accused = _sorted_rows(
+                hypothesis.get("accused_rows"),
+                f"scores.profiles.{profile_name}.hypotheses.{hypothesis_name}.accused_rows",
+            )
+            expected_accused = [
+                row for row, score in enumerate(scores) if float(score) > float(threshold)
+            ]
+            if accused != expected_accused:
+                raise StudyValidationError(
+                    f"{profile_name}/{hypothesis_name} accused rows violate strict score rule"
+                )
+            calibration = _require_dict(
+                hypothesis.get("calibration"),
+                f"scores.profiles.{profile_name}.hypotheses.{hypothesis_name}.calibration",
+            )
+            if calibration.get("status") != "calibrated":
+                raise StudyValidationError(
+                    f"{profile_name}/{hypothesis_name} calibration must be calibrated"
+                )
+            calibration_threshold = calibration.get("threshold")
+            if (
+                isinstance(calibration_threshold, bool)
+                or not isinstance(calibration_threshold, (int, float))
+                or not math.isfinite(float(calibration_threshold))
+                or float(calibration_threshold) != float(threshold)
+            ):
+                raise StudyValidationError(
+                    f"{profile_name}/{hypothesis_name} calibration threshold mismatch"
+                )
+            family_h = calibration.get("hypothesis_count")
+            if (
+                isinstance(family_h, bool)
+                or not isinstance(family_h, int)
+                or family_h < hypothesis_floor
+            ):
+                raise StudyValidationError(
+                    f"{profile_name}/{hypothesis_name} shrinks the planned hypothesis budget"
+                )
+            if family_h != result_hypothesis_count:
+                raise StudyValidationError(
+                    f"{profile_name}/{hypothesis_name} calibration budget differs from scores.hypothesis_count"
+                )
+            family_alpha = calibration.get("family_alpha")
+            if family_alpha != 1e-6:
+                raise StudyValidationError(
+                    f"{profile_name}/{hypothesis_name} family_alpha must remain 1e-6"
+                )
+            observed_union.update(accused)
+        if accused_union != sorted(observed_union):
+            raise StudyValidationError(f"{profile_name} accused_rows is not hypothesis union")
+    return result
+
+
+def _registration_status(prepared: Mapping[str, Any]) -> bool | None:
+    registration = prepared.get("registration")
+    if not isinstance(registration, dict):
+        return None
+    hard_gate = registration.get("hard_gate_passed")
+    return hard_gate if isinstance(hard_gate, bool) else None
+
+
+def _wilson_interval(successes: int, trials: int) -> list[float] | None:
+    if trials <= 0 or successes < 0 or successes > trials:
+        return None
+    z = 1.959963984540054
+    proportion = successes / trials
+    denominator = 1.0 + z * z / trials
+    center = (proportion + z * z / (2.0 * trials)) / denominator
+    margin = (
+        z
+        * math.sqrt(
+            proportion * (1.0 - proportion) / trials
+            + z * z / (4.0 * trials * trials)
+        )
+        / denominator
+    )
+    return [max(0.0, center - margin), min(1.0, center + margin)]
+
+
+def _labelled_raw_ber(
+    prepared: Mapping[str, Any],
+    prepared_directory: Path,
+    contributor_row: int,
+    codebook_cache: dict[tuple[str, str], tuple[np.ndarray, np.ndarray]],
+) -> dict[str, Any]:
+    """Measure committed raw hard decisions against one evaluator-only row.
+
+    This function must only be called after the preparation commitment exists
+    and evaluator labels have been opened.  It is a calibration diagnostic, not
+    a receiver score or an attribution success.
+    """
+
+    if isinstance(contributor_row, bool) or not isinstance(contributor_row, int) or not 0 <= contributor_row < 1000:
+        return {"status": "inconclusive", "reason": "invalid_evaluator_contributor_row"}
+    hard_profile = prepared.get("profiles", {}).get("hard")
+    if not isinstance(hard_profile, dict) or hard_profile.get("status") != "prepared":
+        return {"status": "inconclusive", "reason": "committed_hard_profile_not_prepared"}
+    word_key = hard_profile.get("word_key")
+    erased_key = hard_profile.get("erased_key")
+    if not isinstance(word_key, str) or not isinstance(erased_key, str):
+        return {"status": "inconclusive", "reason": "committed_hard_array_keys_missing"}
+    evidence_path = prepared_directory / "evidence.npz"
+    if _sha256_file(evidence_path) != prepared.get("evidence_sha256"):
+        raise CommitmentError("prepared evidence changed before labelled BER measurement")
+    try:
+        with np.load(evidence_path, allow_pickle=False) as stored:
+            if not {word_key, erased_key, "biases"}.issubset(stored.files):
+                return {
+                    "status": "inconclusive",
+                    "reason": "committed_hard_arrays_missing_from_evidence",
+                }
+            stored_word = np.asarray(stored[word_key])
+            stored_erased = np.asarray(stored[erased_key])
+            stored_biases = np.asarray(stored["biases"])
+            for name, value in (
+                (word_key, stored_word),
+                (erased_key, stored_erased),
+                ("biases", stored_biases),
+            ):
+                if _sha256_array(value) != prepared.get("array_sha256", {}).get(name):
+                    raise CommitmentError(
+                        f"prepared evidence array changed before labelled BER measurement: {name}"
+                    )
+            if (
+                stored_word.dtype != np.uint8
+                or np.any((stored_word != 0) & (stored_word != 1))
+                or stored_erased.dtype != np.bool_
+                or stored_biases.dtype != np.float64
+            ):
+                return {
+                    "status": "inconclusive",
+                    "reason": "committed_hard_array_dtype_or_domain_mismatch",
+                }
+            hard_word = stored_word
+            hard_erased = stored_erased
+            committed_biases = stored_biases
+    except (OSError, ValueError) as exc:
+        return {"status": "inconclusive", "reason": f"cannot_read_committed_hard_arrays:{exc}"}
+    if hard_word.shape != (EXPECTED_CARRIER["m"],) or hard_erased.shape != hard_word.shape:
+        return {"status": "inconclusive", "reason": "committed_hard_array_shape_mismatch"}
+
+    scoring_context = prepared.get("scoring_context")
+    if not isinstance(scoring_context, dict):
+        return {"status": "inconclusive", "reason": "prepared_scoring_context_missing"}
+    secret_hex = scoring_context.get("public_fixture_secret_hex")
+    codebook_context = scoring_context.get("codebook_context")
+    if (
+        not isinstance(secret_hex, str)
+        or re.fullmatch(r"[0-9a-f]{64}", secret_hex) is None
+        or not isinstance(codebook_context, str)
+        or not codebook_context
+    ):
+        return {"status": "inconclusive", "reason": "prepared_public_codebook_context_invalid"}
+    cache_key = (secret_hex, codebook_context)
+    if cache_key not in codebook_cache:
+        from nishan import tardos
+
+        parameter = tardos.parameters(1000, 5, 1e-6)
+        generated_biases, codebook = tardos.generate_keyed(
+            parameter, bytes.fromhex(secret_hex), codebook_context
+        )
+        codebook_cache[cache_key] = (generated_biases, codebook)
+    generated_biases, codebook = codebook_cache[cache_key]
+    if (
+        generated_biases.shape != committed_biases.shape
+        or not np.array_equal(generated_biases, committed_biases)
+    ):
+        raise CommitmentError("evaluator codebook biases differ from committed preparation")
+    expected_word = np.asarray(codebook[contributor_row], dtype=np.uint8)
+    usable = ~hard_erased
+    usable_count = int(np.count_nonzero(usable))
+    erased_count = int(hard_erased.size - usable_count)
+    if usable_count == 0:
+        return {
+            "status": "inconclusive",
+            "reason": "all_committed_hard_symbols_erased",
+            "total_symbols": int(hard_word.size),
+            "erased_symbols": erased_count,
+        }
+    mismatches = int(np.count_nonzero(hard_word[usable] != expected_word[usable]))
+    return {
+        "status": "measured",
+        "measurement_scope": "calibration_only_raw_committed_hard_decisions",
+        "contributor_row": contributor_row,
+        "total_symbols": int(hard_word.size),
+        "compared_symbols": usable_count,
+        "erased_symbols": erased_count,
+        "mismatched_symbols": mismatches,
+        "raw_ber": mismatches / usable_count,
+        "uncertainty": {
+            "status": "conditional_diagnostic",
+            "method": "wilson_score_interval_95",
+            "standard_error": math.sqrt(
+                (mismatches / usable_count)
+                * (1.0 - mismatches / usable_count)
+                / usable_count
+            ),
+            "interval_95": _wilson_interval(mismatches, usable_count),
+            "assumptions": [
+                "committed_non_erased_hard_symbol_decisions_are_the_analysis_units",
+                "binomial_interval_is_reported_as_if_symbol_errors_were_independent",
+            ],
+            "claim_limit": (
+                "conditional diagnostic only; carrier symbols can be spatially correlated and "
+                "this interval is not physical-study confidence or attribution evidence"
+            ),
+        },
+        "word_array_key": word_key,
+        "erased_array_key": erased_key,
+        "evidence_sha256": prepared["evidence_sha256"],
+        "prepared_commitment": prepared["commitment"],
+        "known_label_used_after_preparation_commitment": True,
+        "used_for_receiver_fitting_or_scoring": False,
+    }
+
+
+def _projected_page_geometry(
+    diagnostics: Any, *, source: str
+) -> dict[str, Any]:
+    """Measure projected page dimensions in original capture pixels.
+
+    The accepted registration transform maps capture pixels to the reference
+    page.  Inverting it maps the four reference-page corners back to the raw
+    capture, which is the relevant provenance for the >=1600 captured-pixel
+    page-width envelope.  Whole-image dimensions are deliberately not used.
+    """
+
+    if not isinstance(diagnostics, dict):
+        return {"status": "unmeasured", "reason": "registration_diagnostics_missing"}
+    if source == "receiver_preparation" and diagnostics.get("hard_gate_passed") is not True:
+        return {"status": "unmeasured", "reason": "registration_not_accepted"}
+    if source.startswith("coupon_") and diagnostics.get("rejection_reason") is not None:
+        return {"status": "unmeasured", "reason": "registration_not_accepted"}
+    transform_raw = diagnostics.get("raw_to_reference")
+    transform_field = "raw_to_reference"
+    if transform_raw is None:
+        transform_raw = diagnostics.get("homography_suspect_to_reference")
+        transform_field = "homography_suspect_to_reference"
+    reference_width = diagnostics.get("reference_width")
+    reference_height = diagnostics.get("reference_height")
+    suspect_width = diagnostics.get("suspect_width")
+    suspect_height = diagnostics.get("suspect_height")
+    if any(
+        isinstance(value, bool)
+        or not isinstance(value, (int, float))
+        or not math.isfinite(float(value))
+        or float(value) <= 0.0
+        for value in (reference_width, reference_height, suspect_width, suspect_height)
+    ):
+        return {"status": "unmeasured", "reason": "registration_dimensions_missing"}
+    try:
+        transform = np.asarray(transform_raw, dtype=np.float64)
+        if transform.shape != (3, 3) or not np.all(np.isfinite(transform)):
+            raise ValueError("invalid transform")
+        reference_to_capture = np.linalg.inv(transform)
+        corners = np.asarray(
+            [
+                [0.0, 0.0, 1.0],
+                [float(reference_width), 0.0, 1.0],
+                [float(reference_width), float(reference_height), 1.0],
+                [0.0, float(reference_height), 1.0],
+            ],
+            dtype=np.float64,
+        )
+        projected_h = (reference_to_capture @ corners.T).T
+        if np.any(np.abs(projected_h[:, 2]) < 1e-12):
+            raise ValueError("projected corner at infinity")
+        projected = projected_h[:, :2] / projected_h[:, 2:3]
+        if not np.all(np.isfinite(projected)):
+            raise ValueError("non-finite projected corners")
+    except (ValueError, np.linalg.LinAlgError, TypeError):
+        return {"status": "unmeasured", "reason": "registration_transform_invalid"}
+    top_width = float(np.linalg.norm(projected[1] - projected[0]))
+    bottom_width = float(np.linalg.norm(projected[2] - projected[3]))
+    left_height = float(np.linalg.norm(projected[3] - projected[0]))
+    right_height = float(np.linalg.norm(projected[2] - projected[1]))
+    tolerance = 1.0
+    full_page_inside = bool(
+        np.all(projected[:, 0] >= -tolerance)
+        and np.all(projected[:, 0] <= float(suspect_width) + tolerance)
+        and np.all(projected[:, 1] >= -tolerance)
+        and np.all(projected[:, 1] <= float(suspect_height) + tolerance)
+    )
+    return {
+        "status": "measured",
+        "source": source,
+        "method": "inverse_accepted_registration_reference_corners",
+        "transform_field": transform_field,
+        "transform_sha256": _sha256_json(transform.tolist()),
+        "projected_page_corners_capture_px": projected.tolist(),
+        "page_width_top_capture_px": top_width,
+        "page_width_bottom_capture_px": bottom_width,
+        "minimum_page_width_capture_px": min(top_width, bottom_width),
+        "page_height_left_capture_px": left_height,
+        "page_height_right_capture_px": right_height,
+        "full_page_inside_capture": full_page_inside,
+        "capture_dimensions_px": {
+            "width": int(suspect_width),
+            "height": int(suspect_height),
+        },
+        "reference_dimensions_px": {
+            "width": int(reference_width),
+            "height": int(reference_height),
+        },
+        "whole_image_width_used_for_page_width_claim": False,
+    }
+
+
+def _page_width_pass(row: Mapping[str, Any]) -> bool:
+    geometry = row.get("page_geometry")
+    return bool(
+        isinstance(geometry, dict)
+        and geometry.get("status") == "measured"
+        and geometry.get("full_page_inside_capture") is True
+        and isinstance(geometry.get("minimum_page_width_capture_px"), (int, float))
+        and not isinstance(geometry.get("minimum_page_width_capture_px"), bool)
+        and math.isfinite(float(geometry["minimum_page_width_capture_px"]))
+        and float(geometry["minimum_page_width_capture_px"]) >= 1600.0
+    )
+
+
+def _load_receiver_api(receiver_api: Any | None) -> Any:
+    if receiver_api is not None:
+        candidate = receiver_api
+    else:
+        candidate = importlib.import_module("research.n1_v2.receiver_api")
+    if not callable(getattr(candidate, "prepare_request", None)) or not callable(
+        getattr(candidate, "score_prepared", None)
+    ):
+        raise StudyValidationError(
+            "receiver API must export callable prepare_request and score_prepared"
+        )
+    return candidate
+
+
+def _write_run_failure(output: Path, reason: str, detail: str) -> None:
+    failure = {
+        "schema": "nishan.n1-study-run-failure/v2",
+        "created_at": _utc_now(),
+        "reason": reason,
+        "detail": detail,
+        "physical_result": False,
+    }
+    path = output / "run_failure.json"
+    if not path.exists():
+        _write_json_exclusive(path, failure)
+
+
+def run_study(
+    intake_path: str | os.PathLike[str],
+    receiver_config_path: str | os.PathLike[str],
+    output_path: str | os.PathLike[str],
+    *,
+    receiver_api: Any | None = None,
+) -> dict[str, Any]:
+    """Prepare every request, commit preparation, then open labels and score.
+
+    The output is an exclusive directory.  Failures are retained there and are
+    never silently dropped from the eventual report.
+    """
+
+    for variable in ("OPENBLAS_NUM_THREADS", "OMP_NUM_THREADS"):
+        os.environ.setdefault(variable, "2")
+    os.environ.setdefault("OPENCV_FOR_THREADS_NUM", "2")
+    intake_file = Path(intake_path).resolve()
+    config_path = Path(receiver_config_path).resolve()
+    if not config_path.is_file():
+        raise StudyValidationError(f"receiver config is not a regular file: {config_path}")
+    output = Path(output_path).resolve()
+    if output.exists():
+        raise StudyValidationError(f"refusing to overwrite run output: {output}")
+    output.mkdir(parents=True)
+    try:
+        intake_data, pack, protocol = _validate_intake(intake_file)
+        receiver = _load_receiver_api(receiver_api)
+        config_sha = _sha256_file(config_path)
+        config_binding = _git_binding_for_file(config_path)
+        code_binding = _receiver_code_binding(receiver)
+        config_commit = config_binding["commit"] if config_binding else None
+        split = pack["split"]
+        if split in {"validation", "heldout"} and (
+            config_binding is None
+            or code_binding is None
+            or code_binding["commit"] != config_binding["commit"]
+        ):
+            raise CommitmentError(
+                "validation/held-out preparation requires config and receiver code bytes bound to the same Git commit"
+            )
+        planned_decisions, hypothesis_floor = _planned_budget(
+            protocol, split, len(intake_data["captures"])
+        )
+        sheet_by_id = {sheet["sheet_id"]: sheet for sheet in pack["sheets"]}
+        requests_dir = output / "requests"
+        prepared_root = output / "prepared"
+        requests_dir.mkdir()
+        prepared_root.mkdir()
+        preparation_records: list[dict[str, Any]] = []
+        prepared_objects: dict[str, dict[str, Any]] = {}
+        for capture in intake_data["captures"]:
+            request_id = capture["capture_id"]
+            sheet = sheet_by_id[capture["sheet_id"]]
+            receiver_source_sheet = (
+                sheet_by_id[capture["receiver_source_sheet_id"]]
+                if capture.get("receiver_source_sheet_id")
+                else sheet
+            )
+            receiver_context = capture.get("receiver_context") or pack["context"]
+            request = {
+                "schema": REQUEST_SCHEMA,
+                "request_id": request_id,
+                "source_pdf": receiver_source_sheet["source_pdf"],
+                "source_sha256": receiver_source_sheet["source_sha256"],
+                "capture_path": capture["path"],
+                "capture_sha256": capture["file_identity"]["sha256"],
+                "context": receiver_context,
+                "carrier": pack["carrier"],
+                "receiver_config_path": str(config_path),
+            }
+            if set(request) & {
+                "attack",
+                "contributors",
+                "expected_row",
+                "kind",
+                "sheet_kind",
+                "split",
+                "source_watermark_variant",
+                "output_verdict",
+            }:
+                raise AssertionError("internal evaluator-label leakage into request")
+            request_path = requests_dir / f"{request_id}.json"
+            _write_json_exclusive(request_path, request)
+            prepared_dir = prepared_root / request_id
+            record: dict[str, Any] = {
+                "request_id": request_id,
+                "request_sha256": _sha256_file(request_path),
+                "request_path": str(request_path),
+                "prepared_directory": str(prepared_dir),
+            }
+            if sheet["kind"] in {"coupon_unmarked", "coupon_marked"}:
+                record.update(
+                    {
+                        "status": "coupon_calibration_only",
+                        "reason": "known coupon bypasses recipient receiver preparation and attribution",
+                    }
+                )
+                preparation_records.append(record)
+                continue
+            try:
+                returned = receiver.prepare_request(request, str(prepared_dir))
+                prepared_path = prepared_dir / "prepared.json"
+                prepared = _validate_preparation(
+                    returned,
+                    prepared_path,
+                    config_sha,
+                    {
+                        "source_pdf": receiver_source_sheet["source_sha256"],
+                        "capture_path": capture["file_identity"]["sha256"],
+                    },
+                    receiver_context,
+                    receiver,
+                    config_path,
+                    code_binding,
+                )
+                record.update(
+                    {
+                        "status": prepared["status"],
+                        "prepared_sha256": _sha256_file(prepared_path),
+                        "commitment": prepared["commitment"],
+                    }
+                )
+                if prepared["status"] == "inconclusive":
+                    reasons = sorted(
+                        {
+                            str(profile["reason"])
+                            for profile in prepared["profiles"].values()
+                            if profile.get("status") == "inconclusive" and profile.get("reason")
+                        }
+                    )
+                    record["reason"] = "; ".join(reasons) or "all receiver profiles inconclusive"
+                prepared_objects[request_id] = prepared
+            except Exception as exc:  # retained as a case outcome
+                record.update(
+                    {
+                        "status": "error",
+                        "reason": f"{type(exc).__name__}: {exc}",
+                    }
+                )
+            preparation_records.append(record)
+
+        commitment_payload = {
+            "schema": "nishan.n1-preparation-commitment/v2",
+            "protocol_sha256": intake_data["protocol_sha256"],
+            "intake_sha256": _sha256_file(intake_file),
+            "manifest_sha256": pack["manifest_sha256"],
+            "receiver_config_sha256": config_sha,
+            "receiver_configuration_commit": config_commit,
