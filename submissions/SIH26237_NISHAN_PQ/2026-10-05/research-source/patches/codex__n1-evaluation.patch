+"""Source-only measurement of the N1 calibration coupon.
+
+Known coupon templates are used only after source-content registration and only
+for calibration diagnostics.  Nothing in this module generates or scores a
+Tardos roster row, and its measurements are never attribution successes.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import re
+import sys
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+import cv2
+import numpy as np
+from PIL import Image, UnidentifiedImageError
+
+from nishan.registration import align_page
+
+
+SCHEMA = "nishan.n1-coupon-regions/v2"
+MEASUREMENT_SCHEMA = "nishan.n1-coupon-measurement/v2"
+SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+TONE_NAMES = ("black", "gray", "white")
+BLOCK_SIZES = (6, 12, 24)
+
+
+class CouponValidationError(ValueError):
+    """Coupon descriptor, image, or registration is not usable."""
+
+
+def _duplicate_safe(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    output: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in output:
+            raise CouponValidationError(f"duplicate JSON key: {key}")
+        output[key] = value
+    return output
+
+
+def _load_json(path: Path) -> Any:
+    try:
+        return json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=_duplicate_safe)
+    except (OSError, json.JSONDecodeError) as exc:
+        raise CouponValidationError(f"cannot read coupon descriptor {path}: {exc}") from exc
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    try:
+        with path.open("rb") as handle:
+            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+                digest.update(chunk)
+    except OSError as exc:
+        raise CouponValidationError(f"cannot hash {path}: {exc}") from exc
+    return digest.hexdigest()
+
+
+def _safe_file(root: Path, raw: Any, field: str) -> Path:
+    if not isinstance(raw, str) or not raw:
+        raise CouponValidationError(f"{field} must be a non-empty relative path")
+    candidate = Path(raw)
+    if candidate.is_absolute() or ".." in candidate.parts:
+        raise CouponValidationError(f"{field} must not be absolute or traverse")
+    root_resolved = root.resolve()
+    path = (root / candidate).resolve()
+    try:
+        path.relative_to(root_resolved)
+    except ValueError as exc:
+        raise CouponValidationError(f"{field} escapes the descriptor directory") from exc
+    if not path.is_file():
+        raise CouponValidationError(f"{field} does not identify a file")
+    return path
+
+
+def _require_sha(value: Any, field: str) -> str:
+    if not isinstance(value, str) or SHA256_RE.fullmatch(value) is None:
+        raise CouponValidationError(f"{field} must be lowercase SHA-256")
+    return value
+
+
+def _load_rgb(path: Path) -> np.ndarray:
+    try:
+        with Image.open(path) as image:
+            return np.asarray(image.convert("RGB"), dtype=np.uint8)
+    except (OSError, UnidentifiedImageError, ValueError) as exc:
+        raise CouponValidationError(f"cannot decode RGB image {path}: {exc}") from exc
+
+
+def _luma(image: np.ndarray) -> np.ndarray:
+    image_f = np.asarray(image, dtype=np.float64)
+    if image_f.ndim != 3 or image_f.shape[2] != 3:
+        raise CouponValidationError("RGB array required for luma conversion")
+    return (
+        0.299 * image_f[..., 0]
+        + 0.587 * image_f[..., 1]
+        + 0.114 * image_f[..., 2]
+    )
+
+
+def validate_descriptor(path: str | os.PathLike[str]) -> dict[str, Any]:
+    descriptor_path = Path(path).resolve()
+    raw = _load_json(descriptor_path)
+    if not isinstance(raw, dict) or raw.get("schema") != SCHEMA:
+        raise CouponValidationError(f"descriptor schema must be {SCHEMA}")
+    required = {
+        "schema",
+        "sheet_id",
+        "control_sheet_id",
+        "reference_image",
+        "geometry_anchors",
+        "regions",
+    }
+    allowed = required | {
+        "created_at",
+        "notes",
+        "purpose",
+        "claim_scope",
+        "coordinate_space",
+        "delta_convention",
+        "signal_recipe",
+    }
+    if set(raw) - allowed or required - set(raw):
+        raise CouponValidationError("coupon descriptor has missing or undocumented keys")
+    if raw["sheet_id"] != "C1" or raw["control_sheet_id"] != "C0":
+        raise CouponValidationError("coupon descriptor must bind signal C1 and control C0")
+    reference = raw["reference_image"]
+    if not isinstance(reference, dict) or set(reference) != {
+        "path",
+        "sha256",
+        "width",
+        "height",
+        "dpi",
+    }:
+        raise CouponValidationError("reference_image has the wrong shape")
+    reference_path = _safe_file(
+        descriptor_path.parent, reference["path"], "reference_image.path"
+    )
+    reference_sha = _require_sha(reference["sha256"], "reference_image.sha256")
+    if _sha256(reference_path) != reference_sha:
+        raise CouponValidationError("reference image hash mismatch")
+    if reference["dpi"] != 144:
+        raise CouponValidationError("reference image dpi must be 144")
+    if any(
+        isinstance(reference[key], bool)
+        or not isinstance(reference[key], int)
+        or reference[key] <= 0
+        for key in ("width", "height")
+    ):
+        raise CouponValidationError("reference dimensions must be positive integers")
+    reference_rgb = _load_rgb(reference_path)
+    height, width = reference_rgb.shape[:2]
+    if [width, height] != [reference["width"], reference["height"]]:
+        raise CouponValidationError("reference dimensions do not match decoded bytes")
+
+    coordinate_space = raw.get("coordinate_space")
+    if coordinate_space is not None:
+        if not isinstance(coordinate_space, dict):
+            raise CouponValidationError("coordinate_space must be an object")
+        expected_coordinate_values = {
+            "origin": "top_left",
+            "units": "pixels",
+            "dpi": 144,
+            "width": width,
+            "height": height,
+            "bbox_convention": "half-open [x0,y0,x1,y1]",
+        }
+        if any(coordinate_space.get(key) != value for key, value in expected_coordinate_values.items()):
+            raise CouponValidationError("coordinate_space does not match the 144-dpi reference image")
+    for metadata_key in ("delta_convention", "signal_recipe"):
+        if metadata_key in raw and not isinstance(raw[metadata_key], dict):
+            raise CouponValidationError(f"{metadata_key} must be an object")
+    for text_key in ("purpose", "claim_scope"):
+        if text_key in raw and (not isinstance(raw[text_key], str) or not raw[text_key]):
+            raise CouponValidationError(f"{text_key} must be a non-empty string")
+
+    anchors = raw["geometry_anchors"]
+    required_anchors = {
+        "printable_area_rectangle",
+        "scale_bar_100mm",
+        "square_20mm",
+        "crosshairs",
+    }
+    if isinstance(anchors, dict):
+        if not required_anchors.issubset(anchors):
+            raise CouponValidationError(
+                "geometry_anchors must document printable rectangle, 100mm bar, 20mm square, and crosshairs"
+            )
+    elif isinstance(anchors, list):
+        if not anchors or any(not isinstance(anchor, dict) for anchor in anchors):
+            raise CouponValidationError("geometry_anchors list must contain objects")
+        anchor_ids = [anchor.get("anchor_id") for anchor in anchors]
+        if any(not isinstance(anchor_id, str) or not anchor_id for anchor_id in anchor_ids):
+            raise CouponValidationError("every geometry anchor requires an anchor_id")
+        if len(anchor_ids) != len(set(anchor_ids)):
+            raise CouponValidationError("geometry anchor IDs must be unique")
+        kinds = {anchor.get("kind") for anchor in anchors}
+        has_100mm_bar = any(anchor.get("physical_length_mm") == 100.0 for anchor in anchors)
+        has_20mm_square = any(anchor.get("physical_side_mm") == 20.0 for anchor in anchors)
+        if (
+            "rectangle" not in kinds
+            or not has_100mm_bar
+            or not has_20mm_square
+            or not ({"crosshair", "crosshair_set"} & kinds)
+        ):
+            raise CouponValidationError(
+                "geometry_anchors must document printable rectangle, 100mm bar, 20mm square, and crosshairs"
+            )
+    else:
+        raise CouponValidationError("geometry_anchors must be an object or list")
+    regions_raw = raw["regions"]
+    if not isinstance(regions_raw, list) or len(regions_raw) != 9:
+        raise CouponValidationError("coupon descriptor must contain exactly nine regions")
+    regions: list[dict[str, Any]] = []
+    seen_ids: set[str] = set()
+    combinations: CounterLike = {}
+    for index, region in enumerate(regions_raw):
+        if not isinstance(region, dict):
+            raise CouponValidationError(f"regions[{index}] must be an object")
+        fields = {
+            "region_id",
+            "reference_bbox_px_144",
+            "block_px",
+            "source_tone",
+            "strength",
+            "delta_template_path",
+            "delta_template_sha256",
+            "delta_template_dtype",
+            "delta_template_shape",
+        }
+        allowed_region_fields = fields | {"ideal_signal_sha256"}
+        if set(region) - allowed_region_fields or fields - set(region):
+            raise CouponValidationError(f"regions[{index}] has missing or undocumented keys")
+        region_id = region["region_id"]
+        if not isinstance(region_id, str) or not region_id or region_id in seen_ids:
+            raise CouponValidationError(f"regions[{index}].region_id invalid or duplicate")
+        seen_ids.add(region_id)
+        bbox = region["reference_bbox_px_144"]
+        if (
+            not isinstance(bbox, list)
+            or len(bbox) != 4
+            or any(isinstance(value, bool) or not isinstance(value, int) for value in bbox)
+        ):
+            raise CouponValidationError(f"regions[{index}] bbox must be four integers")
+        x0, y0, x1, y1 = bbox
+        if not (0 <= x0 < x1 <= width and 0 <= y0 < y1 <= height):
+            raise CouponValidationError(f"regions[{index}] bbox is outside reference image")
+        block_px = region["block_px"]
+        if block_px not in BLOCK_SIZES:
+            raise CouponValidationError(f"regions[{index}].block_px must be 6, 12, or 24")
+        tone = region["source_tone"]
+        if not isinstance(tone, dict) or set(tone) != {"name", "rgb"}:
+            raise CouponValidationError(f"regions[{index}].source_tone is malformed")
+        if tone["name"] not in TONE_NAMES:
+            raise CouponValidationError(f"regions[{index}] has unsupported tone name")
+        rgb = tone["rgb"]
+        if (
+            not isinstance(rgb, list)
+            or len(rgb) != 3
+            or any(isinstance(value, bool) or not isinstance(value, int) or not 0 <= value <= 255 for value in rgb)
+        ):
+            raise CouponValidationError(f"regions[{index}].source_tone.rgb invalid")
+        if region["strength"] != 4.0:
+            raise CouponValidationError(f"regions[{index}].strength must remain 4.0")
+        if region["delta_template_dtype"] != "int16":
+            raise CouponValidationError(f"regions[{index}] template dtype must be int16")
+        if "ideal_signal_sha256" in region:
+            _require_sha(
+                region["ideal_signal_sha256"], f"regions[{index}].ideal_signal_sha256"
+            )
+        shape = region["delta_template_shape"]
+        expected_shape = [y1 - y0, x1 - x0, 3]
+        if shape != expected_shape:
+            raise CouponValidationError(
+                f"regions[{index}] template shape must equal bbox RGB shape {expected_shape}"
+            )
+        template_path = _safe_file(
+            descriptor_path.parent,
+            region["delta_template_path"],
+            f"regions[{index}].delta_template_path",
+        )
+        template_sha = _require_sha(
+            region["delta_template_sha256"], f"regions[{index}].delta_template_sha256"
+        )
+        if _sha256(template_path) != template_sha:
+            raise CouponValidationError(f"regions[{index}] template hash mismatch")
+        try:
+            template = np.load(template_path, allow_pickle=False)
+        except (OSError, ValueError) as exc:
+            raise CouponValidationError(f"regions[{index}] template cannot be loaded: {exc}") from exc
+        if template.dtype != np.int16 or list(template.shape) != expected_shape:
+            raise CouponValidationError(f"regions[{index}] template array contract mismatch")
+        combination = (int(block_px), str(tone["name"]))
+        combinations[combination] = combinations.get(combination, 0) + 1
+        regions.append(
+            {
+                **region,
+                "delta_template_path": str(template_path),
+                "delta_template_sha256": template_sha,
+            }
+        )
+    expected_combinations = {(block, tone) for block in BLOCK_SIZES for tone in TONE_NAMES}
+    if set(combinations) != expected_combinations or any(value != 1 for value in combinations.values()):
+        raise CouponValidationError("coupon regions must cross block 6/12/24 with black/gray/white")
+    return {
+        "schema": SCHEMA,
+        "descriptor_path": str(descriptor_path),
+        "descriptor_sha256": _sha256(descriptor_path),
+        "sheet_id": "C1",
+        "control_sheet_id": "C0",
+        "reference_image": {
+            **reference,
+            "path": str(reference_path),
+        },
+        "geometry_anchors": anchors,
+        "regions": regions,
+    }
+
+
+CounterLike = dict[tuple[int, str], int]
+
+
+def _registration(reference: np.ndarray, capture: np.ndarray) -> tuple[np.ndarray, dict[str, Any]]:
+    registered, metrics = align_page(reference, capture)
+    record = metrics.to_dict()
+    accepted = metrics.rejection_reason is None
+    record["accepted"] = accepted
+    record["uses_coupon_template"] = False
+    if not accepted:
+        raise CouponValidationError(f"source-only registration rejected: {metrics.rejection_reason}")
+    return np.asarray(registered, dtype=np.uint8), record
+
+
+def _global_photometry(
+    reference_luma: np.ndarray,
+    capture_luma: np.ndarray,
+    regions: Sequence[Mapping[str, Any]],
+) -> tuple[float, float, dict[str, Any]]:
+    mask = np.ones(reference_luma.shape, dtype=bool)
+    for region in regions:
+        x0, y0, x1, y1 = region["reference_bbox_px_144"]
+        mask[y0:y1, x0:x1] = False
+    x = reference_luma[mask]
+    y = capture_luma[mask]
+    finite = np.isfinite(x) & np.isfinite(y)
+    x = x[finite]
+    y = y[finite]
+    if x.size < 256 or float(np.std(x)) < 5.0:
+        raise CouponValidationError(
+            "global source/anchor photometry is underdetermined (insufficient multi-tone support)"
+        )
+    design = np.column_stack([x, np.ones_like(x)])
+    coefficients, _residuals, rank, singular = np.linalg.lstsq(design, y, rcond=None)
+    if rank < 2 or not np.all(np.isfinite(coefficients)) or coefficients[0] <= 0:
+        raise CouponValidationError("global source-only photometric fit is invalid")
+    predicted = design @ coefficients
+    residual = y - predicted
+    return (
+        float(coefficients[0]),
+        float(coefficients[1]),
+        {
+            "fit_pixels": int(x.size),
+            "rank": int(rank),
+            "singular_values": [float(value) for value in singular],
+            "reference_standard_deviation": float(np.std(x)),
+            "residual_rms": float(np.sqrt(np.mean(np.square(residual)))),
+            "fit_used_coupon_template": False,
+        },
+    )
+
+
+def _measure_regions(
+    descriptor: Mapping[str, Any],
+    reference_rgb: np.ndarray,
+    registered_rgb: np.ndarray,
+    gain: float,
+    offset: float,
+) -> list[dict[str, Any]]:
+    reference_luma = _luma(reference_rgb)
+    capture_luma = _luma(registered_rgb)
+    results: list[dict[str, Any]] = []
+    for region in descriptor["regions"]:
+        x0, y0, x1, y1 = region["reference_bbox_px_144"]
+        template_rgb = np.load(region["delta_template_path"], allow_pickle=False).astype(
+            np.float64
+        )
+        template = _luma(template_rgb)
+        source = reference_luma[y0:y1, x0:x1]
+        observed = capture_luma[y0:y1, x0:x1]
+        expected_without_signal = gain * source + offset
+        residual = observed - expected_without_signal
+        template_centered = template - float(np.mean(template))
+        template_energy = float(np.sum(np.square(template_centered)))
+        base = {
+            "region_id": region["region_id"],
+            "block_px": region["block_px"],
+            "source_tone": region["source_tone"],
+            "reference_bbox_px_144": region["reference_bbox_px_144"],
+            "strength": region["strength"],
+            "delta_template_sha256": region["delta_template_sha256"],
+            "expected_clean_endpoint_rms_luma": float(
+                np.sqrt(np.mean(np.square(template)))
+            ),
+            "expected_clean_endpoint_centered_rms_luma": float(
+                np.sqrt(np.mean(np.square(template_centered)))
+            ),
+            "clipping_fraction": float(
+                np.mean(np.any((registered_rgb[y0:y1, x0:x1] <= 1) | (registered_rgb[y0:y1, x0:x1] >= 254), axis=2))
+            ),
+        }
+        if template_energy <= 1e-12:
+            results.append(
+                {
+                    **base,
+                    "status": "inconclusive",
+                    "reason": "degenerate_zero_or_constant_delta_template",
+                }
+            )
+            continue
+        local_offset = float(np.mean(residual))
+        centered_residual = residual - local_offset
+        modulation = float(np.sum(centered_residual * template_centered) / template_energy)
+        fitted = local_offset + modulation * template_centered
+        unexplained = residual - fitted
+        uncertainty_dof = int(unexplained.size - 2)
+        if uncertainty_dof <= 0:
+            results.append(
+                {
+                    **base,
+                    "status": "inconclusive",
+                    "reason": "modulation_uncertainty_has_no_residual_degrees_of_freedom",
+                }
+            )
+            continue
+        residual_variance = float(
+            np.sum(np.square(unexplained)) / uncertainty_dof
+        )
+        modulation_standard_error = float(
+            math.sqrt(max(0.0, residual_variance) / template_energy)
+        )
+        if not math.isfinite(modulation_standard_error):
+            results.append(
+                {
+                    **base,
+                    "status": "inconclusive",
+                    "reason": "modulation_uncertainty_is_non_finite",
+                }
+            )
+            continue
+        interval_margin = 1.959963984540054 * modulation_standard_error
+        residual_norm = float(np.linalg.norm(centered_residual))
+        correlation = (
+            float(np.sum(centered_residual * template_centered) / (residual_norm * math.sqrt(template_energy)))
+            if residual_norm > 0
+            else 0.0
+        )
+        results.append(
+            {
+                **base,
+                "status": "measured",
+                "regional_offset_luma": local_offset,
+                "measured_modulation_gain": modulation,
+                "measured_modulation_rms_luma": abs(modulation)
+                * base["expected_clean_endpoint_centered_rms_luma"],
+                "template_correlation": correlation,
+                "unexplained_noise_rms_luma": float(
+                    np.sqrt(np.mean(np.square(unexplained)))
+                ),
+                "fit_rank": 2,
+                "rank_aware_model": "regional_intercept_plus_centered_delta_template",
+                "modulation_uncertainty": {
+                    "status": "conditional_diagnostic",
+                    "standard_error": modulation_standard_error,
+                    "interval_95": [
+                        modulation - interval_margin,
+                        modulation + interval_margin,
+                    ],
+                    "residual_degrees_of_freedom": uncertainty_dof,
+                    "residual_variance_luma": residual_variance,
+                    "assumptions": [
+                        "registered_geometry_and_global_photometry_are_fixed",
+                        "regional_luma_residuals_are_independent_and_homoskedastic",
+                        "delta_template_is_exact_in_reference_coordinates",
+                    ],
+                    "claim_limit": (
+                        "conditional diagnostic only; interval excludes spatial correlation, "
+                        "registration error, photometric-model error, and print/camera systematics"
+                    ),
+                },
+            }
+        )
+    return results
+
+
+def measure_coupon(
+    descriptor_path: str | os.PathLike[str],
+    signal_capture_path: str | os.PathLike[str],
+    *,
+    control_capture_path: str | os.PathLike[str] | None = None,
+) -> dict[str, Any]:
+    """Measure one C1 coupon and its optional matching C0 physical control."""
+
+    cv2.setNumThreads(2)
+    descriptor = validate_descriptor(descriptor_path)
+    reference_path = Path(descriptor["reference_image"]["path"])
+    signal_path = Path(signal_capture_path).resolve()
+    if not signal_path.is_file():
+        raise CouponValidationError("signal capture does not exist")
+    reference_rgb = _load_rgb(reference_path)
+    signal_rgb = _load_rgb(signal_path)
+    try:
+        registered_signal, signal_registration = _registration(reference_rgb, signal_rgb)
+        reference_luma = _luma(reference_rgb)
+        signal_luma = _luma(registered_signal)
+        gain, offset, photometry = _global_photometry(
+            reference_luma, signal_luma, descriptor["regions"]
+        )
+        signal_regions = _measure_regions(
+            descriptor, reference_rgb, registered_signal, gain, offset
+        )
+    except CouponValidationError as exc:
+        return {
+            "schema": MEASUREMENT_SCHEMA,
+            "status": "inconclusive",
+            "reason": str(exc),
+            "descriptor_sha256": descriptor["descriptor_sha256"],
+            "signal_capture_path": str(signal_path),
+            "signal_capture_sha256": _sha256(signal_path),
+            "known_coupon_used_for_attribution": False,
+            "automatic_stop_decision": None,
+        }
+
+    result: dict[str, Any] = {
+        "schema": MEASUREMENT_SCHEMA,
+        "status": "measured",
+        "descriptor_sha256": descriptor["descriptor_sha256"],
+        "reference_image_sha256": descriptor["reference_image"]["sha256"],
+        "signal_capture_path": str(signal_path),
+        "signal_capture_sha256": _sha256(signal_path),
+        "signal_registration": signal_registration,
+        "global_photometry": {"gain": gain, "offset": offset, **photometry},
+        "signal_regions": signal_regions,
+        "pair_status": "missing_control",
+        "known_coupon_used_for_attribution": False,
+        "known_coupon_scope": "calibration_measurement_only",
+        "automatic_stop_decision": None,
+    }
+    if control_capture_path is None:
+        return result
+    control_path = Path(control_capture_path).resolve()
+    if not control_path.is_file():
+        result["pair_status"] = "missing_control"
+        result["control_error"] = "control capture path does not exist"
+        return result
+    try:
+        registered_control, control_registration = _registration(
+            reference_rgb, _load_rgb(control_path)
+        )
+        control_gain, control_offset, control_photometry = _global_photometry(
+            _luma(reference_rgb), _luma(registered_control), descriptor["regions"]
+        )
+        control_regions = _measure_regions(
+            descriptor, reference_rgb, registered_control, control_gain, control_offset
+        )
+    except CouponValidationError as exc:
+        result.update(
+            {
+                "pair_status": "control_inconclusive",
+                "control_capture_path": str(control_path),
+                "control_capture_sha256": _sha256(control_path),
+                "control_error": str(exc),
+            }
+        )
+        return result
+    signal_by_id = {region["region_id"]: region for region in signal_regions}
+    paired = []
+    for control_region in control_regions:
+        signal_region = signal_by_id[control_region["region_id"]]
+        delta = None
+        delta_uncertainty = None
+        if signal_region["status"] == "measured" and control_region["status"] == "measured":
+            delta = signal_region["measured_modulation_gain"] - control_region[
+                "measured_modulation_gain"
+            ]
+            signal_se = signal_region["modulation_uncertainty"]["standard_error"]
+            control_se = control_region["modulation_uncertainty"]["standard_error"]
+            paired_se = float(math.sqrt(signal_se * signal_se + control_se * control_se))
+            paired_margin = 1.959963984540054 * paired_se
+            delta_uncertainty = {
+                "status": "conditional_diagnostic",
+                "standard_error": paired_se,
+                "interval_95": [delta - paired_margin, delta + paired_margin],
+                "assumptions": [
+                    "signal_and_control_conditional_fit_errors_are_independent",
+                    "component_registrations_and_photometry_are_fixed",
+                ],
+                "claim_limit": (
+                    "conditional diagnostic only; interval excludes shared print/camera, "
+                    "registration, and spatial-correlation systematics"
+                ),
+            }
+        paired.append(
+            {
+                "region_id": control_region["region_id"],
+                "signal_status": signal_region["status"],
+                "control_status": control_region["status"],
+                "signal_minus_control_modulation_gain": delta,
+                "signal_minus_control_uncertainty": delta_uncertainty,
+            }
+        )
+    result.update(
+        {
+            "pair_status": "matched",
+            "control_capture_path": str(control_path),
+            "control_capture_sha256": _sha256(control_path),
+            "control_registration": control_registration,
+            "control_global_photometry": {
+                "gain": control_gain,
+                "offset": control_offset,
+                **control_photometry,
+            },
+            "control_regions": control_regions,
+            "paired_regions": paired,
+        }
+    )
+    return result
+
+
+def _write_exclusive(path: Path, value: Mapping[str, Any]) -> None:
+    path = path.resolve()
+    if path.exists():
+        raise CouponValidationError(f"refusing to overwrite {path}")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("x", encoding="utf-8") as handle:
+        json.dump(value, handle, sort_keys=True, indent=2, allow_nan=False)
+        handle.write("\n")
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--descriptor", required=True)
+    parser.add_argument("--signal", required=True)
+    parser.add_argument("--control")
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args(argv)
+    try:
+        result = measure_coupon(
+            args.descriptor, args.signal, control_capture_path=args.control
+        )
+        _write_exclusive(Path(args.output), result)
+        print(json.dumps(result, sort_keys=True, indent=2))
+        return 0 if result["status"] == "measured" else 2
+    except CouponValidationError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
