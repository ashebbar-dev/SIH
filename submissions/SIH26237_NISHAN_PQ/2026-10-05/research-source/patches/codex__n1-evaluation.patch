+def _known_text(value: Any) -> bool:
+    return isinstance(value, str) and value.strip().lower() not in UNKNOWN_VALUES
+
+
+def _accused_for_profile(row: Mapping[str, Any], profile_name: str) -> list[int] | None:
+    if row.get("status") != "scored" or row.get("registration_accepted") is not True:
+        return None
+    scores = row.get("scores")
+    if not isinstance(scores, dict):
+        return None
+    profiles = scores.get("profiles")
+    if not isinstance(profiles, dict) or profile_name not in profiles:
+        return None
+    profile = profiles[profile_name]
+    if not isinstance(profile, dict) or profile.get("status") != "scored":
+        return None
+    # The attack family is evaluator-only ground truth.  Operational outcomes
+    # must use the profile-level union across every frozen hypothesis; selecting
+    # the matching labelled hypothesis would be an oracle and could hide an
+    # innocent accused by another family.
+    accused = profile.get("accused_rows")
+    return list(accused) if isinstance(accused, list) else None
+
+
+def _actual_for_outcome(row: Mapping[str, Any]) -> set[int]:
+    if row.get("attack") == "unmarked" or row.get("category") in {
+        "wrong_key",
+        "wrong_context",
+        "wrong_source",
+        "donor_overlay",
+    }:
+        return set()
+    return set(row.get("contributors", []))
+
+
+def _classify_outcome(row: Mapping[str, Any], profile_name: str) -> tuple[str, int, int]:
+    if row.get("status") == "error":
+        return "inconclusive_or_error", 0, 0
+    if row.get("registration_accepted") is False:
+        return "registration_failure", 0, 0
+    if row.get("registration_accepted") is not True:
+        return "inconclusive_or_error", 0, 0
+    accused = _accused_for_profile(row, profile_name)
+    if accused is None:
+        return "inconclusive_or_error", 0, 0
+    actual = _actual_for_outcome(row)
+    accused_set = set(accused)
+    detected = accused_set & actual
+    innocent = accused_set - actual
+    if detected and not innocent:
+        return "success", len(detected), 0
+    if detected and innocent:
+        return "mixed_with_innocent", len(detected), len(innocent)
+    if innocent:
+        return "wrong_valid", 0, len(innocent)
+    return "abstention", 0, 0
+
+
+def _outcome_summary(rows: Sequence[Mapping[str, Any]], profile_name: str) -> dict[str, Any]:
+    counts = {
+        "success": 0,
+        "wrong_valid": 0,
+        "mixed_with_innocent": 0,
+        "abstention": 0,
+        "registration_failure": 0,
+        "inconclusive_or_error": 0,
+    }
+    detected_members = 0
+    actual_members = 0
+    innocent_rows = 0
+    innocent_cases = 0
+    detect_one_cases = 0
+    for row in rows:
+        outcome, detected, innocent = _classify_outcome(row, profile_name)
+        counts[outcome] += 1
+        detected_members += detected
+        actual_members += len(_actual_for_outcome(row))
+        innocent_rows += innocent
+        innocent_cases += int(innocent > 0)
+        detect_one_cases += int(detected > 0)
+    denominator = len(rows)
+    return {
+        **counts,
+        "total_cases": denominator,
+        "detect_one_cases": detect_one_cases,
+        "detect_one_rate": detect_one_cases / denominator if denominator else None,
+        "success_rate": counts["success"] / denominator if denominator else None,
+        "all_member_detected": detected_members,
+        "all_member_total": actual_members,
+        "all_member_recall": detected_members / actual_members if actual_members else None,
+        "innocent_accusation_cases": innocent_cases,
+        "innocent_rows_accused": innocent_rows,
+    }
+
+
+def _paired_success_summary(rows: Sequence[Mapping[str, Any]]) -> dict[str, int]:
+    paired = {
+        "both_success": 0,
+        "candidate_only_success": 0,
+        "baseline_only_success": 0,
+        "neither_success": 0,
+    }
+    for row in rows:
+        candidate_success = _classify_outcome(row, "local_soft")[0] == "success"
+        baseline_success = _classify_outcome(row, "global_soft")[0] == "success"
+        if candidate_success and baseline_success:
+            paired["both_success"] += 1
+        elif candidate_success:
+            paired["candidate_only_success"] += 1
+        elif baseline_success:
+            paired["baseline_only_success"] += 1
+        else:
+            paired["neither_success"] += 1
+    return paired
+
+
+def _rate(rows: Sequence[Mapping[str, Any]], profile_name: str) -> float | None:
+    if not rows:
+        return None
+    successes = sum(_classify_outcome(row, profile_name)[0] == "success" for row in rows)
+    return successes / len(rows)
+
+
+def _bootstrap_gain(
+    rows: Sequence[Mapping[str, Any]], seed: int, resamples: int
+) -> dict[str, Any]:
+    clusters: dict[str, list[Mapping[str, Any]]] = defaultdict(list)
+    for row in rows:
+        key = str(row.get("artifact_id") or f"{row.get('source_id')}::{row.get('attack')}")
+        clusters[key].append(row)
+    keys = sorted(clusters)
+    if len(keys) < 2:
+        return {
+            "unit": "page_artifact",
+            "seed": seed,
+            "resamples": resamples,
+            "cluster_count": len(keys),
+            "gain_percentage_points_interval_95": None,
+            "reason": "fewer_than_two_observed_artifact_clusters",
+        }
+    random_source = random.Random(seed)
+    gains: list[float] = []
+    for _ in range(resamples):
+        sampled_rows: list[Mapping[str, Any]] = []
+        for _cluster in keys:
+            sampled_rows.extend(clusters[random_source.choice(keys)])
+        local = _rate(sampled_rows, "local_soft") or 0.0
+        global_rate = _rate(sampled_rows, "global_soft") or 0.0
+        gains.append(100.0 * (local - global_rate))
+    gains.sort()
+    lower_index = max(0, math.floor(0.025 * (len(gains) - 1)))
+    upper_index = min(len(gains) - 1, math.ceil(0.975 * (len(gains) - 1)))
+    return {
+        "unit": "page_artifact",
+        "seed": seed,
+        "resamples": resamples,
+        "cluster_count": len(keys),
+        "gain_percentage_points_interval_95": [gains[lower_index], gains[upper_index]],
+    }
+
+
+def _is_primary_row(row: Mapping[str, Any]) -> bool:
+    return (
+        row.get("attack") in SOFT_HYPOTHESES
+        and row.get("category") == "original_camera"
+        and row.get("transfer") in {"original", "whatsapp_document"}
+        and row.get("independent_bytes") is True
+    )
+
+
+def _physical_original(row: Mapping[str, Any]) -> bool:
+    return (
+        row.get("category") == "original_camera"
+        and row.get("transfer") in {"original", "whatsapp_document"}
+        and row.get("independent_bytes") is True
+    )
+
+
+def _printer_controls_pass(row: Mapping[str, Any]) -> bool:
+    settings = row.get("printer_settings")
+    if not isinstance(settings, dict):
+        return False
+    printer = str(settings.get("printer", "")).strip().lower()
+    paper = str(settings.get("paper", "")).strip().lower()
+    scale = str(settings.get("scale", "")).strip().lower()
+    normalized_scale = re.sub(r"\s+", "", scale)
+    return (
+        printer == "canon g2020"
+        and "a4" in paper
+        and "plain" in paper
+        and normalized_scale in {"actualsize/100%", "actualsize", "100%"}
+        and settings.get("borderless") is False
+        and settings.get("fit_to_page") is False
+        and settings.get("economy_or_toner_save") is False
+        and _known_text(settings.get("driver"))
+        and _known_text(settings.get("quality"))
+        and _known_text(settings.get("colour"))
+    )
+
+
+def _clipping_observation_pass(row: Mapping[str, Any]) -> bool:
+    settings = row.get("printer_settings")
+    if not isinstance(settings, dict):
+        return False
+    value = settings.get("unprintable_margin_clipping")
+    return isinstance(value, bool) or _known_text(value)
+
+
+def _printer_settings_pass(row: Mapping[str, Any]) -> bool:
+    return _printer_controls_pass(row) and _clipping_observation_pass(row)
+
+
+def _printer_settings_signature(row: Mapping[str, Any]) -> str | None:
+    settings = row.get("printer_settings")
+    if not _printer_controls_pass(row) or not isinstance(settings, dict):
+        return None
+    normalized: dict[str, Any] = {}
+    for key in (
+        "printer",
+        "paper",
+        "scale",
+        "borderless",
+        "fit_to_page",
+        "economy_or_toner_save",
+        "driver",
+        "quality",
+        "colour",
+    ):
+        value = settings.get(key)
+        normalized[key] = value.strip().lower() if isinstance(value, str) else value
+    return _sha256_json(normalized)
+
+
+def _diagnostic_parent_errors(rows: Sequence[Mapping[str, Any]]) -> list[str]:
+    originals_by_sha: dict[str, list[Mapping[str, Any]]] = defaultdict(list)
+    for row in rows:
+        capture_sha = row.get("capture_sha256")
+        if (
+            _physical_original(row)
+            and isinstance(capture_sha, str)
+            and SHA256_RE.fullmatch(capture_sha)
+        ):
+            originals_by_sha[capture_sha].append(row)
+
+    errors: list[str] = []
+    for row in rows:
+        if row.get("category") not in DIAGNOSTIC_CATEGORIES:
+            continue
+        parent_sha = row.get("parent_capture_sha256")
+        candidates = originals_by_sha.get(str(parent_sha), [])
+        matching = []
+        for parent in candidates:
+            parent_content = str(parent.get("content_id") or parent.get("source_id"))
+            row_content = str(row.get("content_id") or row.get("source_id"))
+            if (
+                parent.get("sheet_id") == row.get("sheet_id")
+                and parent_content == row_content
+                and parent.get("attack") == "single"
+                and parent.get("view") == "front"
+                and isinstance(parent.get("phone"), dict)
+                and parent["phone"].get("role") == "phone_a"
+                and row.get("attack") == parent.get("attack")
+                and row.get("view") == parent.get("view")
+                and _phone_identity_tuple(row.get("phone"))
+                == _phone_identity_tuple(parent.get("phone"))
+            ):
+                matching.append(parent)
+        if len(matching) != 1:
+            errors.append(str(row.get("request_id")))
+    return sorted(errors)
+
+
+def _heldout_coverage(rows: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    primary = [row for row in rows if _is_primary_row(row)]
+    primary_attacks = Counter(row.get("attack") for row in primary)
+    phone_roles = Counter(
+        row.get("phone", {}).get("role")
+        for row in primary
+        if isinstance(row.get("phone"), dict)
+    )
+    views = Counter(row.get("view") for row in primary)
+    c5 = sum(row.get("attack") in {"average_5", "interleave_5"} for row in primary)
+    artifacts = {
+        str(row.get("artifact_id") or f"{row.get('source_id')}::{row.get('attack')}")
+        for row in primary
+    }
+    content_ids = {
+        str(row.get("content_id") or row.get("source_id")) for row in primary
+    }
+    expected_cells = {
+        (phone, view)
+        for phone in ("phone_a", "phone_b")
+        for view in ("front", "approx_20deg")
+    }
+    artifact_groups: dict[str, list[Mapping[str, Any]]] = defaultdict(list)
+    for row in primary:
+        artifact_groups[
+            str(row.get("artifact_id") or f"{row.get('source_id')}::{row.get('attack')}")
+        ].append(row)
+    primary_matrix_errors: list[str] = []
+    for artifact_id, artifact_rows in sorted(artifact_groups.items()):
+        cells = [
+            (
+                row.get("phone", {}).get("role")
+                if isinstance(row.get("phone"), dict)
+                else None,
+                row.get("view"),
+            )
+            for row in artifact_rows
+        ]
+        if len(cells) != 4 or set(cells) != expected_cells or len(set(cells)) != len(cells):
+            primary_matrix_errors.append(artifact_id)
+    content_attack_cells = Counter(
+        (str(row.get("content_id") or row.get("source_id")), str(row.get("attack")))
+        for row in primary
+    )
+    content_attack_errors = [
+        f"{content}:{attack}:{content_attack_cells[(content, attack)]}/4"
+        for content in sorted(content_ids)
+        for attack in SOFT_HYPOTHESES
+        if content_attack_cells[(content, attack)] != 4
+    ]
+    page_width_failures = sum(not _page_width_pass(row) for row in primary)
+    unmarked_controls = [
+        row
+        for row in rows
+        if row.get("attack") == "unmarked" and _physical_original(row)
+    ]
+    printer_setting_failures = sum(
+        not _printer_settings_pass(row) for row in [*primary, *unmarked_controls]
+    )
+    unmarked_by_content: dict[str, list[Mapping[str, Any]]] = defaultdict(list)
+    for row in unmarked_controls:
+        unmarked_by_content[str(row.get("content_id") or row.get("source_id"))].append(row)
+    unmarked_matrix_errors: list[str] = []
+    for content in sorted(content_ids):
+        control_rows = unmarked_by_content.get(content, [])
+        cells = [
+            (
+                row.get("phone", {}).get("role")
+                if isinstance(row.get("phone"), dict)
+                else None,
+                row.get("view"),
+            )
+            for row in control_rows
+        ]
+        if len(cells) != 4 or set(cells) != expected_cells or len(set(cells)) != len(cells):
+            unmarked_matrix_errors.append(content)
+    diagnostic_counts = Counter()
+    diagnostic_design_errors = _diagnostic_parent_errors(rows)
+    for row in rows:
+        category = row.get("category")
+        if category == "jpeg_diagnostic":
+            diagnostic_counts["jpeg"] += 1
+        elif category == "donor_overlay":
+            diagnostic_counts["donor_overlay"] += 1
+        elif category in {"wrong_key", "wrong_context", "wrong_source"}:
+            diagnostic_counts[category] += 1
+    diagnostic_content_errors: list[str] = []
+    for diagnostic in ("wrong_key", "wrong_context", "wrong_source", "jpeg", "donor_overlay"):
+        matching = []
+        for row in rows:
+            category = row.get("category")
+            normalized = (
+                "jpeg"
+                if category == "jpeg_diagnostic"
+                else "donor_overlay"
+                if category == "donor_overlay"
+                else category
+            )
+            if normalized == diagnostic:
+                matching.append(row)
+        diagnostic_contents = [
+            str(row.get("content_id") or row.get("source_id")) for row in matching
+        ]
+        if (
+            len(diagnostic_contents) != 6
+            or set(diagnostic_contents) != content_ids
+            or len(set(diagnostic_contents)) != len(diagnostic_contents)
+        ):
+            diagnostic_content_errors.append(diagnostic)
+    missing: list[str] = []
+    if len(primary) != 96:
+        missing.append(f"primary_captures:{len(primary)}/96")
+    if len(artifacts) != 24:
+        missing.append(f"primary_artifacts:{len(artifacts)}/24")
+    if len(content_ids) != 6:
+        missing.append(f"heldout_contents:{len(content_ids)}/6")
+    if primary_matrix_errors:
+        missing.append(
+            "primary_artifact_phone_view_matrix:" + ",".join(primary_matrix_errors)
+        )
+    if content_attack_errors:
+        missing.append("content_attack_matrix:" + ",".join(content_attack_errors))
+    if c5 != 48:
+        missing.append(f"c5_primary_captures:{c5}/48")
+    for attack in SOFT_HYPOTHESES:
+        if primary_attacks[attack] != 24:
+            missing.append(f"attack_{attack}:{primary_attacks[attack]}/24")
+    for phone in ("phone_a", "phone_b"):
+        if phone_roles[phone] != 48:
+            missing.append(f"{phone}:{phone_roles[phone]}/48")
+    for view in ("front", "approx_20deg"):
+        if views[view] != 48:
+            missing.append(f"view_{view}:{views[view]}/48")
+    if len(unmarked_controls) != 24:
+        missing.append(f"unmarked_physical_controls:{len(unmarked_controls)}/24")
+    if unmarked_matrix_errors:
+        missing.append(
+            "unmarked_phone_view_matrix:" + ",".join(unmarked_matrix_errors)
+        )
+    for diagnostic in ("wrong_key", "wrong_context", "wrong_source", "jpeg", "donor_overlay"):
+        if diagnostic_counts[diagnostic] != 6:
+            missing.append(f"diagnostic_{diagnostic}:{diagnostic_counts[diagnostic]}/6")
+    if diagnostic_content_errors:
+        missing.append(
+            "diagnostic_content_matrix:" + ",".join(diagnostic_content_errors)
+        )
+    if diagnostic_design_errors:
+        missing.append(
+            "diagnostic_base_design:" + ",".join(sorted(diagnostic_design_errors))
+        )
+    if page_width_failures:
+        missing.append(
+            f"projected_page_width_unverified_or_below_1600:{page_width_failures}"
+        )
+    if printer_setting_failures:
+        missing.append(f"printer_settings_missing_or_noncanonical:{printer_setting_failures}")
+    return {
+        "complete": not missing,
+        "missing": missing,
+        "primary_rows": primary,
+        "observed_primary_captures": len(primary),
+        "observed_primary_artifacts": len(artifacts),
+        "observed_heldout_contents": len(content_ids),
+        "observed_c5_primary_captures": c5,
+        "primary_by_attack": dict(sorted(primary_attacks.items())),
+        "primary_by_phone": dict(sorted(phone_roles.items())),
+        "primary_by_view": dict(sorted(views.items())),
+        "unmarked_physical_controls": len(unmarked_controls),
+        "diagnostics": dict(sorted(diagnostic_counts.items())),
+        "page_width_envelope_failure_count": page_width_failures,
+        "printer_setting_failure_count": printer_setting_failures,
+        "primary_matrix_error_count": len(primary_matrix_errors) + len(content_attack_errors),
+        "unmarked_matrix_error_count": len(unmarked_matrix_errors),
+        "diagnostic_content_matrix_error_count": len(diagnostic_content_errors),
+        "diagnostic_base_design_error_count": len(diagnostic_design_errors),
+    }
+
+
+def _phone_b_gate(primary: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    rows = [
+        row
+        for row in primary
+        if isinstance(row.get("phone"), dict) and row["phone"].get("role") == "phone_b"
+    ]
+    models = {
+        (str(row["phone"].get("make", "unknown")), str(row["phone"].get("model", "unknown")))
+        for row in rows
+    }
+    model_known = bool(rows) and all(_known_text(make) and _known_text(model) for make, model in models)
+    phone_a_rows = [
+        row
+        for row in primary
+        if isinstance(row.get("phone"), dict) and row["phone"].get("role") == "phone_a"
+    ]
+
+    def identity_evidence(
+        selected: Sequence[Mapping[str, Any]],
+    ) -> tuple[str | None, set[tuple[str, ...]]]:
+        if not selected:
+            return None, set()
+        device_ids = [row["phone"].get("device_id") for row in selected]
+        if all(_known_text(value) for value in device_ids):
+            return "device_id", {("device_id", str(value).strip().lower()) for value in device_ids}
+        if any(_known_text(value) for value in device_ids):
+            return "mixed", set()
+        if all(
+            _known_text(row["phone"].get("make"))
+            and _known_text(row["phone"].get("model"))
+            for row in selected
+        ):
+            return (
+                "make_model",
+                {
+                    (
+                        "make_model",
+                        str(row["phone"]["make"]).strip().lower(),
+                        str(row["phone"]["model"]).strip().lower(),
+                    )
+                    for row in selected
+                },
+            )
+        return None, set()
+
+    phone_a_mode, phone_a_identities = identity_evidence(phone_a_rows)
+    phone_b_mode, phone_b_identities = identity_evidence(rows)
+    identity_evidence_comparable = bool(
+        phone_a_mode in {"device_id", "make_model"}
+        and phone_a_mode == phone_b_mode
+        and len(phone_a_identities) == 1
+        and len(phone_b_identities) == 1
+    )
+    distinct_from_phone_a = bool(
+        identity_evidence_comparable
+        and phone_a_identities
+        and phone_b_identities
+        and phone_a_identities.isdisjoint(phone_b_identities)
+    )
+    success_rate = _rate(rows, "local_soft")
+    return {
+        "observed_captures": len(rows),
+        "recorded_make_models": [list(value) for value in sorted(models)],
+        "model_known": model_known,
+        "phone_a_identity_mode": phone_a_mode,
+        "phone_b_identity_mode": phone_b_mode,
+        "identity_evidence_comparable": identity_evidence_comparable,
+        "distinct_from_phone_a": distinct_from_phone_a,
+        "success_rate": success_rate,
+        "passes_75_percent": bool(
+            model_known
+            and distinct_from_phone_a
+            and success_rate is not None
+            and success_rate >= 0.75
+        ),
+    }
+
+
+def _phone_role_metadata(
+    rows: Sequence[Mapping[str, Any]], role: str
+) -> dict[str, Any]:
+    selected = [
+        row
+        for row in rows
+        if isinstance(row.get("phone"), dict) and row["phone"].get("role") == role
+    ]
+    make_models = {
+        (str(row["phone"].get("make", "unknown")), str(row["phone"].get("model", "unknown")))
+        for row in selected
+    }
+    known = bool(selected) and all(
+        _known_text(make) and _known_text(model) for make, model in make_models
+    )
+    return {
+        "role": role,
+        "observed": len(selected),
+        "recorded_make_models": [list(value) for value in sorted(make_models)],
+        "model_known": known,
+    }
+
