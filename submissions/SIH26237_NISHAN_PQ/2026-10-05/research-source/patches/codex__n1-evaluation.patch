+                    f"manifest.sheets[{index}].page_points must be two positive finite values"
+                )
+            normalized["page_points"] = [float(value) for value in page_points]
+        if "original_source_sha256" in sheet:
+            original_sha = sheet["original_source_sha256"]
+            normalized["original_source_sha256"] = (
+                None
+                if original_sha is None
+                else _require_sha256(
