+from __future__ import annotations
+
+import hashlib
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+from research.n1_v2 import coupon_calibration as coupon
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+class CouponFixture:
+    def __init__(self, root: Path) -> None:
+        self.root = root
+        root.mkdir(parents=True, exist_ok=True)
+        height = width = 240
+        y, x = np.indices((height, width))
+        reference = np.empty((height, width, 3), dtype=np.uint8)
+        base = ((3 * x + 5 * y) % 176 + 40).astype(np.uint8)
+        reference[:] = base[..., None]
+        reference[4:12, :] = 0
+        reference[-12:-4, :] = 255
+        reference[:, 4:12] = 0
+        reference[:, -12:-4] = 255
+        reference[18:22, 18:218] = 20
+        reference[18:218, 18:22] = 20
+
+        regions = []
+        signal = reference.astype(np.int16)
+        tone_values = {"black": 0, "gray": 128, "white": 255}
+        for block_index, block in enumerate((6, 12, 24)):
+            for tone_index, tone in enumerate(("black", "gray", "white")):
+                x0 = 36 + tone_index * 64
+                y0 = 36 + block_index * 64
+                x1, y1 = x0 + 40, y0 + 40
+                reference[y0:y1, x0:x1] = tone_values[tone]
+                checker = ((np.indices((40, 40)).sum(axis=0) // max(1, block // 3)) % 2) * 2 - 1
+                proposed = np.repeat((checker * 4)[..., None], 3, axis=2)
+                marked = np.clip(
+                    reference[y0:y1, x0:x1].astype(np.int16) + proposed, 0, 255
+                )
+                delta = marked - reference[y0:y1, x0:x1].astype(np.int16)
+                signal[y0:y1, x0:x1] = marked
+                template_path = root / f"delta-{block}-{tone}.npy"
+                np.save(template_path, delta.astype(np.int16), allow_pickle=False)
+                regions.append(
+                    {
+                        "region_id": f"b{block}-{tone}",
+                        "reference_bbox_px_144": [x0, y0, x1, y1],
+                        "block_px": block,
+                        "source_tone": {
+                            "name": tone,
+                            "rgb": [tone_values[tone]] * 3,
+                        },
+                        "strength": 4.0,
+                        "delta_template_path": template_path.name,
+                        "delta_template_sha256": _sha(template_path),
+                        "delta_template_dtype": "int16",
+                        "delta_template_shape": [40, 40, 3],
+                    }
+                )
+        self.reference = root / "coupon-C0.png"
+        self.signal = root / "coupon-C1-observed.png"
+        self.control = root / "coupon-C0-observed.png"
+        Image.fromarray(reference).save(self.reference)
+        Image.fromarray(np.clip(signal, 0, 255).astype(np.uint8)).save(self.signal)
+        Image.fromarray(reference).save(self.control)
+        descriptor = {
+            "schema": "nishan.n1-coupon-regions/v2",
+            "sheet_id": "C1",
+            "control_sheet_id": "C0",
+            "reference_image": {
+                "path": self.reference.name,
+                "sha256": _sha(self.reference),
+                "width": width,
+                "height": height,
+                "dpi": 144,
+            },
+            "geometry_anchors": {
+                "printable_area_rectangle": {"documented": True},
+                "scale_bar_100mm": {"documented": True},
+                "square_20mm": {"documented": True},
+                "crosshairs": {"documented": True},
+            },
+            "regions": regions,
+        }
+        self.descriptor = root / "coupon_regions.json"
+        self.descriptor.write_text(json.dumps(descriptor, indent=2) + "\n", encoding="utf-8")
+
+
+class CouponCalibrationTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temp = tempfile.TemporaryDirectory()
+        self.fixture = CouponFixture(Path(self.temp.name))
+
+    def tearDown(self) -> None:
+        self.temp.cleanup()
+
+    def test_known_clean_amplitude_and_zero_unmarked_control(self) -> None:
+        result = coupon.measure_coupon(
+            self.fixture.descriptor,
+            self.fixture.signal,
+            control_capture_path=self.fixture.control,
+        )
+        self.assertEqual(result["status"], "measured")
+        self.assertEqual(result["pair_status"], "matched")
+        signal_gains = [
+            row["measured_modulation_gain"]
+            for row in result["signal_regions"]
+            if row["status"] == "measured"
+        ]
+        control_gains = [
+            row["measured_modulation_gain"]
+            for row in result["control_regions"]
+            if row["status"] == "measured"
+        ]
+        self.assertGreater(min(signal_gains), 0.9)
+        self.assertLess(max(abs(value) for value in control_gains), 0.05)
+        for region in [*result["signal_regions"], *result["control_regions"]]:
+            if region["status"] == "measured":
+                uncertainty = region["modulation_uncertainty"]
+                self.assertEqual(uncertainty["status"], "conditional_diagnostic")
+                self.assertEqual(len(uncertainty["interval_95"]), 2)
+                self.assertIn("registration error", uncertainty["claim_limit"])
+        for region in result["paired_regions"]:
+            self.assertEqual(
+                region["signal_minus_control_uncertainty"]["status"],
+                "conditional_diagnostic",
+            )
+        self.assertIsNone(result["automatic_stop_decision"])
+        self.assertFalse(result["known_coupon_used_for_attribution"])
+
+    def test_saturated_flat_capture_is_inconclusive(self) -> None:
+        saturated = self.fixture.root / "saturated.png"
+        Image.fromarray(np.full((240, 240, 3), 255, dtype=np.uint8)).save(saturated)
+        result = coupon.measure_coupon(self.fixture.descriptor, saturated)
+        self.assertEqual(result["status"], "inconclusive")
+        self.assertIn("registration", result["reason"])
+
+    def test_degenerate_template_is_retained_as_region_inconclusive(self) -> None:
+        descriptor = json.loads(self.fixture.descriptor.read_text(encoding="utf-8"))
+        region = descriptor["regions"][0]
+        template_path = self.fixture.root / region["delta_template_path"]
+        np.save(template_path, np.zeros((40, 40, 3), dtype=np.int16), allow_pickle=False)
+        region["delta_template_sha256"] = _sha(template_path)
+        self.fixture.descriptor.write_text(
+            json.dumps(descriptor, indent=2) + "\n", encoding="utf-8"
+        )
+        result = coupon.measure_coupon(self.fixture.descriptor, self.fixture.signal)
+        target = next(
+            row for row in result["signal_regions"] if row["region_id"] == region["region_id"]
+        )
+        self.assertEqual(target["status"], "inconclusive")
+        self.assertIn("degenerate", target["reason"])
+
+
+if __name__ == "__main__":
+    unittest.main()
