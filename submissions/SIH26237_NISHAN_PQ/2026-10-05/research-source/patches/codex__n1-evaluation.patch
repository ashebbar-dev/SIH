+        )
+        if _sha256_file(pdf_path) != pdf_sha:
+            raise StudyValidationError(f"sheet hash mismatch: {sheet_id}")
+        if _sha256_file(source_path) != source_sha:
+            raise StudyValidationError(f"source hash mismatch: {sheet_id}")
+        referenced_paths.update(
+            {_pack_relative(root, pdf_path), _pack_relative(root, source_path)}
+        )
+        normalized = {
+            "sheet_id": sheet_id,
+            "kind": kind,
+            "source_id": source_id,
+            "pdf": str(pdf_path),
+            "sha256": pdf_sha,
+            "source_pdf": str(source_path),
+            "source_sha256": source_sha,
+            "content_id": sheet.get("content_id", source_id),
+            "artifact_id": sheet.get("artifact_id", sheet_id),
+        }
+        for optional_id in ("content_id", "artifact_id"):
+            _require_string(normalized[optional_id], f"manifest.sheets[{index}].{optional_id}", pattern=ID_RE)
+        if "pair_id" in sheet:
+            normalized["pair_id"] = _require_string(
+                sheet["pair_id"], f"manifest.sheets[{index}].pair_id", pattern=ID_RE
+            )
+        if "carrier_scope" in sheet:
