+                raise StudyValidationError(f"duplicate source provenance for {source_id}")
+            seen_provenance_sources.add(source_id)
+            changed_path = _resolve_pack_path(
+                root,
+                entry["changed_source_pdf"],
+                f"manifest.source_provenance[{index}].changed_source_pdf",
+            )
+            changed_sha = _require_sha256(
+                entry["changed_source_sha256"],
+                f"manifest.source_provenance[{index}].changed_source_sha256",
+            )
+            if _sha256_file(changed_path) != changed_sha:
+                raise StudyValidationError(f"changed source provenance hash mismatch for {source_id}")
+            referenced_paths.add(_pack_relative(root, changed_path))
+            page_points = _require_list(
+                entry["page_points"], f"manifest.source_provenance[{index}].page_points"
+            )
+            if len(page_points) != 2 or any(
+                isinstance(value, bool)
+                or not isinstance(value, (int, float))
+                or not math.isfinite(float(value))
+                or float(value) <= 0.0
+                for value in page_points
+            ):
+                raise StudyValidationError(
+                    f"manifest.source_provenance[{index}].page_points is invalid"
+                )
+            _require_string(
+                entry["calibration_status"],
+                f"manifest.source_provenance[{index}].calibration_status",
+                pattern=ID_RE,
+            )
+            if "original_repo_path" in entry:
+                original_path = Path(
+                    _require_string(
+                        entry["original_repo_path"],
+                        f"manifest.source_provenance[{index}].original_repo_path",
+                    )
+                )
+                if original_path.is_absolute() or ".." in original_path.parts:
+                    raise StudyValidationError("original_repo_path must be safe repository metadata")
+            if "original_sha256" in entry:
+                _require_sha256(
+                    entry["original_sha256"],
+                    f"manifest.source_provenance[{index}].original_sha256",
+                )
+            for object_key in ("named_source_label_packaging_change", "embedded_font"):
+                if object_key in entry and not isinstance(entry[object_key], dict):
+                    raise StudyValidationError(
+                        f"manifest.source_provenance[{index}].{object_key} must be an object"
+                    )
+            if "regions" in entry and not isinstance(entry["regions"], list):
+                raise StudyValidationError(
+                    f"manifest.source_provenance[{index}].regions must be a list"
+                )
+            if "preserved_nonlabel_word_count" in entry and (
+                isinstance(entry["preserved_nonlabel_word_count"], bool)
+                or not isinstance(entry["preserved_nonlabel_word_count"], int)
+                or entry["preserved_nonlabel_word_count"] < 0
+            ):
+                raise StudyValidationError("preserved_nonlabel_word_count must be nonnegative")
+
+    coupon_regions_path: Path | None = None
+    coupon_regions_sha: str | None = None
+    coupon_descriptor: Mapping[str, Any] | None = None
+    if ("coupon_regions_file" in manifest) != ("coupon_regions_sha256" in manifest):
+        raise StudyValidationError(
+            "coupon_regions_file and coupon_regions_sha256 must be declared together"
+        )
+    if "coupon_regions_file" in manifest:
+        coupon_regions_path = _resolve_pack_path(
+            root, manifest["coupon_regions_file"], "manifest.coupon_regions_file"
+        )
+        coupon_regions_sha = _require_sha256(
+            manifest["coupon_regions_sha256"], "manifest.coupon_regions_sha256"
+        )
+        if _sha256_file(coupon_regions_path) != coupon_regions_sha:
+            raise StudyValidationError("coupon-region descriptor hash mismatch")
+        try:
+            from research.n1_v2 import coupon_calibration
+
+            coupon_descriptor = coupon_calibration.validate_descriptor(coupon_regions_path)
+        except (ImportError, ValueError) as exc:
+            raise StudyValidationError(f"invalid coupon-region descriptor: {exc}") from exc
+        referenced_paths.add(_pack_relative(root, coupon_regions_path))
+        referenced_paths.add(
+            _pack_relative(root, Path(coupon_descriptor["reference_image"]["path"]))
+        )
+        for region in coupon_descriptor["regions"]:
+            referenced_paths.add(_pack_relative(root, Path(region["delta_template_path"])))
+    if split == "calibration" and coupon_regions_path is None:
+        raise StudyValidationError(
+            "calibration manifest requires coupon_regions_file and coupon_regions_sha256"
+        )
+
+    artifact_count = None
+    if "artifacts" in manifest:
+        artifact_count = _validate_artifact_inventory(
+            manifest["artifacts"], root, referenced_paths
+        )
+
+    return {
+        "schema": PACK_SCHEMA,
+        "manifest_path": str(path),
+        "manifest_sha256": _sha256_file(path),
+        "pack_id": pack_id,
+        "split": split,
+        "carrier": carrier,
+        "context": context,
+        "sheet_count": len(sheets),
+        "sheets": sheets,
+        "labels_path": str(labels_path),
+        "labels_sha256": labels_sha,
+        "labels": labels,
+        "coupon_regions_path": str(coupon_regions_path) if coupon_regions_path else None,
+        "coupon_regions_sha256": coupon_regions_sha,
+        "artifact_count": artifact_count,
