+
+    labels_path = _resolve_pack_path(root, manifest["labels_file"], "manifest.labels_file")
+    labels_sha = _require_sha256(manifest["labels_sha256"], "manifest.labels_sha256")
+    if _sha256_file(labels_path) != labels_sha:
+        raise StudyValidationError("evaluator labels hash mismatch")
+    referenced_paths.add(_pack_relative(root, labels_path))
+    labels = _validate_labels(labels_path, seen_ids, kinds) if open_labels else None
+    if labels is not None:
+        _validate_split_matrix(split, sheets, labels)
+
+    for hash_key in ("protocol_sha256", "configuration_sha256", "implementation_sha256"):
+        if hash_key in manifest:
+            _require_sha256(manifest[hash_key], f"manifest.{hash_key}")
+    for text_key in ("created_at", "notes"):
