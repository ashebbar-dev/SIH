+class FakeReceiver:
+    def __init__(
+        self,
+        config_path: Path,
+        mutate_config: bool = False,
+        post_prepare_mutation: Callable[[], None] | None = None,
+    ) -> None:
+        self.config_path = config_path
+        self.mutate_config = mutate_config
+        self.post_prepare_mutation = post_prepare_mutation
+        self.requests: list[dict] = []
+        self.score_calls = 0
+
+    def prepare_request(self, request: dict, output_directory: str) -> dict:
+        forbidden = {
+            "attack",
+            "contributors",
+            "expected_row",
+            "kind",
+            "sheet_kind",
+            "split",
+            "source_watermark_variant",
+            "output_verdict",
+        }
+        if forbidden.intersection(request):
+            raise AssertionError("evaluator labels leaked into preparation")
+        self.requests.append(json.loads(json.dumps(request)))
+        output = Path(output_directory)
+        output.mkdir()
+        biases = np.asarray([0.25, 0.75], dtype=np.float32)
+        np.savez_compressed(output / "evidence.npz", biases=biases)
+        prepared = {
+            "schema": "nishan.n1-prepared/v2",
+            "status": "prepared",
+            "request_id": request["request_id"],
+            "carrier": dict(study.EXPECTED_CARRIER),
+            "input_sha256": {
+                "source_pdf": request["source_sha256"],
+                "capture_path": request["capture_sha256"],
+            },
+            "receiver_config_sha256": _sha(self.config_path),
+            "code_sha256": _fake_code_hashes(_sha(self.config_path)),
+            "context_commitment": _fake_context_commitment(request["context"]),
+            "registration": {"hard_gate_passed": True},
+            "array_sha256": {"biases": _array_sha(biases)},
+            "evidence_sha256": _sha(output / "evidence.npz"),
+            "profiles": {
+                key: {"status": "prepared"}
+                for key in ("hard", "global_soft", "local_soft")
+            },
+        }
+        prepared["implementation_sha256"] = _implementation_sha(prepared["code_sha256"])
+        prepared["commitment"] = hashlib.sha256(
+            json.dumps(
+                {
+                    "schema": prepared["schema"],
+                    "request_id": prepared["request_id"],
+                    "receiver_config_sha256": prepared["receiver_config_sha256"],
+                    "input_sha256": prepared["input_sha256"],
+                    "context_commitment": prepared["context_commitment"],
+                    "implementation_sha256": prepared["implementation_sha256"],
+                    "array_sha256": prepared["array_sha256"],
+                    "evidence_sha256": prepared["evidence_sha256"],
+                },
+                sort_keys=True,
+                separators=(",", ":"),
+            ).encode()
+        ).hexdigest()
+        _write_json(output / "prepared.json", prepared)
+        _write_json(
+            output / "commitment.json",
+            {
+                "schema": "nishan.n1-prepared-commitment/v2",
+                "sha256": {
+                    "prepared.json": _sha(output / "prepared.json"),
+                    "evidence.npz": _sha(output / "evidence.npz"),
+                },
+                "receiver_config_sha256": prepared["receiver_config_sha256"],
+                "input_sha256": prepared["input_sha256"],
+            },
+        )
+        if self.mutate_config:
+            self.config_path.write_text('{"changed": true}\n', encoding="utf-8")
+        if self.post_prepare_mutation is not None:
+            self.post_prepare_mutation()
+            self.post_prepare_mutation = None
+        return prepared
+
+    def score_prepared(
+        self, prepared_directory: str, family_alpha: float, hypothesis_count: int
+    ) -> dict:
+        self.score_calls += 1
+        prepared_path = Path(prepared_directory) / "prepared.json"
+        prepared = json.loads(prepared_path.read_text(encoding="utf-8"))
+        result = _score_result(
+            _sha(self.config_path),
+            prepared["input_sha256"],
+            _sha(prepared_path),
+            request_id=prepared["request_id"],
+            prepared_commitment=prepared["commitment"],
+        )
+        for profile in result["profiles"].values():
+            for hypothesis in profile["hypotheses"].values():
+                hypothesis["calibration"]["family_alpha"] = family_alpha
+                hypothesis["calibration"]["hypothesis_count"] = hypothesis_count
+        result["family_alpha"] = family_alpha
+        result["hypothesis_count"] = hypothesis_count
+        return result
+
