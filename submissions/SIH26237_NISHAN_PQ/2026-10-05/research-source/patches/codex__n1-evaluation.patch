+        source_id = _require_string(
+            sheet["source_id"], f"manifest.sheets[{index}].source_id", pattern=ID_RE
+        )
+        pdf_path = _resolve_pack_path(root, sheet["pdf"], f"manifest.sheets[{index}].pdf")
+        source_path = _resolve_pack_path(
