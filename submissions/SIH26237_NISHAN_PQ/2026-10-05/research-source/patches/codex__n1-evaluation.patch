+    def test_raw_ber_uses_committed_hard_arrays_and_reports_conditional_uncertainty(self) -> None:
+        prepared_directory = self.root / "raw-ber-prepared"
+        prepared_directory.mkdir()
+        expected_word = (np.arange(study.EXPECTED_CARRIER["m"]) % 2).astype(np.uint8)
+        hard_word = expected_word.copy()
+        hard_erased = np.zeros(hard_word.shape, dtype=bool)
+        hard_erased[:20] = True
+        hard_word[20:30] ^= 1
+        biases = np.linspace(0.01, 0.99, hard_word.size, dtype=np.float64)
+        evidence_path = prepared_directory / "evidence.npz"
+        np.savez_compressed(
+            evidence_path,
+            hard_word=hard_word,
+            hard_erased=hard_erased,
+            biases=biases,
+        )
+        prepared = {
+            "profiles": {
+                "hard": {
+                    "status": "prepared",
+                    "word_key": "hard_word",
+                    "erased_key": "hard_erased",
+                }
+            },
+            "scoring_context": {
+                "public_fixture_secret_hex": "a" * 64,
+                "codebook_context": "known-synthetic-row-test",
+            },
+            "array_sha256": {
+                "hard_word": _array_sha(hard_word),
+                "hard_erased": _array_sha(hard_erased),
+                "biases": _array_sha(biases),
+            },
+            "evidence_sha256": _sha(evidence_path),
+            "commitment": "7" * 64,
+        }
+        codebook = np.broadcast_to(expected_word, (1000, expected_word.size))
+        cache = {("a" * 64, "known-synthetic-row-test"): (biases, codebook)}
+        measurement = study._labelled_raw_ber(
+            prepared, prepared_directory, 17, cache
+        )
+        self.assertEqual(measurement["status"], "measured")
+        self.assertEqual(measurement["compared_symbols"], hard_word.size - 20)
+        self.assertEqual(measurement["mismatched_symbols"], 10)
+        self.assertAlmostEqual(
+            measurement["raw_ber"], 10 / (hard_word.size - 20)
+        )
+        self.assertEqual(
+            measurement["uncertainty"]["status"], "conditional_diagnostic"
+        )
+        self.assertFalse(measurement["used_for_receiver_fitting_or_scoring"])
