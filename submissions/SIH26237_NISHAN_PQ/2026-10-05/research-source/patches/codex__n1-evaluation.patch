+
+class StudyValidationError(ValueError):
+    """Input fails a schema, hash, path, or coverage gate."""
+
+
+class CommitmentError(RuntimeError):
+    """A committed input changed across the preparation/scoring boundary."""
+
+
+def _reject_duplicate_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise StudyValidationError(f"duplicate JSON key: {key}")
+        result[key] = value
+    return result
+
+
+def _load_json(path: Path, *, description: str) -> Any:
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError as exc:
+        raise StudyValidationError(f"cannot read {description} {path}: {exc}") from exc
+    try:
+        return json.loads(text, object_pairs_hook=_reject_duplicate_pairs)
+    except (json.JSONDecodeError, StudyValidationError) as exc:
+        raise StudyValidationError(f"invalid {description} JSON {path}: {exc}") from exc
+
+
+def _canonical_json_bytes(value: Any) -> bytes:
+    return json.dumps(
+        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
+    ).encode("utf-8")
+
+
+def _sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    try:
+        with path.open("rb") as handle:
+            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+                digest.update(chunk)
+    except OSError as exc:
+        raise StudyValidationError(f"cannot hash {path}: {exc}") from exc
+    return digest.hexdigest()
+
+
+def _sha256_json(value: Any) -> str:
+    return hashlib.sha256(_canonical_json_bytes(value)).hexdigest()
+
+
+def _sha256_array(value: np.ndarray) -> str:
+    array = np.ascontiguousarray(value)
+    prefix = json.dumps(
+        [list(array.shape), array.dtype.str], separators=(",", ":")
+    ).encode("utf-8")
+    return hashlib.sha256(prefix + array.tobytes()).hexdigest()
+
+
+def _utc_now() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
+
+
+def _require_dict(value: Any, field: str) -> dict[str, Any]:
+    if not isinstance(value, dict):
+        raise StudyValidationError(f"{field} must be an object")
+    return value
+
+
+def _require_list(value: Any, field: str) -> list[Any]:
+    if not isinstance(value, list):
+        raise StudyValidationError(f"{field} must be a list")
+    return value
+
+
+def _require_keys(
+    value: Mapping[str, Any], required: set[str], allowed: set[str], field: str
+) -> None:
+    missing = sorted(required - value.keys())
+    unknown = sorted(value.keys() - allowed)
+    if missing:
+        raise StudyValidationError(f"{field} missing required keys: {', '.join(missing)}")
+    if unknown:
+        raise StudyValidationError(f"{field} has undocumented keys: {', '.join(unknown)}")
+
+
+def _require_string(value: Any, field: str, *, pattern: re.Pattern[str] | None = None) -> str:
+    if not isinstance(value, str) or not value:
+        raise StudyValidationError(f"{field} must be a non-empty string")
+    if pattern is not None and pattern.fullmatch(value) is None:
+        raise StudyValidationError(f"{field} has an invalid format")
+    return value
+
+
+def _require_sha256(value: Any, field: str) -> str:
+    if not isinstance(value, str) or SHA256_RE.fullmatch(value) is None:
+        raise StudyValidationError(f"{field} must be a lowercase SHA-256 hex digest")
+    return value
+
+
+def _safe_context(value: Any, field: str) -> str:
+    text = _require_string(value, field, pattern=CONTEXT_RE)
+    if text.startswith("/") or ".." in text.split("/") or "//" in text:
+        raise StudyValidationError(f"{field} is not a safe context identifier")
+    return text
+
+
+def _resolve_pack_path(root: Path, value: Any, field: str) -> Path:
+    raw = _require_string(value, field)
+    candidate = Path(raw)
+    if candidate.is_absolute() or ".." in candidate.parts:
+        raise StudyValidationError(f"{field} must be a non-traversing relative path")
+    root_resolved = root.resolve()
+    resolved = (root / candidate).resolve()
+    try:
+        resolved.relative_to(root_resolved)
+    except ValueError as exc:
+        raise StudyValidationError(f"{field} escapes the pack directory") from exc
+    if not resolved.is_file():
+        raise StudyValidationError(f"{field} does not identify a regular file: {resolved}")
+    return resolved
+
+
+def _resolve_capture_path(root: Path, value: Any, field: str) -> Path:
+    raw = _require_string(value, field)
+    candidate = Path(raw)
+    if candidate.is_absolute():
+        resolved = candidate.resolve()
+    else:
+        if ".." in candidate.parts:
+            raise StudyValidationError(f"{field} contains path traversal")
+        root_resolved = root.resolve()
+        resolved = (root / candidate).resolve()
+        try:
+            resolved.relative_to(root_resolved)
+        except ValueError as exc:
+            raise StudyValidationError(f"{field} escapes the capture-list directory") from exc
+    if not resolved.is_file():
+        raise StudyValidationError(f"{field} does not identify a regular file: {resolved}")
+    return resolved
+
+
+def _load_protocol() -> tuple[dict[str, Any], str]:
+    protocol = _require_dict(_load_json(PROTOCOL_PATH, description="study protocol"), "protocol")
+    if protocol.get("schema") != PROTOCOL_SCHEMA:
+        raise StudyValidationError("study protocol schema mismatch")
+    return protocol, _sha256_file(PROTOCOL_PATH)
+
+
+def _validate_carrier(value: Any) -> dict[str, Any]:
+    carrier = _require_dict(value, "manifest.carrier")
+    _require_keys(carrier, set(EXPECTED_CARRIER), set(EXPECTED_CARRIER), "manifest.carrier")
+    for key, expected in EXPECTED_CARRIER.items():
+        actual = carrier[key]
+        if isinstance(actual, bool) or not isinstance(actual, (int, float)) or actual != expected:
+            raise StudyValidationError(
+                f"manifest.carrier.{key} must equal unchanged-profile value {expected!r}"
+            )
+    return dict(carrier)
+
+
+def _validate_context(value: Any) -> dict[str, str]:
+    context = _require_dict(value, "manifest.context")
+    required = {"kind", "codebook_context", "carrier_context"}
+    _require_keys(context, required, required | {"fixture_secret_hex"}, "manifest.context")
+    normalized = {
+        "kind": _safe_context(context["kind"], "manifest.context.kind"),
+        "codebook_context": _safe_context(
+            context["codebook_context"], "manifest.context.codebook_context"
+        ),
+        "carrier_context": _safe_context(
+            context["carrier_context"], "manifest.context.carrier_context"
+        ),
+    }
+    if "fixture_secret_hex" in context:
+        secret = context["fixture_secret_hex"]
+        if not isinstance(secret, str) or re.fullmatch(r"[0-9A-Fa-f]{64}", secret) is None:
+            raise StudyValidationError(
+                "manifest.context.fixture_secret_hex must contain exactly 64 hexadecimal characters"
+            )
+        normalized["fixture_secret_hex"] = secret
+    return normalized
+
+
+def _validate_context_commitment(
+    value: Any, expected_context: Mapping[str, str]
+) -> dict[str, Any]:
+    commitment = _require_dict(value, "prepared.context_commitment")
+    required = {
+        "kind",
+        "codebook_context",
+        "codebook_context_sha256",
+        "carrier_context",
+        "carrier_context_sha256",
+        "fixture_secret_sha256",
+        "fixture_secret_source",
+        "credential_scope",
+        "context_commitment_sha256",
+    }
+    _require_keys(commitment, required, required, "prepared.context_commitment")
+    for key in ("kind", "codebook_context", "carrier_context"):
+        if commitment[key] != expected_context[key]:
+            raise CommitmentError(f"prepared context commitment changed {key}")
+    for key in ("codebook_context", "carrier_context"):
+        expected_hash = hashlib.sha256(expected_context[key].encode("utf-8")).hexdigest()
+        if commitment[f"{key}_sha256"] != expected_hash:
+            raise CommitmentError(f"prepared context commitment hash mismatch: {key}")
+    fixture_sha = _require_sha256(
+        commitment["fixture_secret_sha256"],
+        "prepared.context_commitment.fixture_secret_sha256",
+    )
+    if "fixture_secret_hex" in expected_context:
+        expected_fixture_sha = hashlib.sha256(
+            bytes.fromhex(expected_context["fixture_secret_hex"])
+        ).hexdigest()
+        if fixture_sha != expected_fixture_sha:
+            raise CommitmentError("prepared context commitment changed fixture seed")
+    _require_string(
+        commitment["fixture_secret_source"],
+        "prepared.context_commitment.fixture_secret_source",
+    )
+    _require_string(commitment["credential_scope"], "prepared.context_commitment.credential_scope")
+    declared_commitment = _require_sha256(
+        commitment["context_commitment_sha256"],
+        "prepared.context_commitment.context_commitment_sha256",
+    )
+    canonical_fields = dict(commitment)
+    del canonical_fields["context_commitment_sha256"]
+    if declared_commitment != _sha256_json(canonical_fields):
+        raise CommitmentError("prepared context commitment digest mismatch")
+    return commitment
+
+
+def _validate_labels(
+    path: Path, expected_sheet_ids: set[str], kinds: Mapping[str, str]
+) -> dict[str, dict[str, Any]]:
+    raw = _require_dict(_load_json(path, description="evaluator labels"), "evaluator labels")
+    if set(raw) != expected_sheet_ids:
+        missing = sorted(expected_sheet_ids - raw.keys())
+        extra = sorted(raw.keys() - expected_sheet_ids)
+        raise StudyValidationError(
+            f"evaluator labels/sheets mismatch (missing={missing}, extra={extra})"
+        )
+    labels: dict[str, dict[str, Any]] = {}
+    for sheet_id in sorted(raw):
+        entry = _require_dict(raw[sheet_id], f"labels.{sheet_id}")
+        _require_keys(
+            entry,
+            {"contributors", "attack"},
+            {"contributors", "attack", "diagnostic_class", "notes"},
+            f"labels.{sheet_id}",
+        )
+        contributors = _require_list(entry["contributors"], f"labels.{sheet_id}.contributors")
+        if any(isinstance(row, bool) or not isinstance(row, int) or not 0 <= row < 1000 for row in contributors):
+            raise StudyValidationError(f"labels.{sheet_id}.contributors contains an invalid row")
+        if contributors != sorted(set(contributors)):
+            raise StudyValidationError(
+                f"labels.{sheet_id}.contributors must be sorted and unique"
+            )
+        attack = entry["attack"]
+        if attack not in ATTACKS:
+            raise StudyValidationError(f"labels.{sheet_id}.attack is not a supported attack")
+        expected_count = {"single": 1, "average_2": 2, "average_5": 5, "interleave_5": 5}
+        if attack in expected_count and len(contributors) != expected_count[attack]:
+            raise StudyValidationError(
+                f"labels.{sheet_id} attack {attack} requires {expected_count[attack]} contributors"
+            )
+        if attack == "unmarked" and contributors:
+            raise StudyValidationError(f"labels.{sheet_id} unmarked control has contributors")
+        if kinds[sheet_id] in {"unmarked", "coupon_unmarked"} and contributors:
+            raise StudyValidationError(f"labels.{sheet_id} contradicts unmarked sheet kind")
+        normalized = {"contributors": list(contributors), "attack": attack}
+        if "diagnostic_class" in entry:
+            normalized["diagnostic_class"] = _require_string(
+                entry["diagnostic_class"], f"labels.{sheet_id}.diagnostic_class", pattern=ID_RE
+            )
+        labels[sheet_id] = normalized
+    return labels
+
+
+def _validate_split_matrix(
+    split: str,
+    sheets: Sequence[Mapping[str, Any]],
+    labels: Mapping[str, Mapping[str, Any]],
+) -> None:
+    """Require the reserved validation/held-out printed-artifact matrix."""
+
+    if split not in {"validation", "heldout"}:
+        return
+    contents_expected = 2 if split == "validation" else 6
+    expected = {
+        "single": contents_expected,
+        "average_2": contents_expected,
+        "average_5": contents_expected,
+        "interleave_5": contents_expected,
+        "unmarked": contents_expected,
+    }
+    counts = Counter(label["attack"] for label in labels.values())
+    if counts.get("diagnostic", 0):
+        raise StudyValidationError(
+            f"{split} printed pack must keep derived diagnostics outside the sheet matrix"
+        )
+    if {attack: counts.get(attack, 0) for attack in expected} != expected:
+        raise StudyValidationError(
+            f"{split} manifest must contain {expected}; observed {dict(sorted(counts.items()))}"
+        )
+    if len(sheets) != contents_expected * 5:
+        raise StudyValidationError(
+            f"{split} manifest must contain {contents_expected * 5} printed artifacts"
+        )
+    sources: dict[str, Counter[str]] = defaultdict(Counter)
+    kinds = {sheet["sheet_id"]: sheet["kind"] for sheet in sheets}
+    source_ids = {sheet["sheet_id"]: sheet["source_id"] for sheet in sheets}
+    for sheet_id, label in labels.items():
+        attack = label["attack"]
+        sources[source_ids[sheet_id]][attack] += 1
+        expected_kind = "unmarked" if attack == "unmarked" else "marked"
+        if kinds[sheet_id] != expected_kind:
+            raise StudyValidationError(
+                f"{split} sheet {sheet_id} kind {kinds[sheet_id]} contradicts attack {attack}"
+            )
+    if len(sources) != contents_expected:
+        raise StudyValidationError(
+            f"{split} manifest must reserve {contents_expected} distinct source contents"
+        )
+    for source_id, attacks in sources.items():
+        if any(attacks.get(attack, 0) != 1 for attack in expected):
+            raise StudyValidationError(
+                f"{split} source {source_id} must have one artifact for every attack family and unmarked control"
+            )
+
+
+def _pack_relative(root: Path, path: Path) -> str:
+    return path.resolve().relative_to(root.resolve()).as_posix()
+
+
+def _validate_optional_pack_file_pair(
+    manifest: Mapping[str, Any],
+    root: Path,
+    stem: str,
+    referenced_paths: set[str],
+) -> Path | None:
+    file_key = f"{stem}_file"
+    sha_key = f"{stem}_sha256"
+    if (file_key in manifest) != (sha_key in manifest):
+        raise StudyValidationError(f"manifest.{file_key} and manifest.{sha_key} must be paired")
+    if file_key not in manifest:
+        return None
+    path = _resolve_pack_path(root, manifest[file_key], f"manifest.{file_key}")
+    expected = _require_sha256(manifest[sha_key], f"manifest.{sha_key}")
+    if _sha256_file(path) != expected:
+        raise StudyValidationError(f"manifest.{stem} file hash mismatch")
+    referenced_paths.add(_pack_relative(root, path))
+    return path
+
+
+def _validate_artifact_inventory(
+    value: Any, root: Path, referenced_paths: set[str]
+) -> int:
+    artifacts = _require_list(value, "manifest.artifacts")
+    if not artifacts:
+        raise StudyValidationError("manifest.artifacts must not be empty when declared")
+    inventory_paths: set[str] = set()
+    for index, raw in enumerate(artifacts):
+        artifact = _require_dict(raw, f"manifest.artifacts[{index}]")
+        _require_keys(
+            artifact,
+            {"path", "sha256", "bytes", "role"},
+            {"path", "sha256", "bytes", "role"},
+            f"manifest.artifacts[{index}]",
+        )
+        path = _resolve_pack_path(root, artifact["path"], f"manifest.artifacts[{index}].path")
+        relative = _pack_relative(root, path)
+        if relative in inventory_paths:
+            raise StudyValidationError(f"manifest.artifacts duplicates path {relative}")
+        inventory_paths.add(relative)
+        expected = _require_sha256(
+            artifact["sha256"], f"manifest.artifacts[{index}].sha256"
+        )
+        if _sha256_file(path) != expected:
+            raise StudyValidationError(f"manifest.artifacts hash mismatch for {relative}")
+        byte_count = artifact["bytes"]
+        if isinstance(byte_count, bool) or not isinstance(byte_count, int) or byte_count < 0:
+            raise StudyValidationError(f"manifest.artifacts[{index}].bytes must be nonnegative")
+        if path.stat().st_size != byte_count:
+            raise StudyValidationError(f"manifest.artifacts byte count mismatch for {relative}")
+        _require_string(
+            artifact["role"], f"manifest.artifacts[{index}].role", pattern=ID_RE
+        )
+    missing = sorted(referenced_paths - inventory_paths)
+    if missing:
+        raise StudyValidationError(
+            f"manifest.artifacts omits referenced transferable files: {', '.join(missing)}"
+        )
+    return len(artifacts)
+
+
+def validate_pack(manifest_path: str | os.PathLike[str], *, open_labels: bool = True) -> dict[str, Any]:
+    """Validate the v2 pack, its coupled paths, and all declared hashes.
+
+    ``open_labels=False`` is the preparation-safe mode.  It verifies the label
+    file's bytes but intentionally does not parse evaluator-only content.
+    """
+
+    path = Path(manifest_path).resolve()
+    manifest = _require_dict(_load_json(path, description="pack manifest"), "manifest")
+    required = {
+        "schema",
+        "pack_id",
+        "split",
+        "carrier",
+        "context",
+        "sheets",
+        "labels_file",
+        "labels_sha256",
+    }
+    allowed = required | {
+        "coupon_regions_file",
+        "coupon_regions_sha256",
+        "created_at",
+        "protocol_sha256",
+        "configuration_sha256",
+        "implementation_sha256",
+        "notes",
+        "artifacts",
+        "canon_references",
+        "clean_qa_file",
+        "clean_qa_sha256",
+        "context_sha256",
+        "fixture_seed_sha256",
+        "guide_file",
+        "guide_sha256",
+        "labels_format",
+        "physical_status",
+        "printing_invariant",
+        "public_fixture_file",
+        "public_fixture_sha256",
+        "security_notice",
+        "source_provenance",
+        "visual_qa_file",
+        "visual_qa_sha256",
+    }
+    _require_keys(manifest, required, allowed, "manifest")
+    if manifest["schema"] != PACK_SCHEMA:
+        raise StudyValidationError(f"manifest.schema must be {PACK_SCHEMA}")
+    pack_id = _require_string(manifest["pack_id"], "manifest.pack_id", pattern=ID_RE)
+    split = manifest["split"]
+    if split not in SPLITS:
+        raise StudyValidationError(f"manifest.split must be one of {sorted(SPLITS)}")
+    carrier = _validate_carrier(manifest["carrier"])
+    context = _validate_context(manifest["context"])
+    if "context_sha256" in manifest:
+        context_sha = _require_sha256(manifest["context_sha256"], "manifest.context_sha256")
+        if context_sha != _sha256_json(context):
+            raise StudyValidationError("manifest.context_sha256 does not bind manifest.context")
+    if "fixture_seed_sha256" in manifest:
+        fixture_seed_sha = _require_sha256(
+            manifest["fixture_seed_sha256"], "manifest.fixture_seed_sha256"
+        )
+        if "fixture_secret_hex" in context:
+            expected_seed_sha = hashlib.sha256(bytes.fromhex(context["fixture_secret_hex"])).hexdigest()
+            if fixture_seed_sha != expected_seed_sha:
+                raise StudyValidationError(
+                    "manifest.fixture_seed_sha256 does not bind the public fixture seed"
+                )
+    if "labels_format" in manifest and manifest["labels_format"] != (
+        "plain_sheet_id_mapping_evaluator_only"
+    ):
+        raise StudyValidationError("manifest.labels_format must name the canonical plain mapping")
+    for text_key in ("physical_status", "security_notice"):
+        if text_key in manifest:
+            _require_string(manifest[text_key], f"manifest.{text_key}")
+    if "canon_references" in manifest:
+        references = _require_list(manifest["canon_references"], "manifest.canon_references")
+        if not references or any(not isinstance(item, str) or not item for item in references):
+            raise StudyValidationError("manifest.canon_references must contain non-empty URLs")
+    if "printing_invariant" in manifest:
+        printing = _require_dict(manifest["printing_invariant"], "manifest.printing_invariant")
+        printing_keys = {
+            "paper",
+            "scale",
+            "borderless",
+            "fit_to_page",
+            "economy_or_toner_save",
+            "normal_margin_loss_recorded_not_compensated",
+        }
+        _require_keys(printing, printing_keys, printing_keys, "manifest.printing_invariant")
+        _require_string(printing["paper"], "manifest.printing_invariant.paper")
+        _require_string(printing["scale"], "manifest.printing_invariant.scale")
+        for flag in printing_keys - {"paper", "scale"}:
+            if not isinstance(printing[flag], bool):
+                raise StudyValidationError(f"manifest.printing_invariant.{flag} must be boolean")
+    sheets_raw = _require_list(manifest["sheets"], "manifest.sheets")
+    if not sheets_raw:
+        raise StudyValidationError("manifest.sheets must not be empty")
+    sheet_allowed = {
+        "sheet_id",
+        "kind",
+        "source_id",
+        "pdf",
+        "sha256",
+        "source_pdf",
+        "source_sha256",
+        "content_id",
+        "artifact_id",
+        "notes",
+        "carrier_scope",
+        "original_source_sha256",
+        "page_points",
+        "pair_id",
+    }
+    sheets: list[dict[str, Any]] = []
+    seen_ids: set[str] = set()
+    kinds: dict[str, str] = {}
+    root = path.parent
+    referenced_paths: set[str] = set()
+    for index, raw in enumerate(sheets_raw):
+        sheet = _require_dict(raw, f"manifest.sheets[{index}]")
+        sheet_required = {
+            "sheet_id",
+            "kind",
+            "source_id",
+            "pdf",
+            "sha256",
+            "source_pdf",
+            "source_sha256",
+        }
+        _require_keys(sheet, sheet_required, sheet_allowed, f"manifest.sheets[{index}]")
+        sheet_id = _require_string(
+            sheet["sheet_id"], f"manifest.sheets[{index}].sheet_id", pattern=ID_RE
+        )
+        if sheet_id in seen_ids:
+            raise StudyValidationError(f"duplicate sheet_id: {sheet_id}")
+        seen_ids.add(sheet_id)
+        kind = sheet["kind"]
+        if kind not in SHEET_KINDS:
