+def _receiver_freeze_status(results: Mapping[str, Any]) -> dict[str, Any]:
+    commit = results.get("receiver_configuration_commit")
+    config_sha = results.get("receiver_config_sha256")
+    config_path_raw = results.get("receiver_config_path")
+    config_binding = results.get("receiver_config_git_binding")
+    code_binding = results.get("receiver_code_git_binding")
+    status = {
+        "bound": False,
+        "commit": commit,
+        "reason": "missing_or_unverifiable_git_bindings",
+    }
+    if (
+        not isinstance(commit, str)
+        or GIT_COMMIT_RE.fullmatch(commit) is None
+        or not isinstance(config_sha, str)
+        or SHA256_RE.fullmatch(config_sha) is None
+        or not isinstance(config_path_raw, str)
+        or not isinstance(config_binding, dict)
+        or not isinstance(code_binding, dict)
+    ):
+        return status
+    if (
+        config_binding.get("commit") != commit
+        or code_binding.get("commit") != commit
+        or config_binding.get("sha256") != config_sha
+    ):
+        status["reason"] = "declared_bindings_disagree"
+        return status
+    config_path = Path(config_path_raw).resolve()
+    actual_config_binding = _git_binding_for_file(config_path)
+    code_root = code_binding.get("repo_root")
+    code_repo_path = code_binding.get("repo_path")
+    if not isinstance(code_root, str) or not isinstance(code_repo_path, str):
+        return status
+    code_path = (Path(code_root).resolve() / code_repo_path).resolve()
+    actual_code_binding = _git_binding_for_file(code_path)
+    if (
+        actual_config_binding is None
+        or actual_code_binding is None
+        or actual_config_binding.get("commit") != commit
+        or actual_code_binding.get("commit") != commit
+        or actual_config_binding.get("sha256") != config_sha
+        or actual_code_binding.get("sha256") != code_binding.get("sha256")
+    ):
+        status["reason"] = "actual_bytes_do_not_match_declared_commit"
+        return status
+    status["bound"] = True
+    status["reason"] = None
+    return status
+
+
+def _calibration_coverage(rows: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    physical = [row for row in rows if _physical_original(row)]
+    expected_cells = {
+        (sheet_id, view)
+        for sheet_id in CALIBRATION_ROLES
+        for view in ("front", "approx_20deg")
+    }
+    cells = [(str(row.get("sheet_id")), str(row.get("view"))) for row in physical]
+    matrix_complete = (
+        len(cells) == len(expected_cells)
+        and set(cells) == expected_cells
+        and len(set(cells)) == len(cells)
+    )
+    phone_a = _phone_role_metadata(physical, "phone_a")
+    page_width_failures = sum(not _page_width_pass(row) for row in physical)
+    printer_control_failures = sum(not _printer_controls_pass(row) for row in physical)
+    clipping_observation_failures = sum(
+        not _clipping_observation_pass(row) for row in physical
+    )
+    clipping_observations = sorted(
+        {
+            str(row["printer_settings"]["unprintable_margin_clipping"])
+            for row in physical
+            if _clipping_observation_pass(row)
+        }
+    )
+    printer_signatures = {
+        signature
+        for row in physical
+        if (signature := _printer_settings_signature(row)) is not None
+    }
+    matched_printer_settings = (
+        len(physical) == 12
+        and printer_control_failures == 0
+        and len(printer_signatures) == 1
+    )
+    missing: list[str] = []
+    if len(physical) != 12:
+        missing.append(f"calibration_originals:{len(physical)}/12")
+    if not matrix_complete:
+        missing.append("calibration_sheet_view_matrix")
+    if phone_a["observed"] != 12:
+        missing.append(f"calibration_phone_a:{phone_a['observed']}/12")
+    if not phone_a["model_known"]:
+        missing.append("phone_a_exact_make_and_model")
+    if page_width_failures:
+        missing.append(
+            f"calibration_projected_page_width_unverified_or_below_1600:{page_width_failures}"
+        )
+    if printer_control_failures:
+        missing.append(
+            f"calibration_printer_settings:{12 - printer_control_failures}/12"
+        )
+    if clipping_observation_failures:
+        missing.append(
+            "calibration_unprintable_margin_clipping_observed:"
+            f"{12 - clipping_observation_failures}/12"
+        )
+    if not matched_printer_settings:
+        missing.append("calibration_printer_settings_not_matched")
+    return {
+        "complete": not missing,
+        "physical_rows": physical,
+        "observed_originals": len(physical),
+        "sheet_view_matrix_complete": matrix_complete,
+        "phone_a": phone_a,
+        "page_width_envelope_failure_count": page_width_failures,
+        "printer_setting_failure_count": printer_control_failures,
+        "clipping_observation_failure_count": clipping_observation_failures,
+        "observed_unprintable_margin_clipping_values": clipping_observations,
+        "printer_settings_signature_count": len(printer_signatures),
+        "matched_printer_settings": matched_printer_settings,
+        "missing": missing,
+    }
+
+
+def _validation_coverage(rows: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    primary = [row for row in rows if _is_primary_row(row)]
+    unmarked = [
+        row for row in rows if row.get("attack") == "unmarked" and _physical_original(row)
+    ]
+    diagnostics = [row for row in rows if row.get("category") in DIAGNOSTIC_CATEGORIES]
+    content_ids = {str(row.get("content_id") or row.get("source_id")) for row in primary}
+    expected_primary_cells = {("phone_a", "front"), ("phone_a", "approx_20deg")}
+    artifact_groups: dict[str, list[Mapping[str, Any]]] = defaultdict(list)
+    for row in primary:
+        artifact_groups[str(row.get("artifact_id") or row.get("sheet_id"))].append(row)
+    artifact_errors = []
+    for artifact_id, artifact_rows in sorted(artifact_groups.items()):
+        cells = [
+            (
+                row.get("phone", {}).get("role") if isinstance(row.get("phone"), dict) else None,
+                row.get("view"),
+            )
+            for row in artifact_rows
+        ]
+        if len(cells) != 2 or set(cells) != expected_primary_cells or len(set(cells)) != 2:
+            artifact_errors.append(artifact_id)
+    content_attack_counts = Counter(
+        (str(row.get("content_id") or row.get("source_id")), str(row.get("attack")))
+        for row in primary
+    )
+    content_attack_errors = [
+        f"{content}:{attack}:{content_attack_counts[(content, attack)]}/2"
+        for content in sorted(content_ids)
+        for attack in SOFT_HYPOTHESES
+        if content_attack_counts[(content, attack)] != 2
+    ]
+    unmarked_counts = Counter(
+        (
+            str(row.get("content_id") or row.get("source_id")),
+            row.get("phone", {}).get("role") if isinstance(row.get("phone"), dict) else None,
+            row.get("view"),
+        )
+        for row in unmarked
+    )
+    unmarked_errors = [
+        f"{content}:{view}:{unmarked_counts[(content, 'phone_a', view)]}/1"
+        for content in sorted(content_ids)
+        for view in ("front", "approx_20deg")
+        if unmarked_counts[(content, "phone_a", view)] != 1
+    ]
+    diagnostic_names = {
+        "wrong_key": "wrong_key",
+        "wrong_context": "wrong_context",
+        "wrong_source": "wrong_source",
+        "jpeg_diagnostic": "jpeg",
+        "donor_overlay": "donor_overlay",
+    }
+    diagnostic_cells: Counter[tuple[str, str]] = Counter()
+    diagnostic_design_errors = _diagnostic_parent_errors(rows)
+    for row in diagnostics:
+        category = str(row.get("category"))
+        name = diagnostic_names[category]
+        content = str(row.get("content_id") or row.get("source_id"))
+        diagnostic_cells[(name, content)] += 1
+    diagnostic_cell_errors = [
+        f"{name}:{content}:{diagnostic_cells[(name, content)]}/1"
+        for name in ("wrong_key", "wrong_context", "wrong_source", "jpeg", "donor_overlay")
+        for content in sorted(content_ids)
+        if diagnostic_cells[(name, content)] != 1
+    ]
+    physical = [*primary, *unmarked]
+    page_width_failures = sum(not _page_width_pass(row) for row in physical)
+    printer_failures = sum(not _printer_settings_pass(row) for row in physical)
+    phone_a = _phone_role_metadata(physical, "phone_a")
+    missing: list[str] = []
+    if len(primary) != 16:
+        missing.append(f"validation_primary:{len(primary)}/16")
+    if len(artifact_groups) != 8:
+        missing.append(f"validation_artifacts:{len(artifact_groups)}/8")
+    if len(content_ids) != 2:
+        missing.append(f"validation_contents:{len(content_ids)}/2")
+    if artifact_errors or content_attack_errors:
+        missing.append("validation_primary_matrix")
+    if len(unmarked) != 4 or unmarked_errors:
+        missing.append(f"validation_unmarked:{len(unmarked)}/4")
+    if len(diagnostics) != 10 or diagnostic_cell_errors or diagnostic_design_errors:
+        missing.append(f"validation_diagnostics:{len(diagnostics)}/10")
+    if phone_a["observed"] != 20 or not phone_a["model_known"]:
+        missing.append("validation_phone_a_metadata")
+    if page_width_failures:
+        missing.append(
+            f"validation_projected_page_width_unverified_or_below_1600:{page_width_failures}"
+        )
+    if printer_failures:
+        missing.append(f"validation_printer_settings:{20 - printer_failures}/20")
+    return {
+        "complete": not missing,
+        "primary_rows": primary,
+        "primary": len(primary),
+        "unmarked_physical": len(unmarked),
+        "derived_diagnostics": len(diagnostics),
+        "contents": len(content_ids),
+        "artifacts": len(artifact_groups),
+        "primary_matrix_error_count": len(artifact_errors) + len(content_attack_errors),
+        "unmarked_matrix_error_count": len(unmarked_errors),
+        "diagnostic_matrix_error_count": len(diagnostic_cell_errors)
+        + len(diagnostic_design_errors),
+        "page_width_envelope_failure_count": page_width_failures,
+        "printer_setting_failure_count": printer_failures,
+        "phone_a": phone_a,
+        "missing": missing,
+    }
