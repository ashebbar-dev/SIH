+from __future__ import annotations
+
+import hashlib
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Callable
+from unittest import mock
+
+import numpy as np
+from PIL import Image
+
+from research.n1_v2 import study
+
+
+SHA_ZERO = "0" * 64
+SHEET_ROLES = {
+    "A0": ("unmarked", []),
+    "A1": ("marked", [3]),
+    "B0": ("unmarked", []),
+    "B1": ("marked", [4]),
+    "C0": ("coupon_unmarked", []),
+    "C1": ("coupon_marked", []),
+}
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _write_json(path: Path, value: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
+
+
+def _fake_code_hashes(config_sha: str) -> dict[str, str]:
+    names = (
+        "receiver_api.py",
+        "channel_fit.py",
+        "compound_score.py",
+        "receiver_config.json",
+        "tardos.py",
+        "tardos_carrier.py",
+        "registration.py",
+        "watermark.py",
+    )
+    values = {f"fake/{name}": hashlib.sha256(name.encode()).hexdigest() for name in names}
+    values["fake/receiver_config.json"] = config_sha
+    return values
+
+
+def _implementation_sha(code_hashes: dict[str, str]) -> str:
+    payload = json.dumps(code_hashes, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _array_sha(value: np.ndarray) -> str:
+    array = np.ascontiguousarray(value)
+    prefix = json.dumps(
+        [list(array.shape), array.dtype.str], separators=(",", ":")
+    ).encode()
+    return hashlib.sha256(prefix + array.tobytes()).hexdigest()
+
+
+def _fake_context_commitment(context: dict[str, str]) -> dict[str, str]:
+    secret_sha = (
+        hashlib.sha256(bytes.fromhex(context["fixture_secret_hex"])).hexdigest()
+        if "fixture_secret_hex" in context
+        else hashlib.sha256(b"fake-default-public-seed").hexdigest()
+    )
+    commitment = {
+        "kind": context["kind"],
+        "codebook_context": context["codebook_context"],
+        "codebook_context_sha256": hashlib.sha256(
+            context["codebook_context"].encode()
+        ).hexdigest(),
+        "carrier_context": context["carrier_context"],
+        "carrier_context_sha256": hashlib.sha256(
+            context["carrier_context"].encode()
+        ).hexdigest(),
+        "fixture_secret_sha256": secret_sha,
+        "fixture_secret_source": "documented fake public synthetic fixture seed",
+        "credential_scope": "public synthetic test identifier; not a production credential",
+    }
+    commitment["context_commitment_sha256"] = hashlib.sha256(
+        json.dumps(commitment, sort_keys=True, separators=(",", ":")).encode()
+    ).hexdigest()
+    return commitment
+
+
+def _score_result(
+    config_sha: str,
+    input_sha: object,
+    prepared_sha: str,
+    *,
+    request_id: str = "fake-request",
+    prepared_commitment: str = SHA_ZERO,
+    hypothesis_count: int = 108000,
+) -> dict:
+    profiles = {}
+    for profile, hypotheses in {
+        "hard": ["hard"],
+        "global_soft": ["single", "average_2", "average_5", "interleave_5"],
+        "local_soft": ["single", "average_2", "average_5", "interleave_5"],
+    }.items():
+        profile_hypotheses = {}
+        for hypothesis in hypotheses:
+            profile_hypotheses[hypothesis] = {
+                "scores": [0.0] * 1000,
+                "threshold": 10.0,
+                "accused_rows": [],
+                "calibration": {
+                    "status": "calibrated",
+                    "threshold": 10.0,
+                    "hypothesis_count": hypothesis_count,
+                    "family_alpha": 1e-6,
+                },
+            }
+        profiles[profile] = {
+            "status": "scored",
+            "accused_rows": [],
+            "hypotheses": profile_hypotheses,
+        }
+    code_hashes = _fake_code_hashes(config_sha)
+    if isinstance(input_sha, str):
+        input_sha = {"source_pdf": "2" * 64, "capture_path": input_sha}
+    return {
+        "schema": "nishan.n1-scores/v2",
+        "request_id": request_id,
+        "prepared_commitment": prepared_commitment,
+        "family_alpha": 1e-6,
+        "hypothesis_count": hypothesis_count,
+        "preparation_sha256": prepared_sha,
+        "receiver_config_sha256": config_sha,
+        "input_sha256": input_sha,
+        "code_sha256": code_hashes,
+        "implementation_sha256": _implementation_sha(code_hashes),
+        "profiles": profiles,
+    }
+
+
+def _set_accused(
+    score: dict, profile_name: str, hypothesis_name: str, accused_rows: list[int]
+) -> None:
+    hypothesis = score["profiles"][profile_name]["hypotheses"][hypothesis_name]
+    accused = sorted(set(accused_rows))
+    for row in accused:
+        hypothesis["scores"][row] = hypothesis["threshold"] + 1.0
+    hypothesis["accused_rows"] = accused
+    score["profiles"][profile_name]["accused_rows"] = sorted(
+        {
+            row
+            for value in score["profiles"][profile_name]["hypotheses"].values()
+            for row in value["accused_rows"]
+        }
+    )
+
+
+def _bound_report_score(
+    root: Path, request_id: str, hypothesis_count: int = 1350000
+) -> tuple[dict, dict]:
+    prepared_directory = root / request_id
+    prepared_directory.mkdir(parents=True)
+    source_sha = "2" * 64
+    capture_sha = "3" * 64
+    config_sha = "1" * 64
+    context = {
+        "kind": "public_fixture_v1",
+        "codebook_context": "report-materialized-codebook/v1",
+        "carrier_context": "report-materialized-carrier/v1",
+        "fixture_secret_hex": "a" * 64,
+    }
+    biases = np.asarray([0.25, 0.75], dtype=np.float64)
+    evidence_path = prepared_directory / "evidence.npz"
+    np.savez_compressed(evidence_path, biases=biases)
+    code_hashes = _fake_code_hashes(config_sha)
+    prepared = {
+        "schema": "nishan.n1-prepared/v2",
+        "status": "prepared",
+        "request_id": request_id,
+        "carrier": dict(study.EXPECTED_CARRIER),
+        "receiver_config_sha256": config_sha,
