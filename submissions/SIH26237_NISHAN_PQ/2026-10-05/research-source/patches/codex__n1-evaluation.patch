+def _load_report_preparation(
+    preparation: Mapping[str, Any],
+    request_id: str,
+    expected_config_sha: str,
+    expected_input_sha: Mapping[str, str],
+) -> dict[str, Any]:
+    prepared_directory = Path(
+        _require_string(
+            preparation.get("prepared_directory"),
+            f"scored report row {request_id}.preparation.prepared_directory",
+        )
+    ).resolve()
+    if prepared_directory.name != request_id:
+        raise CommitmentError(
+            f"scored report row {request_id} prepared directory identity changed"
+        )
+    prepared_path = prepared_directory / "prepared.json"
+    if not prepared_path.is_file():
+        raise CommitmentError(
+            f"scored report row {request_id} prepared.json is not materialized"
+        )
+    expected_prepared_sha = _require_sha256(
+        preparation.get("prepared_sha256"),
+        f"scored report row {request_id}.preparation.prepared_sha256",
+    )
+    if _sha256_file(prepared_path) != expected_prepared_sha:
+        raise CommitmentError(
+            f"scored report row {request_id} prepared.json hash changed"
+        )
+    prepared = _require_dict(
+        _load_json(prepared_path, description=f"prepared report row {request_id}"),
+        f"prepared report row {request_id}",
+    )
+    if prepared.get("schema") != "nishan.n1-prepared/v2":
+        raise StudyValidationError(
+            f"scored report row {request_id} prepared schema is invalid"
+        )
+    if prepared.get("status") != "prepared":
+        raise StudyValidationError(
+            f"scored report row {request_id} does not reference a prepared result"
+        )
+    if prepared.get("request_id") != request_id:
+        raise CommitmentError(
+            f"scored report row {request_id} references another preparation"
+        )
+    _validate_carrier(prepared.get("carrier"))
+    prepared_config_sha = _require_sha256(
+        prepared.get("receiver_config_sha256"),
+        f"prepared report row {request_id}.receiver_config_sha256",
+    )
+    if prepared_config_sha != expected_config_sha:
+        raise CommitmentError(
+            f"scored report row {request_id} preparation uses another configuration"
+        )
+    input_raw = _require_dict(
+        prepared.get("input_sha256"), f"prepared report row {request_id}.input_sha256"
+    )
+    _require_keys(
+        input_raw,
+        {"source_pdf", "capture_path"},
+        {"source_pdf", "capture_path"},
+        f"prepared report row {request_id}.input_sha256",
+    )
+    prepared_input_sha = {
+        "source_pdf": _require_sha256(
+            input_raw["source_pdf"],
+            f"prepared report row {request_id}.input_sha256.source_pdf",
+        ),
+        "capture_path": _require_sha256(
+            input_raw["capture_path"],
+            f"prepared report row {request_id}.input_sha256.capture_path",
+        ),
+    }
+    if prepared_input_sha != dict(expected_input_sha):
+        raise CommitmentError(
+            f"scored report row {request_id} preparation uses other input bytes"
+        )
+
+    code_mapping, implementation_sha = _validate_code_hash_mapping(
+        prepared.get("code_sha256"),
+        prepared.get("implementation_sha256"),
+        receiver=None,
+        config_path=Path("receiver_config.json"),
+        git_binding=None,
+    )
+    context_commitment = _require_dict(
+        prepared.get("context_commitment"),
+        f"prepared report row {request_id}.context_commitment",
+    )
+    declared_context_commitment = _require_sha256(
+        context_commitment.get("context_commitment_sha256"),
+        f"prepared report row {request_id}.context_commitment_sha256",
+    )
+    canonical_context = dict(context_commitment)
+    del canonical_context["context_commitment_sha256"]
+    if declared_context_commitment != _sha256_json(canonical_context):
+        raise CommitmentError(
+            f"scored report row {request_id} context commitment is invalid"
+        )
+    array_hashes_raw = _require_dict(
+        prepared.get("array_sha256"),
+        f"prepared report row {request_id}.array_sha256",
+    )
+    if not array_hashes_raw:
+        raise StudyValidationError(
+            f"scored report row {request_id} preparation has no committed arrays"
+        )
+    array_hashes = {
+        _require_string(name, "prepared array name", pattern=ID_RE): _require_sha256(
+            digest, f"prepared report row {request_id}.array_sha256[{name!r}]"
+        )
+        for name, digest in array_hashes_raw.items()
+    }
+    evidence_sha = _require_sha256(
+        prepared.get("evidence_sha256"),
+        f"prepared report row {request_id}.evidence_sha256",
+    )
+    prepared_commitment = _require_sha256(
+        prepared.get("commitment"), f"prepared report row {request_id}.commitment"
+    )
+    if prepared_commitment != preparation.get("commitment"):
+        raise CommitmentError(
+            f"scored report row {request_id} preparation commitment changed"
+        )
+    expected_commitment = _sha256_json(
+        {
+            "schema": prepared["schema"],
+            "request_id": request_id,
+            "receiver_config_sha256": prepared_config_sha,
+            "input_sha256": prepared_input_sha,
+            "context_commitment": context_commitment,
+            "implementation_sha256": implementation_sha,
+            "array_sha256": array_hashes,
+            "evidence_sha256": evidence_sha,
+        }
+    )
+    if prepared_commitment != expected_commitment:
+        raise CommitmentError(
+            f"scored report row {request_id} prepared scalar commitment is invalid"
+        )
+
+    commitment_path = prepared_directory / "commitment.json"
+    if not commitment_path.is_file():
+        raise CommitmentError(
+            f"scored report row {request_id} commitment.json is not materialized"
+        )
+    file_commitment = _require_dict(
+        _load_json(
+            commitment_path,
+            description=f"prepared commitment report row {request_id}",
+        ),
+        f"prepared commitment report row {request_id}",
+    )
+    committed_files = _require_dict(
+        file_commitment.get("sha256"),
+        f"prepared commitment report row {request_id}.sha256",
+    )
+    if (
+        file_commitment.get("schema") != "nishan.n1-prepared-commitment/v2"
+        or committed_files.get("prepared.json") != expected_prepared_sha
+        or committed_files.get("evidence.npz") != evidence_sha
+        or file_commitment.get("receiver_config_sha256") != prepared_config_sha
+        or file_commitment.get("input_sha256") != prepared_input_sha
+    ):
+        raise CommitmentError(
+            f"scored report row {request_id} commitment.json disagrees with prepared.json"
+        )
+    return {
+        "prepared_sha256": expected_prepared_sha,
+        "commitment": prepared_commitment,
+        "code_sha256": code_mapping,
+        "implementation_sha256": implementation_sha,
+    }
+
+
+def _validate_report_scored_rows(
+    results: Mapping[str, Any],
+    rows: Sequence[Mapping[str, Any]],
+    hypothesis_floor: int,
+) -> int:
+    scored_rows = [row for row in rows if row.get("status") == "scored"]
+    for row in rows:
+        if row.get("status") != "scored" and row.get("scores") is not None:
+            raise StudyValidationError("non-scored report row must not contain scores")
+    if not scored_rows:
+        return 0
+    config_sha = _require_sha256(
+        results.get("receiver_config_sha256"), "results.receiver_config_sha256"
+    )
+    for index, row in enumerate(scored_rows):
+        request_id = _require_string(
+            row.get("request_id"), f"scored report row {index}.request_id", pattern=ID_RE
+        )
+        if row.get("registration_accepted") is not True:
+            raise StudyValidationError(
+                f"scored report row {request_id} lacks accepted registration"
+            )
+        source_sha = _require_sha256(
+            row.get("receiver_source_sha256"),
+            f"scored report row {request_id}.receiver_source_sha256",
+        )
+        capture_sha = _require_sha256(
+            row.get("capture_sha256"),
+            f"scored report row {request_id}.capture_sha256",
+        )
+        preparation = _require_dict(
+            row.get("preparation"), f"scored report row {request_id}.preparation"
+        )
+        if preparation.get("status") != "prepared":
+            raise StudyValidationError(
+                f"scored report row {request_id} is not bound to a prepared case"
+            )
+        prepared_binding = _load_report_preparation(
+            preparation,
+            request_id,
+            config_sha,
+            {"source_pdf": source_sha, "capture_path": capture_sha},
+        )
+        validated = validate_score_result(
+            row.get("scores"),
+            hypothesis_floor,
+            config_sha,
+            {"source_pdf": source_sha, "capture_path": capture_sha},
+            prepared_binding["prepared_sha256"],
+            prepared_binding["code_sha256"],
+            prepared_binding["implementation_sha256"],
+            expected_request_id=request_id,
+            expected_prepared_commitment=prepared_binding["commitment"],
+        )
+        if validated["hypothesis_count"] != results.get("hypothesis_count"):
+            raise CommitmentError(
+                f"scored report row {request_id} uses a different family budget"
+            )
+    return len(scored_rows)
+
+
+def _calibration_measurement_coverage(
+    rows: Sequence[Mapping[str, Any]],
+) -> dict[str, Any]:
+    def finite_number(value: Any) -> bool:
+        return (
+            isinstance(value, (int, float))
+            and not isinstance(value, bool)
+            and math.isfinite(float(value))
+        )
+
+    def conditional_uncertainty(value: Any) -> bool:
+        if not isinstance(value, dict) or value.get("status") != "conditional_diagnostic":
+            return False
+        interval = value.get("interval_95")
+        assumptions = value.get("assumptions")
+        return bool(
+            finite_number(value.get("standard_error"))
+            and float(value["standard_error"]) >= 0.0
+            and isinstance(interval, list)
+            and len(interval) == 2
+            and all(finite_number(endpoint) for endpoint in interval)
+            and float(interval[0]) <= float(interval[1])
+            and isinstance(assumptions, list)
+            and assumptions
+            and all(isinstance(item, str) and item for item in assumptions)
+            and isinstance(value.get("claim_limit"), str)
+            and bool(value["claim_limit"])
+        )
+
+    def raw_ber_valid(row: Mapping[str, Any]) -> bool:
+        measurement = row.get("raw_labelled_ber")
+        preparation = row.get("preparation")
+        if not isinstance(measurement, dict) or not isinstance(preparation, dict):
+            return False
+        prepared_directory_raw = preparation.get("prepared_directory")
+        if not isinstance(prepared_directory_raw, str):
+            return False
+        prepared_directory = Path(prepared_directory_raw).resolve()
+        prepared_path = prepared_directory / "prepared.json"
+        evidence_path = prepared_directory / "evidence.npz"
+        if (
+            not prepared_path.is_file()
+            or not evidence_path.is_file()
+            or _sha256_file(prepared_path) != preparation.get("prepared_sha256")
+            or _sha256_file(evidence_path) != measurement.get("evidence_sha256")
+        ):
+            return False
+        compared = measurement.get("compared_symbols")
+        erased = measurement.get("erased_symbols")
+        mismatched = measurement.get("mismatched_symbols")
+        total = measurement.get("total_symbols")
+        ber = measurement.get("raw_ber")
+        return bool(
+            measurement.get("status") == "measured"
+            and row.get("registration_accepted") is True
+            and total == EXPECTED_CARRIER["m"]
+            and isinstance(compared, int)
+            and not isinstance(compared, bool)
+            and compared > 0
+            and isinstance(erased, int)
+            and not isinstance(erased, bool)
+            and erased >= 0
+            and compared + erased == total
+            and isinstance(mismatched, int)
+            and not isinstance(mismatched, bool)
+            and 0 <= mismatched <= compared
+            and finite_number(ber)
+            and math.isclose(float(ber), mismatched / compared, rel_tol=0.0, abs_tol=1e-15)
+            and conditional_uncertainty(measurement.get("uncertainty"))
+            and measurement.get("known_label_used_after_preparation_commitment") is True
+            and measurement.get("used_for_receiver_fitting_or_scoring") is False
+            and measurement.get("prepared_commitment") == preparation.get("commitment")
+            and isinstance(measurement.get("evidence_sha256"), str)
+            and SHA256_RE.fullmatch(measurement["evidence_sha256"]) is not None
+        )
+
+    def coupon_record_bound(measurement: Mapping[str, Any]) -> bool:
+        path_raw = measurement.get("measurement_path")
+        expected_sha = measurement.get("measurement_sha256")
+        if (
+            not isinstance(path_raw, str)
+            or not isinstance(expected_sha, str)
+            or SHA256_RE.fullmatch(expected_sha) is None
+        ):
+            return False
+        path = Path(path_raw).resolve()
+        if not path.is_file() or _sha256_file(path) != expected_sha:
+            return False
+        try:
+            stored = _load_json(path, description="coupon measurement")
+        except StudyValidationError:
+            return False
+        embedded = dict(measurement)
+        embedded.pop("measurement_path", None)
+        embedded.pop("measurement_sha256", None)
+        return stored == embedded
+
+    raw_ber_rows = [
+        row
+        for row in rows
+        if _physical_original(row)
+        and row.get("sheet_kind") == "marked"
+        and row.get("attack") == "single"
+    ]
+    raw_ber_measured = [
+        row
+        for row in raw_ber_rows
+        if raw_ber_valid(row)
+    ]
+    coupon_signal_rows = [
+        row
+        for row in rows
+        if _physical_original(row) and row.get("sheet_kind") == "coupon_marked"
+    ]
+    coupon_complete_ids: list[str] = []
+    for row in coupon_signal_rows:
+        measurement = row.get("coupon_measurement")
+        if not isinstance(measurement, dict):
+            continue
+        signal_regions = measurement.get("signal_regions")
+        control_regions = measurement.get("control_regions")
+        paired_regions = measurement.get("paired_regions")
+        if (
+            measurement.get("status") != "measured"
+            or measurement.get("pair_status") != "matched"
+            or not coupon_record_bound(measurement)
+            or measurement.get("known_coupon_used_for_attribution") is not False
+            or measurement.get("automatic_stop_decision") is not None
+            or not isinstance(measurement.get("signal_registration"), dict)
+            or measurement["signal_registration"].get("accepted") is not True
+            or not isinstance(measurement.get("control_registration"), dict)
+            or measurement["control_registration"].get("accepted") is not True
+            or not isinstance(signal_regions, list)
+            or not isinstance(control_regions, list)
+            or not isinstance(paired_regions, list)
+            or len(signal_regions) != 9
+            or len(control_regions) != 9
+            or len(paired_regions) != 9
+        ):
+            continue
+        regional_records = [*signal_regions, *control_regions]
+        if not all(
+            isinstance(region, dict)
+            and region.get("status") == "measured"
+            and finite_number(region.get("measured_modulation_gain"))
+            and finite_number(region.get("template_correlation"))
+            and -1.0 <= float(region["template_correlation"]) <= 1.0
+            and finite_number(region.get("clipping_fraction"))
+            and 0.0 <= float(region["clipping_fraction"]) <= 1.0
+            and conditional_uncertainty(region.get("modulation_uncertainty"))
+            for region in regional_records
+        ):
+            continue
+        if not all(
+            isinstance(region, dict)
+            and finite_number(region.get("signal_minus_control_modulation_gain"))
+            and conditional_uncertainty(
+                region.get("signal_minus_control_uncertainty")
+            )
+            for region in paired_regions
+        ):
+            continue
+        coupon_complete_ids.append(str(row.get("request_id")))
+    missing = []
+    if len(raw_ber_rows) != 4 or len(raw_ber_measured) != 4:
+        missing.append(f"calibration_raw_labelled_ber:{len(raw_ber_measured)}/4")
+    if len(coupon_signal_rows) != 2 or len(coupon_complete_ids) != 2:
+        missing.append(
+            f"calibration_coupon_modulation_uncertainty_pairs:{len(coupon_complete_ids)}/2"
+        )
+    return {
+        "complete": not missing,
+        "raw_ber_applicable_cases": len(raw_ber_rows),
+        "raw_ber_measured_cases": len(raw_ber_measured),
+        "raw_ber_cases": [
+            {
+                "request_id": row.get("request_id"),
+                "measurement": row.get("raw_labelled_ber"),
+            }
+            for row in raw_ber_rows
+        ],
+        "coupon_signal_cases": len(coupon_signal_rows),
+        "coupon_complete_pair_ids": sorted(coupon_complete_ids),
+        "conditional_uncertainty_is_physical_confidence": False,
+        "missing": missing,
+    }
+
+
+def build_report(results: Mapping[str, Any]) -> dict[str, Any]:
+    """Mechanically summarize study outcomes without inventing missing evidence."""
+
+    if results.get("schema") != RESULTS_SCHEMA:
+        raise StudyValidationError(f"results.schema must be {RESULTS_SCHEMA}")
+    split = results.get("split")
+    if split not in SPLITS:
+        raise StudyValidationError("results.split is invalid")
+    rows = _require_list(results.get("capture_results"), "results.capture_results")
+    protocol, protocol_sha = _load_protocol()
+    observed_printers = sorted(
+        {
+            str(row.get("printer"))
+            for row in rows
+            if _physical_original(row) and _known_text(row.get("printer"))
+        }
+    )
+    report: dict[str, Any] = {
+        "schema": REPORT_SCHEMA,
+        "protocol_sha256": protocol_sha,
+        "split": split,
+        "decision": "pending_physical_inputs",
+        "decision_is_research_completion": False,
+        "observed_capture_records": len(rows),
+        "observed_primary_captures": 0,
+        "observed_printers": observed_printers,
+        "cross_printer_performance_established": False,
+        "cross_printer_claim": "not_established_by_single_printer_protocol",
+        "stop_rule_exercised": False,
+        "claim_boundaries": protocol["claim_boundaries"],
+        "missing_requirements": [],
+    }
+    stage_key = "held_out" if split == "heldout" else split
+    stage = protocol["stages"].get(stage_key)
+    budget_bound = True
+    if isinstance(stage, dict) and "planned_decisions" in stage:
+        expected_planned = stage["planned_decisions"]
+        expected_h = stage["hypothesis_count_floor"]
+        budget_bound = (
+            results.get("planned_decisions") == expected_planned
+            and isinstance(results.get("hypothesis_count"), int)
+            and not isinstance(results.get("hypothesis_count"), bool)
+            and results["hypothesis_count"] >= expected_h
+        )
+        if not budget_bound:
+            report["missing_requirements"].append(
+                f"frozen_stage_budget:{results.get('planned_decisions')}/{results.get('hypothesis_count')}"
+            )
+    report["frozen_stage_budget_bound"] = budget_bound
+    declared_h = results.get("hypothesis_count")
+    report_hypothesis_floor = (
+        int(stage["hypothesis_count_floor"])
+        if isinstance(stage, dict) and isinstance(stage.get("hypothesis_count_floor"), int)
+        else (
+            declared_h
+            if isinstance(declared_h, int) and not isinstance(declared_h, bool) and declared_h > 0
+            else 1
+        )
+    )
+    report["validated_scored_rows"] = _validate_report_scored_rows(
+        results, rows, report_hypothesis_floor
+    )
+
+    if split == "heldout":
+        coverage = _heldout_coverage(rows)
+        primary = coverage.pop("primary_rows")
+        c5_primary = [
+            row for row in primary if row.get("attack") in {"average_5", "interleave_5"}
+        ]
+        report["coverage"] = coverage
+        report["observed_primary_captures"] = coverage["observed_primary_captures"]
+        candidate = _outcome_summary(primary, "local_soft")
+        baseline = _outcome_summary(primary, "global_soft")
+        c5_candidate = _outcome_summary(c5_primary, "local_soft")
+        c5_baseline = _outcome_summary(c5_primary, "global_soft")
+        report["candidate_outcomes"] = candidate
+        report["baseline_outcomes"] = baseline
+        report["c5_candidate_outcomes"] = c5_candidate
+        report["c5_baseline_outcomes"] = c5_baseline
+        report["paired_success_all_96"] = _paired_success_summary(primary)
+        report["paired_success_c5_48"] = _paired_success_summary(c5_primary)
+        candidate_rate = c5_candidate["success_rate"]
+        baseline_rate = c5_baseline["success_rate"]
+        gain_pp = (
+            100.0 * (candidate_rate - baseline_rate)
+            if candidate_rate is not None and baseline_rate is not None
+            else None
+        )
+        report["gain_percentage_points"] = gain_pp
+        report["bootstrap"] = _bootstrap_gain(
+            c5_primary,
+            int(protocol["execution"]["bootstrap_seed"]),
+            int(protocol["execution"]["bootstrap_resamples"]),
+        )
+        report["bootstrap"]["endpoint_subset"] = "c5_average_5_and_interleave_5"
+        per_attack: dict[str, Any] = {}
+        for attack in SOFT_HYPOTHESES:
+            attack_rows = [row for row in primary if row.get("attack") == attack]
+            per_attack[attack] = {
+                "observed": len(attack_rows),
+                "success_rate": _rate(attack_rows, "local_soft"),
+            }
+        report["candidate_by_attack"] = per_attack
+        phone_a = _phone_role_metadata(primary, "phone_a")
+        report["phone_a_metadata"] = phone_a
+        phone_b = _phone_b_gate(c5_primary)
+        report["phone_b_gate"] = phone_b
+        freeze_status = _receiver_freeze_status(results)
+        report["receiver_freeze"] = freeze_status
+        all_rows_candidate = _outcome_summary(rows, "local_soft")
+        report["all_scored_candidate_outcomes"] = all_rows_candidate
+        report["innocent_error_statement"] = {
+            "observed_innocent_accusation_cases": all_rows_candidate[
+                "innocent_accusation_cases"
+            ],
+            "zero_observed_is_zero_probability": False,
+            "statement": "Zero observed errors, if obtained, does not estimate a zero error probability.",
+        }
+        c5_pass = all(
+            per_attack[attack]["success_rate"] is not None
+            and per_attack[attack]["success_rate"] >= 0.75
+            for attack in ("average_5", "interleave_5")
+        )
+        gates = {
+            "frozen_stage_budget_bound": budget_bound,
+            "receiver_config_and_code_bound_to_actual_commit": freeze_status["bound"],
+            "coverage_complete": coverage["complete"],
+            "c5_primary_at_least_80_percent": bool(
+                candidate_rate is not None and candidate_rate >= 0.8
+            ),
+            "c5_gain_at_least_20_percentage_points": bool(
+                gain_pp is not None and gain_pp >= 20.0
+            ),
+            "each_c5_construction_at_least_75_percent": c5_pass,
+            "phone_b_at_least_75_percent_with_known_model": phone_b["passes_75_percent"],
+            "phone_a_exact_make_and_model_known": phone_a["model_known"],
+            "no_observed_innocent_accusation": all_rows_candidate[
+                "innocent_accusation_cases"
+            ]
+            == 0,
+        }
+        report["advancement_gates"] = gates
+        missing = list(coverage["missing"])
+        if not budget_bound:
+            missing.append("frozen_stage_budget")
+        if not freeze_status["bound"]:
+            missing.append("receiver_config_and_code_actual_commit_binding")
+        if not phone_a["model_known"]:
+            missing.append("phone_a_exact_make_and_model")
+        if not phone_b["model_known"]:
+            missing.append("phone_b_exact_make_and_model")
+        if not phone_b["distinct_from_phone_a"]:
+            missing.append("phone_b_distinct_device_identity")
+        report["missing_requirements"] = missing
+        if (
+            coverage["complete"]
+            and budget_bound
+            and freeze_status["bound"]
+            and phone_a["model_known"]
+            and phone_b["model_known"]
+            and phone_b["distinct_from_phone_a"]
+        ):
+            report["decision"] = "advance" if all(gates.values()) else "do_not_advance"
+            report["decision_is_research_completion"] = True
+    elif split == "calibration":
+        coverage = _calibration_coverage(rows)
+        physical = coverage.pop("physical_rows")
+        measurements = _calibration_measurement_coverage(rows)
+        report["coverage"] = coverage
+        report["calibration_measurements"] = measurements
+        report["observed_primary_captures"] = 0
+        report["calibration_originals_observed"] = len(physical)
+        evidence = results.get("calibration_evidence")
+        evidence_records = []
+        if isinstance(evidence, dict) and isinstance(evidence.get("records"), list):
+            evidence_records = evidence["records"]
+        physical_request_ids = {str(row.get("request_id")) for row in physical}
+        real_records = [
+            record
+            for record in evidence_records
+            if isinstance(record, dict)
+            and record.get("physical_original") is True
+            and record.get("placeholder") is not True
+            and isinstance(record.get("evidence_sha256"), list)
+            and bool(record["evidence_sha256"])
+            and all(
+                isinstance(digest, str) and SHA256_RE.fullmatch(digest)
+                for digest in record["evidence_sha256"]
+            )
+            and record.get("measurement_status")
+            not in {"error", "coupon_inconclusive", "coupon_measurement_pending"}
+            and str(record.get("request_id")) in physical_request_ids
+        ]
+        real_request_ids = {str(record.get("request_id")) for record in real_records}
+        report["real_calibration_evidence_records"] = len(real_records)
+        report["missing_requirements"].extend(coverage["missing"])
+        report["missing_requirements"].extend(measurements["missing"])
+        if len(real_request_ids) < 12:
+            report["missing_requirements"].append(
+                f"real_calibration_measurements:{len(real_request_ids)}/12"
+            )
+        if (
+            coverage["complete"]
+            and measurements["complete"]
+            and budget_bound
+            and len(real_request_ids) >= 12
+            and isinstance(evidence, dict)
+        ):
+            stop_reasons = evidence.get("predeclared_stop_reasons", [])
+            allowed_stop_rules = {
+                "no_usable_actual_carrier_signal",
+                "global_baseline_captures_gain",
+                "requires_changed_operating_point",
+            }
+            evidence_ids = {record["request_id"] for record in real_records}
+            stop_reasons_valid = (
+                isinstance(stop_reasons, list)
+                and bool(stop_reasons)
+                and all(
+                    isinstance(reason, dict)
+                    and reason.get("rule") in allowed_stop_rules
+                    and isinstance(reason.get("evidence_request_ids"), list)
+                    and bool(reason["evidence_request_ids"])
+                    and set(reason["evidence_request_ids"]).issubset(evidence_ids)
+                    for reason in stop_reasons
+                )
+                and len(
+                    {
+                        request_id
+                        for reason in stop_reasons
+                        for request_id in reason["evidence_request_ids"]
+                    }
+                )
+                >= 12
+            )
+            if stop_reasons_valid:
+                report["decision"] = "stop_unchanged_profile"
+                report["stop_rule_exercised"] = True
+                report["stop_reasons"] = stop_reasons
+                report["decision_is_research_completion"] = True
+            else:
+                report["decision"] = "calibration_complete_pending_frozen_validation"
+                if stop_reasons:
+                    report["stop_reason_validation"] = "rejected_incomplete_or_unbound_evidence"
+    elif split == "validation":
+        coverage = _validation_coverage(rows)
+        primary = coverage.pop("primary_rows")
+        report["observed_primary_captures"] = len(primary)
+        report["validation_counts"] = coverage
+        freeze_status = _receiver_freeze_status(results)
+        report["receiver_freeze"] = freeze_status
+        report["receiver_configuration_commit_bound"] = freeze_status["bound"]
+        report["candidate_outcomes"] = _outcome_summary(primary, "local_soft")
+        report["baseline_outcomes"] = _outcome_summary(primary, "global_soft")
+        report["paired_success"] = _paired_success_summary(primary)
+        report["validation_outcome_accounting_complete"] = (
+            len(primary) == 16
+            and report["candidate_outcomes"]["total_cases"] == 16
+            and report["baseline_outcomes"]["total_cases"] == 16
+            and sum(report["paired_success"].values()) == 16
+        )
+        report["missing_requirements"].extend(coverage["missing"])
+        if not report["validation_outcome_accounting_complete"]:
+            report["missing_requirements"].append("validation_outcome_accounting:incomplete")
+        if not freeze_status["bound"]:
+            report["missing_requirements"].append(
+                "receiver_config_and_code_actual_commit_binding"
+            )
+        if not report["missing_requirements"]:
+            report["decision"] = "validation_complete_pending_scientific_review"
+    else:
+        report["observed_primary_captures"] = sum(_is_primary_row(row) for row in rows)
+        report["decision"] = "development_only_no_research_decision"
+
+    if not rows and split != "development":
+        report["decision"] = "pending_physical_inputs"
+        report["decision_is_research_completion"] = False
+    return report
+
+
+def _report_markdown(report: Mapping[str, Any]) -> str:
+    lines = [
+        "# N1 v2 mechanically generated study report",
+        "",
+        f"- Split: `{report['split']}`",
+        f"- Decision: `{report['decision']}`",
+        f"- Observed primary captures: {report['observed_primary_captures']}",
+        f"- Cross-printer performance: `{report['cross_printer_claim']}`",
+        "",
+        "This report does not convert software readiness, placeholders, or missing captures into a physical result.",
+    ]
+    missing = report.get("missing_requirements", [])
+    if missing:
+        lines.extend(["", "## Missing requirements", ""])
+        lines.extend(f"- {item}" for item in missing)
+    lines.extend(
+        [
+            "",
+            "## Machine-readable record",
+            "",
+            "```json",
+            json.dumps(report, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False),
+            "```",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def report_results(
+    results_path: str | os.PathLike[str], output_path: str | os.PathLike[str]
+) -> dict[str, Any]:
+    source = Path(results_path).resolve()
+    if source.is_dir():
+        source = source / "results.json"
+    results = _require_dict(_load_json(source, description="study results"), "results")
+    report = build_report(results)
+    output = Path(output_path).resolve()
+    if output.suffix.lower() == ".md":
+        if output.exists():
+            raise StudyValidationError(f"refusing to overwrite existing output: {output}")
+        output.parent.mkdir(parents=True, exist_ok=True)
+        with output.open("x", encoding="utf-8") as handle:
+            handle.write(_report_markdown(report))
+    else:
+        _write_json_exclusive(output, report)
+    return report
+
+
+def _parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    subparsers = parser.add_subparsers(dest="command", required=True)
+    validate_parser = subparsers.add_parser("validate-pack")
+    validate_parser.add_argument("--manifest", required=True)
+    intake_parser = subparsers.add_parser("intake")
+    intake_parser.add_argument("--manifest", required=True)
+    intake_parser.add_argument("--captures", required=True)
+    intake_parser.add_argument("--output", required=True)
+    run_parser = subparsers.add_parser("run")
+    run_parser.add_argument("--intake", required=True)
+    run_parser.add_argument("--receiver-config", required=True)
+    run_parser.add_argument("--output", required=True)
+    report_parser = subparsers.add_parser("report")
+    report_parser.add_argument("--results", required=True)
+    report_parser.add_argument("--output", required=True)
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = _parser().parse_args(argv)
+    try:
+        if args.command == "validate-pack":
+            value = validate_pack(args.manifest)
+            summary = {
+                key: value[key]
+                for key in (
+                    "schema",
+                    "manifest_path",
+                    "manifest_sha256",
+                    "pack_id",
+                    "split",
+                    "sheet_count",
+                    "labels_sha256",
+                    "coupon_regions_sha256",
+                )
+            }
+        elif args.command == "intake":
+            summary = intake(args.manifest, args.captures, args.output)
+        elif args.command == "run":
+            summary = run_study(args.intake, args.receiver_config, args.output)
+        else:
+            summary = report_results(args.results, args.output)
+        print(json.dumps(summary, sort_keys=True, indent=2, ensure_ascii=False))
+        return 0
+    except (StudyValidationError, CommitmentError, ImportError) as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
