+        if "page_points" in sheet:
+            page_points = _require_list(
+                sheet["page_points"], f"manifest.sheets[{index}].page_points"
+            )
+            if len(page_points) != 2 or any(
+                isinstance(value, bool)
+                or not isinstance(value, (int, float))
+                or not math.isfinite(float(value))
+                or float(value) <= 0.0
+                for value in page_points
+            ):
