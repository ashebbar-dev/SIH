+class SignedScoreTests(unittest.TestCase):
+    def test_signed_score_matches_direct_centered_sum(self):
+        p = np.array([0.2, 0.4, 0.7], dtype=np.float64)
+        codebook = np.array([[1, 0, 1], [0, 1, 0]], dtype=np.uint8)
+        weights = np.array([0.5, -0.25, 0.75], dtype=np.float64)
+        q = receiver.implemented_probabilities(p)
+        expected = np.array([
+            np.sum(weights * (row - q) / np.sqrt(q * (1 - q)))
+            for row in codebook
+        ])
+        np.testing.assert_allclose(receiver.signed_scores(p, codebook, weights), expected)
+
+    def test_conditional_threshold_covers_exact_small_null_tail(self):
+        p = np.array([0.2, 0.45, 0.8], dtype=np.float64)
+        weights = np.array([0.7, -0.4, 1.0], dtype=np.float64)
+        alpha = 0.2
+        threshold = receiver.conditional_signed_threshold(p, weights, alpha, 1)
+        rows = np.array(list(itertools.product((0, 1), repeat=3)), dtype=np.uint8)
+        scores = receiver.signed_scores(p, rows, weights)
+        q = receiver.implemented_probabilities(p)
+        mass = np.prod(np.where(rows == 1, q, 1 - q), axis=1)
+        exact_tail = float(mass[scores > threshold["threshold"]].sum())
+        self.assertLessEqual(exact_tail, alpha + 1e-12)
+        self.assertLessEqual(threshold["modeled_per_hypothesis_upper"], alpha + 1e-9)
+
+    def test_zero_evidence_abstains_and_bad_shapes_fail(self):
+        p = np.array([0.2, 0.8])
+        result = receiver.conditional_signed_threshold(p, np.zeros(2), 1e-6, 1000)
+        self.assertIsNone(result["threshold"])
+        with self.assertRaises(ValueError):
+            receiver.signed_scores(p, np.zeros((2, 3), np.uint8), np.zeros(2))
+
