+"""Fail-closed intake, orchestration, and reporting for the N1 v2 study.
+
+This module deliberately separates capture inventory, row-blind receiver
+preparation, evaluator-label access, scoring, and outcome accounting.  It does
+not contain a receiver and it never turns software tests into physical evidence.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib
+import json
+import math
+import os
+import random
+import re
+import subprocess
+import sys
+from collections import Counter, defaultdict
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+import numpy as np
+from PIL import ExifTags, Image, UnidentifiedImageError
+
+
+PACK_SCHEMA = "nishan.n1-pack/v2"
+REQUEST_SCHEMA = "nishan.n1-request/v2"
+SCORES_SCHEMA = "nishan.n1-scores/v2"
+INTAKE_SCHEMA = "nishan.n1-intake/v2"
+RESULTS_SCHEMA = "nishan.n1-study-results/v2"
+REPORT_SCHEMA = "nishan.n1-study-report/v2"
+PROTOCOL_SCHEMA = "nishan.n1-study-protocol/v2"
+
