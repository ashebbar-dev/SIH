@@ -0,0 +1,221 @@
+"""Bounded research message and ECC for the physical-carrier pilot.
+
+This is deliberately not a deployment authenticator or collusion code.  It
+packs a small recipient/session tuple, adds a 16-bit keyed check, and protects
+the resulting 48 bits with twelve extended-Hamming (8,4,4) blocks.  The keyed
+check is only an experimental rejection mechanism; its size does not justify a
+false-attribution security claim.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+from dataclasses import asdict, dataclass
+
+import numpy as np
+
+
+ROSTER_SIZE = 1000
+ROW_BITS = 10
+MESSAGE_ID_BITS = 22
+BODY_BITS = ROW_BITS + MESSAGE_ID_BITS
+TAG_BITS = 16
+PAYLOAD_BITS = BODY_BITS + TAG_BITS
+CODEWORD_BITS = PAYLOAD_BITS * 2
+MAX_ROW = ROSTER_SIZE - 1
+MAX_MESSAGE_ID = (1 << MESSAGE_ID_BITS) - 1
+_DOMAIN = b"NISHAN-PHYSICAL-MESSAGE/v1\x00"
+
+
+@dataclass(frozen=True)
+class NibbleDecode:
+    nibble: int | None
+    distance: int
+    uncorrectable: bool
+
+
+@dataclass(frozen=True)
+class DecodeResult:
+    payload_bits: int
+    codeword_bits: int
+    corrected_blocks: int
+    uncorrectable_blocks: int
+    tag_valid: bool
+    accepted_expected: bool
+    valid_other_message: bool
+    row: int | None
+    message_id: int | None
+    expected_row: int | None
+    expected_message_id: int | None
+    recovered_payload_hex: str | None
+    failure_reason: str | None
+
+    def to_dict(self) -> dict[str, object]:
+        return asdict(self)
+
+
+def _validate_key_context(key: bytes, context: str) -> None:
+    if not isinstance(key, bytes) or len(key) < 16:
+        raise ValueError("key must be bytes containing at least 16 bytes")
+    if not isinstance(context, str) or not context:
+        raise ValueError("context must be a non-empty string")
+
+
+def _binary_word(value: np.ndarray, length: int, label: str) -> np.ndarray:
+    array = np.asarray(value)
+    if array.shape != (length,) or np.any((array != 0) & (array != 1)):
+        raise ValueError(f"{label} must be a binary vector of length {length}")
+    return array.astype(np.uint8, copy=False)
+
+
+def encode_nibble(nibble: int) -> np.ndarray:
+    """Encode one nibble as systematic extended Hamming (8,4,4)."""
+
+    if not isinstance(nibble, (int, np.integer)) or not 0 <= int(nibble) < 16:
+        raise ValueError("nibble must be an integer in [0, 15]")
+    value = int(nibble)
+    d0 = (value >> 3) & 1
+    d1 = (value >> 2) & 1
+    d2 = (value >> 1) & 1
+    d3 = value & 1
+    p1 = d0 ^ d1 ^ d3
+    p2 = d0 ^ d2 ^ d3
+    p4 = d1 ^ d2 ^ d3
+    first_seven = np.array([p1, p2, d0, p4, d1, d2, d3], dtype=np.uint8)
+    p0 = int(np.bitwise_xor.reduce(first_seven))
+    return np.concatenate((first_seven, np.array([p0], dtype=np.uint8)))
+
+
+_NIBBLE_CODEBOOK = np.stack([encode_nibble(value) for value in range(16)])
+
+
+def decode_nibble(codeword: np.ndarray) -> NibbleDecode:
+    """Decode only distance-zero/one words and reject every larger distance."""
+
+    word = _binary_word(codeword, 8, "nibble codeword")
+    distances = np.count_nonzero(_NIBBLE_CODEBOOK != word[None, :], axis=1)
+    distance = int(distances.min())
+    if distance > 1:
+        return NibbleDecode(nibble=None, distance=distance, uncorrectable=True)
+    nearest = np.flatnonzero(distances == distance)
+    if nearest.size != 1:
+        return NibbleDecode(nibble=None, distance=distance, uncorrectable=True)
+    return NibbleDecode(
+        nibble=int(nearest[0]), distance=distance, uncorrectable=False
+    )
+
+
+def _body(row: int, message_id: int) -> bytes:
+    if not isinstance(row, (int, np.integer)) or not 0 <= int(row) <= MAX_ROW:
+        raise ValueError(f"row must be an integer in [0, {MAX_ROW}]")
+    if (
+        not isinstance(message_id, (int, np.integer))
+        or not 0 <= int(message_id) <= MAX_MESSAGE_ID
+    ):
+        raise ValueError(
+            f"message_id must be an integer in [0, {MAX_MESSAGE_ID}]"
+        )
+    packed = (int(row) << MESSAGE_ID_BITS) | int(message_id)
+    return packed.to_bytes(4, "big")
+
+
+def _tag(body: bytes, key: bytes, context: str) -> bytes:
+    _validate_key_context(key, context)
+    return hmac.new(
+        key,
+        _DOMAIN + context.encode("utf-8") + body,
+        hashlib.sha3_256,
+    ).digest()[: TAG_BITS // 8]
+
+
+def encode_message(row: int, message_id: int, key: bytes, context: str) -> np.ndarray:
+    """Return the frozen 96-bit ECC codeword for one bounded research message."""
+
+    body = _body(row, message_id)
+    payload = body + _tag(body, key, context)
+    payload_bits = np.unpackbits(np.frombuffer(payload, dtype=np.uint8))
+    blocks: list[np.ndarray] = []
+    for start in range(0, PAYLOAD_BITS, 4):
+        nibble = int(np.packbits(payload_bits[start : start + 4], bitorder="big")[0] >> 4)
+        blocks.append(encode_nibble(nibble))
+    result = np.concatenate(blocks).astype(np.uint8, copy=False)
+    if result.shape != (CODEWORD_BITS,):
+        raise AssertionError("message codec emitted the wrong codeword length")
+    return result
+
+
+def decode_message(
+    codeword: np.ndarray,
+    key: bytes,
+    context: str,
+    *,
+    expected: tuple[int, int] | None = None,
+) -> DecodeResult:
+    """Decode the full message; tag validity alone never accepts an expectation."""
+
+    _validate_key_context(key, context)
+    word = _binary_word(codeword, CODEWORD_BITS, "message codeword")
+    if expected is not None:
+        _body(*expected)
+    decoded_blocks = [decode_nibble(block) for block in word.reshape(-1, 8)]
+    corrected = sum(block.distance == 1 for block in decoded_blocks)
+    uncorrectable = sum(block.uncorrectable for block in decoded_blocks)
+    expected_row = expected[0] if expected is not None else None
+    expected_message_id = expected[1] if expected is not None else None
+    if uncorrectable:
+        return DecodeResult(
+            payload_bits=PAYLOAD_BITS,
+            codeword_bits=CODEWORD_BITS,
+            corrected_blocks=corrected,
+            uncorrectable_blocks=uncorrectable,
+            tag_valid=False,
+            accepted_expected=False,
+            valid_other_message=False,
+            row=None,
+            message_id=None,
+            expected_row=expected_row,
+            expected_message_id=expected_message_id,
+            recovered_payload_hex=None,
+            failure_reason="uncorrectable_ecc",
+        )
+
+    nibbles = [int(block.nibble) for block in decoded_blocks]
+    payload = bytes(
+        (nibbles[index] << 4) | nibbles[index + 1]
+        for index in range(0, len(nibbles), 2)
+    )
+    body, observed_tag = payload[:4], payload[4:]
+    packed = int.from_bytes(body, "big")
+    row = packed >> MESSAGE_ID_BITS
+    message_id = packed & MAX_MESSAGE_ID
+    fields_valid = row <= MAX_ROW
+    tag_valid = fields_valid and hmac.compare_digest(
+        observed_tag, _tag(body, key, context)
+    )
+    expected_match = expected is None or (row, message_id) == expected
+    accepted = tag_valid and expected_match
+    valid_other = bool(tag_valid and expected is not None and not expected_match)
+    if not fields_valid:
+        failure_reason = "decoded_row_out_of_roster"
+    elif not tag_valid:
+        failure_reason = "keyed_check_failed"
+    elif valid_other:
+        failure_reason = "valid_other_message"
+    else:
+        failure_reason = None
+    return DecodeResult(
+        payload_bits=PAYLOAD_BITS,
+        codeword_bits=CODEWORD_BITS,
+        corrected_blocks=corrected,
+        uncorrectable_blocks=0,
+        tag_valid=bool(tag_valid),
+        accepted_expected=bool(accepted),
+        valid_other_message=valid_other,
+        row=int(row),
+        message_id=int(message_id),
+        expected_row=expected_row,
+        expected_message_id=expected_message_id,
+        recovered_payload_hex=payload.hex(),
+        failure_reason=failure_reason,
+    )
