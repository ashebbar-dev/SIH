+def _observation(
+    declaration: dict[str, object],
+    source: Path,
+    suspect: Path,
+    profile_name: str,
+    carrier_key: bytes,
+    carrier_context: str,
+    codec_key: bytes,
+    codec_context: str,
+    ground_truth: np.ndarray | None,
+) -> tuple[dict[str, object], np.ndarray, np.ndarray]:
+    profile = PROFILES[profile_name]
+    started = time.perf_counter()
+    decoded_word, correlations, diagnostics = decode_profile(
+        source,
+        suspect,
+        carrier_key,
+        carrier_context,
+        profile,
+        registration_mode="off",
+    )
+    decode_seconds = time.perf_counter() - started
+    result = decode_message(
+        decoded_word, codec_key, codec_context, expected=TARGET
+    )
+    if result.accepted_expected:
+        outcome_class = "exact_expected"
+    elif result.valid_other_message:
+        outcome_class = "valid_other_message"
+    else:
+        outcome_class = "abstain"
+    kind = str(declaration["kind"])
+    target_negative = kind in {
+        "unmarked",
+        "wrong_key",
+        "wrong_context",
+        "other_issued",
+    }
+    ber = (
+        None
+        if ground_truth is None
+        else float(np.count_nonzero(decoded_word != ground_truth) / CODEWORD_BITS)
+    )
+    observation = {
+        **declaration,
+        "outcome_class": outcome_class,
+        "expected_class_observed": outcome_class == declaration["expected_class"],
+        "target_negative": target_negative,
+        "target_negative_pass": None
+        if not target_negative
+        else not result.accepted_expected,
+        "content_binding_failure": kind == "copied_overlay_modified_content"
+        and result.accepted_expected,
+        "codeword_ber_against_embedded": ber,
+        "codeword_ber_unavailable_reason": None
+        if ground_truth is not None
+        else "unmarked observation has no embedded codeword",
+        "decoded_one_bits": int(decoded_word.sum()),
+        "decode_seconds": decode_seconds,
+        "registration_mode": "off",
+        "registration": diagnostics,
+        **result.to_dict(),
+    }
+    return observation, decoded_word, correlations
+
