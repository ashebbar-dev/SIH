+
+class ProfileAccountingTests(unittest.TestCase):
+    def test_profiles_freeze_payload_repetition_area_and_changed_strength(self):
+        self.assertEqual(CANDIDATE.physical_symbols, CODEWORD_BITS * 7)
+        self.assertEqual(BASELINE.physical_symbols, CODEWORD_BITS * 50)
+        self.assertEqual(CANDIDATE.nominal_pixels, 688_128)
+        self.assertEqual(BASELINE.nominal_pixels, 691_200)
+        self.assertLess(
+            abs(CANDIDATE.nominal_pixels / BASELINE.nominal_pixels - 1.0),
+            0.005,
+        )
+        self.assertEqual(CANDIDATE.strength, 18.0)
+        self.assertEqual(BASELINE.strength, 4.0)
+        self.assertNotEqual(CANDIDATE.strength, BASELINE.strength)
+
+    def test_cluster_masks_are_disjoint_equal_ink_and_orientation_specific(self):
+        masks = _cluster_masks(CANDIDATE.block_size)
+        self.assertEqual(masks.shape, (2, 2, 32, 32))
+        for orientation in range(2):
+            negative, positive = masks[orientation]
+            self.assertEqual(int(negative.sum()), 64)
+            self.assertEqual(int(positive.sum()), 64)
+            self.assertFalse(np.any(negative & positive))
+        self.assertFalse(np.array_equal(masks[0], masks[1]))
+
+    def test_all_common_sources_fit_r7_but_reject_fixed_r18_probe(self):
+        for source in sorted(SOURCE_ROOT.glob("*.pdf")):
+            with self.subTest(source=source.name):
+                capacity = candidate_capacity(source)
+                self.assertGreaterEqual(capacity, CANDIDATE.physical_symbols)
+                self.assertLess(
+                    capacity, CODEWORD_BITS * CAPACITY_PROBE_REPETITIONS
+                )
+
+    def test_candidate_tiles_independently_satisfy_text_and_blank_masks(self):
+        source = SOURCE_ROOT / "test_mixed.pdf"
+        pages, _ = watermark.load_pages(source, dpi=144)
+        masks = _text_masks(
+            source,
+            [page.shape[:2] for page in pages],
+            padding=TEXT_PADDING,
+        )
+        tiles = eligible_tiles(source)
+        self.assertGreaterEqual(len(tiles), CANDIDATE.physical_symbols)
+        for tile in tiles:
+            patch = pages[tile.page][
+                tile.y : tile.y + CANDIDATE.block_size,
+                tile.x : tile.x + CANDIDATE.block_size,
+            ]
+            text_patch = masks[tile.page][
+                tile.y : tile.y + CANDIDATE.block_size,
+                tile.x : tile.x + CANDIDATE.block_size,
+            ]
+            self.assertFalse(text_patch.any())
+            self.assertGreaterEqual(
+                float(np.mean(watermark._luma(patch) >= BLANK_LUMA_FLOOR)),
+                MINIMUM_BLANK_FRACTION,
+            )
+
+    def test_correlation_repetitions_are_summed_before_hard_decision(self):
+        correlations = np.zeros(CODEWORD_BITS * 7, dtype=np.float64)
+        correlations.reshape(7, CODEWORD_BITS)[:, 0] = [9, -1, -1, -1, -1, -1, -1]
+        correlations.reshape(7, CODEWORD_BITS)[:, 1] = [-9, 1, 1, 1, 1, 1, 1]
+        word, summed = collapse_correlations(correlations, CODEWORD_BITS, 7)
+        self.assertEqual(int(word[0]), 1)
+        self.assertEqual(int(word[1]), 0)
+        self.assertEqual(float(summed[0]), 3.0)
+        self.assertEqual(float(summed[1]), -3.0)
+
+
+class CandidateRoundTripTests(unittest.TestCase):
