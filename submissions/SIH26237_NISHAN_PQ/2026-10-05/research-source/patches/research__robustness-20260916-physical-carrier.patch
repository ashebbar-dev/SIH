+
+
+class FreshCaptureScorerTests(unittest.TestCase):
+    def test_selected_candidate_digital_pdf_scores_read_only_with_registration(self):
+        capture = PILOT / "print_ready/test-mixed-candidate-row-7.pdf"
+        before = sorted(path.relative_to(PILOT) for path in PILOT.rglob("*"))
+        result = score_capture(
+            capture,
+            pilot=PILOT,
+            source_id="test_mixed",
+            profile_name=CANDIDATE.name,
+        )
+        after = sorted(path.relative_to(PILOT) for path in PILOT.rglob("*"))
+
+        self.assertEqual(before, after)
+        self.assertEqual(result["registration_mode"], "always")
+        self.assertEqual(result["outcome"], "exact_expected")
+        self.assertTrue(result["decode"]["accepted_expected"])
+        self.assertEqual(result["decode"]["row"], 7)
+        self.assertEqual(result["decode"]["message_id"], 0x2A1B3C)
+        self.assertEqual(result["expected_codeword_bit_errors"], 0)
