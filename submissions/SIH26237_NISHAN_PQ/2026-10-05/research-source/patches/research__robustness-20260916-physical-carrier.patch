+        for item in observations
+        if item["kind"] == "positive" and item["transform"] == "clean"
+    ]
+    clean_exact = len(clean) == 12 and all(item["accepted_expected"] for item in clean)
+    negatives = [item for item in observations if item["target_negative"]]
+    negatives_clear = len(negatives) == 72 and all(
+        not item["accepted_expected"] for item in negatives
+    )
+    text_preserved = len(issued) == 12 and all(
+        item["metrics"]["text_preserved"] for item in issued
+    )
+    candidate_issued = [
+        item for item in issued if item["profile"] == CANDIDATE.name
+    ]
+    candidate_text_zero = len(candidate_issued) == 6 and all(
+        item["metrics"]["fidelity"]["text_region"]["changed_fraction"] == 0.0
+        for item in candidate_issued
+    )
+
+    confirmation = [
+        item
+        for item in observations
+        if item["kind"] == "positive"
+        and item["split"] == "confirmation"
+        and item["transform"] in CONFIRMATION_CHANNELS
+    ]
+    confirmation_counts = {
