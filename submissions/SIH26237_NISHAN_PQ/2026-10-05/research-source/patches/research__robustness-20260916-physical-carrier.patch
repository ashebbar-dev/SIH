+def _visual_sample(
+    source_pdf: Path, candidate_pdf: Path, baseline_pdf: Path, destination: Path
+) -> None:
+    source = np.asarray(_render_one(source_pdf), dtype=np.uint8)
+    candidate = np.asarray(_render_one(candidate_pdf), dtype=np.uint8)
+    baseline = np.asarray(_render_one(baseline_pdf), dtype=np.uint8)
+    difference = np.max(np.abs(candidate.astype(np.int16) - source.astype(np.int16)), axis=2)
+    ys, xs = np.nonzero(difference)
+    if ys.size == 0:
+        center_y, center_x = source.shape[0] // 2, source.shape[1] // 2
+    else:
+        center_y, center_x = int(np.median(ys)), int(np.median(xs))
+    crop_size = 256
+    y0 = max(0, min(source.shape[0] - crop_size, center_y - crop_size // 2))
+    x0 = max(0, min(source.shape[1] - crop_size, center_x - crop_size // 2))
+    panels = [
+        source[y0 : y0 + crop_size, x0 : x0 + crop_size],
+        candidate[y0 : y0 + crop_size, x0 : x0 + crop_size],
+        baseline[y0 : y0 + crop_size, x0 : x0 + crop_size],
+    ]
+    montage = np.concatenate(panels, axis=1)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    Image.fromarray(montage).resize(
+        (montage.shape[1] * 2, montage.shape[0] * 2), Image.Resampling.NEAREST
+    ).save(destination, format="PNG")
