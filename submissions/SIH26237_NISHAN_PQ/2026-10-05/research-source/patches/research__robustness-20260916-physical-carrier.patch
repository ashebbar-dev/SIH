+def _jpeg_roundtrip(image: Image.Image, quality: int, subsampling: int) -> Image.Image:
+    stream = io.BytesIO()
+    image.convert("RGB").save(
+        stream,
+        format="JPEG",
+        quality=quality,
+        subsampling=subsampling,
+        optimize=False,
+    )
+    stream.seek(0)
+    with Image.open(stream) as decoded:
+        return decoded.convert("RGB").copy()
+
+
+def _bayer8() -> np.ndarray:
+    matrix = np.array([[0, 2], [3, 1]], dtype=np.float32)
+    while matrix.shape[0] < 8:
+        matrix = np.block(
+            [[4 * matrix, 4 * matrix + 2], [4 * matrix + 3, 4 * matrix + 1]]
+        )
+    return matrix
+
+
+def apply_transform(image: Image.Image, name: str) -> Image.Image:
+    """Apply one deterministic frozen diagnostic channel."""
+
+    rgb = image.convert("RGB")
+    if name == "clean":
+        return rgb.copy()
+    if name == "jpeg55":
+        return _jpeg_roundtrip(rgb, quality=55, subsampling=0)
+    if name == "photo_resize_jpeg":
+        scale = min(1.0, 1280.0 / max(rgb.size))
+        resized = rgb.resize(
+            (max(1, round(rgb.width * scale)), max(1, round(rgb.height * scale))),
+            Image.Resampling.LANCZOS,
+        )
+        return _jpeg_roundtrip(resized, quality=65, subsampling=2)
+    if name == "print_halftone":
+        doubled = rgb.resize(
+            (rgb.width * 2, rgb.height * 2), Image.Resampling.BICUBIC
+        ).convert("L")
+        gray = np.asarray(doubled, dtype=np.float32)
+        bayer = _bayer8()
+        tiled = np.tile(
+            (bayer + 0.5) * (255.0 / 64.0),
+            (int(np.ceil(gray.shape[0] / 8)), int(np.ceil(gray.shape[1] / 8))),
+        )[: gray.shape[0], : gray.shape[1]]
+        screened = np.where(gray <= tiled, 0, 255).astype(np.uint8)
+        gained = Image.fromarray(screened, mode="L").filter(ImageFilter.MinFilter(3))
+        optical = gained.filter(ImageFilter.GaussianBlur(radius=0.6))
+        return optical.resize(rgb.size, Image.Resampling.LANCZOS).convert("RGB")
+    if name == "scanner_contrast":
+        gray = ImageEnhance.Contrast(rgb.convert("L")).enhance(1.8)
+        return gray.filter(ImageFilter.GaussianBlur(radius=0.6)).convert("RGB")
+    if name == "scanner_bilevel":
+        gray = np.asarray(rgb.convert("L"), dtype=np.uint8)
+        binary = np.where(gray <= 200, 0, 255).astype(np.uint8)
+        return Image.fromarray(binary, mode="L").convert("RGB")
+    raise ValueError(f"unknown frozen transform: {name}")
+
+
+def _modified_content_transplant(
+    source: Image.Image, marked: Image.Image
+) -> tuple[Image.Image, dict[str, object]]:
+    """Move the donor residual onto visibly modified content without binding it."""
+
+    source_array = np.asarray(source.convert("RGB"), dtype=np.int16)
+    marked_array = np.asarray(marked.convert("RGB"), dtype=np.int16)
+    if source_array.shape != marked_array.shape:
+        raise ValueError("transplant source and marked render shapes differ")
+    modified = source.convert("RGB").copy()
+    draw = ImageDraw.Draw(modified)
+    width, height = modified.size
+    rectangle = (
+        round(width * 0.07),
+        round(height * 0.07),
+        round(width * 0.43),
+        round(height * 0.105),
+    )
+    draw.rectangle(rectangle, fill=(255, 255, 255))
+    draw.rectangle(
+        (
+            rectangle[0] + 8,
+            rectangle[1] + 8,
+            min(rectangle[2] - 8, rectangle[0] + 230),
+            rectangle[3] - 8,
+        ),
+        fill=(20, 20, 20),
+    )
+    modified_array = np.asarray(modified, dtype=np.int16)
+    donor_residual = marked_array - source_array
+    transplanted = np.clip(modified_array + donor_residual, 0, 255).astype(np.uint8)
+    changed = np.any(modified_array != source_array, axis=2)
+    return Image.fromarray(transplanted, mode="RGB"), {
+        "modified_content_pixels": int(changed.sum()),
+        "modified_content_fraction": float(changed.mean()),
+        "construction": "visible raster modification plus donor marked-minus-source residual",
+    }
+
+
+def _render_one(path: Path) -> Image.Image:
+    pages, _ = watermark.load_pages(path, dpi=DPI)
+    if len(pages) != 1:
+        raise ValueError("the frozen common source pack must contain one-page PDFs")
+    return Image.fromarray(pages[0], mode="RGB")
