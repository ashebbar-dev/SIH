+def _verify_source_pack() -> tuple[dict[str, object], list[dict[str, object]]]:
+    try:
+        manifest = json.loads(SOURCE_MANIFEST.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as error:
+        raise ValueError(f"cannot read common source manifest: {error}") from error
+    if manifest.get("schema") != "nishan-robustness-source-pack/v1":
+        raise ValueError("unexpected common source manifest schema")
+    cases = manifest.get("cases")
+    if not isinstance(cases, list) or len(cases) != 6:
+        raise ValueError("common source manifest must declare exactly six cases")
+    expected_splits = {"development": 2, "validation": 2, "confirmation": 2}
+    actual_splits = {
+        split: sum(case.get("split") == split for case in cases)
+        for split in expected_splits
+    }
+    if actual_splits != expected_splits:
+        raise ValueError("common source split allocation changed")
+    for case in cases:
+        path = COMMON_SOURCE_ROOT / str(case["file"])
+        if not path.is_file() or _sha256(path) != case.get("sha256"):
+            raise ValueError(f"source hash mismatch: {path}")
+    return manifest, cases
