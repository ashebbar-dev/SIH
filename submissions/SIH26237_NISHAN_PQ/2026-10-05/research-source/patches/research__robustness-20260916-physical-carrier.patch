@@ -0,0 +1,160 @@
+from __future__ import annotations
+
+import unittest
+
+import numpy as np
+
+from codec import (
+    CODEWORD_BITS,
+    MAX_MESSAGE_ID,
+    MAX_ROW,
+    PAYLOAD_BITS,
+    _tag,
+    decode_message,
+    decode_nibble,
+    encode_message,
+    encode_nibble,
+)
+
+
+KEY = b"k" * 32
+CONTEXT = "synthetic/source-a"
+TARGET = (7, 0x2A1B3C)
+
+
+class ExtendedHammingTests(unittest.TestCase):
+    def test_all_codewords_have_minimum_distance_four(self):
+        words = np.stack([encode_nibble(value) for value in range(16)])
+        distances = np.count_nonzero(words[:, None, :] != words[None, :, :], axis=2)
+        distances += np.eye(16, dtype=np.int64) * 8
+        self.assertEqual(int(distances.min()), 4)
+
+    def test_each_nibble_round_trips_and_single_error_is_corrected(self):
+        for value in range(16):
+            encoded = encode_nibble(value)
+            clean = decode_nibble(encoded)
+            self.assertEqual(clean.nibble, value)
+            self.assertEqual(clean.distance, 0)
+            self.assertFalse(clean.uncorrectable)
+            for index in range(8):
+                damaged = encoded.copy()
+                damaged[index] ^= 1
+                decoded = decode_nibble(damaged)
+                self.assertEqual(decoded.nibble, value)
+                self.assertEqual(decoded.distance, 1)
+                self.assertFalse(decoded.uncorrectable)
+
+    def test_two_errors_are_rejected_even_if_nearest_codeword_ties(self):
+        for value in range(16):
+            encoded = encode_nibble(value)
+            for first in range(8):
+                for second in range(first + 1, 8):
+                    damaged = encoded.copy()
+                    damaged[[first, second]] ^= 1
+                    decoded = decode_nibble(damaged)
+                    self.assertTrue(decoded.uncorrectable)
+                    self.assertIsNone(decoded.nibble)
+                    self.assertEqual(decoded.distance, 2)
+
+    def test_nibble_inputs_are_validated(self):
+        for bad in (-1, 16):
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                encode_nibble(bad)
+        for bad_word in (np.zeros(7), np.zeros((1, 8)), np.array([0] * 7 + [2])):
+            with self.subTest(shape=bad_word.shape), self.assertRaises(ValueError):
+                decode_nibble(bad_word)
+
+
+class MessageCodecTests(unittest.TestCase):
+    def test_message_round_trip_is_exactly_96_codeword_bits(self):
+        word = encode_message(*TARGET, KEY, CONTEXT)
+        self.assertEqual(word.shape, (CODEWORD_BITS,))
+        self.assertEqual(word.dtype, np.uint8)
+        decoded = decode_message(word, KEY, CONTEXT, expected=TARGET)
+        self.assertTrue(decoded.tag_valid)
+        self.assertTrue(decoded.accepted_expected)
+        self.assertFalse(decoded.valid_other_message)
+        self.assertEqual((decoded.row, decoded.message_id), TARGET)
+        self.assertEqual(decoded.payload_bits, 48)
+        self.assertEqual(decoded.codeword_bits, 96)
+        self.assertEqual(decoded.corrected_blocks, 0)
+        self.assertEqual(decoded.uncorrectable_blocks, 0)
+
+    def test_public_vector_locks_exact_hmac_framing(self):
+        word = encode_message(*TARGET, KEY, CONTEXT)
+        decoded = decode_message(word, KEY, CONTEXT, expected=TARGET)
+        self.assertEqual(decoded.recovered_payload_hex, "01ea1b3c0df4")
+
+    def test_one_error_in_every_block_is_corrected(self):
+        word = encode_message(*TARGET, KEY, CONTEXT)
+        damaged = word.copy()
+        damaged[np.arange(12) * 8] ^= 1
+        decoded = decode_message(damaged, KEY, CONTEXT, expected=TARGET)
+        self.assertTrue(decoded.accepted_expected)
+        self.assertEqual(decoded.corrected_blocks, 12)
+        self.assertEqual(decoded.uncorrectable_blocks, 0)
+
+    def test_double_error_causes_abstention_before_tag_acceptance(self):
+        word = encode_message(*TARGET, KEY, CONTEXT)
+        word[[0, 1]] ^= 1
+        decoded = decode_message(word, KEY, CONTEXT, expected=TARGET)
+        self.assertFalse(decoded.accepted_expected)
+        self.assertFalse(decoded.tag_valid)
+        self.assertEqual(decoded.uncorrectable_blocks, 1)
+        self.assertEqual(decoded.failure_reason, "uncorrectable_ecc")
+
+    def test_wrong_key_and_context_fail_the_keyed_check(self):
+        word = encode_message(*TARGET, KEY, CONTEXT)
+        wrong_key = decode_message(word, b"z" * 32, CONTEXT, expected=TARGET)
+        wrong_context = decode_message(word, KEY, "synthetic/wrong", expected=TARGET)
+        self.assertFalse(wrong_key.tag_valid)
+        self.assertFalse(wrong_key.accepted_expected)
+        self.assertFalse(wrong_context.tag_valid)
+        self.assertFalse(wrong_context.accepted_expected)
+
+    def test_other_issued_message_is_valid_but_not_the_expected_target(self):
+        other = (29, 0x155AA5)
+        word = encode_message(*other, KEY, CONTEXT)
+        decoded = decode_message(word, KEY, CONTEXT, expected=TARGET)
+        self.assertTrue(decoded.tag_valid)
+        self.assertTrue(decoded.valid_other_message)
+        self.assertFalse(decoded.accepted_expected)
+        self.assertEqual((decoded.row, decoded.message_id), other)
+        self.assertEqual(decoded.failure_reason, "valid_other_message")
+
+    def test_field_and_word_bounds_are_rejected(self):
+        for row, message in ((-1, 0), (MAX_ROW + 1, 0), (0, -1), (0, MAX_MESSAGE_ID + 1)):
+            with self.subTest(row=row, message=message), self.assertRaises(ValueError):
+                encode_message(row, message, KEY, CONTEXT)
+        with self.assertRaises(ValueError):
+            decode_message(np.zeros(95, dtype=np.uint8), KEY, CONTEXT, expected=TARGET)
+        with self.assertRaises(ValueError):
+            decode_message(np.full(96, 2, dtype=np.uint8), KEY, CONTEXT, expected=TARGET)
+
+    def test_decoded_row_outside_roster_is_rejected_even_with_matching_tag(self):
+        body = (((MAX_ROW + 1) << 22) | 1).to_bytes(4, "big")
+        payload_bits = np.unpackbits(
+            np.frombuffer(body + _tag(body, KEY, CONTEXT), dtype=np.uint8)
+        )
+        word = np.concatenate(
+            [
+                encode_nibble(
+                    int(
+                        np.packbits(
+                            payload_bits[start : start + 4], bitorder="big"
+                        )[0]
+                        >> 4
+                    )
+                )
+                for start in range(0, PAYLOAD_BITS, 4)
+            ]
+        )
+        decoded = decode_message(word, KEY, CONTEXT, expected=TARGET)
+        self.assertFalse(decoded.accepted_expected)
+        self.assertFalse(decoded.tag_valid)
+        self.assertEqual(decoded.row, MAX_ROW + 1)
+        self.assertEqual(decoded.failure_reason, "decoded_row_out_of_roster")
+
+
+if __name__ == "__main__":
+    unittest.main()
