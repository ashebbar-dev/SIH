+"""Frozen spatial carriers for the print-aware compact-message pilot.
+
+The candidate is an empirical, source-informed background carrier.  It does
+not preserve the threat model of the 52,500-symbol Tardos profile: it carries a
+96-bit ECC word and assumes no collusion.  The legacy comparator uses the
+existing spatial split template but carries the same compact ECC word.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import io
+import math
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
+import numpy as np
+import pymupdf as fitz
+from PIL import Image
+
+from nishan import registration, tardos_carrier, watermark
+
+from codec import CODEWORD_BITS
+
+
+DPI = 144
+TEXT_PADDING = 8
+BLANK_LUMA_FLOOR = 254.0
+MINIMUM_BLANK_FRACTION = 0.99
+CAPACITY_PROBE_REPETITIONS = 18
+
+
+@dataclass(frozen=True)
+class CarrierProfile:
+    name: str
+    kind: str
+    block_size: int
+    repetitions: int
+    strength: float
+    text_avoidance: bool
+
+    @property
+    def physical_symbols(self) -> int:
+        return CODEWORD_BITS * self.repetitions
+
+    @property
+    def nominal_pixels(self) -> int:
+        return self.physical_symbols * self.block_size**2
+
+    def to_dict(self) -> dict[str, object]:
+        return {
+            **asdict(self),
+            "codeword_bits": CODEWORD_BITS,
+            "physical_symbols": self.physical_symbols,
+            "nominal_pixels": self.nominal_pixels,
+            "dpi": DPI,
+        }
+
+
+BASELINE = CarrierProfile(
+    name="legacy_split_12_r50",
+    kind="legacy_split",
+    block_size=12,
+    repetitions=50,
+    strength=4.0,
+    text_avoidance=False,
+)
+CANDIDATE = CarrierProfile(
+    name="inkcluster_32_r7",
+    kind="inkcluster",
+    block_size=32,
+    repetitions=7,
+    strength=18.0,
+    text_avoidance=True,
+)
+PROFILES = {profile.name: profile for profile in (BASELINE, CANDIDATE)}
+
+
+@dataclass(frozen=True)
+class Tile:
+    page: int
+    y: int
+    x: int
+
+
+def _prf_bytes(
+    secret: bytes, context: str, purpose: bytes, length: int
+) -> bytes:
+    if not isinstance(secret, bytes) or len(secret) < 16:
+        raise ValueError("carrier secret must contain at least 16 bytes")
+    if not isinstance(context, str) or not context:
+        raise ValueError("carrier context must be a non-empty string")
+    prefix = b"NISHAN-INKCLUSTER/v1\x00" + purpose + b"\x00" + context.encode(
+        "utf-8"
+    )
+    output = bytearray()
+    for counter in range(math.ceil(length / hashlib.sha3_256().digest_size)):
+        output.extend(
+            hmac.new(
+                secret,
+                prefix + counter.to_bytes(8, "big"),
+                hashlib.sha3_256,
+            ).digest()
+        )
+    return bytes(output[:length])
+
+
+def _binary_word(value: np.ndarray, length: int, label: str) -> np.ndarray:
+    array = np.asarray(value)
+    if array.shape != (length,) or np.any((array != 0) & (array != 1)):
+        raise ValueError(f"{label} must be a binary vector of length {length}")
+    return array.astype(np.uint8, copy=False)
+
+
+def _text(document: fitz.Document) -> str:
+    return "\f".join(page.get_text() for page in document)
+
+
+def _text_hash(value: str) -> str:
+    return hashlib.sha3_256(value.encode("utf-8")).hexdigest()
+
+
+def _text_masks(
+    source: Path,
+    page_shapes: list[tuple[int, int]],
+    *,
+    padding: int,
+) -> list[np.ndarray]:
+    document = fitz.open(source)
+    try:
+        if len(document) != len(page_shapes):
+            raise ValueError("PDF page count changed while making text masks")
+        masks: list[np.ndarray] = []
+        for page, (height, width) in zip(document, page_shapes, strict=True):
+            mask = np.zeros((height, width), dtype=bool)
+            scale_x = width / page.rect.width
+            scale_y = height / page.rect.height
+            for word in page.get_text("words"):
+                x0, y0, x1, y1 = word[:4]
+                left = max(0, int(math.floor(x0 * scale_x)) - padding)
+                right = min(width, int(math.ceil(x1 * scale_x)) + padding)
+                top = max(0, int(math.floor(y0 * scale_y)) - padding)
+                bottom = min(height, int(math.ceil(y1 * scale_y)) + padding)
+                if right > left and bottom > top:
+                    mask[top:bottom, left:right] = True
+            masks.append(mask)
+        return masks
+    finally:
+        document.close()
+
+
+def eligible_tiles(
+    source: Path,
+    *,
+    block_size: int = CANDIDATE.block_size,
+    text_padding: int = TEXT_PADDING,
+    blank_floor: float = BLANK_LUMA_FLOOR,
+    minimum_blank_fraction: float = MINIMUM_BLANK_FRACTION,
+) -> list[Tile]:
+    """Return raster-grid tiles that avoid padded text and are nearly blank."""
+
+    if block_size < 4 or block_size % 2:
+        raise ValueError("block_size must be an even integer of at least four")
+    if text_padding < 0:
+        raise ValueError("text_padding cannot be negative")
+    if not 0.0 <= minimum_blank_fraction <= 1.0:
+        raise ValueError("minimum_blank_fraction must be in [0, 1]")
+    pages, _ = watermark.load_pages(Path(source), dpi=DPI)
+    shapes = [page.shape[:2] for page in pages]
+    masks = _text_masks(Path(source), shapes, padding=text_padding)
+    result: list[Tile] = []
+    for page_index, (page, text_mask) in enumerate(
+        zip(pages, masks, strict=True)
+    ):
+        height, width = page.shape[:2]
+        luma = watermark._luma(page)
+        for y in range(0, height - block_size + 1, block_size):
+            for x in range(0, width - block_size + 1, block_size):
+                if text_mask[y : y + block_size, x : x + block_size].any():
+                    continue
+                blank_fraction = float(
+                    np.mean(
+                        luma[y : y + block_size, x : x + block_size]
+                        >= blank_floor
+                    )
+                )
+                if blank_fraction >= minimum_blank_fraction:
+                    result.append(Tile(page=page_index, y=y, x=x))
+    return result
+
+
+def candidate_capacity(source: Path) -> int:
+    return len(eligible_tiles(Path(source)))
+
+
+def _cluster_masks(block_size: int) -> np.ndarray:
+    """Return `[orientation, negative/positive, y, x]` clustered-dot masks."""
+
+    if block_size != 32:
+        raise ValueError("the frozen candidate uses exactly 32 px blocks")
+    masks = np.zeros((2, 2, block_size, block_size), dtype=bool)
+    # Vertical lobes: four x positions by four y positions, each a 2x2 cluster.
+    for lobe, x_base in enumerate((0, block_size // 2)):
+        for y in (3, 11, 19, 27):
+            for x in (1, 5, 9, 13):
+                masks[0, lobe, y : y + 2, x_base + x : x_base + x + 2] = True
+    # Horizontal lobes use the same equal-ink construction rotated 90 degrees.
+    for lobe, y_base in enumerate((0, block_size // 2)):
+        for y in (1, 5, 9, 13):
+            for x in (3, 11, 19, 27):
+                masks[1, lobe, y_base + y : y_base + y + 2, x : x + 2] = True
+    return masks
+
+
+def _candidate_plan(
+    secret: bytes, context: str, capacity: int, symbols: int
+) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    if symbols > capacity:
+        raise ValueError(
+            f"candidate needs {symbols} blank tiles but source capacity is {capacity}"
+        )
+    keys = np.frombuffer(
+        _prf_bytes(secret, context, b"tile-order", capacity * 8), dtype="<u8"
+    )
+    order = np.argsort(keys, kind="stable")[:symbols]
+    controls = np.unpackbits(
+        np.frombuffer(
+            _prf_bytes(secret, context, b"controls", math.ceil(symbols * 2 / 8)),
+            dtype=np.uint8,
+        )
+    )[: symbols * 2].reshape(symbols, 2)
+    orientations = controls[:, 0]
+    polarities = 2 * controls[:, 1].astype(np.int8) - 1
+    return order, orientations, polarities
+
+
+def _rgba_overlay(alpha: np.ndarray) -> bytes:
+    rgba = np.zeros((*alpha.shape, 4), dtype=np.uint8)
+    rgba[:, :, 3] = alpha
+    stream = io.BytesIO()
+    Image.fromarray(rgba, mode="RGBA").save(stream, format="PNG", optimize=True)
+    return stream.getvalue()
+
+
+def _cluster_origins(orientation: int, lobe: int) -> tuple[tuple[int, int], ...]:
+    """Return the sixteen 2x2 cluster origins for one frozen lobe."""
+
+    if orientation not in {0, 1} or lobe not in {0, 1}:
+        raise ValueError("orientation and lobe must be binary")
+    if orientation == 0:
+        return tuple(
+            (y, 16 * lobe + x)
+            for y in (3, 11, 19, 27)
+            for x in (1, 5, 9, 13)
+        )
+    return tuple(
+        (16 * lobe + y, x)
+        for y in (1, 5, 9, 13)
+        for x in (3, 11, 19, 27)
+    )
+
+
+def _embed_candidate(
+    source: Path,
+    destination: Path,
+    physical_word: np.ndarray,
+    secret: bytes,
+    context: str,
+    profile: CarrierProfile,
+) -> dict[str, object]:
+    pages, _ = watermark.load_pages(source, dpi=DPI)
+    tiles = eligible_tiles(source, block_size=profile.block_size)
+    order, orientations, polarities = _candidate_plan(
+        secret, context, len(tiles), int(physical_word.size)
+    )
+    masks = _cluster_masks(profile.block_size)
+    alpha = int(round(profile.strength))
+    if not 1 <= alpha <= 255 or float(alpha) != profile.strength:
+        raise ValueError("candidate strength must be an integer alpha in [1,255]")
+    signs = 2 * physical_word.astype(np.int8) - 1
+    placements: list[tuple[Tile, int, int]] = []
+    for symbol_index, tile_index in enumerate(order):
+        tile = tiles[int(tile_index)]
+        orientation = int(orientations[symbol_index])
+        encoded_positive = signs[symbol_index] * polarities[symbol_index] > 0
+        lobe = 1 if encoded_positive else 0
+        placements.append((tile, orientation, lobe))
+
+    document = fitz.open(source)
+    try:
+        source_text = _text(document)
+        for page_index, page in enumerate(document):
+            height, width = pages[page_index].shape[:2]
+            scale_x = page.rect.width / width
+            scale_y = page.rect.height / height
+            shape = page.new_shape()
+            rectangles = 0
+            for tile, orientation, lobe in placements:
+                if tile.page != page_index:
+                    continue
+                for local_y, local_x in _cluster_origins(orientation, lobe):
+                    shape.draw_rect(
+                        fitz.Rect(
+                            (tile.x + local_x) * scale_x,
+                            (tile.y + local_y) * scale_y,
+                            (tile.x + local_x + 2) * scale_x,
+                            (tile.y + local_y + 2) * scale_y,
+                        )
+                    )
+                    rectangles += 1
+            if rectangles:
+                gray = (255 - alpha) / 255.0
+                shape.finish(color=None, fill=(gray, gray, gray), width=0)
+                shape.commit(overlay=True)
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        document.save(destination, garbage=0, clean=False, deflate=True)
+    finally:
+        document.close()
+    marked_document = fitz.open(destination)
+    try:
+        marked_text = _text(marked_document)
+    finally:
+        marked_document.close()
+    return {
+        "pages": len(pages),
+        "eligible_tiles": len(tiles),
+        "embedded_symbols": int(physical_word.size),
+        "changed_pixels_per_symbol": 64,
+        "actual_luma_mark_pixels": int(physical_word.size * 64),
+        "text_preserved": marked_text == source_text,
+        "source_text_sha3_256": _text_hash(source_text),
+        "marked_text_sha3_256": _text_hash(marked_text),
+    }
+
+
+def _region_metrics(
+    original: list[np.ndarray],
+    marked: list[np.ndarray],
+    masks: list[np.ndarray],
+) -> dict[str, object]:
+    squared_error = 0.0
+    values = 0
+    pixels = 0
+    changed_pixels = 0
+    max_delta = 0.0
+    for source_page, marked_page, mask in zip(
+        original, marked, masks, strict=True
+    ):
+        if source_page.shape != marked_page.shape or mask.shape != source_page.shape[:2]:
+            raise ValueError("fidelity inputs have incompatible shapes")
+        selected_source = source_page[mask].astype(np.float64)
+        selected_marked = marked_page[mask].astype(np.float64)
+        difference = selected_marked - selected_source
+        if difference.size:
+            squared_error += float(np.square(difference).sum())
+            values += int(difference.size)
+            pixels += int(mask.sum())
+            changed_pixels += int(np.count_nonzero(np.any(difference != 0.0, axis=1)))
+            max_delta = max(max_delta, float(np.abs(difference).max()))
+    if values == 0:
+        return {
+            "pixels": 0,
+            "mse": None,
+            "psnr_db": None,
+            "psnr_infinite": None,
+            "max_absolute_delta": None,
+            "changed_pixels": 0,
+            "changed_fraction": None,
+            "unavailable_reason": "region mask contains no pixels",
+        }
+    mse = squared_error / values
+    return {
+        "pixels": pixels,
+        "mse": mse,
+        "psnr_db": None if mse == 0.0 else 20.0 * math.log10(255.0 / math.sqrt(mse)),
+        "psnr_infinite": mse == 0.0,
+        "max_absolute_delta": max_delta,
+        "changed_pixels": changed_pixels,
+        "changed_fraction": changed_pixels / pixels,
+        "unavailable_reason": None,
+    }
+
+
+def fidelity_metrics(source: Path, marked: Path) -> dict[str, object]:
+    """Measure global, text-box and source-blank rendered distortion."""
+
+    source_pages, _ = watermark.load_pages(Path(source), dpi=DPI)
+    marked_pages, _ = watermark.load_pages(Path(marked), dpi=DPI)
+    if len(source_pages) != len(marked_pages):
+        raise ValueError("source and marked page counts differ")
+    shapes = [page.shape[:2] for page in source_pages]
+    text_masks = _text_masks(Path(source), shapes, padding=0)
+    global_masks = [np.ones(shape, dtype=bool) for shape in shapes]
+    blank_masks = [
+        (watermark._luma(page) >= BLANK_LUMA_FLOOR) & ~text_mask
+        for page, text_mask in zip(source_pages, text_masks, strict=True)
+    ]
+    return {
+        "global": _region_metrics(source_pages, marked_pages, global_masks),
+        "text_region": _region_metrics(source_pages, marked_pages, text_masks),
+        "blank_region": _region_metrics(source_pages, marked_pages, blank_masks),
+        "text_region_definition": "union of extracted word rectangles at 144 DPI, no padding",
+        "blank_region_definition": "source luma >=254 outside unpadded text rectangles",
+    }
+
+
+def embed_profile(
+    source: Path,
+    destination: Path,
+    codeword: np.ndarray,
+    secret: bytes,
+    context: str,
+    profile: CarrierProfile,
+) -> dict[str, object]:
+    """Embed the same 96-bit ECC word through one frozen spatial profile."""
+
+    word = _binary_word(codeword, CODEWORD_BITS, "ECC codeword")
+    physical_word = np.tile(word, profile.repetitions)
+    if profile.kind == "inkcluster":
+        carrier_metrics = _embed_candidate(
+            Path(source), Path(destination), physical_word, secret, context, profile
+        )
+    elif profile.kind == "legacy_split":
+        result = tardos_carrier.embed_pdf(
+            Path(source),
+            Path(destination),
+            physical_word,
+            secret,
+            context,
+            strength=profile.strength,
+            dpi=DPI,
+            block_size=profile.block_size,
+        )
+        carrier_metrics = asdict(result)
+        carrier_metrics["eligible_tiles"] = result.capacity_symbols
+        carrier_metrics["actual_luma_mark_pixels"] = None
+        carrier_metrics["changed_pixels_per_symbol"] = None
+    else:
+        raise ValueError(f"unknown carrier kind: {profile.kind}")
+    return {
+        "profile": profile.to_dict(),
+        **carrier_metrics,
+        "fidelity": fidelity_metrics(Path(source), Path(destination)),
+    }
+
+
+def collapse_correlations(
+    correlations: np.ndarray, logical_bits: int, repetitions: int
+) -> tuple[np.ndarray, np.ndarray]:
+    values = np.asarray(correlations, dtype=np.float64)
+    if logical_bits < 1 or repetitions < 1:
+        raise ValueError("logical_bits and repetitions must be positive")
+    if values.shape != (logical_bits * repetitions,) or not np.all(
+        np.isfinite(values)
+    ):
+        raise ValueError("correlations have the wrong shape or non-finite values")
+    summed = values.reshape(repetitions, logical_bits).sum(axis=0)
+    return (summed > 0.0).astype(np.uint8), summed
+
+
+def _registered_pages(
+    source: Path, suspect: Path, registration_mode: str
+) -> tuple[list[np.ndarray], list[np.ndarray], list[dict[str, object]]]:
+    if registration_mode not in {"off", "auto", "always"}:
+        raise ValueError("registration_mode must be off, auto, or always")
+    reference_pages, _ = watermark.load_pages(source, dpi=DPI)
+    suspect_pages, _ = watermark.load_pages(suspect, dpi=DPI)
+    if len(reference_pages) != len(suspect_pages):
+        raise ValueError("reference and suspect page counts differ")
+    aligned: list[np.ndarray] = []
+    diagnostics: list[dict[str, object]] = []
+    for reference, observed in zip(reference_pages, suspect_pages, strict=True):
+        original_observed_shape = observed.shape[:2]
+        should_register = registration_mode == "always" or (
+            registration_mode == "auto" and observed.shape[:2] != reference.shape[:2]
+        )
+        if should_register:
+            result, metrics = registration.align_page(reference, observed)
+            aligned.append(result)
+            diagnostics.append(metrics.to_dict())
+        else:
+            if observed.shape[:2] != reference.shape[:2]:
+                observed = np.asarray(
+                    Image.fromarray(observed).resize(
+                        (reference.shape[1], reference.shape[0]),
+                        Image.Resampling.LANCZOS,
+                    ),
+                    dtype=np.uint8,
+                )
+            aligned.append(observed)
+            diagnostics.append(
+                {
+                    "method": "identity"
+                    if original_observed_shape == reference.shape[:2]
+                    else "resize-only",
+                    "applied": False,
+                    "reference_width": int(reference.shape[1]),
+                    "reference_height": int(reference.shape[0]),
+                    "suspect_width": int(original_observed_shape[1]),
+                    "suspect_height": int(original_observed_shape[0]),
+                    "rejection_reason": None
+                    if original_observed_shape == reference.shape[:2]
+                    else "registration disabled",
+                }
+            )
+    return reference_pages, aligned, diagnostics
+
+
+def _decode_candidate_physical(
+    source: Path,
+    suspect: Path,
+    symbol_count: int,
+    secret: bytes,
+    context: str,
+    profile: CarrierProfile,
+    registration_mode: str,
+) -> tuple[np.ndarray, list[dict[str, object]]]:
+    reference_pages, suspect_pages, diagnostics = _registered_pages(
+        source, suspect, registration_mode
+    )
+    tiles = eligible_tiles(source, block_size=profile.block_size)
+    order, orientations, polarities = _candidate_plan(
+        secret, context, len(tiles), symbol_count
+    )
+    masks = _cluster_masks(profile.block_size)
+    ink_pages = [
+        watermark._luma(reference) - watermark._luma(observed)
+        for reference, observed in zip(reference_pages, suspect_pages, strict=True)
+    ]
+    correlations = np.empty(symbol_count, dtype=np.float64)
+    for symbol_index, tile_index in enumerate(order):
+        tile = tiles[int(tile_index)]
+        patch = ink_pages[tile.page][
+            tile.y : tile.y + profile.block_size,
+            tile.x : tile.x + profile.block_size,
+        ]
+        orientation = int(orientations[symbol_index])
+        negative, positive = masks[orientation]
+        value = float(patch[positive].sum() - patch[negative].sum())
+        correlations[symbol_index] = value * int(polarities[symbol_index])
+    return correlations, diagnostics
+
+
+def decode_profile(
+    source: Path,
+    suspect: Path,
+    secret: bytes,
+    context: str,
+    profile: CarrierProfile,
+    *,
+    registration_mode: str = "auto",
+) -> tuple[np.ndarray, np.ndarray, dict[str, object]]:
+    """Decode and analog-sum repetitions before making the 96 hard bits."""
+
+    if profile.kind == "inkcluster":
+        physical, page_diagnostics = _decode_candidate_physical(
+            Path(source),
+            Path(suspect),
+            profile.physical_symbols,
+            secret,
+            context,
+            profile,
+            registration_mode,
+        )
+    elif profile.kind == "legacy_split":
+        _, physical, imported_diagnostics = tardos_carrier.decode_word_with_diagnostics(
+            Path(source),
+            Path(suspect),
+            profile.physical_symbols,
+            secret,
+            context,
+            dpi=DPI,
+            block_size=profile.block_size,
+            registration_mode=registration_mode,
+        )
+        page_diagnostics = imported_diagnostics["pages"]
+    else:
+        raise ValueError(f"unknown carrier kind: {profile.kind}")
+    word, summed = collapse_correlations(
+        physical, CODEWORD_BITS, profile.repetitions
+    )
+    return word, summed, {
+        "registration_mode": registration_mode,
+        "pages": page_diagnostics,
+        "physical_correlation_minimum": float(physical.min()),
+        "physical_correlation_maximum": float(physical.max()),
+        "physical_correlation_mean": float(physical.mean()),
+        "logical_correlation_minimum": float(summed.min()),
+        "logical_correlation_maximum": float(summed.max()),
+        "logical_correlation_mean": float(summed.mean()),
+    }
