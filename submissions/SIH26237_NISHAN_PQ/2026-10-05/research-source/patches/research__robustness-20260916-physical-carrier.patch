+            for item in confirmation
+        )
+        for profile in PROFILES
+    }
+    not_lower = (
+        confirmation_counts[CANDIDATE.name]
+        >= confirmation_counts[BASELINE.name]
+    )
+    required_candidate_cases = [
+        item
+        for item in observations
+        if item["kind"] == "positive"
+        and item["split"] == "confirmation"
+        and item["profile"] == CANDIDATE.name
+        and item["transform"] in {"photo_resize_jpeg", "print_halftone"}
+    ]
+    candidate_photo_print_exact = len(required_candidate_cases) == 4 and all(
+        item["accepted_expected"] for item in required_candidate_cases
+    )
+    requirements = {
+        "all_12_clean_positives_exact": clean_exact,
+        "all_72_target_negatives_avoid_expected_acceptance": negatives_clear,
+        "all_12_target_pdfs_preserve_extracted_text": text_preserved,
+        "all_6_candidate_text_regions_have_zero_changed_pixels": candidate_text_zero,
+        "candidate_confirmation_count_not_lower": not_lower,
+        "candidate_both_confirmation_photo_and_halftone_exact": candidate_photo_print_exact,
+    }
+    return {
