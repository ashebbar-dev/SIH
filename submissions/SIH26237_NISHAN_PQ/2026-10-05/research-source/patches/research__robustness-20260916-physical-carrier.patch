+#!/usr/bin/env python3
+"""Run the frozen synthetic pilot for the print-aware compact carrier."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import importlib.metadata
+import io
+import json
+import os
+import platform
+import resource
+import shutil
+import subprocess
+import tempfile
+import time
+import traceback
+from dataclasses import replace
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+from PIL import Image, ImageDraw, ImageEnhance, ImageFilter
+
+from nishan import tardos_carrier, watermark
+
+from carrier import (
+    BASELINE,
+    CAPACITY_PROBE_REPETITIONS,
+    CANDIDATE,
+    DPI,
+    PROFILES,
+    candidate_capacity,
+    decode_profile,
+    embed_profile,
+)
+from codec import CODEWORD_BITS, decode_message, encode_message
+
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+EXPERIMENT_ROOT = Path(__file__).resolve().parent
+COMMON_SOURCE_ROOT = Path(
+    "/tmp/sih-robustness-20260916-control/research/robustness_campaign/sources"
+)
+SOURCE_MANIFEST = COMMON_SOURCE_ROOT / "manifest.json"
+PREREGISTRATION = EXPERIMENT_ROOT / "preregistration.json"
+SOURCE_CONTROL_COMMIT = "1148b8b7bf5dde7d37ef9854f7d9978c6f003456"
+SCHEMA = "nishan-physical-carrier-pilot/v1"
+PUBLIC_SEED = b"NISHAN physical carrier public pilot 2026-09-16 v1"
+WRONG_SEED = b"NISHAN physical carrier intentionally wrong key 2026-09-16 v1"
+CONTEXT_PREFIX = "nishan-physical-carrier-pilot/v1"
+TARGET = (7, 0x2A1B3C)
+OTHER_ISSUED = (29, 0x155AA5)
+POSITIVE_TRANSFORMS = (
+    "clean",
+    "jpeg55",
+    "photo_resize_jpeg",
+    "print_halftone",
+    "scanner_contrast",
+    "scanner_bilevel",
+)
+UNMARKED_TRANSFORMS = ("clean", "print_halftone", "scanner_bilevel")
+CONFIRMATION_CHANNELS = (
+    "photo_resize_jpeg",
+    "print_halftone",
+    "scanner_contrast",
+    "scanner_bilevel",
+)
+
+
+def _now() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _sha3(path: Path) -> str:
+    digest = hashlib.sha3_256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _json_write(path: Path, value: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="utf-8",
+    )
+
+
+def create_output_directory(output: Path) -> None:
+    Path(output).mkdir(parents=True, exist_ok=False)
+
+
+def _derive(seed: bytes, purpose: bytes) -> bytes:
+    return hashlib.sha3_256(seed + b"\x00" + purpose).digest()
+
+
+def _message_context(source_id: str) -> str:
+    return f"{CONTEXT_PREFIX}/{source_id}/message"
+
+
+def _carrier_context(source_id: str, profile_name: str) -> str:
+    return f"{CONTEXT_PREFIX}/{source_id}/carrier/{profile_name}"
+
+
+def build_declared_matrix(
+    cases: list[dict[str, object]],
+) -> list[dict[str, object]]:
+    matrix: list[dict[str, object]] = []
