@@ -0,0 +1,220 @@
+#!/usr/bin/env python3
+"""Score one fresh capture against the frozen compact physical-carrier pilot.
+
+The scorer is deliberately read-only: it verifies the committed pilot and
+source hashes, reads one suspect file, and emits finite JSON to stdout.  It
+does not write into the pilot directory and does not make an identity,
+authenticity, or culpability decision.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import tempfile
+import time
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+from PIL import Image, ImageOps
+
+from nishan import watermark
+
+from carrier import PROFILES, decode_profile
+from codec import CODEWORD_BITS, decode_message, encode_message
+from run_pilot import (
+    EXPERIMENT_ROOT,
+    PREREGISTRATION,
+    PUBLIC_SEED,
+    TARGET,
+    _carrier_context,
+    _derive,
+    _message_context,
+    _sha3,
+)
+
+
+DEFAULT_PILOT = EXPERIMENT_ROOT / "pilot"
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _read_json(path: Path) -> dict[str, Any]:
+    try:
+        value = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as error:
+        raise ValueError(f"cannot read verified JSON {path}: {error}") from error
+    if not isinstance(value, dict):
+        raise ValueError(f"expected a JSON object at {path}")
+    return value
+
+
+def _verified_inputs(
+    pilot: Path, source_id: str, profile_name: str
+) -> tuple[Path, dict[str, Any], dict[str, Any]]:
+    manifest = _read_json(pilot / "manifest.json")
+    results = _read_json(pilot / "results.json")
+    if manifest.get("status") != "prepared" or results.get("status") != "complete":
+        raise ValueError("pilot manifest/results are not in their completed states")
+
+    current_config_hash = _sha3(PREREGISTRATION)
+    recorded_hashes = {
+        manifest.get("preregistration_sha3_256"),
+        results.get("configuration_sha3_256"),
+    }
+    if recorded_hashes != {current_config_hash}:
+        raise ValueError("current preregistration does not match the completed pilot")
+
+    implementation = manifest.get("implementation_sha3_256")
+    if not isinstance(implementation, dict):
+        raise ValueError("pilot manifest has no implementation hash map")
+    repo_root = EXPERIMENT_ROOT.parents[2]
+    for relative, expected_hash in implementation.items():
+        implementation_path = repo_root / str(relative)
+        if not implementation_path.is_file() or _sha3(implementation_path) != expected_hash:
+            raise ValueError(f"implementation hash mismatch: {relative}")
+
+    source_manifest = manifest.get("source_manifest")
+    cases = source_manifest.get("cases") if isinstance(source_manifest, dict) else None
+    if not isinstance(cases, list):
+        raise ValueError("pilot manifest has no verified source cases")
+    matching = [case for case in cases if case.get("id") == source_id]
+    if len(matching) != 1:
+        raise ValueError(f"source id is not uniquely declared: {source_id}")
+    case = matching[0]
+    source = pilot / "sources" / str(case["file"])
+    if not source.is_file() or _sha256(source) != case.get("sha256"):
+        raise ValueError(f"pilot source hash mismatch: {source_id}")
+
+    if profile_name not in PROFILES or profile_name not in manifest.get("profiles", {}):
+        raise ValueError(f"profile was not frozen in the completed pilot: {profile_name}")
+    if PROFILES[profile_name].to_dict() != manifest["profiles"][profile_name]:
+        raise ValueError(f"current profile differs from the completed pilot: {profile_name}")
+    return source, manifest, results
+
+
+def _oriented_raster(capture: Path, temporary: Path) -> Path:
+    """Losslessly materialize EXIF orientation for raster camera files."""
+
+    if watermark.is_pdf_document(capture):
+        return capture
+    with Image.open(capture) as image:
+        oriented = ImageOps.exif_transpose(image).convert("RGB")
+        if oriented.width < 1 or oriented.height < 1:
+            raise ValueError("capture has no raster pixels")
+        normalized = temporary / "capture-exif-oriented.png"
+        oriented.save(normalized, format="PNG", optimize=False)
+    return normalized
+
+
+def score_capture(
+    capture: Path,
+    *,
+    pilot: Path = DEFAULT_PILOT,
+    source_id: str = "test_mixed",
+    profile_name: str,
+) -> dict[str, Any]:
+    capture = Path(capture).resolve()
+    pilot = Path(pilot).resolve()
+    if not capture.is_file():
+        raise ValueError(f"capture does not exist: {capture}")
+    source, manifest, _ = _verified_inputs(pilot, source_id, profile_name)
+
+    master = _derive(PUBLIC_SEED, b"master")
+    carrier_key = _derive(master, b"carrier")
+    codec_key = _derive(master, b"codec")
+    carrier_context = _carrier_context(source_id, profile_name)
+    message_context = _message_context(source_id)
+    expected_word = encode_message(*TARGET, codec_key, message_context)
+
+    started = time.perf_counter()
+    with tempfile.TemporaryDirectory(prefix="nishan-capture-") as directory:
+        suspect = _oriented_raster(capture, Path(directory))
+        decoded_word, correlations, registration = decode_profile(
+            source,
+            suspect,
+            carrier_key,
+            carrier_context,
+            PROFILES[profile_name],
+            registration_mode="always",
+        )
+    elapsed = time.perf_counter() - started
+    decoded = decode_message(
+        decoded_word,
+        codec_key,
+        message_context,
+        expected=TARGET,
+    )
+    if decoded.accepted_expected:
+        outcome = "exact_expected"
+    elif decoded.valid_other_message:
+        outcome = "valid_other_message"
+    else:
+        outcome = "abstain"
+
+    bit_errors = int(np.count_nonzero(decoded_word != expected_word))
+    result: dict[str, Any] = {
+        "schema": "nishan-physical-capture-score/v1",
+        "research_only": True,
+        "synthetic_pilot_message": True,
+        "capture": {
+            "path": str(capture),
+            "sha256": _sha256(capture),
+            "bytes": capture.stat().st_size,
+        },
+        "verified_source": {
+            "source_id": source_id,
+            "path": str(source),
+            "sha256": _sha256(source),
+        },
+        "profile": PROFILES[profile_name].to_dict(),
+        "pilot_configuration_sha3_256": manifest["preregistration_sha3_256"],
+        "verified_implementation_sha3_256": manifest["implementation_sha3_256"],
+        "scorer_sha3_256": _sha3(Path(__file__)),
+        "registration_mode": "always",
+        "registration": registration,
+        "elapsed_seconds": elapsed,
+        "outcome": outcome,
+        "expected_codeword_bit_errors": bit_errors,
+        "expected_codeword_ber": bit_errors / CODEWORD_BITS,
+        "decoded_codeword_hex": np.packbits(decoded_word).tobytes().hex(),
+        "logical_correlation_minimum": float(correlations.min()),
+        "logical_correlation_maximum": float(correlations.max()),
+        "logical_correlation_mean": float(correlations.mean()),
+        "decode": decoded.to_dict(),
+        "interpretation": (
+            "Exact recovery, if present, is only recovery of the public synthetic "
+            "48-bit pilot message. It is not content authentication, a deployment "
+            "identity verdict, a false-attribution bound, or evidence of culpability."
+        ),
+    }
+    json.dumps(result, allow_nan=False)
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--capture", required=True, type=Path)
+    parser.add_argument("--pilot", type=Path, default=DEFAULT_PILOT)
+    parser.add_argument("--source-id", default="test_mixed")
+    parser.add_argument("--profile", required=True, choices=tuple(PROFILES))
+    args = parser.parse_args()
+    result = score_capture(
+        args.capture,
+        pilot=args.pilot,
+        source_id=args.source_id,
+        profile_name=args.profile,
+    )
+    print(json.dumps(result, indent=2, sort_keys=True, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
