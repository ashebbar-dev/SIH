+from __future__ import annotations
+
+import tempfile
+import unittest
+import json
+from itertools import product
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+from carrier import PROFILES
+from run_pilot import (
+    POSITIVE_TRANSFORMS,
+    UNMARKED_TRANSFORMS,
+    apply_transform,
+    build_declared_matrix,
+    create_output_directory,
+    _json_write,
+)
+
+
+CASES = [
+    {"id": "dev_a", "split": "development"},
+    {"id": "confirm_b", "split": "confirmation"},
+]
+EXPECTED_PROFILES = {"legacy_split_12_r50", "inkcluster_32_r7"}
+EXPECTED_POSITIVE_TRANSFORMS = {
+    "clean",
+    "jpeg55",
+    "photo_resize_jpeg",
+    "print_halftone",
+    "scanner_contrast",
+    "scanner_bilevel",
+}
+EXPECTED_UNMARKED_TRANSFORMS = {"clean", "print_halftone", "scanner_bilevel"}
+
+
+class MatrixTests(unittest.TestCase):
+    def test_declared_matrix_has_exact_unique_control_identities(self):
+        matrix = build_declared_matrix(CASES)
+        expected_per_source_profile = (
+            len(POSITIVE_TRANSFORMS) + len(UNMARKED_TRANSFORMS) + 4
+        )
+        self.assertEqual(
+            len(matrix), len(CASES) * len(PROFILES) * expected_per_source_profile
+        )
+        identities = {
+            (
+                item["source_id"],
+                item["profile"],
+                item["kind"],
+                item["transform"],
+            )
+            for item in matrix
+        }
+        self.assertEqual(len(identities), len(matrix))
+        self.assertEqual(set(PROFILES), EXPECTED_PROFILES)
+        self.assertEqual(set(POSITIVE_TRANSFORMS), EXPECTED_POSITIVE_TRANSFORMS)
+        self.assertEqual(set(UNMARKED_TRANSFORMS), EXPECTED_UNMARKED_TRANSFORMS)
+        expected_identities = set()
+        for case, profile, transform in product(
+            CASES, EXPECTED_PROFILES, EXPECTED_POSITIVE_TRANSFORMS
+        ):
+            expected_identities.add((case["id"], profile, "positive", transform))
+        for case, profile, transform in product(
+            CASES, EXPECTED_PROFILES, EXPECTED_UNMARKED_TRANSFORMS
+        ):
+            expected_identities.add((case["id"], profile, "unmarked", transform))
+        for case, profile, kind in product(
+            CASES,
+            EXPECTED_PROFILES,
+            {"wrong_key", "wrong_context", "other_issued"},
+        ):
+            expected_identities.add((case["id"], profile, kind, "clean"))
+        for case, profile in product(CASES, EXPECTED_PROFILES):
+            expected_identities.add(
+                (case["id"], profile, "copied_overlay_modified_content", "transplant")
+            )
+        self.assertEqual(identities, expected_identities)
+        for case in CASES:
+            for profile in PROFILES:
+                subset = [
+                    item
+                    for item in matrix
+                    if item["source_id"] == case["id"]
+                    and item["profile"] == profile
+                ]
+                self.assertEqual(len(subset), 13)
+                self.assertEqual(
+                    {item["kind"] for item in subset},
+                    {
+                        "positive",
+                        "unmarked",
+                        "wrong_key",
+                        "wrong_context",
+                        "other_issued",
+                        "copied_overlay_modified_content",
+                    },
+                )
+
+    def test_output_guard_does_not_overwrite(self):
+        with tempfile.TemporaryDirectory(dir="/tmp") as directory:
+            output = Path(directory) / "run"
+            create_output_directory(output)
+            sentinel = output / "sentinel"
+            sentinel.write_text("keep", encoding="utf-8")
+            with self.assertRaises(FileExistsError):
+                create_output_directory(output)
+            self.assertEqual(sentinel.read_text(encoding="utf-8"), "keep")
+
+    def test_json_writer_is_finite(self):
+        with tempfile.TemporaryDirectory(dir="/tmp") as directory:
+            finite = Path(directory) / "finite.json"
+            _json_write(finite, {"value": 1.25})
+            self.assertEqual(json.loads(finite.read_text())["value"], 1.25)
+            with self.assertRaises(ValueError):
+                _json_write(Path(directory) / "nan.json", {"value": float("nan")})
+
+
+class TransformTests(unittest.TestCase):
+    def setUp(self):
+        ramp = np.linspace(0, 255, 96, dtype=np.uint8)
+        x, y = np.meshgrid(ramp, ramp)
+        rgb = np.stack((x, y, np.full((96, 96), 220)), axis=2)
+        self.image = Image.fromarray(rgb.astype(np.uint8), mode="RGB")
+
+    def test_all_frozen_transforms_are_deterministic(self):
+        for name in POSITIVE_TRANSFORMS:
+            with self.subTest(name=name):
+                first = np.asarray(apply_transform(self.image, name))
+                second = np.asarray(apply_transform(self.image, name))
+                np.testing.assert_array_equal(first, second)
+
+    def test_photo_channel_is_separate_resize_and_recompression(self):
+        large = self.image.resize((1500, 1800))
+        transformed = apply_transform(large, "photo_resize_jpeg")
+        self.assertEqual(max(transformed.size), 1280)
+        self.assertNotEqual(transformed.size, large.size)
+
+    def test_scanner_bilevel_is_binary_and_not_jpeg55(self):
+        bilevel = np.asarray(apply_transform(self.image, "scanner_bilevel"))
+        self.assertLessEqual(set(np.unique(bilevel).tolist()), {0, 255})
+        jpeg = np.asarray(apply_transform(self.image, "jpeg55"))
+        self.assertGreater(len(np.unique(jpeg)), 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
